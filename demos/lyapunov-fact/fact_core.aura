;; demos/lyapunov-fact/fact_core.aura
;; Reference Aura helpers for the lyapunov-fact demo.
;;
;; Production runners drive Aura from Python via set-code / query:* /
;; ast:snapshot (see aura_driver.py). This file documents the same
;; contracts in Aura surface form for interactive exploration:
;;
;;   export AURA_PIPELINE_STRICT=0
;;   ./build/aura
;;   (load "demos/lyapunov-fact/fact_core.aura")  ; if load is wired
;;
;; Or paste forms into the pipe-mode Repl.

(define INITIAL-CODE
  "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))")

(define GOOD-ITER
  "(define (fact n) (let loop ((i n) (acc 1)) (if (= i 0) acc (loop (- i 1) (* acc i)))))")

(define (install-code code)
  (set-code code)
  (eval-current)
  #t)

(define (node-count)
  (let ((r (query:root)))
    (if (not r)
        0
        (let cnt ((id r))
          (+ 1 (apply + (map cnt (query :children id))))))))

(define (recursive-residual)
  (length (query:calls "fact")))

(define (test-fail)
  (if (= (fact 10) 3628800) 0 1))

;; energy already scaled by driver (0.05 * |Δnodes|)
(define (compute-V energy)
  (+ (* 10 (test-fail))
     (* 2 (recursive-residual))
     (* 0.1 (node-count))
     energy))

(define (in-S? initial-nc)
  (and (= (test-fail) 0)
       (= (recursive-residual) 0)
       (<= (node-count) (* 1.5 initial-nc))))
