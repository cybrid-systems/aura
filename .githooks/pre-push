#!/usr/bin/env bash
#
# Aura pre-push hook — fast static gate before push.
#
# Default: ./build.py gate --changed
#   - docs + ruff + clang-format (changed C++ only)
#   - parallel coverage checks whose paths intersect the git diff
#   - nested check_* cascades suppressed (gate already runs each once)
#   - chaos runtime profiles skipped (static coverage still runs if selected)
#
# Full gate (CI parity, slower):
#   AURA_GATE_FULL=1 git push
#   # or: python3 build.py gate --full
#
# Exit codes:
#   0 — gate clean
#   1 — gate failed (fix locally, then push again)

set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)

if ! command -v python3 >/dev/null 2>&1; then
    echo "❌ pre-push: python3 not found on PATH" >&2
    exit 1
fi

GATE_ARGS=(gate --changed)
if [[ "${AURA_GATE_FULL:-}" == "1" || "${AURA_GATE_FULL:-}" == "true" || "${AURA_GATE_FULL:-}" == "yes" ]]; then
    GATE_ARGS=(gate --full)
    echo "pre-push: running FULL ./build.py gate (AURA_GATE_FULL=1)..."
else
    echo "pre-push: running ./build.py gate --changed (fast path)..."
    echo "          set AURA_GATE_FULL=1 for full gate (CI parity)"
fi

if ! python3 "$ROOT/build.py" "${GATE_ARGS[@]}"; then
    echo "❌ pre-push: gate failed — fix locally before pushing" >&2
    echo "   hints: ./build.py format --fix  |  ./build.py lint --fix  |  ./build.py docs" >&2
    echo "   full:  ./build.py gate --full   |  AURA_GATE_FULL=1 git push" >&2
    exit 1
fi

# Issue #4566: class-2 statistical gate plus a short class-1/3 slice.
# Fails only on a class-2 checksum miss or a #1936 regression.
# 200 and 2000 defines stay on `bench/run.py --full`.
echo "pre-push: class benchmark gate (bench/run.py --gate)..."
if ! python3 "$ROOT/bench/run.py" --gate; then
    echo "❌ pre-push: class-2 benchmark gate failed" >&2
    echo "   rerun: python3 bench/run.py --gate" >&2
    exit 1
fi

echo "pre-push: gate clean ✓"
exit 0
