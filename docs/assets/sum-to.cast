[2.140728, "o", "aura: preset=dev sandbox=restricted caps=mutate,read,write (tenant=0, ws=0)\r\n"]
[2.180222, "o", "live\r\n(define (sum-to n) (letrec ((loop (lambda (i s) (if (> i n) s (loop (+ i 1) (+ s i)))))) (loop 1 0)))\r\n\r\n"]
[4.267813, "o", "(sum-to 1000000) => 500000500000    487 ms\r\n"]
[5.667556, "o", "\r\npropose\r\n(define (sum-to n) (* n n))\r\n"]
[6.869969, "o", "trial  (sum-to 1000000) => 1000000000000    0 ms\r\n"]
[7.669744, "o", "       result changed, want 500000500000\r\n"]
[7.670513, "o", "ROLLBACK\r\nlive\r\n(define (sum-to n) (letrec ((loop (lambda (i s) (if (> i n) s (loop (+ i 1) (+ s i)))))) (loop 1 0)))\r\n"]
[9.271736, "o", "\r\npropose\r\n(define (sum-to n) (/ (* n (+ n 1)) 2))\r\n"]
[10.475613, "o", "trial  (sum-to 1000000) => 500000500000    0 ms\r\n"]
[11.275194, "o", "       same result on 1, 10, 100, 1000000; 0 ms vs 487 ms\r\nKEEP\r\nlive\r\n(define (sum-to n) (/ (* n (+ n 1)) 2))\r\n"]
[12.674909, "o", "\r\n(sum-to 1000000) => 500000500000    0 ms\r\n"]
