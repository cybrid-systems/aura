; Class 2: eight fibers eval pure while the parent rebinds hot.
; pure is not the mutated binding, so the fiber checksum stays stable.
; Encoded result is hot*100000000 + the sum of the eight fiber results.
; Default spin 500: one fiber sums 1..500 = 125250, times 8 = 1002000,
; hot(1) = 10, encoded 1001002000.
(define spin
  (let ((v (getenv "BENCH_SPIN")))
    (if (string? v) (string->number v) 500)))
(set-code "(define (pure x) (+ x 1))\n(define (hot x) (+ x 1))")
(eval-current)
(define (spin-sum)
  (let ((i 0) (a 0))
    (while (< i spin)
      (set! a (+ a (pure i)))
      (set! i (+ i 1)))
    a))
(define t0 (monotonic-ms))
(define fs
  (list
    (fiber:spawn (lambda () (spin-sum)))
    (fiber:spawn (lambda () (spin-sum)))
    (fiber:spawn (lambda () (spin-sum)))
    (fiber:spawn (lambda () (spin-sum)))
    (fiber:spawn (lambda () (spin-sum)))
    (fiber:spawn (lambda () (spin-sum)))
    (fiber:spawn (lambda () (spin-sum)))
    (fiber:spawn (lambda () (spin-sum)))))
(mutate:rebind "hot" "(lambda (x) (+ x 9))" "overlap")
(eval-current)
(define sum 0)
(define rest fs)
(while (pair? rest)
  (set! sum (+ sum (fiber:join (car rest))))
  (set! rest (cdr rest)))
(define hotv (hot 1))
(define t1 (monotonic-ms))
(display "BENCH fibers ")
(display (+ (* hotv 100000000) sum))
(display " ")
(display (- t1 t0))
(newline)
