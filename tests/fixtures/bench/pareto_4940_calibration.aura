; Issue #4940 — manual calibration for std/pareto (NSGA-II) and std/moead.
;
; NOT part of a gate: the 20k cells take minutes. Run it by hand after
; touching either module and paste the numbers into the comment block at
; the top of tests/suite/pareto_4940.aura / tests/suite/moead_4940.aura.
;
;   ./build/aura tests/fixtures/bench/pareto_4940_calibration.aura
;
; Every ratio is HV(front) / HV(analytic front) against the reference point
; (1.1 1.1), i.e. 1.0 is a front that covers the analytic front's volume.
; Fixed seeds: the numbers are reproducible on any walker, timings are not.

(require "std/pareto" all:)
(require "std/moead" all:)

(define (sum xs) (let loop ((ys xs) (a 0.0)) (if (null? ys) a (loop (cdr ys) (+ a (car ys))))))
(define (zdt1 g)
  (let* ((x1 (car g)) (rest (cdr g)) (nn (length rest))
         (gg (+ 1.0 (* 9.0 (/ (sum rest) nn)))) (f1 x1))
    (list f1 (* gg (- 1.0 (sqrt (/ f1 gg)))))))
(define (zdt2 g)
  (let* ((x1 (car g)) (rest (cdr g)) (nn (length rest))
         (gg (+ 1.0 (* 9.0 (/ (sum rest) nn)))) (f1 x1))
    (list f1 (* gg (- 1.0 (expt (/ f1 gg) 2))))))
(define (dtlz2 g)
  (let* ((k 10) (n (length g))
         (tail (let loop ((xs g) (i 0) (acc (list)))
                 (if (null? xs) (reverse acc)
                     (loop (cdr xs) (+ i 1)
                           (if (>= i (- n k)) (cons (car xs) acc) acc)))))
         (gg (sum (map (lambda (x) (* (- x 0.5) (- x 0.5))) tail)))
         (th1 (* 0.5 3.141592653589793 (car g)))
         (th2 (* 0.5 3.141592653589793 (car (cdr g)))))
    (list (* (+ 1.0 gg) (cos th1) (cos th2))
          (* (+ 1.0 gg) (cos th1) (sin th2))
          (* (+ 1.0 gg) (sin th1)))))
(define (front1 n) (let loop ((i 0) (acc (list))) (if (>= i n) (reverse acc)
  (let ((x (/ (* 1.0 i) (- n 1.0)))) (loop (+ i 1) (cons (list x (- 1.0 (sqrt x))) acc))))))
(define (front2 n) (let loop ((i 0) (acc (list))) (if (>= i n) (reverse acc)
  (let ((x (/ (* 1.0 i) (- n 1.0)))) (loop (+ i 1) (cons (list x (- 1.0 (* x x))) acc))))))
(define (front3 steps)
  (let loop1 ((i 0) (acc (list)))
    (if (> i steps) (reverse acc)
        (let ((th1 (* 0.5 3.141592653589793 (/ (* 1.0 i) steps))))
          (loop1 (+ i 1)
                 (let loop2 ((j 0) (a acc))
                   (if (> j steps) a
                       (let* ((th2 (* 0.5 3.141592653589793 (/ (* 1.0 j) steps)))
                              (p (list (* (cos th1) (cos th2))
                                       (* (cos th1) (sin th2))
                                       (sin th1))))
                         (loop2 (+ j 1) (cons p a))))))))))

(define ref2 (list 1.1 1.1))
(define ref3 (list 1.1 1.1 1.1))
(define dmin2 (hash "dirs" (list "min" "min")))
(define dmin3 (hash "dirs" (list "min" "min" "min")))
(define hv1 (pareto:hypervolume (front1 1001) ref2 dmin2))
(define hv2 (pareto:hypervolume (front2 1001) ref2 dmin2))
(define hv3 (pareto:hypervolume (front3 40) ref3 dmin3))
(display "analytic HV: zdt1=") (display hv1) (display " zdt2=") (display hv2)
(display " dtlz2=") (display hv3) (newline)

(define (ratio-of fr thv ref dirs)
  (let ((objs (map (lambda (e) (let ((o (hash-ref e "objs" #f))) (if (list? o) o e))) fr)))
    (/ (pareto:hypervolume objs ref dirs) thv)))

(define (nsga-cell dim evals)
  (let* ((s (nsga2:make (hash "dim" dim "pop" 30 "seed" 1 "dirs" (list "min" "min"))))
         (t0 (monotonic-ms)))
    (nsga2:run! s (lambda (c) (zdt1 (evo:candidate-genome c))) evals)
    (display "nsga2 zdt1 dim=") (display dim) (display " evals=") (display evals)
    (display " ms=") (display (- (monotonic-ms) t0))
    (display " ratio=") (display (ratio-of (nsga2:front s) hv1 ref2 dmin2)) (newline)))

(define (moead-cell tag fit thv ref dirs opts evals)
  (let ((s (moead:make opts)))
    (moead:run! s (lambda (c) (fit (evo:candidate-genome c))) evals)
    (display tag) (display " evals=") (display evals)
    (display " front=") (display (length (moead:front s)))
    (display " ratio=") (display (ratio-of (moead:front s) thv ref dirs)) (newline)))

(nsga-cell 10 6000)
(nsga-cell 30 6000)
(nsga-cell 30 20000)
(moead-cell "moead zdt1 dim=30" zdt1 hv1 ref2 dmin2
            (hash "n-obj" 2 "H" 39 "T" 20 "dim" 30 "seed" 3 "dirs" (list "min" "min")) 6000)
(moead-cell "moead zdt1 dim=30" zdt1 hv1 ref2 dmin2
            (hash "n-obj" 2 "H" 39 "T" 20 "dim" 30 "seed" 3 "dirs" (list "min" "min")) 20000)
(moead-cell "moead zdt2 dim=30" zdt2 hv2 ref2 dmin2
            (hash "n-obj" 2 "H" 39 "T" 20 "dim" 30 "seed" 4 "dirs" (list "min" "min")) 6000)
(moead-cell "moead zdt2 dim=30" zdt2 hv2 ref2 dmin2
            (hash "n-obj" 2 "H" 39 "T" 20 "dim" 30 "seed" 4 "dirs" (list "min" "min")) 20000)
(moead-cell "moead dtlz2 dim=12" dtlz2 hv3 ref3 dmin3
            (hash "n-obj" 3 "H" 16 "T" 16 "dim" 12 "seed" 5 "dirs" (list "min" "min" "min")) 6000)
(moead-cell "moead dtlz2 dim=12" dtlz2 hv3 ref3 dmin3
            (hash "n-obj" 3 "H" 16 "T" 16 "dim" 12 "seed" 5 "dirs" (list "min" "min" "min")) 20000)
