; Issue #2965: make-vector accepts integer-valued float lengths and
; rejects non-integers with an error value.
(require "std/test" all:)
(test-file "make_vector_float_len_2965.aura")

(test-case "integer-valued lengths" (hash "issue" 2965)
  (check= 5 (vector-length (make-vector 5 0.0)))
  (check= 5 (vector-length (make-vector 5.0 0.0)))
  (check= 10 (vector-length (make-vector (floor 10.0) 0.0)))
  (check= 5 (vector-length (make-vector (/ 10.0 2.0) 0.0)))
  (check= 10 (vector-length (make-vector (round 10.1) 0.0)))
  (check= 500 (vector-length (make-vector (+ (floor (/ 0.005 1e-5)) 1) 0.0))))

(test-case "non-integer lengths are errors" (hash "issue" 2965)
  (check (error? (make-vector 5.5 0.0)))
  (check (error? (make-vector -1 0.0))))

(test-finish)
