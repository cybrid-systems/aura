;; Issue #5031: register_query_obs_mid_primitives and
;; register_query_lifecycle_primitives are peeled into per-responsibility phases.
;; Primitive names, registration order, lambda capture lifetimes and every stats
;; payload key must not move.
(require "std/io" all:)

(define fails 0)
(define (check pred msg)
  (if pred
      #t
      (begin (set! fails (+ fails 1)) (display (format "FAIL ~a\n" msg)))))
(define (hget h k) (hash-ref h k))

;; ── obs_mid: pattern index / safety / rebuild / hash phase ──────────
(check (integer? (stats:get "query:pattern-index-stats")) "pattern-index-stats")
(check (hash? (stats:get "query:pattern-safety-stats")) "pattern-safety-stats")
(check (hash? (stats:get "query:pattern-index-rebuild-stats")) "pattern-index-rebuild")
(check (hash? (stats:get "query:pattern-index-stats-hash")) "pattern-index-stats-hash")

