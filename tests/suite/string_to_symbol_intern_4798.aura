; Issue #4798 — string->symbol interns like a quoted literal
(define *n* 0)
(define *fails* 0)
(define (check! pred msg)
  (set! *n* (+ *n* 1))
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))
(define (string-has? s sub)
  (let loop ((i 0))
    (cond ((> (+ i (string-length sub)) (string-length s)) #f)
          ((equal? (substring s i (+ i (string-length sub))) sub) #t)
          (else (loop (+ i 1))))))
(define (err-text thunk)
  (try (begin (thunk) "no-error") (catch (e) (format "~a" e))))

(check! (symbol? (string->symbol "high")) "string->symbol returns a symbol")
(check! (eq? (string->symbol "high") 'high) "eq? to the quoted literal")
(check! (equal? (assq (string->symbol "k") '((k . 1))) '(k . 1)) "assq finds it")
(check! (eq? (string->symbol "tile-4x4") 'tile-4x4) "hyphenated names intern")
(check! (equal? (symbol->string (string->symbol "abc")) "abc") "round-trips through symbol->string")
(check! (eq? (string->symbol 'already) 'already) "symbol input passes through")
(check! (equal? (case (string->symbol "b") ((a) 1) ((b) 2) (else 3)) 2) "usable in case")
(check! (string? (string->symbol "123")) "numeric text keeps string fallback")
(check! (string? (string->symbol "a b")) "text with spaces keeps string fallback")
(check! (equal? (string->symbol "") "") "empty string keeps string fallback")

(if (= *fails* 0)
    (begin (display "OK-string-to-symbol-4798 ") (display *n*) (display " checks") (newline))
    (begin (display "string-to-symbol-4798: ") (display (- *n* *fails*))
           (display "/") (display *n*) (newline) (exit 1)))
