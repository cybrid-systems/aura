; Issue #4798: string->symbol interns like a quoted literal.
(require "std/test" all:)
(test-file "string_to_symbol_intern_4798.aura")

(test-case "string to symbol" (hash "issue" 4798)
  (check (symbol? (string->symbol "high")))
  (check (eq? (string->symbol "high") 'high))
  (check= '(k . 1) (assq (string->symbol "k") '((k . 1))))
  (check (eq? (string->symbol "tile-4x4") 'tile-4x4))
  (check= "abc" (symbol->string (string->symbol "abc")))
  (check (eq? (string->symbol 'already) 'already))
  (check= 2 (case (string->symbol "b") ((a) 1) ((b) 2) (else 3)))
  (check (string? (string->symbol "123")))
  (check (string? (string->symbol "a b")))
  (check= "" (string->symbol "")))

(test-finish)
