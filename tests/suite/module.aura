; Module face: use, module-get, import, and require.
; Each export graph that needs its own (require ... all:) stays in its
; file: export_set_nested_require.aura, export_set_after_require.aura,
; export_set_require_order.aura, bench_exports.aura, and
; issue_5062_stats_export.aura. Overwrite warnings are stderr, so they
; stay in tests/python/process/export_contracts.py.
(require "std/test" all:)
(test-file "module.aura")

(test-case "use" (hash)
  (check (module? (use "std/list")))
  (check (module? (use "std/math"))))

(test-case "keys" (hash)
  (define keys (module-keys (use "std/list")))
  (check (pair? keys))
  (check (> (length keys) 0)))

(test-case "get" (hash)
  (check (procedure? (module-get (use "std/list") "sort")))
  (check= '() (module-get (use "std/list") "nonexistent")))

(test-case "import" (hash)
  (import "std/list")
  (check (eq? sort (module-get (use "std/list") "sort"))))

(test-case "import prefix" (hash)
  (import "std/list" "lst:")
  (check (eq? lst:sort (module-get (use "std/list") "sort"))))

; Both require spellings bind the module's exports as bare names.
(test-case "require symbol form" (hash)
  (require std/math)
  (check (procedure? square))
  (check (procedure? sqrt)))

(test-case "require all" (hash)
  (require std/math all:)
  (check (procedure? factorial))
  (check (procedure? sqrt)))

(test-finish)
