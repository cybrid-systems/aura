;; expect: (1 1 7 8 9 0 0 #t)(5 70 #t 0)
; Issue #4489: float keys by eqv?, list / vector / pair keys by content.
(define h (hash))
(hash-set! h 1.5 1)
(hash-set! h (list 1 2 3) 7)
(hash-set! h (vector 1 2) 8)
(hash-set! h (cons 'a 1) 9)
(hash-set! h 0.0 10)
(display (list (hash-ref h 1.5 0) (hash-ref h (* 0.5 3) 0) (hash-ref h (list 1 2 3) 0) (hash-ref h (vector 1 2) 0)
  (hash-ref h (cons 'a 1) 0) (hash-ref h -0.0 0) (hash-ref h 1 0) (hash-has-key? h (list 1 2 3))))
(hash-set! h (list 1 2 3) 70)
(display (list (hash-length h) (hash-ref h (list 1 2 3) 0) (hash-remove! h 1.5) (hash-ref h 1.5 0)))
(newline)
