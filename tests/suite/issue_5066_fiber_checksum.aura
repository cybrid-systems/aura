; #5066: parallel fibers still compute the modulo loop correctly.
; Scaling numbers are printed by tests/python/bench_fiber_scale_5066.py.
; This file is the correctness regression. A wrong fast path fails the sum.
(require "std/test" all:)
(test-file "issue_5066_fiber_checksum.aura")

(define WORK 20000)

(define (body)
  (let loop ((i 0) (a 0))
    (if (>= i WORK) a
      (loop (+ i 1) (+ a (modulo i 7))))))

(define (join-all xs acc)
  (if (null? xs) acc
    (join-all (cdr xs) (+ acc (fiber:join (car xs))))))

(test-case "parallel fibers agree on the sum" (hash "issue" 5066)
  (define one (body))
  (define ids (list (fiber:spawn (lambda () (body)))
                    (fiber:spawn (lambda () (body)))
                    (fiber:spawn (lambda () (body)))
                    (fiber:spawn (lambda () (body)))))
  (check= (* 4 one) (join-all ids 0)))

(test-finish)
