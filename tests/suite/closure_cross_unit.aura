; Issue #5342: calling a closure defined in another compilation unit must
; cost the same as calling one defined in the same unit. A module written to
; /tmp supplies the cross-unit callee and loop; the same loop/body lives in
; this file. Node ids are per-flat, so the evaluator's per-node name memo has
; to keep one bucket per flat (one shared vector made each side evict the
; other's entries).
(require "std/test" all:)
(require "std/io" all:)
(require "std/string" all:)
(test-file "closure_cross_unit.aura")

(define cross-mod "/tmp/aura5342_cross_unit_mod.aura")
(file-write cross-mod
  (string-join
    (list "(export m-any m-neg?)"
          "(define (m-any pred xs) (let loop ((xs xs)) (if (null? xs) #f (let ((r (pred (car xs)))) (if r r (loop (cdr xs)))))))"
          "(define (m-neg? x) (< x 0))")
    "\n"))
(require "/tmp/aura5342_cross_unit_mod.aura" all:)

(define (f-any pred xs)
  (let loop ((xs xs))
    (if (null? xs) #f (let ((r (pred (car xs)))) (if r r (loop (cdr xs)))))))
(define (iota0 n) (let loop ((i (- n 1)) (acc (list))) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define neg? (lambda (x) (< x 0)))
(define big (iota0 160000))
(define small (iota0 40000))

(test-case "cross-unit closure results" (hash "issue" 5342)
  (check= #t (m-any neg? (list 1 -1)))
  (check= #f (m-any neg? (list 1 2)))
  (check= #t (f-any m-neg? (list 1 -1)))
  (check= #f (f-any m-neg? (list 1 2)))
  (check= #f (m-any neg? (list))))

(m-any neg? (list 1 -1))
(f-any neg? (list 1 -1))
(define (once th) (let ((t0 (monotonic-ms))) (th) (- (monotonic-ms) t0)))
(define (best3 th) (min (once th) (min (once th) (once th))))
(define (best5 th)
  (min (once th) (min (once th) (min (once th) (min (once th) (once th))))))

(test-case "cross-unit call budget" (hash "issue" 5342)
  (define fm (best5 (lambda () (f-any neg? big))))
  (define mm (best5 (lambda () (m-any neg? big))))
  ; Same process, back-to-back best-of-five. The old 1.2x ceiling was
  ; calibrated on an idle box (~1.17x here); on a loaded CI runner the
  ; same code spends the slack in the wall clock (the v0.2.6 run failed
  ; here at 303/306 with the rest green). 1.6x still separates the fixed
  ; shape from the 1.94x shared-memo regression, and best-of-five skips
  ; a single descheduled sample.
  (check (< mm (* 1.6 (max 1 fm)))))

; CI run 37c1f59 failed this row on one 40k/160k sample pair: a single
; descheduled walk inflates the 160k side much more than the 40k side, so the
; measured ratio jumps although the shape is linear. Run each sample three
; times (same work as a 3x longer input) so a fixed pause is a smaller share
; of each timing; the 5x bound for the 4x size step is unchanged.
(define (thrice th)
  (th)
  (th)
  (th))

(test-case "cross-unit call scales" (hash "issue" 5342)
  (define f40 (best3 (lambda () (thrice (lambda () (f-any neg? small))))))
  (define f160 (best3 (lambda () (thrice (lambda () (f-any neg? big))))))
  (define m40 (best3 (lambda () (thrice (lambda () (m-any neg? small))))))
  (define m160 (best3 (lambda () (thrice (lambda () (m-any neg? big))))))
  (check (<= f160 (* 5 (max 1 f40))))
  (check (<= m160 (* 5 (max 1 m40)))))

(file-delete cross-mod)
(test-finish)
