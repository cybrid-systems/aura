; Issue #5186: std/string string-replace splits the input on matches and
; joins those segments once. Scale checks assert length and every
; segment, not timing.
(require "std/test" all:)
(require "std/string" all:)
(test-file "string_replace.aura")

; Doubling copy. string-repeat still appends onto a growing result, so
; the 40k input is built here instead of through that path.
(define (repeat s n)
  (let ((out "")
        (bit s)
        (k n))
    (while (lambda () (> k 0))
      (lambda ()
        (if (= (modulo k 2) 1)
            (set! out (string-append out bit)))
        (set! bit (string-append bit bit))
        (set! k (quotient k 2))))
    out))

(define (chunks-ok? s n piece)
  (let ((i 0)
        (ok #t)
        (plen (string-length piece)))
    (while (lambda () (and ok (< i n)))
      (lambda ()
        (let ((start (* i plen)))
          (if (not (equal? (substring s start (+ start plen)) piece))
              (set! ok #f)))
        (set! i (+ i 1))))
    ok))

(define (replace-scale n)
  (let* ((src (repeat "abcdefghij" n))
         (got (string-replace src "a" "xy"))
         (want (* n 11)))
    (check (string? got))
    (check= want (string-length got))
    (check (chunks-ok? got n "xybcdefghij"))))

(define s-plain "abc")

(test-case "replace one character" (hash "issue" 5186)
  (check= "Zb" (string-replace "ab" "a" "Z"))
  (check= "zb" (string-replace "ab" "a" "z")))

(test-case "replace a multi-char needle" (hash "issue" 5186)
  (check= "aXX" (string-replace "ababa" "ba" "X")))

(test-case "multiple matches" (hash "issue" 5186)
  (check= "bb-bb-bb" (string-replace "a-a-a" "a" "bb")))

(test-case "no match returns the same string" (hash "issue" 5186)
  (check= "abc" (string-replace s-plain "z" "Q"))
  (check (eq? (string-replace s-plain "z" "Q") s-plain)))

(test-case "empty old returns the same string" (hash "issue" 5186)
  (check (eq? (string-replace s-plain "" "Q") s-plain))
  (check= "abc" (string-replace s-plain "" "nope")))

(test-case "old longer than s returns the same string" (hash "issue" 5186)
  (check (eq? (string-replace s-plain "abcd" "Q") s-plain)))

(test-case "empty s" (hash "issue" 5186)
  (check= "" (string-replace "" "a" "b"))
  (check (eq? (string-replace "" "" "b") "")))

(test-case "empty replacement" (hash "issue" 5186)
  (check= "ac" (string-replace "abc" "b" ""))
  (check= "" (string-replace "aaa" "a" ""))
  (check= "-" (string-replace "a-a" "a" "")))

(test-case "adjacent matches" (hash "issue" 5186)
  (check= "XX" (string-replace "aaaa" "aa" "X")))

(test-case "overlap advances by the length of old" (hash "issue" 5186)
  (check= "ba" (string-replace "aaa" "aa" "b")))

(test-case "replacement is not searched" (hash "issue" 5186)
  (check= "aa" (string-replace "a" "a" "aa"))
  (check= "aba" (string-replace "a" "a" "aba")))

(test-case "match at the ends" (hash "issue" 5186)
  (check= "Z" (string-replace "abc" "abc" "Z"))
  (check= "Zc" (string-replace "abc" "ab" "Z"))
  (check= "aZ" (string-replace "abc" "bc" "Z")))

(test-case "every character matches" (hash "issue" 5186)
  (check= "bbb" (string-replace "aaa" "a" "b")))

(test-case "multi-character needle" (hash "issue" 5186)
  (check= "a-b-a" (string-replace "a::b::a" "::" "-")))

(test-case "same-length miss returns the same string" (hash "issue" 5186)
  (check (eq? (string-replace s-plain "xyz" "Q") s-plain)))

(test-case "repeat builder" (hash "issue" 5186)
  (check= "abababab" (repeat "ab" 4)))

(define s-cafe "café")

(test-case "utf-8 code points" (hash "issue" 5186)
  (check= "cafe" (string-replace s-cafe "é" "e"))
  (check= 4 (string-length s-cafe))
  (check= 1 (string-length "é"))
  (check= "hELlo hELlo" (string-replace "héllo héllo" "él" "EL"))
  (check= "漢文漢" (string-replace "中文中" "中" "漢"))
  (check= 3 (string-length (string-replace "中文中" "中" "漢")))
  (check= "a!b!c" (string-replace "a😀b😀c" "😀" "!"))
  (check= 1 (string-length "😀"))
  (check= "aéX" (string-replace "aé中😀" "中😀" "X"))
  (check= "😀😀" (string-replace "aa" "a" "😀"))
  (check= 2 (string-length (string-replace "aa" "a" "😀")))
  (check= "eee" (string-replace "ééé" "é" "e"))
  (check= "aa" (string-replace "aéa" "é" ""))
  (check (eq? (string-replace s-cafe "中" "X") s-cafe))
  (check= "ééé" (repeat "é" 3)))

; "é" is the bytes C3 A9, one unit. "\xC3" is that lead byte alone, which
; is its own ill-formed unit. An unmatched ill-formed unit is copied, not
; re-encoded as U+00C3.
(define raw "a\xC3éb")
(define u00c3 (list->string (list 195)))
(define mixed "\xC3é\xC3")
(define torn "\xC3é\xFFé")
(define s-bebe "bébé")

(test-case "ill-formed lead byte is its own unit" (hash "issue" 5186)
  (check= 4 (string-length raw))
  (check= (list 97 195 233 98)
          (list (string-ref raw 0) (string-ref raw 1)
                (string-ref raw 2) (string-ref raw 3)))
  (check (not (equal? (substring "é" 0 1) "\xC3")))
  (check (not (equal? "\xC3" u00c3)))
  (check= "bébé" (string-replace s-bebe "\xC3" "X"))
  (check (eq? (string-replace s-bebe "\xC3" "X") s-bebe))
  (check= "bébé" (string-replace s-bebe "\xA9" "X"))
  (check= "bebe" (string-replace s-bebe "é" "e"))
  (check= "QéQ" (string-replace mixed "\xC3" "Q"))
  (check= 3 (string-length (string-replace mixed "\xC3" "Q")))
  (check= "é" (substring (string-replace mixed "\xC3" "Q") 1 2)))

(test-case "unmatched ill-formed bytes are copied" (hash "issue" 5186)
  (define raw-replaced (string-replace raw "é" "E"))
  (check= (string-append (substring raw 0 2) "E" (substring raw 3 4))
          raw-replaced)
  (check= "\xC3" (substring raw-replaced 1 2))
  (check (not (equal? (substring raw-replaced 1 2) u00c3)))
  (define torn-replaced (string-replace torn "é" "Z"))
  (check= (string-append (substring torn 0 1) "Z"
                         (substring torn 2 3) "Z")
          torn-replaced)
  (check= 255 (string-ref torn-replaced 2)))

(test-case "replace scale 10000" (hash "issue" 5186)
  (replace-scale 1000))

(test-case "replace scale 40000" (hash "issue" 5186)
  (replace-scale 4000))

(test-case "dense replace 2000" (hash "issue" 5186)
  (define dense-src (repeat "a" 2000))
  (define dense (string-replace dense-src "a" "xy"))
  (check (string? dense))
  (check= 4000 (string-length dense))
  (check (chunks-ok? dense 2000 "xy")))

(test-case "10k no-match returns the same string" (hash "issue" 5186)
  (define big (repeat "abcdefghij" 1000))
  (check (eq? (string-replace big "ZZZ" "xy") big)))

(test-finish)
