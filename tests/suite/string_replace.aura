;; expect: OK-5186
; Issue #5186: std/string string-replace splits the input on matches and
; joins those segments once. A parts list that still mints one string per
; character is a different, still-quadratic algorithm and does not satisfy
; these cases. Scale checks assert length and every segment, not timing.

(require "std/string" all:)

(define *fails* 0)
(define *passes* 0)
(define (check pred msg)
  (if pred
      (begin
        (set! *passes* (+ *passes* 1))
        (display "  pass: ") (display msg) (newline))
      (begin
        (set! *fails* (+ *fails* 1))
        (display "  FAIL: ") (display msg) (newline))))

; Doubling copy. string-repeat still appends onto a growing result, so
; the 40k input is built here instead of through that path.
(define (repeat s n)
  (let ((out "")
        (bit s)
        (k n))
    (while (lambda () (> k 0))
      (lambda ()
        (if (= (modulo k 2) 1)
            (set! out (string-append out bit)))
        (set! bit (string-append bit bit))
        (set! k (quotient k 2))))
    out))

(define (chunks-ok? s n piece)
  (let ((i 0)
        (ok #t)
        (plen (string-length piece)))
    (while (lambda () (and ok (< i n)))
      (lambda ()
        (let ((start (* i plen)))
          (if (not (equal? (substring s start (+ start plen)) piece))
              (begin
                (display "  chunk mismatch at ") (display i) (newline)
                (set! ok #f))))
        (set! i (+ i 1))))
    ok))

; ── oneshot / left-to-right semantics ──────────────────────────────────────
(define s-plain "abc")
(check (equal? (string-replace "ab" "a" "Z") "Zb")
       "ab / a / Z")
(check (equal? (string-replace "ab" "a" "z") "zb")
       "ab / a / z")
(check (equal? (string-replace "ababa" "ba" "X") "aXX")
       "ababa / ba / X")
(check (equal? (string-replace "a-a-a" "a" "bb") "bb-bb-bb")
       "multiple matches")
(check (equal? (string-replace s-plain "z" "Q") "abc")
       "no match content")
(check (eq? (string-replace s-plain "z" "Q") s-plain)
       "no match returns the same string")
(check (eq? (string-replace s-plain "" "Q") s-plain)
       "empty old returns the same string")
(check (equal? (string-replace s-plain "" "nope") "abc")
       "empty old content")
(check (eq? (string-replace s-plain "abcd" "Q") s-plain)
       "old longer than s returns the same string")
(check (equal? (string-replace "" "a" "b") "")
       "empty s")
(check (eq? (string-replace "" "" "b") "")
       "empty old on empty s")
(check (equal? (string-replace "abc" "b" "") "ac")
       "empty replacement in the middle")
(check (equal? (string-replace "aaa" "a" "") "")
       "empty replacement of every character")
(check (equal? (string-replace "a-a" "a" "") "-")
       "empty replacement at both edges")
(check (equal? (string-replace "aaaa" "aa" "X") "XX")
       "adjacent matches")
(check (equal? (string-replace "aaa" "aa" "b") "ba")
       "overlap advances by the length of old")
(check (equal? (string-replace "a" "a" "aa") "aa")
       "replacement is not searched")
(check (equal? (string-replace "a" "a" "aba") "aba")
       "replacement that contains old is not searched")
(check (equal? (string-replace "abc" "abc" "Z") "Z")
       "the whole string is one match")
(check (equal? (string-replace "abc" "ab" "Z") "Zc")
       "match at the start")
(check (equal? (string-replace "abc" "bc" "Z") "aZ")
       "match at the end")
(check (equal? (string-replace "aaa" "a" "b") "bbb")
       "every character matches")
(check (equal? (string-replace "a::b::a" "::" "-") "a-b-a")
       "multi-character needle")
(check (eq? (string-replace s-plain "xyz" "Q") s-plain)
       "same-length miss returns the same string")
(check (equal? (repeat "ab" 4) "abababab")
       "repeat builder")

; ── UTF-8 code points, same indexing as substring ──────────────────────────
(define s-cafe "café")
(check (equal? (string-replace s-cafe "é" "e") "cafe")
       "replace a 2-byte character")
(check (= (string-length s-cafe) 4)
       "café is 4 code points")
(check (= (string-length "é") 1)
       "é is one code point")
(check (equal? (string-replace "héllo héllo" "él" "EL") "hELlo hELlo")
       "multi-byte needle across two words")
(check (equal? (string-replace "中文中" "中" "漢") "漢文漢")
       "3-byte characters")
(check (= (string-length (string-replace "中文中" "中" "漢")) 3)
       "3-byte replacement keeps code-point length")
(check (equal? (string-replace "a😀b😀c" "😀" "!") "a!b!c")
       "4-byte character")
(check (= (string-length "😀") 1)
       "emoji is one code point")
(check (equal? (string-replace "aé中😀" "中😀" "X") "aéX")
       "needle of a 3-byte and a 4-byte character")
(check (equal? (string-replace "aa" "a" "😀") "😀😀")
       "replacement is a 4-byte character")
(check (= (string-length (string-replace "aa" "a" "😀")) 2)
       "4-byte replacement is two code points")
(check (equal? (string-replace "ééé" "é" "e") "eee")
       "adjacent multi-byte matches")
(check (equal? (string-replace "aéa" "é" "") "aa")
       "empty replacement of a multi-byte character")
(check (eq? (string-replace s-cafe "中" "X") s-cafe)
       "no multi-byte match returns the same string")
(check (equal? (repeat "é" 3) "ééé")
       "repeat builder keeps multi-byte characters")

; ── a prefix of a code unit is not a character ─────────────────────────────
; "é" is the bytes C3 A9, one unit. "\xC3" is that lead byte alone, which
; is its own ill-formed unit. substring / equal? do not treat the lead
; byte as a match inside "é", and an unmatched ill-formed unit is copied
; by substring rather than re-encoded as U+00C3 (bytes C3 83).
(define raw "a\xC3éb")
(define u00c3 (list->string (list 195)))
(define mixed "\xC3é\xC3")
(define torn "\xC3é\xFFé")
(define s-bebe "bébé")
(check (= (string-length raw) 4)
       "ill-formed lead byte is its own unit")
(check (equal? (list (string-ref raw 0) (string-ref raw 1)
                     (string-ref raw 2) (string-ref raw 3))
               (list 97 195 233 98))
       "code points around the ill-formed lead")
(check (not (equal? (substring "é" 0 1) "\xC3"))
       "substring of é is not the lead byte")
(check (not (equal? "\xC3" u00c3))
       "raw lead byte is not U+00C3")
(check (equal? (string-replace s-bebe "\xC3" "X") "bébé")
       "lead byte does not match inside é")
(check (eq? (string-replace s-bebe "\xC3" "X") s-bebe)
       "lead-byte miss returns the same string")
(check (equal? (string-replace s-bebe "\xA9" "X") "bébé")
       "continuation byte does not match inside é")
(check (equal? (string-replace s-bebe "é" "e") "bebe")
       "the whole é still replaces")
(check (equal? (string-replace mixed "\xC3" "Q") "QéQ")
       "replacing the prefix unit leaves é whole")
(check (= (string-length (string-replace mixed "\xC3" "Q")) 3)
       "prefix-unit replacement length")
(check (equal? (substring (string-replace mixed "\xC3" "Q") 1 2) "é")
       "é between prefix units is intact")
(define raw-replaced (string-replace raw "é" "E"))
(check (equal? raw-replaced
               (string-append (substring raw 0 2) "E" (substring raw 3 4)))
       "unmatched run equals the substring slices")
(check (equal? (substring raw-replaced 1 2) "\xC3")
       "unmatched prefix byte is copied as itself")
(check (not (equal? (substring raw-replaced 1 2) u00c3))
       "unmatched prefix byte is not re-encoded as U+00C3")
(define torn-replaced (string-replace torn "é" "Z"))
(check (equal? torn-replaced
               (string-append (substring torn 0 1) "Z"
                              (substring torn 2 3) "Z"))
       "ill-formed neighbors of é are not torn")
(check (= (string-ref torn-replaced 2) 255)
       "illegal FF byte stays one unit")

; ── 10k / 40k content, plus a dense join ───────────────────────────────────
(define (replace-scale n)
  (let* ((src (repeat "abcdefghij" n))
         (got (string-replace src "a" "xy"))
         (want (* n 11))
         (label (number->string (* n 10))))
    (if (not (string? got))
        (begin
          (display "  got=") (display got) (newline)
          (check #f (string-append "string? len=" label))
          (check #f (string-append "length len=" label))
          (check #f (string-append "content len=" label)))
        (begin
          (check #t (string-append "string? len=" label))
          (if (not (= (string-length got) want))
              (begin
                (display "  got-len ") (display (string-length got))
                (display " want-len ") (display want) (newline)))
          (check (= (string-length got) want)
                 (string-append "length len=" label))
          (check (chunks-ok? got n "xybcdefghij")
                 (string-append "content len=" label))))))

(replace-scale 1000)
(replace-scale 4000)

(define dense-src (repeat "a" 2000))
(define dense (string-replace dense-src "a" "xy"))
(check (string? dense) "string? dense 2000")
(check (= (string-length dense) 4000) "length dense 2000")
(check (chunks-ok? dense 2000 "xy") "content dense 2000")

(define big (repeat "abcdefghij" 1000))
(check (eq? (string-replace big "ZZZ" "xy") big)
       "10k no-match returns the same string")

(if (and (= *fails* 0) (= *passes* 66))
    (display "OK-5186\n")
    (begin
      (display "FAIL-5186 fails=") (display *fails*)
      (display " passes=") (display *passes*) (newline)
      (exit 1)))
