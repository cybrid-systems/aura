; Issue #5417 — std/secret minimal-disclosure credential store
; Run: ./build/aura tests/suite/secret.aura
(require "std/test" all:)
(require "std/secret" all:)
(require "std/string" all:)
(require "std/json" all:)
(require "std/encoding" all:)

(test-file "secret.aura")

(define sec-store-path "/tmp/aura_secret_suite")
(define sec-store (secret:store sec-store-path))
(define sec-key "sk-suite-abc123")

; A fresh fixture directory; this suite owns it.
(shell (string-append "rm -rf " sec-store-path))

(test-case "put creates a 0700 store and a 0600 secret file" (hash "issue" 5417 "tags" (list "secret"))
  (check (equal? #t (secret:put! sec-store "test-key" sec-key)))
  (check= "700" (string-trim (command-output (string-append "stat -c %a " sec-store-path))))
  (check= "600" (string-trim (command-output (string-append "stat -c %a " sec-store-path "/test-key.secret"))))
  (check (secret:exists? sec-store "test-key"))
  (check (member? "test-key" (secret:list sec-store))))

(test-case "use hands the value to the callback and audits the name" (hash "issue" 5417 "tags" (list "secret"))
  (check= "***" (secret:use (secret:get sec-store "test-key") (lambda (v) v)))
  (check= sec-key (secret:use-raw (secret:get sec-store "test-key") (lambda (v) v)))
  (let ((audit (secret:audit)))
    (check (pair? audit))
    (check (not (string-contains? (json-encode audit) sec-key)))))

(test-case "redact masks a known value" (hash "issue" 5417 "tags" (list "secret"))
  (check (secret:contains-known? (string-append "key=" sec-key)))
  (check= "key=***" (secret:redact (string-append "key=" sec-key))))

(test-case "a missing secret is unavailable, never a value" (hash "issue" 5417 "tags" (list "secret"))
  (let ((r (secret:use (secret:get sec-store "missing") (lambda (v) v))))
    (check (hash? r))
    (check= #f (hash-ref r "ok" #f))
    (check= "secret-unavailable" (hash-ref r "error"))))

(test-case "bad names are refused before touching a path" (hash "issue" 5417 "tags" (list "secret"))
  (let ((h (secret:get sec-store "../escape")))
    (check= "secret-error" (hash-ref h "kind")))
  (let ((r (secret:put! sec-store "../escape" "x")))
    (check (hash? r))
    (check= #f (hash-ref r "ok" #f))))

(test-case "import-file migrates a plaintext key" (hash "issue" 5417 "tags" (list "secret"))
  (file-write "/tmp/aura_secret_import" "  imported-key-42  \n")
  (check (equal? #t (secret:import-file! sec-store "imported" "/tmp/aura_secret_import")))
  (check= "imported-key-42" (secret:use-raw (secret:get sec-store "imported") (lambda (v) v))))

(test-case "default store refuses a missing HOME (#5442)" (hash "issue" 5442 "tags" (list "secret"))
  ; setenv is not a public primitive; run the child with both variables
  ; removed so the no-HOME system-service path is exercised for real.
  (define out
    (string-trim
      (command-output
        "env -u HOME -u AURA_SECRET_STORE AURA_SANDBOX=off ./build/aura -e '(begin (require \"std/secret\" all:) (display (hash-ref (secret:default-store) \"error\" \"\")) (newline))'")))
  (check= "bad-store-path" out))

(test-case "a store directory with the wrong mode is unavailable (#5442)"
  (hash "issue" 5442 "tags" (list "secret"))
  (define bad-dir "/tmp/aura_secret_bad_dir")
  (shell (string-append "rm -rf " bad-dir " && mkdir -p " bad-dir " && chmod 755 " bad-dir))
  (file-write (string-append bad-dir "/k.secret") (base64-encode "attacker-value"))
  (shell (string-append "chmod 600 " bad-dir "/k.secret"))
  (check= "secret-unavailable"
          (hash-ref (secret:use (secret:get (secret:store bad-dir) "k") (lambda (v) v))
                    "error" ""))
  (check (not (secret:exists? (secret:store bad-dir) "k")))
  (shell (string-append "rm -rf " bad-dir)))

(test-case "a secret file with the wrong mode is unavailable (#5442)"
  (hash "issue" 5442 "tags" (list "secret"))
  (define bad-dir "/tmp/aura_secret_bad_file")
  (shell (string-append "rm -rf " bad-dir " && mkdir -p " bad-dir " && chmod 700 " bad-dir))
  (file-write (string-append bad-dir "/k.secret") (base64-encode "attacker-value"))
  (shell (string-append "chmod 644 " bad-dir "/k.secret"))
  (check= "secret-unavailable"
          (hash-ref (secret:use (secret:get (secret:store bad-dir) "k") (lambda (v) v))
                    "error" ""))
  (check (not (secret:exists? (secret:store bad-dir) "k")))
  (shell (string-append "rm -rf " bad-dir)))

(test-finish)
