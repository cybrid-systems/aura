; Issue #4860: concurrent stats:get must not corrupt the heap.
; Eight fibers read the stats panels fifty times, then a final read
; proves the registry is still consistent.
(require "std/test" all:)
(test-file "issue_4860_stats_concurrent.aura")

(define panels (list "gc-heap-stats" "closure:stats" "concurrency:stats"))

(define (read-panels n)
  (let loop ((k 0))
    (if (< k n)
        (begin
          (for-each (lambda (p) (stats:get p)) panels)
          (loop (+ k 1)))
        'done)))

(test-case "concurrent stats reads join" (hash "issue" 4860)
  (define workers
    (map (lambda (i) (fiber:spawn (lambda () (read-panels 50))))
         (range 0 8)))
  (check= '(done done done done done done done done)
          (map (lambda (f) (fiber:join f)) workers))
  (check (hash? (stats:get "gc-heap-stats")))
  (check (hash? (stats:get "closure:stats")))
  (check (hash? (stats:get "concurrency:stats"))))

(test-finish)
