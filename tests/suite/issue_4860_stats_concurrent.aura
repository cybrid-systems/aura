; Issue #4860 regression suite: concurrent stats:get must not corrupt the heap.
;
; g_hash_tables is a PROCESS global. A fiber worker that mints a result
; hash used to push_back into it WITHOUT the evaluator's
; alloc_storage_lock_, so two workers could reallocate the vector at the
; same time: glibc "double free or corruption" /
; "malloc(): unaligned tcache chunk detected" -> SIGABRT.
;
; 8 fibers x 50 iterations over the stats panels, then a final read that
; proves the registry is still consistent.

(define *fails* 0)
(define (check pred msg)
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))

(define panels (list "gc-heap-stats" "closure:stats" "concurrency:stats"))

(define (read-panels n)
  (let loop ((k 0))
    (if (< k n)
        (begin
          (for-each (lambda (p) (stats:get p)) panels)
          (loop (+ k 1)))
        'done)))

(define workers
  (map (lambda (i) (fiber:spawn (lambda () (read-panels 50))))
       (range 0 8)))

(check (equal? '(done done done done done done done done)
               (map (lambda (f) (fiber:join f)) workers))
       "#4860 8 fibers x 50 concurrent stats reads all joined")

(for-each (lambda (p) (check (hash? (stats:get p)) p)) panels)

(if (= *fails* 0)
    (display "OK-4860\n")
    (begin (display "FAIL-4860 fails=") (display *fails*) (newline) (exit 1)))
