; Issue #5062: (require "std/stats" all:) binds the names the module
; defines. The export list used to say get/list/contains?/… while the
; definitions were stats:get/stats:contains?/…, so contains? and filter
; stayed unbound.
(require "std/test" all:)
(require "std/stats" all:)
(test-file "issue_5062_stats_export.aura")

(define (starts-with? s p)
  (and (>= (string-length s) (string-length p))
       (string=? (substring s 0 (string-length p)) p)))

(test-case "stats exports are bound" (hash "issue" 5062)
  (check (procedure? stats:contains?))
  (check (procedure? stats:filter))
  (check (procedure? stats:get))
  (check (procedure? stats:list))
  (check (procedure? stats:count))
  (check (procedure? stats:prefix)))

(test-case "registry queries" (hash "issue" 5062)
  (check (stats:contains? "query:envframe-dualpath-stats"))
  (check (not (stats:contains? "no-such-stat-5062")))
  (define queried (stats:filter (lambda (n) (starts-with? n "query:"))))
  (check (pair? queried))
  (check (stats:contains? (car queried)))
  (define prefixed (stats:prefix "compile:"))
  (check (pair? prefixed))
  (check= (stats:count) (length (stats:list)))
  (check (> (stats:count) 0)))

(test-case "bare get is not the stats export" (hash "issue" 5062)
  (define legacy-get
    (try (get "query:envframe-dualpath-stats")
         (catch (e) e)))
  (check (string? legacy-get)))

(test-finish)
