; Issue #4867 regression suite: orch keyword arguments are validated and a
; second live agent under the same name is rejected.
(define *fails* 0)
(define (check pred msg)
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))
(define (caught thunk) (try (thunk) (catch (e) e)))

(orch:scope-spawn "s4867" (lambda () 1))
(check (equal? (caught (lambda () (orch:scope-join-all :timeout-ms "abc")))
               "orch:scope-join-all: :timeout-ms expects an integer")
       "#4867 a string :timeout-ms is a parameter error")
(orch:scope-spawn "s4867" (lambda () 1))
(check (equal? (caught (lambda () (orch:scope-join-all :timeout-ms 1.5)))
               "orch:scope-join-all: :timeout-ms expects an integer")
       "#4867 a float :timeout-ms is a parameter error")
(orch:scope-spawn "s4867" (lambda () 1))
(check (equal? (caught (lambda () (orch:scope-join-all :timeot-ms 100)))
               "orch:scope-join-all: unknown keyword :timeot-ms")
       "#4867 a misspelled keyword is reported")
(orch:scope-spawn "s4867" (lambda () 1))
(check (equal? (caught (lambda () (orch:scope-join-all :timeout-ms 100 :max-restarts "3")))
               "orch:scope-join-all: :max-restarts expects an integer")
       "#4867 a string :max-restarts is a parameter error")

(orch:spawn-agent "q4867" (lambda () 1))
(check (equal? (caught (lambda () (orch:agent-join "q4867" :timeout-ms "x")))
               "orch:agent-join: :timeout-ms expects an integer")
       "#4867 agent-join rejects a string :timeout-ms")
(orch:spawn-agent "q4867b" (lambda () 1))
(check (equal? (caught (lambda () (orch:agent-join "q4867b" :timeout-ms -1)))
               "orch:agent-join: :timeout-ms must not be negative")
       "#4867 agent-join rejects a negative :timeout-ms")

(define release #f)
(orch:spawn-agent "dup4867" (lambda ()
  (let wait () (if release #t (begin (fiber:yield) (wait))))
  'done))
(check (equal? (caught (lambda () (orch:spawn-agent "dup4867" (lambda () 2))))
               "orch:spawn-agent: name already running: dup4867")
       "#4867 a second live spawn under the same name is rejected")
(set! release #t)
(orch:agent-join "dup4867" :timeout-ms 2000)

(if (= *fails* 0)
    (begin (display "OK-4867 kwarg validation") (newline))
    (begin (display "FAIL-4867 fails=") (display *fails*) (newline) (error "4867 suite failed")))
