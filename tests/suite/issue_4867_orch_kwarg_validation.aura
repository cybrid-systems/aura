; Issue #4867: orch keyword arguments are validated, and a second live
; agent under the same name is rejected.
(require "std/test" all:)
(test-file "issue_4867_orch_kwarg_validation.aura")

(define (caught thunk) (try (thunk) (catch (e) e)))

(test-case "scope-join-all rejects bad keywords" (hash "issue" 4867)
  (orch:scope-spawn "s4867" (lambda () 1))
  (check= "orch:scope-join-all: :timeout-ms expects an integer"
          (caught (lambda () (orch:scope-join-all :timeout-ms "abc"))))
  (orch:scope-spawn "s4867" (lambda () 1))
  (check= "orch:scope-join-all: :timeout-ms expects an integer"
          (caught (lambda () (orch:scope-join-all :timeout-ms 1.5))))
  (orch:scope-spawn "s4867" (lambda () 1))
  (check= "orch:scope-join-all: unknown keyword :timeot-ms"
          (caught (lambda () (orch:scope-join-all :timeot-ms 100))))
  (orch:scope-spawn "s4867" (lambda () 1))
  (check= "orch:scope-join-all: :max-restarts expects an integer"
          (caught (lambda () (orch:scope-join-all :timeout-ms 100 :max-restarts "3")))))

(test-case "agent-join rejects a bad timeout" (hash "issue" 4867)
  (orch:spawn-agent "q4867" (lambda () 1))
  (orch:agent-join "q4867" :timeout-ms 2000)
  (check= "orch:agent-join: :timeout-ms expects an integer"
          (caught (lambda () (orch:agent-join "q4867" :timeout-ms "x"))))
  (orch:spawn-agent "q4867b" (lambda () 1))
  (orch:agent-join "q4867b" :timeout-ms 2000)
  (check= "orch:agent-join: :timeout-ms must not be negative"
          (caught (lambda () (orch:agent-join "q4867b" :timeout-ms -1)))))

(test-case "a second live spawn under the same name is rejected" (hash "issue" 4867)
  (define release #f)
  (orch:spawn-agent "dup4867" (lambda ()
    (let wait () (if release #t (begin (fiber:yield) (wait))))
    'done))
  (define dup-denied (orch:spawn-agent "dup4867" (lambda () 2)))
  (check (not (hash-ref dup-denied "ok")))
  (check= 0 (hash-ref dup-denied "id"))
  (check= "name-reuse-while-live" (hash-ref dup-denied "deny-detail" ""))
  (set! release #t)
  (orch:agent-join "dup4867" :timeout-ms 2000))

(test-finish)
