; Issue #4842: orch:scope-spawn + orch:scope-join-all inside an
; orch:spawn-agent body must run the child during the join and return
; status "ok" in milliseconds. The 900ms ceiling is the original bound:
; the join must not wait out its 1000ms timeout. The serve-async face
; is issue_4842_nested_scope_join_async.aura.
(require "std/test" all:)
(test-file "issue_4842_nested_scope_join.aura")

(test-case "nested child runs during the join" (hash "issue" 4842)
  (define out1 (channel:create 16))
  (orch:spawn-agent "par-4842" (lambda ()
    (orch:scope-spawn "k1-4842" (lambda () (channel:send out1 'k1-ran) 10))
    (let* ((t0 (monotonic-ms)) (r (orch:scope-join-all :timeout-ms 1000)))
      (channel:send out1 (list 'inner-ms (- (monotonic-ms) t0)
                               'status (hash-ref r "status")))
      (channel:send out1 'after-join))))
  (define jp (orch:agent-join "par-4842" :timeout-ms 4000))
  (define m1 (channel:try-recv out1))
  (define m2 (channel:try-recv out1))
  (define m3 (channel:try-recv out1))
  (check= "ok" (hash-ref jp "status"))
  (check= 'k1-ran m1)
  (check (pair? m2))
  (check= 'status (list-ref m2 2))
  (check= "ok" (list-ref m2 3))
  (check (< (list-ref m2 1) 900))
  (check= 'after-join m3))

(test-case "a failing nested child is counted" (hash "issue" 4842)
  (define out2 (channel:create 16))
  (orch:spawn-agent "par2-4842" (lambda ()
    (orch:scope-spawn "kid2-4842" (lambda () (error "kid failed")))
    (let* ((t0 (monotonic-ms)) (r (orch:scope-join-all :timeout-ms 1000)))
      (channel:send out2 (list 'inner-ms (- (monotonic-ms) t0)
                               'status (hash-ref r "status")
                               'err (hash-ref r "err-count")
                               'errors (hash-ref r "errors"))))))
  (orch:agent-join "par2-4842" :timeout-ms 4000)
  (define e1 (channel:try-recv out2))
  (check (pair? e1))
  (check (< (list-ref e1 1) 900))
  (check= "partial" (list-ref e1 3))
  (check= 1 (list-ref e1 5))
  ; One pair of strings: child name, error text.
  (check= (list (cons "kid2-4842" "kid failed")) (list-ref e1 7)))

(test-case "fiber body inside an agent runs its scope child" (hash "issue" 4842)
  (define out3 (channel:create 16))
  (orch:spawn-agent "par3-4842" (lambda ()
    (fiber:join
     (fiber:spawn
      (lambda ()
        (orch:scope-spawn "kid3-4842" (lambda () (channel:send out3 'kid3-ran) 10))
        (let* ((t0 (monotonic-ms)) (r (orch:scope-join-all :timeout-ms 1000)))
          (channel:send out3 (list 'inner-ms (- (monotonic-ms) t0)
                                   'status (hash-ref r "status")))))))))
  (orch:agent-join "par3-4842" :timeout-ms 4000)
  (define f1 (channel:try-recv out3))
  (define f2 (channel:try-recv out3))
  (check= 'kid3-ran f1)
  (check (pair? f2))
  (check (< (list-ref f2 1) 900))
  (check= "ok" (list-ref f2 3)))

(test-case "top-level scope join is unchanged" (hash "issue" 4842)
  (define out4 (channel:create 16))
  (orch:scope-spawn "kid4-4842" (lambda () (channel:send out4 'kid4-ran) 10))
  (let* ((t0 (monotonic-ms)) (r (orch:scope-join-all :timeout-ms 1000)))
    (channel:send out4 (list 'inner-ms (- (monotonic-ms) t0)
                             'status (hash-ref r "status"))))
  (define g1 (channel:try-recv out4))
  (define g2 (channel:try-recv out4))
  (check= 'kid4-ran g1)
  (check (pair? g2))
  (check (< (list-ref g2 1) 900))
  (check= "ok" (list-ref g2 3)))

(test-finish)
