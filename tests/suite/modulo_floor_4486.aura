;; expect: (-1 -1 -3 0 1 1) (-1 -1 -3 0 1 1) (1 -1 -1 1) div0-ok
; Issue #4486: modulo / mod are floor modulo (result has the divisor's
; sign, R7RS); remainder stays truncating (sign of the dividend).
(define (m a b) (modulo a b))
(define (md a b) (mod a b))
(display (list (m 7 -2) (m -7 -2) (m 9 -4) (m 6 -3) (m -7 2) (m 7 2)))
(display " ")
(display (list (md 7 -2) (md -7 -2) (md 9 -4) (md 6 -3) (md -7 2) (md 7 2)))
(display " ")
(display (list (remainder 7 -2) (remainder -7 -2) (remainder -7 2) (remainder 7 2)))
(display " ")
(display (if (try (begin (m 7 0) #f) (catch (e) #t)) "div0-ok" "div0-bad"))
(newline)
