;; Issue #5033: the messaging, memory and stdlib-review registrations moved
;; into peeled RegSplitParts parts (messaging: one part per inter-agent /
;; fiber / channel responsibility, with the #4763 payload codec built once;
;; memory: one part per gc / arena / dirty responsibility; stdlib review: one
;; part per production-review issue group). Primitive names, registration
;; order and behavior must not move.
(require "std/io" all:)

(set-code "(define probe5033c 1)") (eval-current)

(define fails 0)
(define (check pred msg)
  (if pred
      #t
      (begin (set! fails (+ fails 1)) (display (format "FAIL ~a\n" msg)))))
;; A dashboard that answers "no data yet" with () is still a live registration.
(define (panel? v) (or (hash? v) (list? v)))

;; ── messaging parts: channels + the #4763 payload codec ──────────────
(define c (channel:create 4))
(check (integer? c) "channel:create")
(check (eq? #t (channel:send c (list 1 "two" (vector 3)))) "channel:send list payload")
(check (equal? (channel:recv c) (list 1 "two" (vector 3))) "channel:recv structured payload")
(check (eq? #t (channel:send c "plain")) "channel:send string")
(check (equal? "plain" (channel:recv c)) "channel:recv string")
(define c2 (channel:create 1))
(channel:send c2 7)
(check (equal? 7 (channel:try-recv c2)) "channel:try-recv buffered")
(check (equal? "" (channel:try-recv c2)) "channel:try-recv empty")
(check (eq? #t (channel:close c)) "channel:close")
(check (equal? "" (channel:recv c)) "channel:recv after close")
(check (eq? #f (channel:send 999999 1)) "channel:send unknown channel")

;; ── messaging parts: agent / mailbox / scheduler probes ──────────────
(check (integer? (stats:get "mailbox-count")) "mailbox-count")
(check (string? (my-id)) "my-id")
(check (eq? #f (session-active? 999999)) "session-active? unknown")
(check (list? (_agent:list)) "_agent:list")
(check (hash? (stats:get "query:mf-mailbox-stats")) "query:mf-mailbox-stats")
(check (hash? (stats:get "query:parallel-orch-stats")) "query:parallel-orch-stats")
(check (or (string? (stats:get "orch:metrics")) (list? (stats:get "orch:metrics")))
       "orch:metrics")
(check (integer? (fiber:spawn-backend)) "fiber:spawn-backend")
(check (eq? #f (fiber:cancel 999999)) "fiber:cancel unknown fiber")

;; ── messaging parts: fiber lifecycle + join ──────────────────────────
(define f1 (fiber:spawn (lambda () (+ 40 2))))
(check (integer? f1) "fiber:spawn returns an id")
(check (equal? 42 (fiber:join f1)) "fiber:join returns the body value")
(check (equal? 42 (fiber:join f1)) "fiber:join repeat returns the cached value")
(check (void? (fiber:join 999999)) "fiber:join unknown fiber -> void")
(check (void? (fiber:yield)) "fiber:yield")

;; ── memory parts: gc / arena / dirty probes ──────────────────────────
(check (hash? (stats:get "gc-heap-stats")) "gc-heap-stats")
(check (string? (stats:get "gc-stats")) "gc-stats")
(check (integer? (stats:get "gc-module-count")) "gc-module-count")
(check (hash? (stats:get "type-registry-stats")) "type-registry-stats")
(check (integer? (stats:get "arena:estimate")) "arena:estimate")
(check (boolean? (stats:get "arena:defrag-requested?")) "arena:defrag-requested?")
(check (boolean? (stats:get "arena:safepoint-registered?")) "arena:safepoint-registered?")
(check (pair? (stats:get "arena:defrag-stats")) "arena:defrag-stats")
(check (string? (stats:get "arena:stats-json")) "arena:stats-json")
(check (hash? (memory-pressure)) "memory-pressure")
(check (hash? (stats:get "string-pool:stats")) "string-pool:stats")
(check (hash? (stats:get "dirty:counts")) "dirty:counts")
(check (hash? (stats:get "dirty:summary")) "dirty:summary")
(check (integer? (dirty:reasons 0)) "dirty:reasons")
(check (integer? (stats:get "arena:estimate")) "arena:estimate int")
(check (hash? (stats:get "closure:free-stats")) "closure:free-stats")
(check (eq? #t (gc-heap)) "gc-heap runs a collection")
(check (hash? (stats:get "gc-heap-stats")) "gc-heap-stats after collection")

;; ── stdlib review parts: dashboards / probes / sweep ranges ──────────
(check (hash? (stats:get "query:stdlib-production-review-stats"))
       "query:stdlib-production-review-stats")
(check (hash? (stats:get "query:primitive-tier-stats")) "query:primitive-tier-stats")
