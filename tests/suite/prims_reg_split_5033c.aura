(check (hash? (stats:get "query:generation-stats")) "query:generation-stats")
(check (hash? (stats:get "query:production-sweep-1286-1290-stats"))
       "query:production-sweep-1286-1290-stats")
(check (hash? (stats:get "query:production-sweep-1291-1295-stats"))
       "query:production-sweep-1291-1295-stats")
(check (hash? (stats:get "query:production-sweep-1296-1300-stats"))
       "query:production-sweep-1296-1300-stats")
(check (hash? (stats:get "query:production-sweep-1301-1305-stats"))
       "query:production-sweep-1301-1305-stats")
(check (hash? (stats:get "query:production-sweep-1306-1310-stats"))
       "query:production-sweep-1306-1310-stats")
(check (hash? (stats:get "query:production-sweep-1311-1315-stats"))
       "query:production-sweep-1311-1315-stats")
(check (hash? (stats:get "query:production-sweep-1316-1320-stats"))
       "query:production-sweep-1316-1320-stats")
(check (hash? (stats:get "query:production-sweep-1321-1324-stats"))
       "query:production-sweep-1321-1324-stats")
(check (integer? (stats:dirty-count)) "stats:dirty-count")
(check (integer? (stats:deopt-count)) "stats:deopt-count")
(check (hash? (stats:get "query:production-sweep-1325-1330-stats"))
       "query:production-sweep-1325-1330-stats")
(check (hash? (stats:get "query:production-sweep-1336-1348-stats"))
       "query:production-sweep-1336-1348-stats")

(if (> fails 0)
    (error "prims reg split 5033c regression")
    (begin (display "prims reg split 5033c ok") (newline)))
