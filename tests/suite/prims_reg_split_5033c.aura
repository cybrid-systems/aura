       "query:production-sweep-1177-1201-stats")
(check (hash? (stats:get "query:production-sweep-1202-1228-stats"))
       "query:production-sweep-1202-1228-stats")
(check (hash? (stats:get "query:lifetime-pin-stats")) "query:lifetime-pin-stats")
(check (hash? (stats:get "query:production-health")) "query:production-health")
(check (hash? (stats:get "query:production-sweep-1229-1240-stats"))
       "query:production-sweep-1229-1240-stats")
(check (hash? (stats:get "query:production-sweep-1241-1245-stats"))
       "query:production-sweep-1241-1245-stats")
