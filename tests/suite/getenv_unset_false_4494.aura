;; expect: (#f dflt) caught
; Issue #4494: getenv of an unset variable is #f; channel:send of a payload it
; cannot deliver raises. #4744 delivers immediates (number/boolean/void/symbol)
; on channel:send, so the rejected case is a Ref payload (a pair).
(display (list (getenv "AURA_4494_SURELY_UNSET") (or (getenv "AURA_4494_SURELY_UNSET") "dflt")))
(display " ")
(define c (channel:create 4))
(display (try (begin (channel:send c (cons 1 2)) "silent") (catch (e) "caught")))
(newline)
