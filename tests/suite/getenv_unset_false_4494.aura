;; expect: (#f dflt) caught
; Issue #4494: getenv of an unset variable is #f; channel:send of a non-string raises.
(display (list (getenv "AURA_4494_SURELY_UNSET") (or (getenv "AURA_4494_SURELY_UNSET") "dflt")))
(display " ")
(define c (channel:create 4))
(display (try (begin (channel:send c 7) "silent") (catch (e) "caught")))
(newline)
