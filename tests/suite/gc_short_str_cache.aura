;; tests/suite/gc_short_str_cache.aura
;;
;; short_str_cache_ invalidation after gc-heap (# short string cache
;; + string_heap_ clear; cells_ also cleared #2486).
;; No define after gc-heap — only pure expressions.

(require "std/test" all:)

; Flood string_heap via loop without surviving defines after gc-heap
(define (flood n)
  (if (= n 0)
      0
      (begin
        (define _pad (string-append "pad-" (number->string n) "-padding-string"))
        (flood (- n 1)))))

(flood 50)
(check= 2 (string-length "ab"))
(check= 3 (string-length "xyz"))
(check= 6 (string-length "ffffff"))
(check= 7 (string-length "ggggggg"))

; Full reset — after this only pure expr (no cell-backed defines)
(gc-heap)

; Short strings must re-evaluate cleanly (cache must not return stale idx)
(check= 2 (string-length "ab"))
(check= 3 (string-length "xyz"))
(check= 1 (string-length "z"))
(check= 4 (string-length "dddd"))
(check= 5 (string-length "eeeee"))
(check= 6 (string-length "ffffff"))
(check= 7 (string-length "ggggggg"))

(set-code "(string-length \"hi\")")
(check= 2 (eval-current))
