; #5064: try/catch on the fiber's own stack must see the documented
; cancel payload, not a located "type error:" diagnostic.
; Cancellation is a cooperative condition, the same shape as (error ...).
(require "std/test" all:)
(test-file "issue_5064_fiber_cancel_text.aura")

(define (string-contains-5064 s sub)
  (let ((n (string-length s)) (m (string-length sub)))
    (let loop ((i 0))
      (cond
        ((> (+ i m) n) #f)
        ((string=? (substring s i (+ i m)) sub) #t)
        (else (loop (+ i 1)))))))

(define payload "fiber-cancelled: cancel requested via (fiber:cancel)")

(test-case "cancel payload is not a type error" (hash "issue" 5064)
  (define cf (fiber:spawn (lambda ()
    (try (let loop ((i 0))
           (fiber:yield)
           (loop (+ i 1)))
         (catch (e) (format "~a" e))))))
  (check= #t (fiber:cancel cf))
  (define joined (fiber:join cf))
  (check= payload joined)
  (check (not (string-contains-5064 joined "type error"))))

(test-case "user error joined from outside" (hash "issue" 5064)
  (define bf (fiber:spawn (lambda () (error "boom"))))
  (define boom (try (fiber:join bf) (catch (e) (format "~a" e))))
  (check= "boom" boom))

; #5414: the kernel wait. This file runs on the thread backend (file /
; --load): the sleeping thread sleeps in slices and a cancel lands within
; one slice. The parked form is tests/suite/fiber_sleep_park.aura.
(test-case "fiber:sleep waits the whole interval and answers #t" (hash "issue" 5414)
  (define t0 (monotonic-ms))
  (check= #t (fiber:sleep 60))
  (define waited (- (monotonic-ms) t0))
  (check (>= waited 55))
  (check (< waited 5000))
  (check= #t (fiber:sleep 0))
  (define f (fiber:spawn (lambda () (list 'slept (fiber:sleep 40)))))
  (check= (list 'slept #t) (fiber:join f)))

(test-case "fiber:sleep is a cancellation safepoint" (hash "issue" 5414)
  (define g (fiber:spawn (lambda ()
    (try (list 'slept (fiber:sleep 60000))
         (catch (e) (list 'cancelled e))))))
  (fiber:sleep 30)
  (check= #t (fiber:cancel g))
  (define t0 (monotonic-ms))
  (define joined (fiber:join g))
  (check= 'cancelled (car joined))
  (check= payload (car (cdr joined)))
  ; the body did not sit out the minute it asked for
  (check (< (- (monotonic-ms) t0) 5000)))

(test-case "fiber:sleep refuses what is not a non-negative integer" (hash "issue" 5414)
  (define usage "fiber:sleep: usage: (fiber:sleep ms), 0 <= ms <= 86400000")
  (check= usage (try (fiber:sleep -1) (catch (e) e)))
  (check= usage (try (fiber:sleep "x") (catch (e) e)))
  (check= usage (try (fiber:sleep 1.5) (catch (e) e)))
  (check= usage (try (fiber:sleep 86400001) (catch (e) e)))
  (check= usage (try (fiber:sleep) (catch (e) e))))

(test-case "finished fibers nobody joined are reclaimed, bounded, and still join" (hash "issue" 5446)
  ; The thread of a finished body used to stay registered until fiber:join
  ; or ~Evaluator, about 104 kB each: one fiber per request grew without
  ; bound. It is joined by the next spawn / join; only the result waits,
  ; the most recent 1024 per Evaluator.
  (define first (fiber:spawn (lambda () 'first)))
  (let loop ((i 0))
    (if (< i 1500) (begin (fiber:spawn (lambda () 'done)) (loop (+ i 1))) #f))
  (fiber:sleep 100)
  ; past the cap the oldest unjoined result is gone: an unknown id answers void
  (check (null? (fiber:join first)))
  ; a fiber that finished before a later spawn is answered with its value
  (define late (fiber:spawn (lambda () (fiber:sleep 30) 'late)))
  (fiber:sleep 80)
  (define other (fiber:spawn (lambda () 'other)))
  (check= 'late (fiber:join late))
  (check= 'other (fiber:join other)))

(test-finish)
