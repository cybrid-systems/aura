; #5064: try/catch on the fiber's own stack must see the documented
; cancel payload, not a located "type error:" diagnostic.
; Cancellation is a cooperative condition, the same shape as (error ...).
(require "std/test" all:)
(test-file "issue_5064_fiber_cancel_text.aura")

(define (string-contains-5064 s sub)
  (let ((n (string-length s)) (m (string-length sub)))
    (let loop ((i 0))
      (cond
        ((> (+ i m) n) #f)
        ((string=? (substring s i (+ i m)) sub) #t)
        (else (loop (+ i 1)))))))

(define payload "fiber-cancelled: cancel requested via (fiber:cancel)")

(test-case "cancel payload is not a type error" (hash "issue" 5064)
  (define cf (fiber:spawn (lambda ()
    (try (let loop ((i 0))
           (fiber:yield)
           (loop (+ i 1)))
         (catch (e) (format "~a" e))))))
  (check= #t (fiber:cancel cf))
  (define joined (fiber:join cf))
  (check= payload joined)
  (check (not (string-contains-5064 joined "type error"))))

(test-case "user error joined from outside" (hash "issue" 5064)
  (define bf (fiber:spawn (lambda () (error "boom"))))
  (define boom (try (fiber:join bf) (catch (e) (format "~a" e))))
  (check= "boom" boom))

(test-finish)
