; Issue #4801 — unbound channel spellings point at channel:create & co.
(define *n* 0)
(define *fails* 0)
(define (check! pred msg)
  (set! *n* (+ *n* 1))
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))
(define (string-has? s sub)
  (let loop ((i 0))
    (cond ((> (+ i (string-length sub)) (string-length s)) #f)
          ((equal? (substring s i (+ i (string-length sub))) sub) #t)
          (else (loop (+ i 1))))))
(define (err-text thunk)
  (try (begin (thunk) "no-error") (catch (e) (format "~a" e))))

(define e1 (err-text (lambda () (make-channel 1))))
(display "  make-channel: ") (display e1) (newline)
(check! (string-has? e1 "channel:create") "make-channel hints channel:create")
(check! (string-has? (err-text (lambda () (channel-send 1 2))) "channel:send") "channel-send hints channel:send")
(check! (string-has? (err-text (lambda () (channel-recv 1))) "channel:recv") "channel-recv hints channel:recv")
(check! (string-has? (err-text (lambda () (channel-close 1))) "channel:close") "channel-close hints channel:close")
(define c (channel:create 2))
(channel:send c 7)
(check! (equal? (channel:recv c) 7) "channel:create/send/recv still work")

(if (= *fails* 0)
    (begin (display "OK-channel-hint-4801 ") (display *n*) (display " checks") (newline))
    (begin (display "channel-hint-4801: ") (display (- *n* *fails*))
           (display "/") (display *n*) (newline) (exit 1)))
