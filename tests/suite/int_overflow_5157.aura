; Issue #5157 — abs / quotient / round / expt must not abort past the
; fixnum range. A result that does not fit saturates, or stays a float.
(define *fails* 0)
(define (assert! pred msg)
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin
        (set! *fails* (+ *fails* 1))
        (display "  FAIL: ")
        (display msg)
        (newline))))

(define kmax 4611686018427387903)
(define kmin -4611686018427387904)
(define p62 4611686018427387904)
(define p63 9223372036854775808.0)
(define n63 -9223372036854775808.0)

(assert! (and (exact? (abs kmin)) (= (abs kmin) kmax))
         "abs of the fixnum minimum saturates")
(assert! (= (abs (- kmax)) kmax) "abs of an in-range negative stays exact")
(assert! (= (quotient 1e19 1) kmax) "quotient of 1e19 saturates")
(assert! (= (quotient 1e18 1) 1000000000000000000) "quotient of 1e18 stays exact")
(assert! (= (quotient (truncate 5e18) 1) kmax) "quotient of truncate 5e18 saturates")
(assert! (= (modulo 1e19 3) 1) "modulo 1e19 3 stays 1")
(assert! (= (remainder 1e19 3) 1) "remainder 1e19 3 stays 1")
(assert! (= (mod 1e19 3) 1) "mod aliases modulo")
(assert! (and (inexact? (round 5e18)) (= (round 5e18) 5e18)) "round 5e18 stays a float")
(assert! (and (inexact? (round -5e18)) (= (round -5e18) -5e18)) "round -5e18 stays a float")
(assert! (number? (round p62)) "round of 2^62 returns")
(assert! (number? (round n63)) "round of -2^63 returns")
(assert! (and (number? (expt kmin 3)) (inexact? (expt kmin 3)))
         "expt of a negative fixnum minimum promotes")
(assert! (number? (expt p62 3)) "expt of 2^62 returns")
(assert! (= (gcd 1e19 1) 1) "gcd with a large float returns")
(assert! (number? (lcm 1e19 1)) "lcm with a large float returns")

; Survival sweep: fixnum minimum, 2^62, 2^63, 1e300. Reaching the OK
; line means none of these aborted inside make_int.
(define samples (list kmin p62 p63 n63 1e300 -1e300))
(define (hold label thunk)
  (try (thunk) (catch (e) #f)))

(define (sweep-one x)
  (hold "abs" (lambda () (abs x)))
  (hold "quotient" (lambda () (quotient x 1)))
  (hold "modulo" (lambda () (modulo x 3)))
  (hold "mod" (lambda () (mod x 3)))
  (hold "remainder" (lambda () (remainder x 3)))
  (hold "gcd" (lambda () (gcd x 3)))
  (hold "lcm" (lambda () (lcm x 3)))
  (hold "round" (lambda () (round x)))
  (hold "floor" (lambda () (floor x)))
  (hold "ceiling" (lambda () (ceiling x)))
  (hold "truncate" (lambda () (truncate x)))
  (hold "min" (lambda () (min x 1)))
  (hold "max" (lambda () (max x 1)))
  (hold "+" (lambda () (+ x 1)))
  (hold "-" (lambda () (- x 1)))
  (hold "*" (lambda () (* x 2)))
  (hold "/" (lambda () (/ x 2)))
  (hold "inexact->exact" (lambda () (inexact->exact x)))
  (hold "exact" (lambda () (exact x)))
  (hold "exact->inexact" (lambda () (exact->inexact x)))
  (hold "inexact" (lambda () (inexact x)))
  (hold "even?" (lambda () (even? x)))
  (hold "odd?" (lambda () (odd? x)))
  (hold "zero?" (lambda () (zero? x)))
  (hold "positive?" (lambda () (positive? x)))
  (hold "negative?" (lambda () (negative? x)))
  (hold "number->string" (lambda () (number->string x)))
  (hold "string->number" (lambda () (string->number (number->string x))))
  (hold "bitwise-and" (lambda () (bitwise-and x 7)))
  (hold "bitwise-ior" (lambda () (bitwise-ior x 1)))
  (hold "bitwise-xor" (lambda () (bitwise-xor x 1)))
  (hold "bitwise-not" (lambda () (bitwise-not x)))
  (hold "arithmetic-shift" (lambda () (arithmetic-shift x 1)))
  (hold "expt" (lambda () (expt x 3))))

(define (sweep xs)
  (if (null? xs) #t
    (begin
      (display "  sweep ")
      (display (car xs))
      (newline)
      (sweep-one (car xs))
      (sweep (cdr xs)))))
(sweep samples)

(if (= *fails* 0)
    (begin (display "OK-5157 integer overflow saturates\n"))
    (begin
      (display "FAIL-5157 fails=")
      (display *fails*)
      (newline)
      (error "5157 suite failed")))
