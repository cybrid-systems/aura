; Issue #2874 — pluggable swarm intelligence (grid + pso + ant)
;
; Pure fitness: maximize -||x||^2 (sphere). No network.
(require "std/test" all:)
(require "std/swarm" all:)

(define *fails* 0)
(define (assert! pred msg)
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin
        (set! *fails* (+ *fails* 1))
        (display "  FAIL: ")
        (display msg)
        (newline))))

(define (sphere ind)
  (let loop ((xs ind) (s 0.0))
    (if (null? xs) (- 0.0 s)
      (loop (cdr xs) (+ s (* (car xs) (car xs)))))))

(define (l2 ind)
  (let loop ((xs ind) (s 0.0))
    (if (null? xs) s
      (loop (cdr xs) (+ s (* (car xs) (car xs)))))))

; AC1: grid backend improves toward origin
(display "AC1 grid sphere\n")
(swarm:init (hash "kind" "grid" "dim" 1 "pop" 10
                  "bounds" (list (list -2.0 2.0)) "seed" 11))
(let loop ((i 0))
  (if (>= i 12) #t (begin (swarm:step! sphere) (loop (+ i 1)))))
(assert! (= (swarm:gen) 12) "grid gen=12")
(assert! (< (l2 (swarm:best)) 0.25) "grid best near 0")
(assert! (string? (swarm:export)) "grid export string")

; AC2: pso backend
(display "AC2 pso sphere\n")
(swarm:init (hash "kind" "pso" "dim" 2 "pop" 12
                  "bounds" (list (list -2.0 2.0) (list -2.0 2.0))
                  "seed" 22))
(let loop ((i 0))
  (if (>= i 20) #t (begin (swarm:step! sphere) (loop (+ i 1)))))
(assert! (string=? (swarm:kind) "pso") "kind pso")
(assert! (< (l2 (swarm:best)) 0.5) "pso best near 0")

; AC3: ant backend — mutation-type ranking (#2876; not continuous sphere)
(display "AC3 ant mutation-type ranking\n")
(define ant-ops (list "edsl-lit-tweak" "edsl-op-swap" "edsl-disp-ref"))
(define (ant-fit op)
  (if (string=? op "edsl-lit-tweak") 1.0 0.1))
(swarm:init (hash "kind" "ant" "pop" 3 "ops" ant-ops
                  "evaporate" 0.95 "seed" 33))
(let loop ((i 0))
  (if (>= i 6) #t (begin (swarm:step! ant-fit) (loop (+ i 1)))))
(assert! (string=? (swarm:kind) "ant") "kind ant")
(assert! (string=? (swarm:best) "edsl-lit-tweak") "ant best lit-tweak")

; AC4: optional parallel fitness (flat join)
(display "AC4 parallel grid\n")
(swarm:init (hash "kind" "grid" "dim" 1 "pop" 6
                  "bounds" (list (list -1.0 1.0))
                  "seed" 44 "parallel" #t))
(swarm:step! sphere)
(assert! (hash-ref (swarm:report) "parallel") "parallel flag")
(assert! (number? (hash-ref (swarm:report) "best-fit")) "parallel best-fit")

; AC5: help surface
(assert! (not (= (string-index (swarm:help) "2874" 0) -1)) "help mentions 2874")

; ── Issue #4740: multi-objective (vector fitness + Pareto archive) ──
(display "AC6 multi-objective front\n")
(define (absv x) (if (< x 0.0) (- 0.0 x) x))
; maximize "recall" (peaks at 0.5), minimize "far distance" (peaks at 0.2)
(define (mo-fit ind)
  (let ((x (car ind)))
    (list (absv (- x 0.5)) (absv (- x 0.2)))))

(define (vec-dom? a b)
  ; a dominates b in MAXIMIZE space
  (let loop ((xs a) (ys b) (strict #f))
    (cond ((or (null? xs) (null? ys)) strict)
          ((< (car xs) (car ys)) #f)
          ((> (car xs) (car ys)) (loop (cdr xs) (cdr ys) #t))
          (#t (loop (cdr xs) (cdr ys) strict)))))

(define (max-space fit dirs)
  (if (null? fit) (list)
    (cons (* (if (string=? (car dirs) "min") -1.0 1.0) (car fit))
          (max-space (cdr fit) (cdr dirs)))))

(define (front-non-dominated? front dirs)
  (if (null? front) #t
    (let ((mi (max-space (hash-ref (car front) "fitness") dirs)))
      (let loop ((rest (cdr front)))
        (if (null? rest) (front-non-dominated? (cdr front) dirs)
          (if (vec-dom? (max-space (hash-ref (car rest) "fitness") dirs) mi)
              #f
              (loop (cdr rest))))))))

(swarm:init (hash "kind" "grid" "dim" 1 "pop" 8 "bins" 8
                  "bounds" (list (list 0.0 1.0))
                  "objectives" 2 "directions" (list "max" "min")
                  "seed" 5))
(swarm:step! mo-fit)
(swarm:step! mo-fit)
(define front (swarm:front))
(assert! (> (length front) 1) "archive holds a trade-off front")
(assert! (= (length front) (hash-ref (swarm:report) "front-size")) "report front-size")
(assert! (number? (hash-ref (swarm:report) "hypervolume")) "report hypervolume")
(assert! (> (hash-ref (swarm:report) "hypervolume") 0.0) "hypervolume positive")
(assert! (front-non-dominated? front (list "max" "min")) "front is non-dominated")

; scalarization helper (documented weights + directions)
(assert! (= (swarm:scalarize (list 1.0 0.0) (list 1.0 1.0) (list "max" "max")) 1.0) "scalarize max")
(assert! (= (swarm:scalarize (list 1.0 1.0) (list 1.0 1.0) (list "max" "min")) 0.0) "scalarize min")

; the archive is bounded (crowding-distance trim)
(swarm:init (hash "kind" "grid" "dim" 1 "pop" 8 "bins" 8
                  "bounds" (list (list 0.0 1.0))
                  "objectives" 2 "directions" (list "max" "min")
                  "archive-max" 3 "seed" 5))
(let loop ((i 0))
  (if (>= i 12) #t (begin (swarm:step! mo-fit) (loop (+ i 1)))))
(assert! (<= (length (swarm:front)) 3) "archive-max caps the front")

; scalar runs keep an empty front
(swarm:init (hash "kind" "grid" "dim" 1 "pop" 4
                  "bounds" (list (list -1.0 1.0)) "seed" 2))
(swarm:step! sphere)
(assert! (= (hash-ref (swarm:report) "front-size") 0) "scalar run has an empty front")

; ── Issue #4741: bounded + isolated parallel evaluation ─────────
(display "AC7 bounded parallel\n")
(define (slow-fit ind)
  (let loop ((k 0)) (if (>= k 500) (sphere ind) (loop (+ k 1)))))

(swarm:init (hash "kind" "grid" "dim" 1 "pop" 12 "bins" 12
                  "bounds" (list (list -1.0 1.0)) "seed" 3
                  "parallel" (hash "max-fibers" 3 "isolate" #t
                                   "on-error" "reject")))
(swarm:step! slow-fit)
(assert! (= (hash-ref (swarm:report) "max-fibers") 3) "max-fibers recorded")
(assert! (hash-ref (swarm:report) "isolate") "isolate recorded")
(assert! (= (length (swarm:population)) 12) "bounded waves evaluate the whole population")
(assert! (= (length (swarm:last-errors)) 0) "healthy run records no errors")

(define (flaky-fit ind)
  (if (< (car ind) 0.0) (error "boom") (sphere ind)))
(swarm:init (hash "kind" "grid" "dim" 1 "pop" 8 "bins" 8
                  "bounds" (list (list -1.0 1.0)) "seed" 3
                  "parallel" (hash "max-fibers" 2 "isolate" #t
                                   "on-error" "reject")))
(swarm:step! flaky-fit)
(assert! (> (length (swarm:last-errors)) 0) "failing individuals are recorded, not fatal")
(assert! (= (hash-ref (swarm:report) "errors") (length (swarm:last-errors))) "report errors count")

; isolate: a candidate that defines a name does not leak into siblings
(swarm:init (hash "kind" "grid" "dim" 1 "pop" 4 "bins" 4
                  "bounds" (list (list -1.0 1.0)) "seed" 9
                  "parallel" (hash "max-fibers" 2 "isolate" #t
                                   "on-error" "reject")))
(swarm:step! (lambda (ind) (begin (define swarm-leak-probe 1) (sphere ind))))
(assert! (= (length (swarm:last-errors)) 0) "isolated bodies run clean")

(if (= *fails* 0)
    (begin (display "OK-2874 swarm\n"))
    (begin
      (display "FAIL-2874 fails=")
      (display *fails*)
      (newline)
      (error "2874 suite failed")))
