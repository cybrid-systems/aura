; Issue #2919 — current-source unparse P0 tags roundtrip
; set-code → current-source :workspace → set-code must not emit <N> fallbacks
; for TypeAnnotation / Coercion / Linear family / DefineType / dotted lambda / escapes.

(define ok #t)

(define (roundtrip src)
  (set-code src)
  (define out (current-source :workspace))
  (set-code out)
  (define out2 (current-source :workspace))
  (if (equal? out out2)
      out
      #f))

; ── Type annotation forms ──
(define r1 (roundtrip "(: x Int 5)"))
(if (string? r1)
    #t
    (begin (display "FAIL-2919 type-annot-3arg\n") (set! ok #f)))

(define r1b (roundtrip "(check 1 : Int)"))
(if (string? r1b)
    #t
    (begin (display "FAIL-2919 check-annot\n") (set! ok #f)))

; ── Coercion / cast ──
(define r2 (roundtrip "(cast 1 : Int)"))
(if (string? r2)
    #t
    (begin (display "FAIL-2919 cast-int\n") (set! ok #f)))

; ── Linear family ──
(define r3 (roundtrip "(Linear 1)"))
(if (string? r3)
    #t
    (begin (display "FAIL-2919 Linear\n") (set! ok #f)))

(define r4 (roundtrip "(move x)"))
(if (string? r4)
    #t
    (begin (display "FAIL-2919 move\n") (set! ok #f)))

(define r5 (roundtrip "(borrow x)"))
(if (string? r5)
    #t
    (begin (display "FAIL-2919 borrow\n") (set! ok #f)))

(define r6 (roundtrip "(mut-borrow x)"))
(if (string? r6)
    #t
    (begin (display "FAIL-2919 mut-borrow\n") (set! ok #f)))

(define r7 (roundtrip "(drop x)"))
(if (string? r7)
    #t
    (begin (display "FAIL-2919 drop\n") (set! ok #f)))

; ── DefineType ──
(define r8 (roundtrip "(define-type Tree (leaf val) (node left right))"))
(if (string? r8)
    #t
    (begin (display "FAIL-2919 define-type\n") (set! ok #f)))

; ── Lambda dotted rest ──
(define r9 (roundtrip "(lambda (a . rest) rest)"))
(if (string? r9)
    #t
    (begin (display "FAIL-2919 lambda-dotted\n") (set! ok #f)))

; ── String escapes: newline / tab / quote / backslash ──
(define r10 (roundtrip "(define s \"a\\nb\\tc\\\"d\\\\e\")"))
(if (string? r10)
    #t
    (begin (display "FAIL-2919 string-escape\n") (set! ok #f)))

; Compound: typed + cast + Linear
(define r11 (roundtrip "(begin (: x Int 1) (cast x : Int) (Linear x))"))
(if (string? r11)
    #t
    (begin (display "FAIL-2919 compound\n") (set! ok #f)))

; Smoke: unparse of P0 surface must not contain angle-digit fallback tokens.
; We check a known bad pattern by re-parsing a tag that would have been <15>
; if TypeAnnotation were still missing — already covered by r1/r1b string?.
(if ok
    (begin (display "OK-2919 current-source-unparse") (newline))
    (begin (display "FAIL-2919") (newline) (unbound-2919-force-fail)))
