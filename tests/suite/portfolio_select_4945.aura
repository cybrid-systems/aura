; Issue #4945 — std/portfolio + std/algo-select + std/hyper-heuristic:
; algorithm combination, compute alignment, feature-based selection,
; bandit operator allocation, irace-style racing and the multi-seed gate.
(require "std/portfolio" all:)
(require "std/algo-select" all:)
(require "std/hyper-heuristic" all:)
(require "std/moead" all:)
(require "std/pareto" all:)
(require "std/list" all:)

(define *fails* 0)
(define (assert! pred msg)
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin
        (set! *fails* (+ *fails* 1))
        (display "  FAIL: ")
        (display msg)
        (newline))))

; ═══════════════════════════════════════════════════════════════════
; AC1 — portfolio registry, matrix, VBS/SBS
; ═══════════════════════════════════════════════════════════════════
(display "AC1 portfolio\n")
(define (mk name score) (lambda (inst ctx) score))
(define pf (portfolio:add! (portfolio:add! (portfolio:add!
                                             (portfolio:make (hash "sense" "max"))
                                             "a" (mk "a" 1.0))
                                           "b" (mk "b" 3.0))
                           "c" (mk "c" 2.0)))
(assert! (= 3 (length (portfolio:members pf))) "three members registered")
(assert! (string=? (hash-ref (portfolio:member pf "b") "name") "b")
         "members are looked up by name")
(define pf2 (portfolio:add! pf "a" (mk "a" 9.0)))
(assert! (= 3 (length (portfolio:members pf2))) "re-adding a name keeps one entry")
(assert! (string=? (hash-ref (portfolio:run pf2 'i (hash)) "winner") "a")
         "re-adding a name replaces its factory")
(define r (portfolio:run pf 'inst (hash)))
(assert! (string=? (hash-ref r "winner") "b") "equal run picks the best member")
(assert! (= 3.0 (hash-ref r "winner-score")) "winner score reported")
(assert! (= 3 (length (hash-ref r "rows"))) "one audit row per member")
(assert! (every (lambda (row) (equal? (hash-ref row "status") "ok"))
                (hash-ref r "rows"))
         "every member completed")
(define mtx (portfolio:matrix pf (list 'i1 'i2) (hash "seeds" (list 1 2 3))))
(assert! (= 3 (length (list-ref (hash-ref mtx "means") 0))) "matrix rows per instance")
(assert! (= 3.0 (portfolio:vbs pf mtx)) "VBS is the per-instance best")
(assert! (= 3.0 (portfolio:sbs pf mtx)) "SBS is the best single member")
(assert! (= 3 (length (hash-ref mtx "seeds"))) "matrix keeps the seed list")

; ═══════════════════════════════════════════════════════════════════
; AC2 — compute alignment: budget split, cancellation, audit
; ═══════════════════════════════════════════════════════════════════
(display "AC2 compute alignment\n")
(define (quick inst ctx) 5.0)
(define (spinner inst ctx)
  (let loop ((n 0)) (fiber:yield) (loop (+ n 1))))
(define pfb (portfolio:add! (portfolio:add! (portfolio:make (hash)) "quick" quick)
                            "spin" spinner))
(define rb (portfolio:run pfb 'i (hash "budget-ms" 400)))
(define rows (hash-ref rb "rows"))
(define spinrow (find (lambda (row) (equal? (hash-ref row "member") "spin")) rows))
(define quickrow (find (lambda (row) (equal? (hash-ref row "member") "quick")) rows))
(assert! (equal? (hash-ref spinrow "status") "cancelled")
         "an over-budget member is cancelled")
(assert! (<= (hash-ref spinrow "actual-ms") (+ (hash-ref spinrow "budget-ms") 100))
         "cancellation lands within 100 ms of the budget")
(assert! (< (abs (- (hash-ref spinrow "actual-ms") (hash-ref spinrow "budget-ms")))
            (* 0.1 (hash-ref spinrow "budget-ms")))
         "audited actual time is within 10 % of the budget")
(assert! (= 200 (hash-ref spinrow "budget-ms")) "equal allocation splits the budget")
(assert! (equal? (hash-ref quickrow "status") "ok") "the fast member finished")
(assert! (string=? (hash-ref rb "winner") "quick") "a cancelled member cannot win")
(assert! (number? (hash-ref rb "spent-ms" #f)) "run audits total spent time")

; ═══════════════════════════════════════════════════════════════════
; AC3 — successive halving and bandit allocation
; ═══════════════════════════════════════════════════════════════════
(display "AC3 allocation strategies\n")
(define rh (portfolio:run pf 'i (hash "alloc" "successive-halving")))
(assert! (string=? (hash-ref rh "winner") "b") "halving keeps the best")
(assert! (>= (hash-ref rh "rounds") 2) "halving ran several rounds")
(assert! (< (length (hash-ref rh "rows")) 9) "halving did not evaluate the full grid")
(define ru (portfolio:run pf 'i (hash "alloc" "ucb" "slots" 12)))
(assert! (string=? (hash-ref ru "winner") "b") "UCB allocation finds the best")
(define usage (hash-ref ru "arms"))
(define bad-pulls (car (cdr (cdr (find (lambda (row) (equal? (car row) "a")) usage)))))
(assert! (<= bad-pulls 4) "UCB stops pulling the weakest member")
(define rt (portfolio:run pf 'i (hash "alloc" "thompson" "slots" 12)))
(assert! (string=? (hash-ref rt "winner") "b") "Thompson allocation finds the best")
(define t-pulls (foldl (lambda (acc row) (+ acc (car (cdr (cdr row)))))
                         0 (hash-ref rt "arms")))
(assert! (= 12 t-pulls) "thompson spends every slot")

; ═══════════════════════════════════════════════════════════════════
; AC4 — feature-based selection closes the SBS -> VBS gap
; ═══════════════════════════════════════════════════════════════════
(display "AC4 feature-based selection\n")
(define kinds (list 0 0 0 1 1 1 2 2 2))
(define insts (map (lambda (k) (hash "kind" k)) kinds))
(define (row-for k)
  (cond ((= k 0) (list 1.0 0.4 0.3))
        ((= k 1) (list 0.4 1.0 0.3))
        (else (list 0.3 0.4 1.0))))
(define sm (hash "members" (list "a" "b" "c") "instances" insts
                 "means" (map row-for kinds)))
(define sel (select:offline (select:make (hash "model" "knn" "k" 1)) sm (hash)))
(define rep (select:report sel))
(assert! (>= (hash-ref rep "gap-closure") 0.5)
         "kNN selection closes at least half of the SBS->VBS gap")
(assert! (> (hash-ref rep "vbs") (hash-ref rep "sbs")) "the synthetic set has a gap")
(assert! (string=? (car (select:choose sel (hash "kind" 0) 1)) "a")
         "kind 0 selects member a")
(assert! (string=? (car (select:choose sel (hash "kind" 1) 1)) "b")
         "kind 1 selects member b")
(assert! (string=? (car (select:choose sel (hash "kind" 2) 1)) "c")
         "kind 2 selects member c")
(assert! (= 2 (length (select:choose sel (hash "kind" 1) 2))) "choose returns k members")
(define tre (select:offline (select:make (hash "model" "tree")) sm (hash)))
(assert! (>= (hash-ref (select:report tre) "gap-closure") 0.5)
         "tree selection closes at least half of the gap")
(assert! (string=? (car (select:choose tre (hash "kind" 2) 1)) "c")
         "tree resolves the third regime")
(define pw (select:offline (select:make (hash "model" "pairwise" "k" 3)) sm (hash)))
(assert! (string=? (car (select:choose pw (hash "kind" 1) 1)) "b")
         "pairwise selection picks the winner in its neighbourhood")
(assert! (number? (hash-ref (select:report pw) "gap-closure"))
         "pairwise report carries a gap closure")
; explicit feature function (instance is not a feature hash itself)
(define sfeat (select:features-fn! (select:make (hash "model" "knn" "k" 1))
                                   (lambda (inst) (hash "size" (hash-ref inst "size")))))
(define finsts (map (lambda (k)
                      (hash "size" k "id" k))
                    (list 0 0 0 1 1 1)))
(define fmat (hash "members" (list "a" "b")
                   "instances" finsts
                   "means" (map (lambda (k) (if (= k 0) (list 1.0 0.2) (list 0.2 1.0)))
                                (list 0 0 0 1 1 1))))
(define sf (select:offline sfeat fmat (hash)))
(assert! (string=? (car (select:choose sf (hash "size" 1 "id" 9) 1)) "b")
         "features-fn maps an instance to its feature hash")
(assert! (string=? (car (select:choose sf (hash "size" 0 "id" 8) 1)) "a")
         "features-fn is used for both training and query")

; AC4b — a feature key must never index a member-score row (#5060)
; Seven features, four members: the tree total used to do (list-ref row k)
; with k a feature index, so it ran past a 4-long score row.
(display "AC4b features exceed members\n")
(define f7 (map (lambda (r)
                  (hash "f0" 1 "f1" 1 "f2" (* 10 r) "f3" 1
                        "f4" 1 "f5" 1 "f6" 1))
                (list 0 0 1 1 2 2 3 3)))
(define f7means (map (lambda (r)
                       (cond ((= r 0) (list 1.0 0.2 0.1 0.0))
                             ((= r 1) (list 0.1 1.0 0.2 0.0))
                             ((= r 2) (list 0.1 0.2 1.0 0.0))
                             (else (list 0.0 0.1 0.2 1.0))))
                     (list 0 0 1 1 2 2 3 3)))
(define f7mat (hash "members" (list "m0" "m1" "m2" "m3")
                    "instances" f7 "means" f7means))
(define tr7 (select:offline (select:make (hash "model" "tree")) f7mat (hash)))
(assert! (number? (hash-ref (select:report tr7) "gap-closure"))
         "tree selection with 7 features / 4 members returns a report")
(assert! (member? (car (select:choose tr7 (hash "f0" 1 "f1" 1 "f2" 20 "f3" 1
                                                    "f4" 1 "f5" 1 "f6" 1) 1))
                     (list "m0" "m1" "m2" "m3"))
         "tree selection returns a known member when features > members")

; ═══════════════════════════════════════════════════════════════════
; AC5 — online feedback and drift detection
; ═══════════════════════════════════════════════════════════════════
(display "AC5 online feedback\n")
(define so (select:feedback! (select:feedback! sel (hash "kind" 0) "c" 9.0)
                             (hash "kind" 0) "c" 9.0))
(assert! (string=? (car (select:choose so (hash "kind" 0) 1)) "c")
         "online feedback overrides the offline prior")
(define (feed-n s n inst)
  (if (= n 0) s (feed-n (select:feedback! s inst "c" 1.0) (- n 1) inst)))
(define so6 (feed-n so 4 (hash "kind" 2)))
(assert! (> (select:drift-score so6) 0.0) "drift score sees the context shift")
(define sd (select:make (hash "model" "knn" "k" 1 "drift-threshold" 0.25)))
(define sdd (select:offline sd sm (hash)))
(define shifted (feed-n sdd 10 (hash "kind" 2)))
(assert! (select:drift? shifted) "drift is flagged after the context changes")
(assert! (not (select:drift? sdd)) "no drift without feedback")

; ═══════════════════════════════════════════════════════════════════
; AC6 — FRRMAB stops using the bad operator
; ═══════════════════════════════════════════════════════════════════
(display "AC6 FRRMAB operator credit\n")
(define (op-reward op)
  (cond ((string=? op "good") 1.0) ((string=? op "mid") 0.6) (else 0.05)))
(define (run-hh n h)
  (let loop ((i 0) (hh h) (sum 0.0))
    (if (>= i n) (cons hh sum)
      (let* ((step (hh:next hh))
             (op (car step))
             (next (hh:credit! (cdr step) op (op-reward op))))
        (loop (+ i 1) next (+ sum (op-reward op)))))))
(define hh0 (hh:make (hash "low-level" (list "good" "mid" "bad")
                           "credit" "frr" "window" 20 "c" 0.5)))
(define hr (run-hh 200 hh0))
(define hh1 (car hr))
(define total-reward (cdr hr))
(define u (hh:usage hh1))
(assert! (<= (hash-ref u "bad") 20) "the bad operator is used at most 10 % of the time")
(assert! (>= (/ total-reward 200.0) 0.95) "the selected operators keep >= 95 % of the best reward")
(assert! (= 200 (hash-ref (hh:report hh1) "pulls")) "report counts every pull")
(define hpm (run-hh 200 (hh:make (hash "low-level" (list "good" "mid" "bad")
                                         "credit" "pm"))))
(assert! (<= (hash-ref (hh:usage (car hpm)) "bad") 20)
         "probability matching also starves the bad operator")
(define hap (run-hh 200 (hh:make (hash "low-level" (list "good" "mid" "bad")
                                         "credit" "ap"))))
(assert! (<= (hash-ref (hh:usage (car hap)) "bad") 20)
         "adaptive pursuit also starves the bad operator")

; ═══════════════════════════════════════════════════════════════════
; AC7 — multi-seed gate rejects noise winners; tune:race
; ═══════════════════════════════════════════════════════════════════
(display "AC7 multi-seed gate + tune:race\n")
(define (nrm s)
  (let* ((s1 (modulo (+ (* s 1664525) 1013904223) 4294967296))
         (u1 (max 1e-12 (/ (* 1.0 s1) 4294967296.0)))
         (s2 (modulo (+ (* s1 1664525) 1013904223) 4294967296))
         (u2 (/ (* 1.0 s2) 4294967296.0)))
    (cons (* (sqrt (* -2.0 (log u1))) (cos (* 2.0 3.141592653589793 u2))) s2)))
(define (gauss5 s)
  (let loop ((i 0) (st s) (acc (quote ())))
    (if (>= i 5) (reverse acc)
      (let ((r (nrm st))) (loop (+ i 1) (cdr r) (cons (car r) acc))))))
(define (noise-keeps alpha trials)
  (let loop ((i 0) (st 12345) (kept 0))
    (if (>= i trials) kept
      (let ((g (tune:gate (gauss5 st) (gauss5 (+ st 977)) (hash "alpha" alpha))))
        (loop (+ i 1) (+ st 7) (if (hash-ref g "keep") (+ kept 1) kept))))))
(define kept05 (noise-keeps 0.05 400))
(define kept01 (noise-keeps 0.01 400))
(assert! (<= kept05 20) "alpha 0.05: false KEEP rate <= 5 % over 400 noise trials")
(assert! (<= kept01 10) "alpha 0.01: false KEEP rate <= 2.5 %")
(display "  false-keep @0.05: ") (display kept05) (newline)
(define strong (tune:gate (list 1.5 1.6 1.4 1.55 1.5)
                          (list 1.0 1.0 0.9 1.0 1.05) (hash "alpha" 0.05)))
(assert! (hash-ref strong "keep") "a real improvement passes the gate")
(define same (tune:gate (list 1.0 1.0 1.0) (list 1.0 1.0 1.0) (hash "alpha" 0.05)))
(assert! (not (hash-ref same "keep")) "identical results are not a winner")
(define (ev cfg inst seed) (+ (hash-ref cfg "v") (* 0.0 seed)))
(define cfgs (list (hash "name" "c0" "v" 0.0)
                   (hash "name" "c1" "v" 1.0)
                   (hash "name" "c2" "v" 2.0)))
(define tr (tune:race cfgs (hash "instances" (range 0 6) "seeds" (list 1 2 3)
                                 "evaluate" ev)))
(assert! (string=? (hash-ref tr "winner") "c2") "tune:race finds the best config")
(assert! (< (hash-ref tr "evaluations") (* 3 6 3))
         "tune:race spends fewer evaluations than the full grid")
(assert! (>= (length (hash-ref tr "rounds")) 2) "tune:race ran several rounds")

; ═══════════════════════════════════════════════════════════════════
; AC8 — EoH-style admission: complementary KEEP, redundant DROP
; ═══════════════════════════════════════════════════════════════════
(display "AC8 member admission (EoH mock)\n")
(define base (hash "members" (list "a" "b") "instances" insts
                   "means" (map (lambda (k)
                                  (cond ((= k 0) (list 1.0 0.4))
                                        ((= k 1) (list 0.4 1.0))
                                        (else (list 0.3 0.3))))
                                kinds)))
(define (eval-set m)
  (select:report (select:offline (select:make (hash "model" "knn" "k" 1)) m (hash))))
(define base-rep (eval-set base))
(define with-c (hash "members" (list "a" "b" "c") "instances" insts
                     "means" (map (lambda (k)
                                    (cond ((= k 0) (list 1.0 0.4 0.3))
                                          ((= k 1) (list 0.4 1.0 0.3))
                                          (else (list 0.3 0.3 1.0))))
                                  kinds)))
(define c-rep (eval-set with-c))
(define with-d (hash "members" (list "a" "b" "d") "instances" insts
                     "means" (map (lambda (k)
                                    (cond ((= k 0) (list 1.0 0.4 1.0))
                                          ((= k 1) (list 0.4 1.0 0.4))
                                          (else (list 0.3 0.3 0.3))))
                                  kinds)))
(define d-rep (eval-set with-d))
; Marginal contribution is measured on absolute performance (VBS) and on
; the selector's own LOO score; gap closure is 1.0 for both because the
; selector is perfect on this set, so it cannot be the admission signal.
(define c-delta-vbs (- (hash-ref c-rep "vbs") (hash-ref base-rep "vbs")))
(define d-delta-vbs (- (hash-ref d-rep "vbs") (hash-ref base-rep "vbs")))
(define c-delta-loo (- (hash-ref c-rep "loo") (hash-ref base-rep "loo")))
(define d-delta-loo (- (hash-ref d-rep "loo") (hash-ref base-rep "loo")))
(define keep-c (> c-delta-vbs 0.1))
(define keep-d (> d-delta-vbs 0.05))
(assert! keep-c "a member that wins a new regime is KEPT (VBS improves)")
(assert! (> c-delta-loo 0.1) "the selector's own score improves with the new member")
(assert! (not keep-d) "a redundant member is DROPPED (VBS unchanged)")
(define audit (list (hash "candidate" "c" "delta-vbs" c-delta-vbs
                          "delta-loo" c-delta-loo "decision" (if keep-c "KEEP" "DROP"))
                    (hash "candidate" "d" "delta-vbs" d-delta-vbs
                          "delta-loo" d-delta-loo "decision" (if keep-d "KEEP" "DROP"))))
(assert! (equal? (map (lambda (a) (hash-ref a "decision")) audit) (list "KEEP" "DROP"))
         "the admission decisions are recorded with evidence")
(assert! (every (lambda (a) (number? (hash-ref a "delta-vbs" #f))) audit)
         "each admission record carries its measured delta")
(assert! (not (= -1 (string-index (portfolio:help) "4945" 0))) "portfolio help mentions 4945")
(assert! (not (= -1 (string-index (select:help) "4945" 0))) "select help mentions 4945")
(assert! (not (= -1 (string-index (tune:help) "4945" 0))) "tune help mentions 4945")


; ═══════════════════════════════════════════════════════════════════
; AC9 — non-stationary stream: the windowed bandit beats a fixed SBS
; ═══════════════════════════════════════════════════════════════════
(display "AC9 non-stationary regret\n")
; Two reward regimes on the SAME context bucket (a season, not a new
; instance family): member a pays 1.0 then 0.0, member b the reverse.
; The fixed SBS is member a (its pre-drift mean is higher), so it pays
; the full second regime as regret.
(define ns-insts (list (hash "kind" 0) (hash "kind" 0) (hash "kind" 0) (hash "kind" 0)))
(define ns-matrix (hash "members" (list "a" "b") "instances" ns-insts
                        "means" (list (list 1.0 0.6) (list 0.9 0.5)
                                      (list 1.0 0.7) (list 0.95 0.6))))
(define ns0 (select:offline (select:make (hash "model" "knn" "k" 1
                                          "decay" 0.9 "warm-start" #t))
                            ns-matrix (hash)))
(define (ns-reward phase m)
  (if (= phase 0) (if (string=? m "a") 1.0 0.0)
      (if (string=? m "b") 1.0 0.0)))
(define (ns-step s i)
  (let* ((phase (if (< i 100) 0 1))
         (chosen (car (select:choose s (hash "kind" 0) 1)))
         (r (ns-reward phase chosen)))
    (list (select:feedback! s (hash "kind" 0) chosen r) r chosen)))
(define (ns-loop i s regret picks drift-max)
  (if (>= i 200) (list s regret (reverse picks) drift-max)
      (let* ((st (ns-step s i))
             (s2 (car st)) (r (car (cdr st))) (m (car (cdr (cdr st))))
             (ds (select:drift-score s2)))
        (ns-loop (+ i 1) s2 (+ regret (- 1.0 r)) (cons (cons i m) picks)
                 (max drift-max ds)))))
(define ns-out (ns-loop 0 ns0 0.0 (quote ()) 0.0))
(define ns-picks (car (cdr (cdr ns-out))))
(define ns-regret (car (cdr ns-out)))
(define ns-fixed-regret 100.0)   ; member a in the second regime
(define ns-post (filter (lambda (p) (>= (car p) 100)) ns-picks))
(define ns-first-b
  (let loop ((xs ns-post) (i 0))
    (cond ((null? xs) 999) ((string=? (cdr (car xs)) "b") i)
          (else (loop (cdr xs) (+ i 1))))))
(define ns-b25 (length (filter (lambda (p) (string=? (cdr p) "b"))
                               (take ns-post 25))))
(assert! (< ns-regret (* 0.7 ns-fixed-regret))
         "bandit cumulative regret is >= 30 % below the fixed SBS")
(assert! (<= ns-first-b 10) "the bandit recovers within 10 steps of the drift")
(assert! (>= ns-b25 18) "the new best member is played in >= 18 of the next 25 steps")
(assert! (> (car (cdr (cdr (cdr ns-out)))) 0.35)
         "the reward shift is reported as drift")
(display "  regret: bandit ") (display ns-regret)
(display " vs fixed-sbs ") (display ns-fixed-regret)
(display ", first-b after drift ") (display ns-first-b) (newline)

; ═══════════════════════════════════════════════════════════════════
; AC10 — successive halving under a real budget: the audit time matches
; ═══════════════════════════════════════════════════════════════════
(display "AC10 halving compute alignment\n")
(define (spin-forever inst ctx)
  (let loop ((n 0)) (fiber:yield) (loop (+ n 1))))
(define (spin-some inst ctx)
  (let loop ((n 0))
    (if (>= n 20) 3.0 (begin (fiber:yield) (loop (+ n 1))))))
(define pfh (portfolio:add! (portfolio:add! (portfolio:add!
                              (portfolio:make (hash)) "quick" quick)
                            "some" spin-some)
                          "spin" spin-forever))
(define rhb (portfolio:run pfh 'i (hash "budget-ms" 600 "alloc" "successive-halving")))
(define hrows (hash-ref rhb "rows"))
(define spin-rows (filter (lambda (row) (equal? (hash-ref row "member") "spin")) hrows))
(assert! (>= (length spin-rows) 1) "the spinner ran in a halving round")
(assert! (every (lambda (row) (equal? (hash-ref row "status") "cancelled")) spin-rows)
         "every round cancels the over-budget spinner")
(assert! (every (lambda (row)
                  (and (<= (hash-ref row "actual-ms")
                           (+ (hash-ref row "budget-ms") 100))
                       (< (abs (- (hash-ref row "actual-ms") (hash-ref row "budget-ms")))
                          (* 0.1 (hash-ref row "budget-ms")))))
                spin-rows)
         "a halving slot cancels within 100 ms and audits within 10 %")
(assert! (<= (hash-ref rhb "spent-ms") (* 1.1 (hash-ref rhb "budget-ms")))
         "halving spends no more than 110 % of the budget")
(assert! (string=? (hash-ref rhb "winner") "quick")
         "a cancelled member cannot win a halving round")
(display "  halving spent ") (display (hash-ref rhb "spent-ms"))
(display " of ") (display (hash-ref rhb "budget-ms")) (display " ms") (newline)

; ═══════════════════════════════════════════════════════════════════
; AC11 — FRRMAB inside MOEA/D (MOEA/D-FRRMAB): the bandit picks the
; variation operator per subproblem, and the front keeps its quality
; ═══════════════════════════════════════════════════════════════════
(display "AC11 MOEA/D-FRRMAB hypervolume\n")
(define (frr-sum xs) (foldl (lambda (a x) (+ a x)) 0.0 xs))
; ZDT1 (Zhang & Li 2007 benchmark), dim 6, both objectives minimized
(define (zdt1 g)
  (let* ((f1 (car g)) (tail (cdr g))
         (gg (+ 1.0 (* 9.0 (/ (frr-sum tail) (max 1 (length tail)))))))
    (list f1 (* gg (- 1.0 (sqrt (/ f1 gg)))))))
(define frr-ref (list 1.2 1.2))
; one step: ask a candidate, credit its operator with the scalar
; improvement over the parent subproblem, tell, repeat. Credit is
; per candidate (a batch-level rank reward is a constant 0.5 for every
; operator, which makes the bandit blind).
(define (frr-step box mode s i)
  (let* ((c (car (moead:ask s 1)))
         (sub (hash-ref (evo:candidate-meta c) "sub" 0))
         (ws (moead:weights s))
         (w (list-ref ws (modulo sub (length ws))))
         (pop (hash-ref s "pop" (list)))
         (pobj (if (< sub (length pop)) (hash-ref (list-ref pop sub) "objs" (list)) (list)))
         (psc (if (null? pobj) #f (moead:scalar s pobj w)))
         (objs (zdt1 (evo:candidate-genome c)))
         (csc (moead:scalar s objs w)))
    (if (and (string=? mode "auto") (number? psc))
        (let ((rew (max 0.0 (min 1.0 (/ (max 0.0 (- psc csc))
                                      (max 1e-9 (abs psc)))))))
          (vector-set! box 0 (hh:credit! (vector-ref box 0) (vector-ref box 1) rew))))
    (moead:tell! s (list c) (list objs))))
(define (frr-search mode evals)
  (let* ((box (vector (hh:make (hash "low-level" (list "de" "de-explore" "rand")
                                        "credit" "frr" "window" 20 "c" 0.5
                                        "decay" 0.5))
                      #f))
         (chooser (lambda (s sub)
                    (if (string=? mode "auto")
                        (let ((step (hh:next (vector-ref box 0))))
                          (vector-set! box 0 (cdr step))
                          (vector-set! box 1 (car step))
                          (car step))
                        mode)))
         (s (moead:make (hash "n-obj" 2 "H" 12 "T" 5 "dim" 6 "seed" 7
                              "dirs" (list "min" "min") "ref" frr-ref
                              "operator" (hash "choose" chooser)))))
    (let loop ((i 0))
      (if (>= i evals)
          (list (hash-ref (moead:report s) "hypervolume")
                (hh:usage (vector-ref box 0))
                (hash-ref (hh:report (vector-ref box 0)) "pulls")
                (hash-ref (moead:report s) "nfe"))
          (begin (frr-step box mode s i) (loop (+ i 1)))))))
(define frr-auto (frr-search "auto" 1560))
(define frr-de (frr-search "de" 1560))
(define frr-dex (frr-search "de-explore" 1560))
(define frr-rand (frr-search "rand" 1560))
(define frr-best (max (car frr-de) (car frr-dex)))
(define frr-usage (car (cdr frr-auto)))
(define frr-pulls (car (cdr (cdr frr-auto))))
(define frr-bad (hash-ref frr-usage "rand" 0))
(assert! (and (>= frr-pulls 1500) (<= frr-pulls 1560))
         "the bandit credits every pull with a parent scalar")
(assert! (= 1560 (car (cdr (cdr (cdr frr-auto))))) "all 1560 evaluations ran")
(assert! (<= frr-bad (* 0.10 frr-pulls)) "the bad operator is used at most 10 % of the time")
(assert! (>= (car frr-auto) (* 0.95 frr-best))
         "FRRMAB keeps >= 95 % of the best single operator's hypervolume")
(assert! (< (car frr-rand) (* 0.5 frr-best)) "the random operator is genuinely weak")
(display "  hv auto=") (display (car frr-auto))
(display " best-single=") (display frr-best)
(display " bad-pulls=") (display frr-bad) (display "/") (display frr-pulls)
(newline)
(if (= *fails* 0)
    (begin (display "OK-4945 portfolio/select/hh\n"))
    (begin
      (display "FAIL-4945 fails=")
      (display *fails*)
      (newline)
      (error "4945 suite failed")))
