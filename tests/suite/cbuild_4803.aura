; Issue #4803 — std/cbuild: on-disk content-addressed incremental build cache
(require "std/cbuild" all:)
(require "std/process" all:)
(define *n* 0)
(define *fails* 0)
(define (check! pred msg)
  (set! *n* (+ *n* 1))
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))
(define (string-has? s sub)
  (let loop ((i 0))
    (cond ((> (+ i (string-length sub)) (string-length s)) #f)
          ((equal? (substring s i (+ i (string-length sub))) sub) #t)
          (else (loop (+ i 1))))))
(define (cb-exists? p) (= 0 (shell (string-append "test -e '" p "'"))))
(define (stat k) (cdr (assoc k (cbuild-stats))))
(define (err-text thunk) (try (begin (thunk) "no-error") (catch (e) (format "~a" e))))

(define base (string-append "/tmp/cbuild-4803-" (number->string (current-time-ms))))
(define root (string-append base "/cache"))
(shell (string-append "mkdir -p " base))
(cbuild-set-root! root)
(check! (equal? (cbuild-root) root) "root override")

; ---- objects: build once, then hit ----------------------------------------------
(define src "int add3(int a) { return a + 3; }\n")
(define o1 (cbuild-object! src))
(check! (cb-exists? o1) "object built")
(check! (= (stat "built") 1) "one build")
(define o1b (cbuild-object! src))
(check! (equal? o1 o1b) "same text -> same cached object")
(check! (and (= (stat "hits") 1) (= (stat "built") 1)) "second request is a hit")
(check! (not (equal? o1 (cbuild-object! src "-O0 -fPIC"))) "flags are part of the key")
(check! (not (equal? o1 (cbuild-object! (string-append src " ")))) "any text change is a new key")
(check! (not (equal? (cbuild-key "obj" (string-append (cbuild-toolchain-id) "\n-O2") src)
                     (cbuild-key "obj" (string-append "cc:other-compiler\n-O2") src)))
        "toolchain id is part of the key")
(check! (string-has? (cbuild-toolchain-id) "cc:") "toolchain id names the compiler")
(check! (equal? (cbuild-lookup "obj" (string-append (cbuild-toolchain-id) "\n-O2 -fPIC") src) (substring o1 0 (- (string-length o1) 6)))
        "lookup finds the published entry")

; ---- link and run ------------------------------------------------------------------
(define main-o (cbuild-object! "#include <stdio.h>\nint add3(int);\nint main(void) { printf(\"%d\\n\", add3(39)); return 0; }\n"))
(define exe (cbuild-link! (list main-o o1) 'exe))
(check! (equal? (command-output exe) "42") "linked executable runs")
(define built-before (stat "built"))
(check! (equal? exe (cbuild-link! (list main-o o1) 'exe)) "relink of the same objects is a hit")
(check! (= built-before (stat "built")) "no rebuild on relink")
(define so (cbuild-link! (list o1) 'so))
(check! (string-has? so "/lib.so") "shared library")

; ---- failures publish nothing ---------------------------------------------------------
(define bad "int broken( { return; }\n")
(define et (err-text (lambda () (cbuild-object! bad))))
(check! (string-has? et "cbuild: obj build failed") "compile error raises cbuild error")
(check! (string-has? et "src.c") "error carries the compiler log")
(check! (not (cbuild-lookup "obj" (string-append (cbuild-toolchain-id) "\n-O2 -fPIC") bad)) "failed build is not published")
(check! (= (stat "failed") 1) "failure counted")
(check! (equal? "" (command-output (string-append "ls " root "/tmp"))) "no staging leftovers")

; ---- fibers sharing a key ------------------------------------------------------------
(define fsrc "int fib_shared(int a) { return a * 2; }\n")
(define fs (map (lambda (i) (fiber:spawn (lambda () (cbuild-object! fsrc)))) (list 1 2 3)))
(define fpaths (map fiber:join fs))
(check! (and (equal? (car fpaths) (cadr fpaths)) (equal? (car fpaths) (car (cddr fpaths)))) "fibers get one path")
(check! (cb-exists? (car fpaths)) "fiber-built object exists")

; ---- processes sharing a key: built exactly once ----------------------------------------
(define counter (string-append base "/counter"))
(write-file (string-append base "/child.aura")
  (string-append
   "(require \"std/cbuild\" all:)\n(cbuild-set-root! \"" root "\")\n"
   "(cbuild-artifact! \"test\" \"m\" \"in.txt\" \"same input\" \"sleep 0.3; echo x >> '" counter "'; echo built > out.txt\" (list \"out.txt\"))\n"
   "(display (cdr (assoc \"built\" (cbuild-stats))))\n"))
(define exe-path (command-output "readlink /proc/$PPID/exe 2>/dev/null"))
(if (and (> (string-length exe-path) 0) (= 0 (shell (string-append "test -x " exe-path))))
    (begin
      (shell (string-append "cd " base " && for i in 1 2 3 4; do " exe-path " --load child.aura > out$i 2>&1 & done; wait"))
      (check! (equal? (command-output (string-append "wc -l < " counter)) "1") "4 concurrent processes: command ran once")
      (check! (equal? (command-output (string-append "cat " base "/out1 " base "/out2 " base "/out3 " base "/out4 | grep -o '[01]' | sort | tr -d '\\n'"))
                      "0001")
              "exactly one process built, the others reused its entry")
      (check! (equal? (read-file (string-append (cbuild-lookup "test" "m" "same input") "/out.txt")) "built\n")
              "published entry is complete"))
    (begin (display "  skip: cannot locate the aura binary for the multi-process check") (newline)))

; ---- invalidate / gc / clear --------------------------------------------------------------
(check! (cbuild-invalidate! "obj" (string-append (cbuild-toolchain-id) "\n-O2 -fPIC") src) "invalidate removes the entry")
(check! (not (cbuild-lookup "obj" (string-append (cbuild-toolchain-id) "\n-O2 -fPIC") src)) "entry gone")
(check! (not (cbuild-invalidate! "obj" (string-append (cbuild-toolchain-id) "\n-O2 -fPIC") src)) "second invalidate is a no-op")
(define b0 (stat "built"))
(cbuild-object! src)
(check! (= (stat "built") (+ b0 1)) "invalidated entry is rebuilt")

(cbuild-clear!)
(check! (= 0 (cdr (assoc "entries" (cbuild-disk-stats)))) "clear empties the cache")
(define g1 (cbuild-artifact! "blob" "" "in" "one" "head -c 20000 /dev/zero > o" (list "o")))
(define g2 (cbuild-artifact! "blob" "" "in" "two" "head -c 20000 /dev/zero > o" (list "o")))
(define g3 (cbuild-artifact! "blob" "" "in" "three" "head -c 20000 /dev/zero > o" (list "o")))
(write-file (string-append g1 "/.atime") "1000")
(write-file (string-append g2 "/.atime") "3000")
(write-file (string-append g3 "/.atime") "2000")
(define kb (cdr (assoc "kbytes" (cbuild-disk-stats))))
(check! (= 3 (cdr (assoc "entries" (cbuild-disk-stats)))) "three entries")
(check! (= 1 (cbuild-gc! (- kb 1))) "gc evicts one entry to fit")
(check! (and (not (cb-exists? (string-append g1 "/.meta"))) (cb-exists? (string-append g3 "/.meta"))) "least recently used goes first")
(write-file (string-append g3 "/.atime") (number->string (current-time-ms)))
(check! (= 1 (cbuild-gc! 1000000000 3600)) "age limit evicts stale entries only")
(check! (cb-exists? (string-append g3 "/.meta")) "fresh entry survives the age limit")
(check! (= 1 (cdr (assoc "entries" (cbuild-disk-stats)))) "one entry left")

(if (> *fails* 0) (display (command-output (string-append "head -c 300 " base "/out*"))) (shell (string-append "rm -rf " base)))
(if (= *fails* 0)
    (begin (display "OK-cbuild-4803 ") (display *n*) (display " checks") (newline))
    (begin (display "cbuild-4803: ") (display (- *n* *fails*)) (display "/") (display *n*) (newline) (exit 1)))
