;; expect: 4459 live-ok 7 7 1 2 9 13495500 1124250 199
; Issue #4459: a file-mode loop must drop dead closures, pairs, and vectors.
; The live closure, pair spine, vector, and retained closure list are read
; only after the loops. The list is long enough to cross a reclaim.
(define (make k) (lambda (x) (+ x k)))
(define live (make 3))
(define box (cons live '()))
(define p (cons 1 (cons 2 '())))
(define v (make-vector 2 9))
(define (go i acc)
  (if (< i 3000)
      (go (+ i 1)
          (let ((f (lambda (x) (+ x i))))
            (+ (f acc)
               (car (cons i '()))
               (vector-ref (make-vector 4 i) 0))))
      acc))
(define junk (go 0 0))
(define (inner k)
  (let lp ((j 0))
    (if (< j 2) (lp (+ j 1)) k)))
(define (ngo i acc)
  (if (< i 1500)
      (ngo (+ i 1) (+ acc (inner i)))
      acc))
(define njunk (ngo 0 0))
(define (keep i acc)
  (if (< i 200)
      (keep (+ i 1) (cons (lambda (x) (+ x i)) acc))
      acc))
(define kept (keep 0 '()))
(display "4459 live-ok ")
(display (live 4))
(display " ")
(display ((car box) 4))
(display " ")
(display (car p))
(display " ")
(display (car (cdr p)))
(display " ")
(display (vector-ref v 0))
(display " ")
(display junk)
(display " ")
(display njunk)
(display " ")
(display ((car kept) 0))
(newline)
