;; Issue #5032: list registrations and their apply helpers moved to RegSplitParts.
(define fails 0)
(define (check pred msg)
  (if pred #t (begin (set! fails (+ fails 1)) (display (format "FAIL ~a\n" msg)))))
(define xs (list 1 2 3))
(check (= 3 (length xs)) "length")
(check (equal? (list 2 3 4) (map (lambda (x) (+ x 1)) xs)) "map")
(check (equal? (list 2) (filter (lambda (x) (> x 1)) (list 1 2))) "filter")
(check (= 6 (foldl + 0 xs)) "foldl")
(check (equal? (list 3 2 1) (reverse xs)) "reverse")
(check (equal? (list 1 2 3 4) (append xs (list 4))) "append")
(if (> fails 0)
    (error "list split regression")
    (begin (display "list split ok") (newline)))
