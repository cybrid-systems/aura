; Issue #5118: scope and workflow verbs resolve after (require "std/orch").
; v0.2.0 returned hashes. The names must still resolve and return hashes.
; The api-reference case is the follow-up that drops the one-cycle marker.
(require "std/test" all:)
(require "std/orch" all:)
(test-file "issue_5118_orch_scope.aura")

(define (missing-5118? thunk)
  (eq? (try (thunk) (catch (caught) 'missing-5118)) 'missing-5118))

(test-case "scope and workflow verbs resolve" (hash "issue" 5118)
  (define scope-5118
    (try (orch:scope-spawn "s5118" (lambda () 1)) (catch (caught) 'missing-5118)))
  (define flow-5118
    (try (orch:compose-workflow 'collect-all) (catch (caught) 'missing-5118)))
  (check (not (missing-5118? (lambda () (orch:scope-spawn "s5118b" (lambda () 1))))))
  (check (not (eq? scope-5118 'missing-5118)))
  (check (hash? scope-5118))
  (check (not (missing-5118? (lambda () (orch:compose-workflow 'collect-all)))))
  (check (not (eq? flow-5118 'missing-5118)))
  (check (hash? flow-5118))
  (check (procedure? orch:supervise-batch))
  (check (procedure? orch:agent-join))
  (check (procedure? orch:metrics)))

(test-case "api reference dropped the deprecation marker" (hash "issue" 5131)
  (define api-5118 (query :api-reference))
  (check (string? api-5118))
  (check= -1 (string-find api-5118 "DEPRECATED (#5118)")))

(test-finish)
