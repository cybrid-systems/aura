; string-split content: multi-character separators, literal metacharacters,
; the iterative length checks, and the long-line pieces. The wall-clock
; comparison with regex-split lives in tests/bench/string_split_regex_band.aura.
(require "std/test" all:)
(require "std/string" all:)
(test-file "string_split_fast_5283.aura")

(define (caught thunk) (try (thunk) (catch (e) e)))

; Doubling copy. string-repeat still appends onto a growing result.
(define (repeat s n)
  (let ((out "")
        (bit s)
        (k n))
    (while (lambda () (> k 0))
      (lambda ()
        (if (= (modulo k 2) 1)
            (set! out (string-append out bit)))
        (set! bit (string-append bit bit))
        (set! k (quotient k 2))))
    out))

; Issue #4795: a multi-char separator splits on the whole substring.
(test-case "multi-char separators" (hash "issue" 4795)
  (check= (list "a" "b" "c") (string-split "a::b::c" "::"))
  (check= (list "k=v;x=y") (string-split "k=v;x=y" "=;"))
  (check= (list "" "a" "") (string-split "::a::" "::"))
  (check= (list "a:b:") (string-split "a:b:" "::"))
  (check= (list "" "ab") (string-split "abcab" "abc"))
  (check= (list "x" "y" "z") (string-split "x-->y-->z" "-->"))
  (check= (list "a" "b" "" "c") (string-split "a,b,,c" ","))
  (check= (list "x" "y") (string-split "x y" 32))
  (check= (list "") (string-split "" "::")))

(test-case "trailing and literal separators" (hash "issue" 5283)
  (check= (list "a" "b" "c") (string-split "a,b,c" ","))
  (check= (list "a" "b" "") (string-split "a\nb\n" "\n"))
  (check= (list "" "") (string-split "\n" "\n"))
  (check= (list "" "" "" "") (string-split "\n\n\n" "\n"))
  (check= (list "" "" "" "") (string-split "aaa" "a"))
  (check= (list "a" "b" "c") (string-split "a.b.c" "."))
  (check= (list "a" "b" "") (string-split "a.b." "."))
  (check= (list "a" "b" "") (string-split "a*b*" "*"))
  (check= (list "a" "b" "") (string-split "a|b|" "|"))
  (check= (list "a" "b" "") (string-split "a$b$" "$"))
  (check= (list "a" "b" "") (string-split "a\\b\\" "\\"))
  (check= (list "a" "b") (string-split "a\\nb" "\\n"))
  (check= (list "a" "b" "c") (string-split "aébéc" "é"))
  (check= (list "a" "") (string-split "aé" 233)))

(test-case "empty separator is an error" (hash "issue" 5283)
  (check (string-contains? (format "~a" (caught (lambda () (string-split "a" ""))))
                           "empty separator")))

(test-case "two hundred newlines" (hash "issue" 5283)
  (check= 201 (length (string-split (string-repeat "a\n" 200) "\n"))))

; Issue #2770: O(1)-stack iterative split. 5000 one-shot pieces, 2000
; lines, and string-split-words stay content checks, not timers.
(test-case "split long text" (hash "issue" 2770)
  (check= 1 (length (string-split (string-repeat "a" 5000) "|")))
  (check= 2001 (length (string-split (string-repeat "a\n" 2000) "\n")))
  (check= (list "hi" "there" "world") (string-split-words "hi  there\tworld"))
  (check= 500 (length (string-split-words (string-repeat "w " 500)))))

(test-case "four thousand lines" (hash "issue" 5283)
  (define text4 (repeat "a\n" 4000))
  (define warm (string-split text4 "\n"))
  (check= 4001 (length warm))
  (check (string=? (car warm) "a"))
  (check (string=? (car (reverse warm)) "")))

(test-finish)
