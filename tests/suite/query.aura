(require "std/test" all:)
(require "std/query" all:)

; ── query:filter 基础 ──
(test-suite "query:filter-basic"
  (check (pair? (query:filter (lambda (x) (= (% x 2) 0)) (list 1 2 3 4 5)))))

(test-suite "query:filter-empty"
  (check (null? (query:filter (lambda (x) #t) (quote ())))))

(test-suite "query:filter-all-true"
  (check (= (length (query:filter (lambda (x) #t) (list 1 2 3))) 3)))

(test-suite "query:filter-all-false"
  (check (null? (query:filter (lambda (x) #f) (list 1 2 3)))))

(test-suite "query:filter-numeric-pred"
  (check (pair? (query:filter (lambda (x) (> x 3)) (list 1 2 3 4 5)))))

; ── query:uncalled ──
(test-suite "query:uncalled-identity"
  (set-code "(define (unused x) (* x 2)) (define (used y) (+ y 1)) (display (used 5))")
  (check (= (length (query:uncalled)) 1)))

(test-suite "query:uncalled-recursive"
  (set-code "(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))")
  (check (null? (query:uncalled))))

(test-suite "query:uncalled-no-define"
  (set-code "(display 42)")
  (check (null? (query:uncalled))))

(test-suite "query:uncalled-all-used"
  (set-code "(define (a x) x) (define (b x) (a x)) (display (b 1))")
  (check (null? (query:uncalled))))

; ── query:callers-of ──
(test-suite "query:callers-basic"
  (set-code "(define (helper x) (* x 2)) (define (main y) (+ (helper y) 1)) (display (main 5))")
  (check (= (length (query:callers-of "helper")) 1)))

(test-suite "query:callers-no-callers"
  (set-code "(define (alone x) x)")
  (check (null? (query:callers-of "alone"))))

(test-suite "query:callers-nonexistent"
  (set-code "(display 42)")
  (check (null? (query:callers-of "nobody"))))

; ── Issue #5009 / #5097: one read verb, one write verb ─────────
; (query :op) reads. (mutate :op) writes. The old prefixes are unbound.
; A short op names one primitive. Failures exit 1.

(define fails5009 0)
(define (ok5009 cond name)
  (if cond
      #t
      (begin (set! fails5009 (+ fails5009 1))
             (display "FAIL-5009 ") (display name) (newline))))

(define (raised5009 thunk)
  (eq? (try (thunk) (catch (caught) 'raised-5009)) 'raised-5009))

(set-code "(define (f x) x)")

(ok5009 (integer? (query :generation)) "query :generation reads")
(ok5009 (equal? (query "qr:generation") (query :generation))
        "string op is the query: name")
(ok5009 (integer? (query :memory-used)) "query :memory-used reads")
(ok5009 (integer? (query :memory-limit)) "query :memory-limit reads")
(ok5009 (not (raised5009 (lambda () (query :validate-nodes)))) "query :validate-nodes runs")

(ok5009 (raised5009 (lambda () (ast:generation))) "ast:generation is unbound")
(ok5009 (raised5009 (lambda () (ast:snapshot "nope"))) "ast:snapshot is unbound")
(ok5009 (raised5009 (lambda () (workspace:memory-used))) "workspace:memory-used is unbound")
(ok5009 (raised5009 (lambda () (query "ast:generation"))) "retired string op is not a query")

; Snapshot and restore are writes. A read must not checkpoint or roll back.
(define before5009 (query :code))
(ok5009 (raised5009 (lambda () (query :snapshot))) "query :snapshot is unknown")
(ok5009 (equal? (query :code) before5009) "query :snapshot did not edit the workspace")
(define sid5009 (mutate :snapshot "algebra"))
(ok5009 (integer? sid5009) "mutate :snapshot returns an id")
(mutate :rebind "f" "(lambda (x) (+ x 1))" "bump")
(ok5009 (not (equal? (query :code) before5009)) "rebind changed the code")
(ok5009 (eq? (mutate :restore sid5009) #t) "mutate :restore rolls back")
(ok5009 (equal? (query :code) before5009) "code is the snapshot again")
(ok5009 (raised5009 (lambda () (query :restore sid5009))) "query :restore is unknown")

; The scheduler is not a query or mutate op.
(ok5009 (raised5009 (lambda () (query :spawn))) "query :spawn is not fiber:spawn")
(ok5009 (raised5009 (lambda () (query :yield))) "query :yield is not fiber:yield")
(ok5009 (raised5009 (lambda () (mutate :cancel 1))) "mutate :cancel is not fiber:cancel")

; One short name, one shape. The pair-shaped ref is its own op.
(ok5009 (not (equal? (query :stable-ref 0) (query :stable-ref-pair 0)))
        "query :stable-ref is not the pair shape")
(ok5009 (raised5009 (lambda () (mutate :stable-ref 0)))
        "mutate :stable-ref is not a second shape")

(let ((sid (mutate :snapshot "algebra-diff")))
  (ok5009 (pair? (query :diff sid)) "query :diff is the line-pair read")
  (ok5009 (equal? (query :diff sid) (query "qr:diff" sid)) "query:diff string form")
  (ok5009 (hash? (query :mutation-log-summary)) "mutation-log summary is its own op"))

(define badq (try (query :no-such-op-5009) (catch (caught) caught)))
(ok5009 (and (pair? badq) (equal? (car badq) "bad-arg")) "query rejects unknown op")
(define badm (try (mutate :no-such-op-5009) (catch (caught) caught)))
(ok5009 (and (pair? badm) (equal? (car badm) "bad-arg")) "mutate rejects unknown op")

(if (= fails5009 0)
    (display "OK-5009 one read verb, one write verb\n")
    (exit 1))
