; Issue #4861: scope-join-all failure-policy arguments are validated
; instead of being silently ignored. A negative timeout or restart budget
; is an error. A quoted symbol policy is honoured. A recovered child is
; not a final failure.
(require "std/test" all:)
(test-file "issue_4861_scope_join_fail_args.aura")

(define (caught thunk) (try (thunk) (catch (e) e)))

(test-case "negative timeout is a parameter error" (hash "issue" 4861)
  (orch:scope-spawn "s-neg-timeout" (lambda () 1))
  (check= "orch:scope-join-all: :timeout-ms must not be negative"
          (caught (lambda () (orch:scope-join-all :timeout-ms -5)))))

(test-case "negative restart budget is a parameter error" (hash "issue" 4861)
  (orch:scope-spawn "s-neg-restarts" (lambda () 1))
  (check= "orch:scope-join-all: :max-restarts must not be negative"
          (caught (lambda () (orch:scope-join-all :max-restarts -1)))))

(test-case "a non-name policy is a parameter error" (hash "issue" 4861)
  (orch:scope-spawn "s-bad-policy" (lambda () 1))
  (check= "orch:scope-join-all: :on-join-fail expects a policy name (string or symbol: cancel / restart-n / throttle / report-only)"
          (caught (lambda () (orch:scope-join-all :on-join-fail 42)))))

(test-case "a symbol policy arms cancel" (hash "issue" 4861)
  (orch:scope-spawn "s-symbol-policy" (lambda () (error "bad")))
  (define r-symbol (orch:scope-join-all :timeout-ms 2000 :on-join-fail 'cancel))
  (check= "cancel" (hash-ref r-symbol "on-join-fail-effective")))

(test-case "a string policy arms cancel" (hash "issue" 4861)
  (orch:scope-spawn "s-string-policy" (lambda () (error "bad")))
  (define r-string (orch:scope-join-all :timeout-ms 2000 :on-join-fail "cancel"))
  (check= "cancel" (hash-ref r-string "on-join-fail-effective")))

(test-case "a recovered child is not a final failure" (hash "issue" 4861)
  (define n 0)
  (orch:scope-spawn "flaky" (lambda ()
    (set! n (+ n 1))
    (if (< n 3) (error "attempt failed") 'finally)))
  (define rr (orch:scope-join-all :timeout-ms 5000 :on-join-fail "restart-n" :max-restarts 3))
  (check= #t (hash-ref rr "ok"))
  (check= "ok" (hash-ref rr "status"))
  (check= 0 (hash-ref rr "err-count"))
  (check= 2 (hash-ref rr "attempt-errors"))
  (check= 1 (hash-ref rr "body-ok-count")))

(test-case "restart exhaustion is counted" (hash "issue" 4861)
  (orch:scope-spawn "bad" (lambda () (error "always")))
  (define r-spent (orch:scope-join-all :timeout-ms 3000 :on-join-fail "restart-n" :max-restarts 2))
  (check= 1 (hash-ref r-spent "err-count"))
  (check= 2 (hash-ref r-spent "restart-attempted"))
  (check= 1 (hash-ref r-spent "restart-exhausted")))

(test-finish)
