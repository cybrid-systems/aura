(require "std/test" all:)
(require "std/string" all:)
(require "std/json" all:)
(require "std/math" all:)
(require "std/list" all:)

; Issue #2486: gc-heap clears cells_/string_heap_/pairs_ (full reset).
; Order matters: run gc-temp survival tests FIRST (need cell bindings),
; then gc-heap pure checks at the end (no defines after gc-heap).

; ── 1. gc-stats returns a string ──
(assert (string? (stats:get "gc-stats")))

; ── 2. gc-temp basic ──
(assert (gc-temp))
(gc-temp) (gc-temp)

; ── 3. Function bindings survive gc-temp ──
(define (add1 x) (+ x 1))
(check= 6 (add1 5))
(gc-temp)
(check= 7 (add1 6))
(gc-temp)
(check= 8 (add1 7))

; ── 4. Closure survives gc-temp ──
(define square (lambda (x) (* x x)))
(check= 25 (square 5))
(gc-temp)
(check= 36 (square 6))

; ── 5. set! survives gc-temp ──
(define counter 0)
(set! counter 1)
(gc-temp)
(check= 1 counter)
(set! counter 2)
(check= 2 counter)

; ── 6. String survives gc-temp ──
(define hello "hello world")
(check= 11 (string-length hello))
(gc-temp)
(check= 11 (string-length hello))

; ── 7. gc-temp after intend ──
(define (my-gen g) "(+ 1 2)")
(define (my-ver c) "#t")
(intend "gc-test" my-gen my-ver 1)
(gc-temp)
(assert (string? (stats:get "gc-stats")))
(check= 3 (+ 1 2))

; ── 8. gc-temp under stress ──
(define (mod-fn x) (* x 3))
(gc-temp) (gc-temp) (gc-temp)
(check= 15 (mod-fn 5))

; ── 9. gc-temp in loop ──
(define k 0)
(while (lambda () (< k 20))
  (lambda ()
    (gc-temp)
    (check= (+ 2 2) 4)
    (set! k (+ k 1))))
(check= 20 k)

; ── 10. Multiple intends with gc-temp between ──
(define (gen-simple g) "(display 1)")
(define (ver-simple c) "#t")
(intend "a" gen-simple ver-simple 1) (gc-temp)
(intend "b" gen-simple ver-simple 1) (gc-temp)
(intend "c" gen-simple ver-simple 1) (gc-temp)
(check= 3 (+ 1 2))

; ── 11. gc-temp preserves closures after gc-freeze ──
(gc-freeze)
(define (persistent-closure x) (* x x))
(intend "freeze" (lambda (g) "(display 1)") (lambda (c) "#t") 1)
(gc-temp)
(check= 25 (persistent-closure 5))
(gc-temp)
(check= 36 (persistent-closure 6))

; ── 12. require after gc-temp ──
(gc-temp)
(require "std/math" all:)
(check= 20 (+ 10 10))

; ════════════════════════════════════════════════════════
; Full reset tests — gc-heap last (no further defines)
; ════════════════════════════════════════════════════════

; ── 13. gc-heap cleanly runs ──
(assert (gc-heap))

; ── 14. Pure arithmetic after gc-heap ──
(check= 3 (+ 1 2))
(gc-heap)
(check= 42 (* 6 7))

; ── 15. set-code / eval-current after gc-heap ──
(gc-heap)
(set-code "(+ 100 200)")
(check= 300 (eval-current))

; ── 16. json-parse after gc-heap ──
(gc-heap)
(assert (json-parse "{\"x\":1}"))

; ── 17. gc-heap idempotent ──
(gc-heap) (gc-heap) (gc-heap)
(assert (string? (stats:get "gc-stats")))

; ── 18. gc-freeze + gc-heap ──
(gc-freeze)
(gc-heap)
(gc-freeze)

; ── 19. Mixed ending sequence ──
(gc-temp)
(gc-heap)
(json-parse "{\"y\":2}")
(set-code "(+ 1 2)")
(check= 3 (eval-current))
(check= 99 99)
