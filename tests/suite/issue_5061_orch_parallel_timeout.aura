; #5061: orch:parallel's timeout must interrupt a worker that only yields.
; The old join order blocked on the worker, so the timer fiber never ran.
; The windows below are the original bounds, not a speedup ratio:
; the yielding call returns after 500ms and before 4000ms, and a finished
; call returns before 1500ms.
(require "std/test" all:)
(require "std/orch" all:)
(test-file "issue_5061_orch_parallel_timeout.aura")

(define (hang x)
  (let loop ((i 0))
    (fiber:yield)
    (loop (+ i 1))))

(test-case "a yielding worker times out" (hash "issue" 5061)
  (define t0 (monotonic-ms))
  (define hung (orch:parallel (list hang) 0 1))
  (define dt (- (monotonic-ms) t0))
  (check (pair? hung))
  (check (not (car hung)))
  (check (and (> dt 500) (< dt 4000))))

(test-case "finished workers keep spawn order" (hash "issue" 5061)
  (define t1 (monotonic-ms))
  (define fast (orch:parallel (list (lambda (x) (+ x 1))
                                    (lambda (x) (+ x 2)))
                              5 2))
  (define fast-dt (- (monotonic-ms) t1))
  (check= (list 6 7) fast)
  (check (< fast-dt 1500)))

(test-case "a fast sibling is kept when another worker times out" (hash "issue" 5061)
  (check= (list 4 #f) (orch:parallel (list (lambda (x) (+ x 3)) hang) 1 1)))

(test-case "a raised worker does not drop its sibling" (hash "issue" 5061)
  (define errs (orch:parallel (list (lambda (x) (error "boom"))
                                    (lambda (x) (+ x 1)))
                              5))
  (check (pair? errs))
  (check= 'error (car errs))
  (check= 6 (car (cdr errs))))

(test-finish)
