; Issue #4802 — std/kir-gpu: CUDA C / PTX / Triton lowering of the kernel IR
; Toolchain checks run only when the tool is present (skipped otherwise):
;   ptxas (or $AURA_PTXAS)      validates the emitted PTX and the clang-compiled CUDA
;   clang++ with nvptx64        compiles the CUDA C device-only (-nocudainc shim)
;   python3                     parses the Triton module (ast)
;   $AURA_KIR_GPU_OUT=<dir>     keeps the artifacts (k.cu / k.ptx / k.py / run_triton.py)
(require "std/kir" all:)
(require "std/kir-gpu" all:)
(require "std/process" all:)
(define *n* 0)
(define *fails* 0)
(define *skips* 0)
(define (check! pred msg)
  (set! *n* (+ *n* 1))
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))
(define (skip! msg) (set! *skips* (+ *skips* 1)) (display "  skip: ") (display msg) (newline))
(define (string-has? s sub)
  (let loop ((i 0))
    (cond ((> (+ i (string-length sub)) (string-length s)) #f)
          ((equal? (substring s i (+ i (string-length sub))) sub) #t)
          (else (loop (+ i 1))))))
(define (has-err? errs sub)
  (cond ((null? errs) #f) ((string-has? (car errs) sub) #t) (else (has-err? (cdr errs) sub))))
(define (err-text thunk) (try (begin (thunk) "no-error") (catch (e) (format "~a" e))))

(define m
  '(module gk
     (func sq f32 (params (v f32)) (return (* v v)))
     (func pos bool (params (v f32)) (return (> v (f32 0))))
     (kernel saxpy (params (a f32) (x (ptr f32) :in) (y (ptr f32) :inout) (n i64))
       (pfor (i 0 n) (set (ref y i) (+ (* a (ref x i)) (ref y i)))))
     (kernel nrm (params (x (ptr f32) :in) (o (ptr f32) :out) (n i32))
       (let lim f32 (f32 10))
       (pfor (i 0 n)
         (let v f32 (ref x i))
         (if (call pos v) (set (ref o i) (fmin lim (sqrt (call sq v)))) (set (ref o i) (exp v)))
         (when (and (> i 0) (< (ref x (- i 1)) v)) (+= (ref o i) (f32 0.5)))))
     (kernel rowsum (params (x (ptr f64) :in) (o (ptr f64) :out) (rows i64) (cols i64))
       (pfor (r 0 rows)
         (let acc f64 0.0)
         (for (c 0 cols) (when (> (ref x (+ (* r cols) c)) 0.0) (+= acc (ref x (+ (* r cols) c)))))
         (set (ref o r) (? (> acc 100.0) 100.0 acc))))
     (kernel flags (params (x (ptr i32) :in) (b (ptr bool) :out) (n i32) (t i32))
       (pfor (i 0 n) (set (ref b i) (or (> (ref x i) t) (== (% (ref x i) 2) 0)))))))

; ---- GPU contracts ------------------------------------------------------------
(check! (null? (kir-gpu-check 'cuda m)) "module passes the CUDA contract")
(check! (null? (kir-gpu-check 'ptx m)) "module passes the PTX contract")
(check! (null? (kir-gpu-check 'triton m)) "module passes the Triton contract")
(check! (has-err? (kir-gpu-check 'cuda '(kernel k (params (o (ptr f32) :out) (n i64)) (set (ref o 0) (f32 1))))
                  "needs one top-level pfor") "kernel without pfor is rejected")
(check! (has-err? (kir-gpu-check 'cuda '(kernel k (params (o (ptr f32) :out) (n i64))
                                          (pfor (i 0 n) (set (ref o i) (f32 1))) (set (ref o 0) (f32 2))))
                  "statement after pfor") "nothing may follow pfor")
(check! (has-err? (kir-gpu-check 'ptx '(kernel k (params (o (ptr f32) :out) (n i64))
                                         (set (ref o 0) (f32 2)) (pfor (i 0 n) (set (ref o i) (f32 1)))))
                  "only let / scalar set may precede pfor") "stores before pfor are rejected (every thread runs them)")
(check! (has-err? (kir-gpu-check 'ptx '(kernel k (params (x (ptr f64) :in) (o (ptr f64) :out) (n i64))
                                         (pfor (i 0 n) (set (ref o i) (exp (ref x i))))))
                  "exp on f64 has no PTX instruction") "PTX reports f64 exp instead of miscompiling")
(check! (null? (kir-gpu-check 'cuda '(kernel k (params (x (ptr f64) :in) (o (ptr f64) :out) (n i64))
                                       (pfor (i 0 n) (set (ref o i) (exp (ref x i)))))))
        "CUDA accepts f64 exp")
(check! (has-err? (kir-gpu-check 'triton '(kernel k (params (x (ptr i64) :in) (o (ptr i64) :out) (n i64))
                                            (pfor (i 0 n) (let s i64 0) (for (j 0 (ref x i)) (+= s j)) (set (ref o i) s))))
                  "is not uniform across the block") "Triton rejects per-element loop bounds")
(check! (has-err? (kir-gpu-check 'triton '(kernel k (params (o (ptr f32) :out) (n i64))
                                            (pfor (i 0 n) (when (> i 3) (return)) (set (ref o i) (f32 1)))))
                  "return inside pfor") "Triton rejects return inside pfor")
(check! (has-err? (kir-gpu-check 'triton '(module mt (func g f32 (params (p (ptr f32) :in)) (return (ref p 0)))
                                             (kernel k (params (x (ptr f32) :in) (o (ptr f32) :out) (n i64))
                                               (pfor (i 0 n) (set (ref o i) (call g x))))))
                  "uses ref") "Triton helpers may not dereference pointers")
(check! (string-has? (err-text (lambda () (kir->ptx '(kernel k (params (n i64)) (let a f32 (f32 1)))))) "kir-gpu-check failed")
        "lowering refuses contract violations")

; ---- CUDA C -------------------------------------------------------------------
(define cu (kir->cuda-unit m))
(check! (string-has? cu "extern \"C\" __global__ void saxpy(float a, const float* __restrict__ x, float* __restrict__ y, int64_t n)")
        "kernel -> extern C __global__ with __restrict__")
(check! (string-has? cu "int64_t i = (0 + (((int64_t)(blockIdx.x)) * ((int64_t)(blockDim.x))) + ((int64_t)(threadIdx.x)));")
        "pfor -> global thread index")
(check! (string-has? cu "if ((i < n)) {") "pfor bound guard")
(check! (string-has? cu "extern \"C\" __device__ float sq(float v);") "funcs -> __device__ with prototypes")
(check! (string-has? (kir->cuda (kir-find m 'saxpy)) "__global__ void saxpy") "single-kernel kir->cuda")

; ---- PTX ----------------------------------------------------------------------
(define ptx (kir->ptx m))
(check! (string-has? ptx ".version 7.0\n.target sm_80\n.address_size 64") "PTX header")
(check! (string-has? (kir->ptx m 'sm_90) ".target sm_90") "PTX arch parameter")
(check! (string-has? ptx ".visible .entry saxpy(") "kernel -> .entry")
(check! (string-has? ptx "cvta.to.global.u64 %v_x, %rd1;") "pointer params converted to global")
(check! (string-has? ptx "mul.wide.u32") "64-bit global index")
(check! (string-has? ptx "mad.lo.s32") "32-bit global index")
(check! (string-has? ptx "call.uni (retval0), sq, (param0);") "func call through .param")
(check! (string-has? ptx "ex2.approx.f32") "f32 exp via ex2")
(check! (string-has? ptx "@!%p") "branches on predicates")

; ---- Triton -------------------------------------------------------------------
(define py (kir->triton m))
(check! (string-has? py "@triton.jit\ndef saxpy(a, x, y, n, KIR_BLOCK: tl.constexpr):") "kernel -> @triton.jit with KIR_BLOCK")
(check! (string-has? py "i = 0 + _pid.to(tl.int64) * KIR_BLOCK + tl.arange(0, KIR_BLOCK)") "pfor -> program_id * BLOCK + arange")
(check! (string-has? py "tl.store(y + (i), ((a * tl.load(x + (i), mask=_mask, other=0)) + tl.load(y + (i), mask=_mask, other=0)), mask=_mask)")
        "masked loads and stores")
(check! (string-has? py "mask=(_mask & (_c1 == 0))") "divergent if -> masked else branch")
(check! (string-has? py "acc = tl.where(_c3, (acc + ") "divergent local update -> tl.where")
(check! (string-has? py "tl.load(x + ((i - 1)), mask=(_mask & (i > 0)), other=0)") "and guards the right operand's load")
(check! (string-has? py "for c in range(0, cols):") "uniform loop -> range")
(check! (string-has? py "def launch_rowsum(x, o, rows, cols, block=256):") "host launcher")

; ---- toolchains (optional) ----------------------------------------------------
(define dir (let ((d (getenv "AURA_KIR_GPU_OUT")))
              (if (and d (> (string-length d) 0)) d
                  (string-append "/tmp/kir-gpu-4802-" (number->string (current-time-ms))))))
(define keep? (let ((d (getenv "AURA_KIR_GPU_OUT"))) (and d (> (string-length d) 0))))
(shell (string-append "mkdir -p " dir))
(write-file (string-append dir "/k.cu") cu)
(write-file (string-append dir "/k.ptx") ptx)
(write-file (string-append dir "/k.py") py)
(define ptxas (let ((e (getenv "AURA_PTXAS")))
                (cond ((and e (> (string-length e) 0)) e)
                      ((= 0 (shell "command -v ptxas >/dev/null 2>&1")) "ptxas")
                      (else #f))))
(if ptxas
    (check! (= 0 (shell (string-append ptxas " -arch=sm_80 -o " dir "/k.cubin " dir "/k.ptx")))
            "ptxas accepts the emitted PTX")
    (skip! "ptxas not found (set AURA_PTXAS)"))
(define clang-nvptx? (= 0 (shell "clang++ --print-targets 2>/dev/null | grep -q nvptx64")))
(if clang-nvptx?
    (begin
      (check! (= 0 (shell (string-append "clang++ -x cuda --cuda-device-only --cuda-gpu-arch=sm_80 -nocudainc -nocudalib"
                                         " -DAURA_KIR_NOCUDAINC -O2 -Wall -Werror -S -o " dir "/k.clang.ptx " dir "/k.cu")))
              "CUDA C compiles device-only with clang (-Wall -Werror)")
      (if ptxas
          (check! (= 0 (shell (string-append ptxas " -arch=sm_80 -o " dir "/k2.cubin " dir "/k.clang.ptx")))
                  "clang's PTX for the CUDA C assembles")
          (skip! "ptxas not found for the clang PTX")))
    (skip! "clang++ without nvptx64"))
(if (= 0 (shell "command -v python3 >/dev/null 2>&1"))
    (check! (= 0 (shell (string-append "python3 -c \"import ast,sys; ast.parse(open(sys.argv[1]).read())\" " dir "/k.py")))
            "Triton module is valid Python")
    (skip! "python3 not found"))
(write-file (string-append dir "/run_triton.py") "import os, sys
os.environ['TRITON_INTERPRET'] = '1'
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import torch, k
x = torch.tensor([1., 4., -1., 9., 16.]); y = torch.ones(5)
k.launch_saxpy(2.0, x, y, 5, block=4)
o = torch.zeros(5); k.launch_nrm(x, o, 5, block=2)
z = torch.tensor([1., -9., 2., 70., 3., 80.], dtype=torch.float64); zo = torch.zeros(2, dtype=torch.float64)
k.launch_rowsum(z, zo, 2, 3, block=4)
xi = torch.tensor([1, 2, 7, 3], dtype=torch.int32); b = torch.zeros(4, dtype=torch.int32)
k.launch_flags(xi, b, 4, 5, block=4)
print(' '.join('%g' % v for v in y.tolist() + [round(v, 4) for v in o.tolist()] + zo.tolist() + b.tolist()))
")
(define expect "3 9 -1 19 33 1 4.5 0.3679 9.5 10.5 3 100 0 1 1 0")
(if (= 0 (shell "python3 -c 'import triton, torch' >/dev/null 2>&1"))
    (check! (equal? (command-output (string-append "python3 " dir "/run_triton.py 2>/dev/null")) expect)
            "Triton kernels compute the right values (TRITON_INTERPRET=1)")
    (skip! (string-append "triton/torch not importable; run " dir "/run_triton.py, expect: " expect)))
(if (not keep?) (shell (string-append "rm -rf " dir)))

(if (= *fails* 0)
    (begin (display "OK-kir-gpu-4802 ") (display *n*) (display " checks, ") (display *skips*) (display " skipped") (newline))
    (begin (display "kir-gpu-4802: ") (display (- *n* *fails*)) (display "/") (display *n*) (newline) (exit 1)))
