; Issue #2920: workspace source follows mutate. FlatAST is authoritative.
; Post-mutate text readers must not see the pre-mutate set-code string.
; (current-source :workspace) unparses the live AST. Snapshot restore
; restamps that text.
(require "std/test" all:)
(test-file "workspace_source_ssot_2920.aura")

(test-case "set-code changes workspace source" (hash "issue" 2920)
  (set-code "(define ssot-2920-a 1)")
  (define s0 (current-source :workspace))
  (set-code "(define ssot-2920-b 2)")
  (check (not (equal? s0 (current-source :workspace)))))

(test-case "restore restamps the workspace unparse" (hash "issue" 2920)
  (set-code "(define ssot-fn (lambda (x) x))")
  (define before (current-source :workspace))
  (set-code "(define ssot-fn (lambda (x) (+ x 1)))")
  (define after (current-source :workspace))
  (check (not (equal? before after)))
  (define sid (mutate :snapshot "ssot-2920"))
  (set-code "(define other 0)")
  (check (mutate :restore sid))
  (check= after (current-source :workspace)))

;; Issue #5315: unparsable set-code is a catchable diagnostic that names the
;; set-code buffer. It installs nothing and leaves the previous workspace.
(test-case "unparsable set-code errors and keeps the previous workspace" (hash "issue" 5315)
  (set-code "(define (kept5315) 7)")
  (eval-current)
  (define before (current-source :workspace))
  (define r (try (begin (set-code "(define (probe-x) 1)\n(define (probe-y 2))\n") "installed")
                 (catch (e) (if (string? e) e "not-string"))))
  (check (string? r))
  (check (not (string=? r "installed")))
  (check (>= (string-index r "parse-error:" 0) 0))
  (check (>= (string-index r "workspace.aura:" 0) 0))
  (check (>= (string-index r "parse error:" 0) 0))
  (check (>= (string-index r "unexpected" 0) 0))
  (check (< (string-index r "workspace_source_ssot" 0) 0))
  (check (equal? before (current-source :workspace)))
  (check (< (string-index (current-source :workspace) "probe-x" 0) 0))
  (check (= (try (eval "(if (procedure? probe-x) 1 0)") (catch (e) 99)) 99))
  (check (= (kept5315) 7))
  (define again (try (eval-current) (catch (e) (if (string? e) e "not-string"))))
  (check (string? again))
  (check (>= (string-index again "workspace.aura:" 0) 0))
  (check (= (try (eval "(if (procedure? probe-x) 1 0)") (catch (e) 99)) 99))
  (check (= (kept5315) 7))
  (eval-current)
  (check (= (kept5315) 7))
  (check (eq? (set-code "(define (kept5315) 8)") #t))
  (eval-current)
  (check (= (kept5315) 8)))

(test-finish)
