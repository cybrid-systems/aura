; Issue #2920: workspace source follows mutate. FlatAST is authoritative.
; Post-mutate text readers must not see the pre-mutate set-code string.
; (current-source :workspace) unparses the live AST. Snapshot restore
; restamps that text.
(require "std/test" all:)
(test-file "workspace_source_ssot_2920.aura")

(test-case "set-code changes workspace source" (hash "issue" 2920)
  (set-code "(define ssot-2920-a 1)")
  (define s0 (current-source :workspace))
  (set-code "(define ssot-2920-b 2)")
  (check (not (equal? s0 (current-source :workspace)))))

(test-case "restore restamps the workspace unparse" (hash "issue" 2920)
  (set-code "(define ssot-fn (lambda (x) x))")
  (define before (current-source :workspace))
  (set-code "(define ssot-fn (lambda (x) (+ x 1)))")
  (define after (current-source :workspace))
  (check (not (equal? before after)))
  (define sid (mutate :snapshot "ssot-2920"))
  (set-code "(define other 0)")
  (check (mutate :restore sid))
  (check= after (current-source :workspace)))

(test-finish)
