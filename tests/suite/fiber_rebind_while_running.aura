; Fibers keep calling a hot workspace policy while another fiber rebinds
; it. Callers must see a valid binding (old or new, never an error), and
; the final binding after the joins.
(require "std/test" all:)
(require "std/mutate" all:)
(test-file "fiber_rebind_while_running.aura")

(test-case "rebind while fibers are calling" (hash)
  (set-code "(define pol-0 (lambda () 0))")
  (eval-current)
  (define errs 0)
  (define (caller k)
    (let l ((t 0) (s 0))
      (if (< t k)
          (begin
            (fiber:yield)
            (l (+ t 1)
               (+ s (try (pol-0)
                         (catch (e) (begin (set! errs (+ errs 1)) 0))))))
          s)))
  (define (rebinder k)
    (let l ((t 1))
      (if (< t k)
          (begin
            (mutate :rebind "pol-0"
                    (string-append "(lambda () " (number->string t) ")")
                    "rb")
            (eval-current)
            (fiber:yield)
            (l (+ t 1)))
          t)))
  (define cs (list (fiber:spawn (lambda () (caller 200)))
                   (fiber:spawn (lambda () (caller 200)))))
  (define rj (fiber:join (fiber:spawn (lambda () (rebinder 40)))))
  (define sums (map fiber:join cs))
  (check= 0 errs)
  (check= 40 rj)
  (check= 39 (pol-0))
  (check= 2 (length (filter number? sums))))

(test-finish)
