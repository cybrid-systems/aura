; Issue #5197: a nested require must not drop exports the parent
; recorded before it. inner requires std/list and exports z. mid
; exports m1, requires inner, then exports m2. Both stay bound.
(require "std/test" all:)
(require "./export_set_nested/before/mid" all:)
(test-file "export_set_nested_require.aura")

(define (value thunk)
  (try (thunk) (catch (e) 'unbound-5197)))

(test-case "nested require keeps earlier exports" (hash "issue" 5197)
  (check= 1 (value (lambda () m1)))
  (check= 2 (value (lambda () m2))))

(test-finish)
