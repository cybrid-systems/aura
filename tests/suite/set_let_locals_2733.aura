; Issue #2733 — set! on let locals + top-level defines survive set-code
(require "std/mutate" all:)

(define *fails* 0)
(define (assert! pred msg)
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin
        (set! *fails* (+ *fails* 1))
        (display "  FAIL: ")
        (display msg)
        (newline))))

(display "set! on let locals\n")
(define (f)
  (let ((x 0))
    (set! x (+ x 1))
    x))
(assert! (= (f) 1) "simple let set!")

(define (soak rounds)
  (let ((okc 0)
        (i 0))
    (while (lambda () (< i rounds))
      (lambda ()
        (set! okc (+ okc 1))
        (set! i (+ i 1))))
    okc))
(assert! (= (soak 5) 5) "while let set!")

;; Issue #5342 follow-up: set! on a PARAMETER must be visible to every
;; later read in the body, including a while condition read from a child
;; flat. The #4599 SymId mirror used to keep the pre-set! value, so a
;; parameter-driven while loop spun forever (walk-5000 JIT timeouts).
(display "param set! stays live\n")
(define (bump-param x)
  (set! x (+ x 1))
  x)
(assert! (= (bump-param 1) 2) "parameter set! visible after the write")

(define (drain ys)
  (let ((n 0))
    (while (pair? ys)
      (set! n (+ n 1))
      (set! ys (cdr ys)))
    n))
(assert! (= (drain (list 1 2 3)) 3) "parameter set! drives a while condition")

(display "top-level define after set-code\n")
(define ROUNDS 16)
(define SAMPLE-ARG 7)
(set-code "(define (g x) (+ x 42)) (define (h x) (g (g x)))")
(eval-current)
(assert! (= ROUNDS 16) "ROUNDS stable")
(assert! (= SAMPLE-ARG 7) "SAMPLE-ARG stable")
(assert! (= (h SAMPLE-ARG) 91) "h uses SAMPLE-ARG")
(assert! (= (soak ROUNDS) 16) "soak after set-code")

(display "outer define set! + while after set-code\n")
(define okc 0)
(define i 0)
(set-code "(define (id x) x)")
(eval-current)
(while (lambda () (< i 5))
  (lambda ()
    (set! okc (+ okc 1))
    (set! i (+ i 1))))
(assert! (= okc 5) "outer okc")
(assert! (= i 5) "outer i")

(if (= *fails* 0)
    (begin (display "OK-2733 set! let + top-level defines\n"))
    (begin
      (display "FAIL-2733 fails=")
      (display *fails*)
      (newline)
      (exit 1)))
