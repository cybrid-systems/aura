; Issues #4802 / #4803 — std/cgen C EDSL + content-addressed build cache (first step)
(require "std/cgen" all:)
(define *n* 0)
(define *fails* 0)
(define (check! pred msg)
  (set! *n* (+ *n* 1))
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))
(define (string-has? s sub)
  (let loop ((i 0))
    (cond ((> (+ i (string-length sub)) (string-length s)) #f)
          ((equal? (substring s i (+ i (string-length sub))) sub) #t)
          (else (loop (+ i 1))))))
(define (err-text thunk)
  (try (begin (thunk) "no-error") (catch (e) (format "~a" e))))

(define axpy (cgen-fn "void" 'axpy '(("float" a) ("const float*" x) ("float*" y) ("long" n))
  '((for (i 0 n) (+= (ref y i) (* a (ref x i)))))))
(check! (string-has? axpy "void axpy(float a, const float* x, float* y, long n) {") "function signature")
(check! (string-has? axpy "for (long i = 0; i < n; i++) {") "for loop")
(check! (string-has? axpy "y[i] += (a * x[i]);") "compound assign + array ref")
(check! (equal? (cgen-expr '(? (< i n) (- x) (f32 1.5))) "((i < n) ? (-x) : 1.5f)") "ternary, unary minus, f32")
(check! (equal? (cgen-expr '(call fmaxf (cast "float" k) 0)) "fmaxf(((float)(k)), 0)") "call + cast")
(check! (equal? (cgen-stmt '(decl "int" t (% k 4))) "int t = (k % 4);\n") "decl with init")
(check! (equal? (cgen-stmt '(for (j 0 m 4) (set (ref o j) 0)))
                "for (long j = 0; j < m; j += 4) {\n    o[j] = 0;\n}\n") "strided for")
(check! (string-has? (cgen-stmt '(if (== k 0) (return 1) (return 2))) "} else {") "if/else")
(check! (string-has? (cgen-unit '("stddef.h") (list axpy)) "#include <stddef.h>\n\nvoid axpy") "unit with includes")
(check! (string-has? (err-text (lambda () (cgen-expr '(bogus 1)))) "unknown form") "unknown forms are rejected")
; #4803 content-addressed cache
(check! (equal? (cgen-digest axpy) (cgen-digest (string-append axpy ""))) "digest is stable")
(check! (not (equal? (cgen-digest "ab") (cgen-digest "ba"))) "digest is order-sensitive")
(cgen-cache-clear!)
(define builds 0)
(define (fake-build text) (set! builds (+ builds 1)) (string-length text))
(define r1 (cgen-build-cached! axpy fake-build))
(define r2 (cgen-build-cached! axpy fake-build))
(cgen-build-cached! "int f(void) { return 0; }\n" fake-build)
(check! (and (equal? r1 r2) (= builds 2)) "unchanged text is not rebuilt")
(check! (equal? (cgen-cache-stats) '(1 2)) "cache stats (hits misses)")

(if (= *fails* 0)
    (begin (display "OK-cgen-4802 ") (display *n*) (display " checks") (newline))
    (begin (display "cgen-4802: ") (display (- *n* *fails*))
           (display "/") (display *n*) (newline) (exit 1)))
