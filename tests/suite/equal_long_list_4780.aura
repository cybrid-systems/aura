;; expect: equal-long-list-ok
;; Issue #4780: equal? answered #t for any two lists that shared their first
;; 64 elements. StructuralEqual bumped depth along the cdr spine too and its
;; cap returned true past depth 64. The spine is now walked iteratively at a
;; constant depth; only car / vector-element descent nests, and a walk that
;; gives up (nesting > cap, cyclic spine) raises instead of answering.
(define fails 0)
(define (chk name got want)
  (if (not (eq? got want))
      (begin (set! fails (+ fails 1))
             (display "FAIL ") (display name) (display " got=") (display got) (newline))))
(define (range n) (let loop ((i (- n 1)) (acc (list))) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(chk "64-vs-65" (equal? (range 64) (range 65)) #f)
(chk "65-vs-66" (equal? (range 65) (range 66)) #f)
(chk "66-vs-65" (equal? (range 66) (range 65)) #f)
(chk "70th-differs" (equal? (range 100) (map (lambda (i) (if (= i 70) -1 i)) (range 100))) #f)
(chk "last-differs" (equal? (range 2000) (map (lambda (i) (if (= i 1999) -1 i)) (range 2000))) #f)
(chk "long-equal" (equal? (range 5000) (range 5000)) #t)
(chk "vec" (equal? (list->vector (range 300)) (list->vector (range 301))) #f)
;; nested lists: 200 levels of car nesting
(define (nest n leaf) (if (= n 0) leaf (list (nest (- n 1) leaf))))
(chk "nest-200-eq" (equal? (nest 200 1) (nest 200 1)) #t)
(chk "nest-200-ne" (equal? (nest 200 1) (nest 200 2)) #f)
;; lists of long lists
(chk "list-of-long" (equal? (list (range 80) (range 80)) (list (range 80) (range 79))) #f)
(chk "list-of-long-eq" (equal? (list (range 80) (range 80)) (list (range 80) (range 80))) #t)
;; member shares the comparison (#4628)
(chk "member-long" (if (member (range 70) (list (range 69) (range 71))) #t #f) #f)
(chk "member-long-hit" (if (member (range 70) (list (range 69) (range 70))) #t #f) #t)
;; 2000 mailbox-style check from the report: 256 received vs 2000 expected
(chk "prefix-256-vs-2000" (equal? (range 256) (range 2000)) #f)
;; hash-table list keys share the spine walk (eval_hash_keys_eq)
(define hk (make-hash))
(hash-set! hk (range 100) "v")
(chk "hash-long-key-hit" (hash-ref hk (range 100) "miss") "v")
(chk "hash-long-key-miss" (hash-ref hk (range 101) "miss") "miss")
;; nesting past the cap is an error, never a silent #t
(chk "nest-over-cap-errors" (try (begin (equal? (nest 1100 1) (nest 1100 1)) "no-error") (catch (e) "error")) "error")
(if (= fails 0)
    (begin (display "equal-long-list-ok") (newline))
    (begin (display "equal-long-list-fails=") (display fails) (newline) (exit 1)))
