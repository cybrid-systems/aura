; Issue #5193: (require "std/bench" all:) must bind every public name.
; task-count, all-tasks, run-rounds, and aggregate used to be dropped
; because their export form sat before a nested require chain.
(require "std/test" all:)
(require "std/bench" all:)
(test-file "bench_exports.aura")

(define (bound thunk)
  (try (thunk) (catch (e) 'unbound-5193)))

(test-case "task count matches the task list" (hash "issue" 5193)
  (define tc (bound (lambda () (task-count))))
  (define tasks (bound (lambda () all-tasks)))
  (check (integer? tc))
  (check (>= tc 0))
  (check (list? tasks))
  (check= tc (length tasks))
  (check (> tc 0)))

(test-case "public runners are bound" (hash "issue" 5193)
  (check (procedure? (bound (lambda () run-rounds))))
  (check (procedure? (bound (lambda () aggregate))))
  (check (procedure? (bound (lambda () print-report))))
  (check (procedure? (bound (lambda () run-one))))
  (check (procedure? (bound (lambda () run-parallel))))
  (check (procedure? (bound (lambda () bench:list-sort))))
  (check (procedure? (bound (lambda () bench:foldl-sum)))))

(test-case "list-sort of four" (hash "issue" 5193)
  (define sort-r (bound (lambda () (bench:list-sort 4))))
  (check (list? sort-r))
  (check= 3 (length sort-r))
  (check= 'ok (car sort-r))
  (check= 4 (list-ref sort-r 2)))

(test-case "foldl-sum of four" (hash "issue" 5193)
  (define sum-r (bound (lambda () (bench:foldl-sum 4))))
  (check (list? sum-r))
  (check= 3 (length sum-r))
  (check= 'ok (car sum-r))
  (check= 6 (list-ref sum-r 2)))

(test-finish)
