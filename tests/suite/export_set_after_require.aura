; Issue #5197: the same mid module with (export m1) moved to after
; the require. This already bound both names. It must keep doing so.
(require "std/test" all:)
(require "./export_set_nested/after/mid" all:)
(test-file "export_set_after_require.aura")

(define (value thunk)
  (try (thunk) (catch (e) 'unbound-5197)))

(test-case "export after require stays bound" (hash "issue" 5197)
  (check= 1 (value (lambda () m1)))
  (check= 2 (value (lambda () m2))))

(test-finish)
