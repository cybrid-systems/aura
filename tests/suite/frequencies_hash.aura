; Issue #5188: std/hash frequencies and std/iter frequencies are one
; hash-shaped function. The Restricted preset matrix stays in
; tests/python/test_frequencies_restricted.py.
(require "std/test" all:)
(require "std/list" all:)
(test-file "frequencies_hash.aura")

(test-case "frequencies from hash" (hash "issue" 5188)
  (require "std/hash" all:)
  (define honly (frequencies (list "a" "b" "a")))
  (test-check (hash? honly))
  (test-check (not (pair? honly)))
  (test-check= 2 (hash-length honly))
  (test-check= 2 (hash-ref honly "a" 0))
  (test-check= 1 (hash-ref honly "b" 0)))

(test-case "frequencies after iter" (hash "issue" 5188)
  (require "std/iter" all:)
  (define both (frequencies (list "a" "b" "a")))
  (test-check (hash? both))
  (test-check (not (pair? both)))
  (test-check= 2 (hash-length both))
  (test-check= 2 (hash-ref both "a" 0))
  (test-check= 1 (hash-ref both "b" 0))
  (test-check (pair? (frequencies-alist (list "a" "a")))))

(test-case "hash-set is copy-on-write" (hash "issue" 5188)
  (define src (hash "a" 1))
  (define grown (hash-set src "b" 2))
  (test-check= 1 (hash-length src))
  (test-check= 2 (hash-length grown))
  (define from-alist (alist->hash (list (cons "a" 2) (cons "b" 1))))
  (test-check= 2 (hash-ref from-alist "a" 0)))

(test-finish)
