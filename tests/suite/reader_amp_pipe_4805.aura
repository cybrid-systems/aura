; Issue #4805 — reader: `&&` is an ordinary symbol, |...| quotes symbols (R7RS)
(define *n* 0)
(define *fails* 0)
(define (check! pred msg)
  (set! *n* (+ *n* 1))
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))

(define amp (quote (a && b)))
(check! (= (length amp) 3) "(a && b) has three elements")
(check! (symbol? (cadr amp)) "&& is a symbol")
(check! (equal? (symbol->string (cadr amp)) "&&") "&& keeps its name")
(check! (eq? (cadr amp) (quote &&)) "&& is interned")
(check! (equal? (symbol->string (quote &&&)) "&&&") "&&& is a symbol too")
(define && 7)
(check! (= && 7) "&& can be bound as a variable")

(define pipes (quote (x || y)))
(check! (= (length pipes) 3) "(x || y) has three elements")
(check! (symbol? (cadr pipes)) "|| is a symbol")
(check! (equal? (symbol->string (cadr pipes)) "") "|| is the empty symbol")
(check! (equal? (symbol->string (quote |hello world|)) "hello world") "|...| quotes spaces")
(check! (equal? (symbol->string (quote |a\|b|)) "a|b") "\\| escapes a bar")
(check! (eq? (quote |abc|) (quote abc)) "|abc| is the same symbol as abc")
(check! (equal? (symbol->string (quote |(x)|)) "(x)") "parens inside bars are part of the name")
(define |my var| 41)
(check! (= (+ |my var| 1) 42) "|...| names can be bound")

; text after a bar symbol still parses (the whole file used to fail)
(define after-pipes (+ 1 2))
(check! (= after-pipes 3) "forms after || still evaluate")

(if (= *fails* 0)
    (begin (display "OK-reader-4805 ") (display *n*) (display " checks") (newline))
    (begin (display "reader-4805: ") (display (- *n* *fails*)) (display "/") (display *n*) (newline) (exit 1)))
