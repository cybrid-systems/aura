; Issue #4822 — orch:agent-join must report an agent body that failed on its
; own (error / car on a non-pair / raise) as ok #f, status "error", with an
; "error" message key; a clean body stays ok #t / status "ok".
(define *fails4822* 0)
(define (check4822 pred msg)
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails4822* (+ *fails4822* 1)) (display "  FAIL: ") (display msg) (newline))))
(define (failed4822? name)
  (let ((j (orch:agent-join name :timeout-ms 3000)))
    (and (not (hash-ref j "ok"))
         (equal? (hash-ref j "status") "error")
         (string? (hash-ref j "error")))))
(orch:spawn-agent "e1-4822" (lambda () (error "agent crashed")))
(check4822 (failed4822? "e1-4822") "error body -> ok #f / error")
(orch:spawn-agent "e2-4822" (lambda () (car 1)))
(check4822 (failed4822? "e2-4822") "car on non-pair -> ok #f / error")
(orch:spawn-agent "e3-4822" (lambda () (raise 'boom)))
(check4822 (failed4822? "e3-4822") "raise -> ok #f / error")
(orch:spawn-agent "e4-4822" (lambda () (error "agent crashed")))
(check4822 (let ((e (hash-ref (orch:agent-join "e4-4822" :timeout-ms 3000) "error")))
             (and (string? e) (string-contains? e "agent crashed")))
           "error key carries the raised message")
(orch:spawn-agent "ok-4822" (lambda () 42))
(check4822 (let ((j (orch:agent-join "ok-4822" :timeout-ms 3000)))
             (and (eq? #t (hash-ref j "ok")) (equal? (hash-ref j "status") "ok")))
           "clean body -> ok #t / ok")
(if (= *fails4822* 0)
    (display "OK-4822\n")
    (begin (display "FAIL-4822 fails=") (display *fails4822*) (newline) (exit 1)))
