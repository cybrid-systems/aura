; Issue #2740 — internal define after side effects must be sequential (not letrec lift)
(define *fails* 0)
(define (assert! pred msg)
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1))
             (display "  FAIL: ") (display msg) (newline))))

(display "define after vector-set!\n")
(let* ((n 5)
       (out (make-vector n 0)))
  (vector-set! out 0 1)
  (vector-set! out 1 2)
  (vector-set! out 2 3)
  (vector-set! out 3 4)
  (vector-set! out 4 5)
  (define a (= (vector-ref out 0) 1))
  (define b (= (vector-ref out 4) 5))
  (assert! a "a=#t after fill")
  (assert! b "b=#t after fill")
  (assert! (= (vector-ref out 4) 5) "out4=5"))

(display "mutual recursion at head still works\n")
(define (test-letrec)
  (define (even? n) (if (= n 0) #t (odd? (- n 1))))
  (define (odd? n) (if (= n 0) #f (even? (- n 1))))
  (list (even? 4) (odd? 3) (even? 5)))
(let ((r (test-letrec)))
  (assert! (equal? r (list #t #t #f)) "letrec even/odd"))

(if (= *fails* 0)
    (begin (display "OK-2740 define after side effects\n"))
    (begin (display "FAIL-2740\n") (exit 1)))
