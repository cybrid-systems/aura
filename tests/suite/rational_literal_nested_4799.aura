; Issue #4799 — nested rational literal keeps its own diagnostic
(define *n* 0)
(define *fails* 0)
(define (check! pred msg)
  (set! *n* (+ *n* 1))
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))
(define (string-has? s sub)
  (let loop ((i 0))
    (cond ((> (+ i (string-length sub)) (string-length s)) #f)
          ((equal? (substring s i (+ i (string-length sub))) sub) #t)
          (else (loop (+ i 1))))))
(define (err-text thunk)
  (try (begin (thunk) "no-error") (catch (e) (format "~a" e))))

(define (parse-msg src)
  (let ((r (try (set-code src) (catch (e) (list 'raised (format "~a" e))))))
    (if (and (pair? r) (pair? (cdr r))) (format "~a" (cadr r)) (format "~a" r))))
(define nested (parse-msg "(define zz (list 1/3))"))
(display "  nested: ") (display nested) (newline)
(check! (string-has? nested "rational literal '1/3' is not supported") "nested 1/3 reports the rational diagnostic")
(check! (string-has? nested "1:18: rational literal") "diagnostic points at the literal itself")
(check! (not (string-has? (substring nested 0 (min 30 (string-length nested))) "unexpected")) "rational diagnostic comes first, not unexpected ')'")
(define deep (parse-msg "(define zw (vector (list 2 7/2)))"))
(check! (string-has? deep "rational literal '7/2'") "doubly nested literal reports the rational diagnostic")
(check! (equal? (set-code "(define zf (list 1.0 3))") (set-code "(define zf (list 1.0 3))")) "ordinary floats still parse")

(if (= *fails* 0)
    (begin (display "OK-rational-nested-4799 ") (display *n*) (display " checks") (newline))
    (begin (display "rational-nested-4799: ") (display (- *n* *fails*))
           (display "/") (display *n*) (newline) (exit 1)))
