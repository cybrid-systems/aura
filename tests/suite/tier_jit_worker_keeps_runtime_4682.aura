; #4682 follow-up: the tier JIT worker builds a private AuraJIT; its init()
; used to call aura_reset_runtime(), wiping every live hash table and the
; string pool of the running program as soon as the first hot define was
; compiled (here: a rebound workspace policy called right after rebind).
(require "std/mutate" all:)
(define m (make-hash))
(hash-set! m "x" 1)
(define h2 (make-hash))
(hash-set! h2 5 6)
(set-code "(define pol-0 (lambda () 0))")
(eval-current)
(define (offset) (try (pol-0) (catch (e) 0)))
(define (tick t)
  (mutate:rebind "pol-0" (string-append "(lambda () " (number->string t) ")") "rb")
  (eval-current)
  (offset))
(define lost -1)
(define stale 0)
(define (go k) (let l ((t 1)) (if (< t k)
  (begin (offset)
         (if (not (= (tick t) t)) (set! stale (+ stale 1)))
         (if (and (< lost 0) (not (= 1 (hash-ref m "x" -1)))) (set! lost t))
         (l (+ t 1))) t)))
(go 60)
(define pass 0)
(define fail 0)
(define (check name ok) (if ok (set! pass (+ pass 1)) (begin (set! fail (+ fail 1)) (display "FAIL: ") (display name) (newline))))
(check "hash m survives tier compiles" (and (< lost 0) (= 1 (hash-ref m "x" -1))))
(check "second hash survives" (= 6 (hash-ref h2 5 -1)))
(check "rebound policy visible right after rebind" (= stale 0))
(check "final binding" (= (pol-0) 59))
(check "string pool intact" (string=? (string-append "a" "b") "ab"))
(if (= fail 0)
    (begin (display "OK-tierworker4682 ") (display pass) (display " checks") (newline))
    (begin (display "tier_jit_worker_keeps_runtime_4682: ") (display pass) (display "/") (display (+ pass fail)) (newline) (exit 1)))
