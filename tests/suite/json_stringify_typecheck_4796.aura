; Issue #4796: json-stringify / json-value are std/json defines, not
; engine primitives. Without the module the name is rejected up front.
; This file must not require std/json: --load hoists module requires.
(require "std/test" all:)
(test-file "json_stringify_typecheck_4796.aura")

(define (rebind name body label)
  (try (mutate :rebind name body label) (catch (e) (list "raised" e))))

(define (string-has? s sub)
  (let loop ((i 0))
    (cond ((> (+ i (string-length sub)) (string-length s)) #f)
          ((equal? (substring s i (+ i (string-length sub))) sub) #t)
          (else (loop (+ i 1))))))

(test-case "json-stringify needs the module" (hash "issue" 4796)
  (set-code "(define (enc4796 x) (json-encode x))")
  (eval-current)
  (let ((r (rebind "enc4796" "(lambda (x) (json-stringify x))" "no-require")))
    (check (and (pair? r) (equal? (car r) "mutation-failed")))
    (check (and (pair? r) (string? (cadr r)) (string-has? (cadr r) "json-stringify"))))
  (check= "[3]" (enc4796 (list 3)))
  (check= "unbound" (try (json-stringify 1) (catch (e) "unbound"))))

(test-finish)
