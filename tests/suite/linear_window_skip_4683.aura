; Issue #4683: the linear-GC invalidation window is skipped while no linear
; state has ever been written and no linear roots/pins exist. Once linear
; values appear (after many skipped windows) enforcement must still fire.
(define *fails* 0)
(define *n* 0)
(define (check! ok msg)
  (set! *n* (+ *n* 1))
  (if (not ok)
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))
(set-code "(define f (lambda (x) (+ x 1)))\n(define g (lambda (x) (f x)))\n")
(eval-current)
;; phase 1: linear-free rebinds (windows skipped)
(let loop ((i 0))
  (if (< i 20)
      (begin
        (mutate:rebind "f" (string-append "(lambda (x) (+ x " (number->string i) "))") "t")
        (eval-current)
        (check! (= (g 1) (+ 1 i)) "g after linear-free rebind")
        (loop (+ i 1)))))
;; phase 2: introduce linear values via rebind; enforcement still active
(mutate:rebind "f" "(lambda (x) (let ((v (Linear x))) (move v)))" "t")
(eval-current)
(check! (= (g 5) 5) "linear move through rebound f")
(check! (try (let ((x (Linear 42))) (move x) (borrow x)) (catch (e) #t))
        "use-after-move still rejected after skipped windows")
(check! (try (let ((x (Linear 1))) (move x) (drop x)) (catch (e) #t))
        "drop-after-move still rejected")
;; phase 3: rebinds after linear state was written (windows run again)
(let loop ((i 0))
  (if (< i 5)
      (begin
        (mutate:rebind "f" (string-append "(lambda (x) (* x " (number->string (+ i 2)) "))") "t")
        (eval-current)
        (check! (= (g 3) (* 3 (+ i 2))) "g after post-linear rebind")
        (loop (+ i 1)))))
(check! (try (let ((x (Linear 7))) (move x) (drop x)) (catch (e) #t))
        "drop-after-move rejected post-linear")
(display "linear_window_skip_4683: ") (display (- *n* *fails*)) (display "/") (display *n*) (newline)
(if (> *fails* 0) (exit 1))
