; Issue #5198: extract-code is the text extractor. llm:extract-code is
; the agent extractor. iota, vector-map, and sorted? live in the list,
; vector, and sort homes. Require order and overwrite warnings stay in
; tests/python/process/export_contracts.py.
(require "std/test" all:)
(require "std/agent" all:)
(require "std/extract" all:)
(test-file "export_contracts_5198.aura")

(define fenced "{\"error\":false,\"choices\":[{\"message\":{\"content\":\"(lambda (x) x)\"}}]}")

(test-case "text extract" (hash "issue" 5198)
  (check= "x" (extract-code "x")))

; llm:parse-response keeps the raw body when the JSON does not parse.
(test-case "llm keeps a plain body" (hash "issue" 5198)
  (check= "x" (llm:extract-code "x")))

; "error" must be present: llm:parse-response hash-refs that key.
(test-case "llm extract" (hash "issue" 5198)
  (check= "(lambda (x) x)" (llm:extract-code fenced)))

(test-finish)
