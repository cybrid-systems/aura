; #5065: default (engine:metrics) keeps schema 2 and drops issue-3531.
; The 100-call timing band lives in tests/bench/engine_metrics_snapshot_cost.aura.
(require "std/test" all:)
(test-file "issue_5065_engine_metrics.aura")

(test-case "default snapshot keeps schema 2" (hash "issue" 5065)
  (define snap (engine:metrics))
  (check= 2 (hash-ref snap "schema"))
  (check (> (hash-ref snap "stats-count") 0))
  (check (hash? (hash-ref snap "compile")))
  (check (not (hash-has-key? snap "issue-3531")))
  (check (not (hash-has-key? snap "schema-3531")))
  (check (hash-has-key? (stats:get "stats:drift-check") "schema-3531")))

(test-finish)
