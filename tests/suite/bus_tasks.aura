; #5399: the task board. A task is published, claimed atomically,
; heartbeat-renewed, completed, and its state reads back. A second claim
; while the lease is live is refused. #5407: subscribe and query name an
; unknown channel identically.
(require "std/test" all:)
(require "std/bus" all:)
(test-file "bus_tasks.aura")

(test-case "task board claim lease complete" (hash "issue" 5399 "tags" "bus")
  (define h (bus:host 8979))
  (check (bus:ok? h))
  (define a (bus:attach "" 8979 0 127 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  (define p (bus:post-task s 0 7))
  (check (bus:ok? p))
  (define id (car (cdr p)))
  (define c (bus:claim s 5000 id))
  (check (bus:ok? c))
  (check (bus:error? (bus:claim s 5000 id)))
  (check (bus:ok? (bus:heartbeat s id 5000)))
  (check (bus:ok? (bus:complete s id 9)))
  (define st (bus:task-status s id))
  (check (bus:ok? st))
  (check= 2 (list-ref st 2))
  (check= 9 (list-ref st 7))
  (check (bus:ok? (bus:query s 6 0 0)))
  (define timeline (bus:task-audit s id))
  (check (bus:ok? timeline))
  (check (> (list-ref timeline 1) 0))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8979))))

(test-case "task-scoped grant bounds the trial" (hash "issue" 5401 "tags" "bus")
  (define h (bus:host 8982))
  (check (bus:ok? h))
  (define a (bus:attach "" 8982 0 127 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  ; trial+keep+rollback, scoped to task 1
  (define g (bus:grant s 28 255 0 0 0 1))
  (check (bus:ok? g))
  (check (bus:ok? (bus:grant-activate s (car (cdr g)))))
  (define wrong (bus:trial s 3 2))
  (check (bus:error? wrong))
  (check (string=? (bus:message wrong) "capability is scoped to another task"))
  (define right (bus:trial s 3 1))
  (check (bus:ok? right))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8982))))

(test-case "approval gates the claim" (hash "issue" 5404 "tags" "bus")
  (define h (bus:host 8985))
  (check (bus:ok? h))
  (define a (bus:attach "" 8985 0 255 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  ; flags bit 0 = the task needs an approval
  (define t (bus:post-task s 0 77 1))
  (check (bus:ok? t))
  (define id (car (cdr t)))
  (define blocked (bus:claim s 5000 id))
  (check (bus:error? blocked))
  (check (string=? (bus:message blocked) "contract-approval-pending"))
  (define before (bus:approve s id 3 0))
  (check (bus:ok? before))
  (check= 0 (list-ref before 2))
  (define ap (bus:approve s id 1 0))
  (check (bus:ok? ap))
  (check= 1 (list-ref ap 2))
  (check (bus:ok? (bus:claim s 5000 id)))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8985))))

(test-case "contract gates claim and completion" (hash "issue" 5402 "tags" "bus")
  (define h (bus:host 8987))
  (check (bus:ok? h))
  (define a (bus:attach "" 8987 0 255 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  (define t (bus:post-task s 0 77))
  (check (bus:ok? t))
  (define id (car (cdr t)))
  (define c (bus:contract s id 42 100))
  (check (bus:ok? c))
  (check (> (list-ref c 2) 0))
  (check= 0 (list-ref c 3))
  (define blocked (bus:claim s 5000 id))
  (check (bus:error? blocked))
  (check (string=? (bus:message blocked) "contract-approval-pending"))
  (check (bus:ok? (bus:approve s id 1 0)))
  (check= 1 (list-ref (bus:contract-status s id) 3))
  (check (bus:ok? (bus:claim s 5000 id)))
  (define noev (bus:complete s id 1))
  (check (bus:error? noev))
  (check (string=? (bus:message noev) "contract has no evidence"))
  (check (bus:ok? (bus:contract-evidence s id 1 99)))
  (define low (bus:complete s id 1))
  (check (bus:error? low))
  (check (string=? (bus:message low) "contract metric 99 is below the floor 100"))
  (check (bus:ok? (bus:contract-evidence s id 1 100)))
  (check (bus:ok? (bus:complete s id 2)))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8987))))

(test-case "budget trips task and global" (hash "issue" 5403 "tags" "bus")
  (define h (bus:host 8988))
  (check (bus:ok? h))
  (define a (bus:attach "" 8988 0 255 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  (define t (bus:post-task s 0 77))
  (check (bus:ok? t))
  (define id (car (cdr t)))
  (check (bus:ok? (bus:claim s 5000 id)))
  (define r0 (bus:budget-report s id))
  (check (bus:ok? r0))
  (check= 0 (list-ref r0 2))
  (define over (bus:budget-charge s id 2000001))
  (check (bus:error? over))
  (check (string=? (bus:message over) "task token budget exceeded"))
  (define r1 (bus:budget-report s id))
  (check= 1 (list-ref r1 8))
  (check= 3 (list-ref (bus:task-status s id) 2))
  (define t2 (bus:post-task s 0 78))
  (check (bus:ok? t2))
  (define id2 (car (cdr t2)))
  (check (bus:ok? (bus:claim s 5000 id2)))
  (define over2 (bus:budget-charge s id2 20000000))
  (check (bus:error? over2))
  (define g (bus:budget-report s 0))
  (check= 3 (list-ref g 8))
  (define t3 (bus:post-task s 0 79))
  (check (bus:ok? t3))
  (define blocked (bus:claim s 5000 (car (cdr t3))))
  (check (bus:error? blocked))
  (check (string=? (bus:message blocked) "global budget exhausted"))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8988))))

(test-case "claim any skips blocked open tasks" (hash "issue" 5439 "tags" "bus")
  (define h (bus:host 8991))
  (check (bus:ok? h))
  (define a (bus:attach "" 8991 0 255 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  (define empty (bus:claim s 5000))
  (check (bus:error? empty))
  (check (string=? (bus:message empty) "task-none-open"))
  ; task 1 waits for an approval; task 2 is immediately claimable.
  (define t1 (bus:post-task s 0 1 1))
  (check (bus:ok? t1))
  (define id1 (car (cdr t1)))
  (define t2 (bus:post-task s 0 2))
  (check (bus:ok? t2))
  (define id2 (car (cdr t2)))
  (define named (bus:claim s 5000 id1))
  (check (bus:error? named))
  (check (string=? (bus:message named) "contract-approval-pending"))
  (define c (bus:claim s 5000))
  (check (bus:ok? c))
  (check= id2 (car (cdr c)))
  ; Only the denied task stays open: the error must say there is work
  ; but none of it is claimable, not that the board is empty.
  (define den (bus:approve s id1 2 0))
  (check (bus:ok? den))
  (define blocked (bus:claim s 5000))
  (check (bus:error? blocked))
  (check (string=? (bus:message blocked) "task-none-claimable"))
  (define named2 (bus:claim s 5000 id1))
  (check (bus:error? named2))
  (check (string=? (bus:message named2) "contract-denied"))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8991))))

; #5468: the source byte region is a wall of its own. Full-size
; carriers fill it in 16 publishes while most of the 1024 slots remain;
; the plan must report 0 rounds and low=1, not the slot count.
(test-case "byte-full source table reports no rounds" (hash "issue" 5468 "tags" "bus")
  (define h (bus:host 8993))
  (check (bus:ok? h))
  (define a (bus:attach "" 8993 0 127 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  (define before (bus:capacity-plan s))
  (check (bus:ok? before))
  ; At most one 4096-byte carrier per round: 16 rounds, not 1024.
  (check= 16 (list-ref before 1))
  (check= 0 (list-ref before 2))
  (check= 65536 (list-ref before 11))
  (define big (string-repeat "x" 4090))
  (define accepted
    (let loop ((i 0))
      (if (< i 2048)
          (if (bus:ok? (bus:publish-source s big))
              (loop (+ i 1))
              i)
          i)))
  ; The byte region is full, the slot array is not: the wall is bytes.
  (check= 16 accepted)
  (define after (bus:capacity-plan s))
  (check (bus:ok? after))
  (check= 1008 (list-ref after 10))
  (check= 0 (list-ref after 11))
  (check= 0 (list-ref after 1))
  (check= 1 (list-ref after 2))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8993))))

(test-case "unknown channel refusal is uniform" (hash "issue" 5407 "tags" "bus")
  (define h (bus:host 8978))
  (check (bus:ok? h))
  (define a (bus:attach "" 8978 0 127 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  (define sub (bus:subscribe s 0))
  (define qry (bus:query s 0 0 0))
  (check (bus:error? sub))
  (check (bus:error? qry))
  (check (string=? (bus:message sub) (bus:message qry)))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8978))))

(test-finish)
