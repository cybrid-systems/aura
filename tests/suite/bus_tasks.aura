; #5399: the task board. A task is published, claimed atomically,
; heartbeat-renewed, completed, and its state reads back. A second claim
; while the lease is live is refused. #5407: subscribe and query name an
; unknown channel identically.
(require "std/test" all:)
(require "std/bus" all:)
(test-file "bus_tasks.aura")

(test-case "task board claim lease complete" (hash "issue" 5399 "tags" "bus")
  (define h (bus:host 8979))
  (check (bus:ok? h))
  (define a (bus:attach "" 8979 0 127 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  (define p (bus:post-task s 0 7))
  (check (bus:ok? p))
  (define id (car (cdr p)))
  (define c (bus:claim s 5000 id))
  (check (bus:ok? c))
  (check (bus:error? (bus:claim s 5000 id)))
  (check (bus:ok? (bus:heartbeat s id 5000)))
  (check (bus:ok? (bus:complete s id 9)))
  (define st (bus:task-status s id))
  (check (bus:ok? st))
  (check= 2 (list-ref st 2))
  (check= 9 (list-ref st 7))
  (check (bus:ok? (bus:query s 6 0 0)))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8979))))

(test-case "task-scoped grant bounds the trial" (hash "issue" 5401 "tags" "bus")
  (define h (bus:host 8982))
  (check (bus:ok? h))
  (define a (bus:attach "" 8982 0 127 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  ; trial+keep+rollback, scoped to task 1
  (define g (bus:grant s 28 255 0 0 0 1))
  (check (bus:ok? g))
  (check (bus:ok? (bus:grant-activate s (car (cdr g)))))
  (define wrong (bus:trial s 3 2))
  (check (bus:error? wrong))
  (check (string=? (bus:message wrong) "capability is scoped to another task"))
  (define right (bus:trial s 3 1))
  (check (bus:ok? right))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8982))))

(test-case "unknown channel refusal is uniform" (hash "issue" 5407 "tags" "bus")
  (define h (bus:host 8978))
  (check (bus:ok? h))
  (define a (bus:attach "" 8978 0 127 255))
  (check (bus:ok? a))
  (define s (car (cdr a)))
  (define sub (bus:subscribe s 0))
  (define qry (bus:query s 0 0 0))
  (check (bus:error? sub))
  (check (bus:error? qry))
  (check (string=? (bus:message sub) (bus:message qry)))
  (bus:detach s)
  (check (bus:ok? (bus:unhost 8978))))

(test-finish)
