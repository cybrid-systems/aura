;; quasiquote_template_data_4760.aura — Issue #4760: a backquote template is
;; data except for unquote / unquote-splicing. Special forms inside it (let,
;; cond, define, ...) must keep their surface shape, and (quasiquote X) is
;; the long form of `X. Pass = exit 0 + OK line.

(define *fails* 0)
(define (check! got want msg)
  (if (equal? got want)
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1))
             (display "  FAIL: ") (display msg) (display " got ") (write got) (newline))))

(define q 5)
(define xs '(1 2))
(check! `(let ((tmp 1)) tmp) '(let ((tmp 1)) tmp) "let template keeps its bindings")
(check! `(let ((tmp ,q)) tmp) '(let ((tmp 5)) tmp) "unquote inside a let template")
(check! `(cond (a ,q)) '(cond (a 5)) "cond template is not evaluated")
(check! `(define (f x) ,q) '(define (f x) 5) "define template")
(check! `(if a ,q c) '(if a 5 c) "if template")
(check! `(lambda (x) ,q) '(lambda (x) 5) "lambda template")
(check! `(when a ,q) '(when a 5) "when template")
(check! `(case k ((1) ,q)) '(case k ((1) 5)) "case template")
(check! `(a ,@xs b) '(a 1 2 b) "unquote-splicing")
(check! `(a ',q) '(a (quote 5)) "quote around an unquote substitutes")
(check! (quasiquote (cond (a 1))) '(cond (a 1)) "long form (quasiquote ...)")
(check! (quasiquote (x (unquote q) (unquote-splicing xs))) '(x 5 1 2) "long-form unquote / unquote-splicing")
(check! `(a `(b ,(c ,q))) '(a (quasiquote (b (unquote (c 5))))) "nested quasiquote keeps inner level")
(check! `(1 ,(+ 1 1) 3) '(1 2 3) "unquote operand is code")
(check! `(x ,(let ((y 2)) (* y q))) '(x 10) "special forms inside unquote still run")

;; the defmacro idiom from the issue
(defmacro (sw a b) `(let ((tmp ,a)) (set! ,a ,b) (set! ,b tmp)))
(define m 1) (define n 2)
(sw m n)
(check! (list m n) '(2 1) "defmacro with a let template swaps")

(if (= *fails* 0)
    (begin (display "OK-4760 quasiquote templates are data") (newline))
    (begin (display "FAIL-4760 fails=") (display *fails*) (newline) (error "4760 suite failed")))
