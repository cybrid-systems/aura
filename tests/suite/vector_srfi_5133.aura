; #5133: SRFI-133 / R7RS vector surface. The same predicates run on the
; host and inside a guest fiber.
(require "std/test" all:)
(require "std/vector" all:)
(test-file "vector_srfi_5133.aura")

(define v (vector 1 2 3))

(define (vector-ok?)
  (and
   (= (vector-length v) 3)
   (= (vector-ref v 1) 2)
   (equal? (vector->list v) (list 1 2 3))
   (equal? (list->vector (list 4 5)) (vector 4 5))
   (equal? (vector-copy v 0 2) (vector 1 2))
   (equal? (vector-copy v 1) (vector 2 3))
   (equal? (vector-map (lambda (x) (* x 2)) v) (vector 2 4 6))
   (equal? (vector-map + (vector 1 2 3) (vector 10 20)) (vector 11 22))
   (let ((w (vector 0 0 0))) (vector-fill! w 7) (equal? w (vector 7 7 7)))
   (let ((a (vector-append (vector 1) (vector 2)))) (equal? a (vector 1 2)))
   (eq? (try (vector-ref v 9) (catch (e) 'raised)) 'raised)
   (eq? (try (vector-ref v -1) (catch (e) 'raised)) 'raised)
   (eq? (try (vector-ref (vector) 0) (catch (e) 'raised)) 'raised)))

(test-case "srfi vector host" (hash "issue" 5133)
  (check (vector-ok?)))

(test-case "srfi vector guest" (hash "issue" 5133)
  (check= 1 (fiber:join (fiber:spawn (lambda () (if (vector-ok?) 1 0))))))

; Issue #5198: vector-map stops at the shortest input, including the
; historical one-argument procedure over two vectors.
(test-case "vector-map zip" (hash "issue" 5198)
  (check= (vector 11 22) (vector-map + (vector 1 2) (vector 10 20 30))))

(test-case "vector-map one" (hash "issue" 5198)
  (check= (vector 2 3) (vector-map (lambda (x) (+ x 1)) (vector 1 2))))

(test-case "vector-map repro" (hash "issue" 5198)
  (check= (vector '() '())
          (vector-map (lambda (x) x) (make-vector 2 0) (make-vector 3 1))))

(test-case "vector builders" (hash)
  (check= (vector 1 2 3) (vector-concatenate (list (vector 1) (vector 2 3))))
  (check (vector-empty? (vector)))
  (check= 6 (vector-fold (lambda (acc x) (+ acc x)) 0 (vector 1 2 3)))
  (check= (list 1 2 3)
          (vector-fold-right (lambda (acc x) (cons x acc)) (list) (vector 1 2 3)))
  (check= 2 (vector-count even? (vector 1 2 3 4)))
  (check= 2 (vector-index even? (vector 1 3 4)))
  (check (not (vector-index even? (vector 1 3 5))))
  (check (vector-any odd? (vector 2 4 5)))
  (check (vector-every odd? (vector 1 3 5)))
  (check= (vector 3 2 1) (vector-reverse-copy (vector 1 2 3)))
  (check= 1 (vector-binary-search (vector 10 20 30) 20 (lambda (a b) (- a b)))))

(test-case "vector-for-each counts" (hash)
  (let ((n (vector 0)))
    (vector-for-each (lambda (x) (vector-set! n 0 (+ (vector-ref n 0) 1)))
                     (vector 1 2 3))
    (check= 3 (vector-ref n 0))))

; Issue #5311: map/for-each read the vectors, then call f in order.
; One argument over several vectors stays the #5198 result. The walk
; stops at the shortest vector.
(test-case "vector-map direct" (hash "issue" 5311)
  (check= (vector) (vector-map (lambda (x) (* x 2)) (vector)))
  (check= (vector 3.0 6.0) (vector-map (lambda (x) (* x 2.0)) (vector 1.5 3.0)))
  (let ((n (vector 0)))
    (check= (vector 2 4 6)
            (vector-map (lambda (x)
                          (vector-set! n 0 (+ (vector-ref n 0) 1))
                          (* x 2))
                        (vector 1 2 3)))
    (check= 3 (vector-ref n 0)))
  (check= (vector 11 22) (vector-map + (vector 1 2 9) (vector 10 20)))
  (check= (vector 6) (vector-map + (vector 1 8) (vector 2 8) (vector 3))))

(test-case "vector-for-each direct" (hash "issue" 5311)
  (let ((n (vector 0)))
    (vector-for-each (lambda (x) (vector-set! n 0 (+ (vector-ref n 0) x)))
                     (vector 1 2 3))
    (check= 6 (vector-ref n 0)))
  (let ((n (vector 0)))
    (vector-for-each (lambda (a b) (vector-set! n 0 (+ (vector-ref n 0) a b)))
                     (vector 1 2) (vector 10 20 30))
    (check= 33 (vector-ref n 0)))
  (let ((n (vector 0)))
    (vector-for-each (lambda (a b c) (vector-set! n 0 (+ (vector-ref n 0) a b c)))
                     (vector 1 2) (vector 10 20) (vector 100))
    (check= 111 (vector-ref n 0))))

(test-case "vector-copy! returns the target" (hash)
  (let ((to (vector 0 0 0)))
    (vector-copy! to 0 (vector 7 8))
    (check= (vector 7 8 0) to)))

; Issue #5327: vector-append copies through the native list->vector path
; instead of a vector-ref/vector-set! pair per element (two 160k vectors:
; 3463 ms before, 141 ms here). Pin the arity results, independence from
; the inputs, and the shape.
(test-case "vector-append copies natively" (hash "issue" 5327)
  (check= (vector) (vector-append))
  (check= (vector 1 2) (vector-append (vector 1 2)))
  (check= (vector 1 2 3) (vector-append (vector 1 2) (vector 3)))
  (check= (vector 1 2 3) (vector-append (vector) (vector 1) (vector) (vector 2 3)))
  (check= (vector 1 2 3) (vector-concatenate (list (vector 1) (vector 2 3))))
  (define a (vector 1 2))
  (define out (vector-append a))
  (vector-set! a 0 99)
  (check= 1 (vector-ref out 0)))

(test-case "vector-append scale" (hash "issue" 5327)
  (define a (make-vector 160000 7))
  (define b (make-vector 160000 9))
  (define t0 (monotonic-ms))
  (define out (vector-append a b))
  (define dt (- (monotonic-ms) t0))
  (check= 320000 (vector-length out))
  (check= 7 (vector-ref out 0))
  (check= 9 (vector-ref out 160000))
  ; 320k slots: the native path is ~140 ms on this box, the old element
  ; loop ~3500 ms; 1500 ms separates them with room for a loaded box.
  (check (< dt 1500)))

(test-finish)
