; Issue #5197: export before a single-level require stays bound, and
; a name that was never exported does not leak out of the module.
(require "std/test" all:)
(require "./export_set_nested/single/mod" all:)
(require "./export_set_nested/filter/mod" all:)
(test-file "export_set_require_order.aura")

(define (value thunk)
  (try (thunk) (catch (e) 'unbound-5197)))

(test-case "export around a require stays bound" (hash "issue" 5197)
  (check= 1 (value (lambda () a1)))
  (check= 2 (value (lambda () a2))))

(test-case "unexported name stays inside the module" (hash "issue" 5197)
  (check= 1 (value (lambda () pub)))
  (check= 'unbound-5197 (value (lambda () secret))))

(test-finish)
