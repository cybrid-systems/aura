;; Issue #5197 — export before a single-level require stays bound, and
;; a name that was never exported does not leak out of the module.

(require "./export_set_nested/single/mod" all:)
(require "./export_set_nested/filter/mod" all:)

(define fails 0)
(define (expect cond name)
  (if cond
      #t
      (begin
        (set! fails (+ fails 1))
        (display "FAIL-5197 ")
        (display name)
        (newline))))

(define (value thunk)
  (try (thunk) (catch (e) 'unbound-5197)))

(define got-a1 (value (lambda () a1)))
(define got-a2 (value (lambda () a2)))
(define got-pub (value (lambda () pub)))
(define got-secret (value (lambda () secret)))

(expect (equal? got-a1 1) "a1 exported before require is 1")
(expect (equal? got-a2 2) "a2 exported after require is 2")
(expect (equal? got-pub 1) "pub is exported")
(expect (eq? got-secret 'unbound-5197) "secret is not exported")

(if (= fails 0)
    (begin (display "OK-5197-order") (newline))
    (exit 1))
