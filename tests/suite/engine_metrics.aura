; suite/engine_metrics.aura — P1a/P2b/#1433 (engine:metrics) facade
; Works under AURA_PRIMITIVES=full and s0 (facade-only).

(require "std/test" all:)

(test-suite "engine:metrics-summary"
  (check (hash? (engine:metrics)))
  (check (= 2 (hash-ref (engine:metrics) "schema"))) ; #1433 nested groups
  (check (> (hash-ref (engine:metrics) "stats-count") 0))
  (check (pair? (hash-ref (engine:metrics) "stats-names")))
  (check (>= (hash-ref (engine:metrics) "metrics-field-count") 200)))

(test-suite "engine:metrics-groups"
  (check (hash? (hash-ref (engine:metrics) "telemetry")))
  (check (hash? (engine:metrics :group "jit")))
  (check (number? (hash-ref (engine:metrics :group "jit") "jit_compilations"))))

(test-suite "engine:metrics-prefix"
  (define q (engine:metrics :prefix "query:"))
  (check (hash? q))
  (check (= 2 (hash-ref q "schema")))
  (check (> (hash-length q) 2)))

(test-suite "engine:metrics-by-name"
  ; Lookup routes to underlying stats prim when registered (full mode).
  ; Under s0, individual query:*-stats are absent → void (still OK).
  (define one (engine:metrics \"query:macro-hygiene-stats\"))
  (check (or (hash? one) (eq? one (void))))
  (check (eq? (engine:metrics \"query:no-such-stats-zzz\") (void))))

(test-suite "engine:metrics-all"
  (define all (engine:metrics :all))
  (check (hash? all))
  (check (= (hash-ref (engine:metrics) "stats-count")
            (hash-ref all "stats-count")))
  ; Issue #3018: current catalog must not collapse the table or stamp overflow.
  (check (= 2 (hash-ref all "schema")))
  (check (not (hash-has-key? all "overflow"))))

(test-suite "engine:metrics-overflow-3018"
  (define all (engine:metrics :all))
  (define q (engine:metrics :prefix "query:"))
  (check (hash? all))
  (check (hash? q))
  (check (eq? (hash-ref all "overflow") (void)))
  (check (eq? (hash-ref q "overflow") (void)))
  (check (eq? (engine:metrics "query:no-such-stats-zzz") (void))))

; Issue #3020: high-churn domain queries keep documented keys; no overflow
; under default catalog size (soak). Forced-full is C++-only.
(test-suite "engine:metrics-query-hash-overflow-3020"
  (define pb (engine:metrics "query:reload-recovery-playbook"))
  (define sp (engine:metrics "query:security-posture"))
  (define tl (engine:metrics "query:type-linear-commit-health"))
  (check (or (eq? pb (void)) (and (hash? pb) (= 2953 (hash-ref pb "schema-2953"))
                                  (eq? (hash-ref pb "overflow") (void)))))
  (check (or (eq? sp (void)) (and (hash? sp) (= 2534 (hash-ref sp "schema-2534"))
                                  (eq? (hash-ref sp "overflow") (void)))))
  (check (or (eq? tl (void)) (and (hash? tl) (= 2613 (hash-ref tl "schema-2613"))
                                  (eq? (hash-ref tl "overflow") (void)))))
  (define evd (engine:metrics "query:evolution-audit-decision"))
  (check (or (eq? evd (void)) (and (hash? evd) (= 3114 (hash-ref evd "schema-3114"))
                                   (= 1 (hash-ref evd "observe-only"))
                                   (eq? (hash-ref evd "overflow") (void))))))

; Full-mode parity: direct stats prim matches facade by-name.
(test-suite "engine:metrics-parity"
  (define via (engine:metrics \"query:macro-hygiene-stats\"))
  (if (eq? via (void))
      (check #t) ; s0: no bulk stats registered
    (begin
      (define direct (engine:metrics \"query:macro-hygiene-stats\"))
      (check (hash? direct))
      (check (hash? via))
      (check (number? (hash-ref via "schema"))))))

(test-suite "engine-metrics-stdlib"
  (require "std/engine-metrics" all:)
  (check (hash? (engine-metrics:get)))
  (check (pair? (engine-metrics:list)))
  (check (hash? (engine-metrics:group "jit")))
  (check (> (engine-metrics:count) 0)))
