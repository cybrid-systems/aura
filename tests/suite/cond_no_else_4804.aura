; Issue #4804 — cond without else: the last clause's test must still be checked
(define *n* 0)
(define *fails* 0)
(define (check! pred msg)
  (set! *n* (+ *n* 1))
  (if pred
      (begin (display "  pass: ") (display msg) (newline))
      (begin (set! *fails* (+ *fails* 1)) (display "  FAIL: ") (display msg) (newline))))

(define x #f)
(define trace '())
(define (h1) (cond ((equal? 1 2) (set! trace (cons 'a trace))) (x (set! trace (cons 'b trace)))) 'done)
(h1)
(check! (null? trace) "false last test does not run its body (statement position)")
(define (k y) (cond ((= y 1) 'one) ((= y 2) 'two)))
(check! (equal? (k 1) 'one) "first clause")
(check! (equal? (k 2) 'two) "last clause when its test holds")
(check! (not (equal? (k 3) 'two)) "no clause matches -> not the last body")
(check! (equal? (cond ((= 1 2) 1) (else 2)) 2) "else still unconditional")
(check! (equal? (cond (#f 1) (#t 2)) 2) "#t last clause")
(check! (not (equal? (cond (#f 1) (#f 2)) 2)) "literal #f last clause")
(define (multi y) (cond ((= y 1) (set! trace (cons 1 trace)) 'm1) ((= y 2) (set! trace (cons 2 trace)) 'm2)))
(set! trace '())
(multi 5)
(check! (null? trace) "multi-expression last clause skipped when false")
(check! (equal? (multi 2) 'm2) "multi-expression last clause value")
(define (lam-cond f) (f 3))
(check! (not (equal? (lam-cond (lambda (y) (cond ((= y 1) 'one) ((= y 2) 'two)))) 'two)) "inside lambda")

(if (= *fails* 0)
    (begin (display "OK-cond-4804 ") (display *n*) (display " checks") (newline))
    (begin (display "cond-4804: ") (display (- *n* *fails*)) (display "/") (display *n*) (newline) (exit 1)))
