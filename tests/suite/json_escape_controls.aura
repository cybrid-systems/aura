;; expect: OK-json-escape-controls
; json-escape must emit RFC 8259 escapes for controls, quotes, and
; backslashes. The bytes are checked here; a strict parser check lives
; in tests/python/test_json_escape_controls.py (Aura's json-parse still
; accepts raw controls).
(require "std/json" all:)

(define *fails* 0)
(define *passes* 0)
(define (check name got want)
  (if (equal? got want)
      (set! *passes* (+ *passes* 1))
      (begin (set! *fails* (+ *fails* 1))
             (display "  FAIL: ") (display name)
             (display " got ") (display got)
             (display " want ") (display want) (newline))))

(define (has-raw-control? s)
  (let loop ((i 0))
    (if (>= i (string-length s))
        #f
        (if (< (string-ref s i) 32)
            #t
            (loop (+ i 1))))))

(check "newline" (json-escape "line1\nline2") "line1\\nline2")
(check "tab" (json-escape "a\tb") "a\\tb")
(check "cr" (json-escape "a\rb") "a\\rb")
(check "quote" (json-escape "a\"b") "a\\\"b")
(check "backslash" (json-escape "a\\b") "a\\\\b")
(check "backspace" (json-escape "\x08") "\\b")
(check "formfeed" (json-escape "\x0c") "\\f")
(check "u0001" (json-escape "\x01") "\\u0001")
(check "nul" (json-escape "\x00") "\\u0000")
(check "no raw control" (has-raw-control? (json-escape "\x01\n\t\x08\x0c")) #f)

; json-encode of the same string still round-trips through a quoted form
; whose interior is json-escape.
(check "encode wraps escape"
       (json-encode "line1\nline2")
       (string-append "\"" (json-escape "line1\nline2") "\""))
(check "encode u0001" (json-encode "\x01") "\"\\u0001\"")

(define obj (json-obj-items (hash "a\nb" 1) (list "a\nb") number->string))
(check "obj-items" obj "\"a\\nb\":1")
(check "obj-items no raw" (has-raw-control? obj) #f)

(define arr (json-arr-items (list "a\nb" "c\"d")
                            (lambda (s) (string-append "\"" (json-escape s) "\""))))
(check "arr-items" arr "\"a\\nb\",\"c\\\"d\"")
(check "arr-items no raw" (has-raw-control? arr) #f)

; Existing quote escape inside json-encode of a vector must stay put.
(check "vector string" (json-encode (vector "a\"b")) "[\"a\\\"b\"]")

(if (and (= *fails* 0) (= *passes* 16))
    (display "OK-json-escape-controls\n")
    (begin
      (display "FAIL-json-escape-controls fails=") (display *fails*)
      (display " passes=") (display *passes*) (newline)
      (error "json-escape-controls failed")))
