; Issue #5189: json-escape emits RFC 8259 escapes for controls, quotes,
; and backslashes. Aura's json-parse still accepts raw controls, so the
; strict parser check stays in tests/python/test_json_escape_controls.py.
(require "std/test" all:)
(require "std/json" all:)
(test-file "json_escape_controls.aura")

(define (has-raw-control? s)
  (let loop ((i 0))
    (if (>= i (string-length s))
        #f
        (if (< (string-ref s i) 32)
            #t
            (loop (+ i 1))))))

(test-case "escape controls" (hash "issue" 5189)
  (check= "line1\\nline2" (json-escape "line1\nline2"))
  (check= "a\\tb" (json-escape "a\tb"))
  (check= "a\\rb" (json-escape "a\rb"))
  (check= "a\\\"b" (json-escape "a\"b"))
  (check= "a\\\\b" (json-escape "a\\b"))
  (check= "\\b" (json-escape "\x08"))
  (check= "\\f" (json-escape "\x0c"))
  (check= "\\u0001" (json-escape "\x01"))
  (check= "\\u0000" (json-escape "\x00"))
  (check (not (has-raw-control? (json-escape "\x01\n\t\x08\x0c")))))

(test-case "encode wraps escape" (hash "issue" 5189)
  (check= (string-append "\"" (json-escape "line1\nline2") "\"")
          (json-encode "line1\nline2"))
  (check= "\"\\u0001\"" (json-encode "\x01"))
  (check= "1" (json-stringify 1)))

(test-case "object and array items" (hash "issue" 5189)
  (define obj (json-obj-items (hash "a\nb" 1) (list "a\nb") number->string))
  (check= "\"a\\nb\":1" obj)
  (check (not (has-raw-control? obj)))
  (define arr (json-arr-items (list "a\nb" "c\"d")
                              (lambda (s) (string-append "\"" (json-escape s) "\""))))
  (check= "\"a\\nb\",\"c\\\"d\"" arr)
  (check (not (has-raw-control? arr))))

(test-finish)
