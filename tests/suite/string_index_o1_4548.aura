; Issue #4548: string-ref / substring / string-length on a long string
; match code-point indexing, and string-fill! drops the cached index.
; The flat-cost timer lives in tests/bench/string_ref_flat_cost.aura.
(require "std/test" all:)
(require "std/adaptive" all:)
(require "std/hash" all:)
(require "std/rule" all:)
(require "std/string" all:)
(test-file "string_index_o1_4548.aura")

(define (dbl s k) (if (= k 0) s (dbl (string-append s s) (- k 1))))

(define a10 "abcdefghij")
(define big (dbl (string-append a10 a10 a10) 13))
(define unit "aé中😀b")
(define wide (dbl unit 12))
(define w2 (dbl "é" 9))

(test-case "ascii index" (hash "issue" 4548)
  (check= 245760 (string-length big))
  (check= 97 (string-ref big 0))
  (check= 106 (string-ref big 245759))
  (check= (char->integer #\h) (string-ref big 123457))
  (check= 'oob (try (string-ref big 245760) (catch (e) 'oob)))
  (check= "abcdefghij" (substring big 245750 245760))
  (check= "fghij" (substring big 245755 999999))
  (check= "" (substring big 10 10))
  (check= "" (substring big 20 10)))

(test-case "wide index" (hash "issue" 4548)
  (check= 20480 (string-length wide))
  (check= 233 (string-ref wide (+ (* 5 4000) 1)))
  (check= 20013 (string-ref wide (+ (* 5 4095) 2)))
  (check= 128512 (string-ref wide 20478))
  (check= 98 (string-ref wide 20479))
  (check= 'oob (try (string-ref wide 20480) (catch (e) 'oob)))
  (check= "😀baé中" (substring wide 10003 10008))
  (check= (substring (dbl unit 6) 63 66) (substring wide 63 66))
  (check= unit (substring wide 20475 30000))
  (check= 2000 (string-length (substring wide 1000 3000))))

(test-case "fill drops the cached index" (hash "issue" 4548)
  (check= 512 (string-length w2))
  (check= 233 (string-ref w2 511))
  (string-fill! w2 (char->integer #\q))
  (check= 1024 (string-length w2))
  (check= (char->integer #\q) (string-ref w2 1023))
  (check= "qqqq" (substring w2 1020 1030)))

; Issue #5238: std/adaptive used to export a 3-argument string-index closure,
; silently replacing the core primitive and breaking the 2-argument form.
(test-case "adaptive keeps the core string-index" (hash "issue" 5238)
  (check= 2 (string-index "abcd" "c"))
  (check= 2 (string-index "abcd" "c" 2))
  (check= -1 (string-index "abcd" "c" 3))
  (check= -1 (string-index "abcd" "zz")))

; Issue #5341: string-index no longer copies the haystack or walks from
; byte 0 for start/result. Code-point indexes are preserved on multibyte
; text, and repeated offset searches stay linear.
(test-case "index at an offset is code-point exact" (hash "issue" 5341)
  (check= 2 (string-index wide "中" 0))
  (check= 7 (string-index wide "中" 3))
  (check= 3 (string-index wide "😀b" 0))
  (check= 10002 (string-index wide "中" 10000))
  (check= -1 (string-index wide "中" 20480))
  (check= -1 (string-index "abcd" "c" 3))
  (check= 0 (string-index "abcd" "" 3))
  (check= 2 (string-index "abcd" "c" 2)))

(test-case "index scan is linear" (hash "issue" 5341)
  (define (lines n) (string-join (make-list n "0123456789abcdefghij") "\n"))
  (define (scan s)
    (let loop ((i 0) (hits 0))
      (let ((p (string-index s "\n" i)))
        (if (= p -1) hits (loop (+ p 1) (+ hits 1))))))
  (define small (lines 4000))
  (define large (lines 16000))
  (define t0 (monotonic-ms))
  (check= 3999 (scan small))
  (define dt-small (- (monotonic-ms) t0))
  (define t1 (monotonic-ms))
  (check= 15999 (scan large))
  (define dt-large (- (monotonic-ms) t1))
  ; The old copy + walk-from-zero shape was ~15x per 4x step (3.4 s at 16k).
  (check (<= dt-large (* 5 (max 1 dt-small)))))

(test-case "index near the tail is flat" (hash "issue" 5341)
  (define flat (string-repeat "a" 320000))
  (define (rep n th)
    (let ((t0 (monotonic-ms)))
      (let loop ((k 0)) (if (< k n) (begin (th) (loop (+ k 1))) #f))
      (- (monotonic-ms) t0)))
  (define idx-ms (rep 2000 (lambda () (string-index flat "b" 319990))))
  (define sub-ms (rep 2000 (lambda () (substring flat 319990 320000))))
  (check= -1 (string-index flat "b" 319990))
  (check= 10 (string-length (substring flat 319990 320000)))
  ; Same position, substring used to be ~100x cheaper than string-index.
  (check (<= idx-ms (+ (* 2 sub-ms) 20))))

; std/hash and std/rule used to define their own for-each; the core
; primitive must stay visible after both requires.
(test-case "hash and rule keep the core for-each" (hash "issue" 5238)
  (check= #t (procedure? for-each))
  (define seen (list))
  (for-each (lambda (x) (set! seen (cons x seen))) (list 1 2 3))
  (check= (list 3 2 1) seen))

(test-finish)
