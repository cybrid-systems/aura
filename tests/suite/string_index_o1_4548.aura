; Issue #4548: string-ref / substring / string-length on a long string
; match code-point indexing, and string-fill! drops the cached index.
; The flat-cost timer lives in tests/bench/string_ref_flat_cost.aura.
(require "std/test" all:)
(test-file "string_index_o1_4548.aura")

(define (dbl s k) (if (= k 0) s (dbl (string-append s s) (- k 1))))

(define a10 "abcdefghij")
(define big (dbl (string-append a10 a10 a10) 13))
(define unit "aé中😀b")
(define wide (dbl unit 12))
(define w2 (dbl "é" 9))

(test-case "ascii index" (hash "issue" 4548)
  (check= 245760 (string-length big))
  (check= 97 (string-ref big 0))
  (check= 106 (string-ref big 245759))
  (check= (char->integer #\h) (string-ref big 123457))
  (check= 'oob (try (string-ref big 245760) (catch (e) 'oob)))
  (check= "abcdefghij" (substring big 245750 245760))
  (check= "fghij" (substring big 245755 999999))
  (check= "" (substring big 10 10))
  (check= "" (substring big 20 10)))

(test-case "wide index" (hash "issue" 4548)
  (check= 20480 (string-length wide))
  (check= 233 (string-ref wide (+ (* 5 4000) 1)))
  (check= 20013 (string-ref wide (+ (* 5 4095) 2)))
  (check= 128512 (string-ref wide 20478))
  (check= 98 (string-ref wide 20479))
  (check= 'oob (try (string-ref wide 20480) (catch (e) 'oob)))
  (check= "😀baé中" (substring wide 10003 10008))
  (check= (substring (dbl unit 6) 63 66) (substring wide 63 66))
  (check= unit (substring wide 20475 30000))
  (check= 2000 (string-length (substring wide 1000 3000))))

(test-case "fill drops the cached index" (hash "issue" 4548)
  (check= 512 (string-length w2))
  (check= 233 (string-ref w2 511))
  (string-fill! w2 (char->integer #\q))
  (check= 1024 (string-length w2))
  (check= (char->integer #\q) (string-ref w2 1023))
  (check= "qqqq" (substring w2 1020 1030)))

(test-finish)
