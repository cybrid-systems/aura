;; expect: OK-4556 native memory views, bulk f64vector ops and handles
; Issue #4556: typed views onto native memory (no byte-string snapshot per
; poll), seqlock-consistent block reads, bulk f64vector ops, and handles
; whose finalizer runs exactly once. A view whose owner was freed or closed
; raises a catchable error; polling the same address reuses one slot.
(require "std/ffi" all:)
(define *fails* 0)
(define *passes* 0)
(define (check name got want)
  (if (equal? got want)
      (set! *passes* (+ *passes* 1))
      (begin (set! *fails* (+ *fails* 1))
             (display "  FAIL: ") (display name) (display " got ") (display got)
             (display " want ") (display want) (newline))))
(define (raises? thunk) (try (begin (thunk) #f) (catch (e) #t)))
(define (f64v xs)
  (let ((v (make-f64vector (length xs) 0.0)))
    (let loop ((i 0) (xs xs))
      (if (null? xs) v (begin (f64vector-set! v i (car xs)) (loop (+ i 1) (cdr xs)))))))
(define (f64l v)
  (let loop ((i (- (f64vector-length v) 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (f64vector-ref v i) acc)))))

; ── views over a c-alloc block ──
(define blk (c-alloc 64))
(define u (c-view blk 0 8 'u64))
(check "view?" (c-view? u) #t)
(check "opaque not view" (c-view? blk) #f)
(check "length" (c-view-length u) 8)
(c-view-set! u 0 7)
(c-view-set! u 7 123456789)
(check "u64 ref 0" (c-view-ref u 0) 7)
(check "u64 ref 7" (c-view-ref u 7) 123456789)
(check "u64 zero" (c-view-ref u 3) 0)
(check "ref oob" (raises? (lambda () (c-view-ref u 8))) #t)
(check "window past c-alloc size" (raises? (lambda () (c-view blk 8 8 'u64))) #t)
(check "bad kind" (raises? (lambda () (c-view blk 0 1 'f128))) #t)
(define f (c-view blk 8 4 'f64))
(c-view-set! f 0 2.5)
(c-view-set! f 3 -1)
(check "f64 ref" (c-view-ref f 0) 2.5)
(check "f64 from int" (c-view-ref f 3) -1.0)
(check "aliasing u64 sees f64 write" (= (c-view-ref u 1) 0) #f)
(define b (c-view blk 0 64 'u8))
(check "u8 low byte" (c-view-ref b 0) 7)
(define sub (c-view f 8 2 'f64))         ; view of a view: elements 1..2 of f
(c-view-set! sub 1 9.75)
(check "sub view composes" (c-view-ref f 2) 9.75)
(check "sub view bounded by parent" (raises? (lambda () (c-view f 8 4 'f64))) #t)
(define i32 (c-view blk 0 2 'i32))
(c-view-set! i32 1 -5)
(check "i32 signed" (c-view-ref i32 1) -5)
(check "u32 unsigned" (c-view-ref (c-view blk 4 1 'u32) 0) 4294967291)

; ── bulk copy into f64vectors ──
(define dst (make-f64vector 6 0.0))
(check "copy! count" (c-view-copy! f dst 1) 4)
(check "copy! f64" (f64vector-ref dst 1) 2.5)
(check "copy! f64 last" (f64vector-ref dst 4) -1.0)
(check "copy! untouched" (f64vector-ref dst 0) 0.0)
(check "copy! does not fit" (raises? (lambda () (c-view-copy! f dst 3))) #t)
(define uv (c-view->f64vector (c-view blk 56 1 'u64)))
(check "view->f64vector converts" (f64vector-ref uv 0) 123456789.0)

; ── seqlock-consistent read ──
(define shm (c-alloc 72))                ; [seq u64][8 x f64]
(define seq (c-view shm 0 1 'u64))
(define vals (c-view shm 8 8 'f64))
(c-view-set! vals 5 42.0)
(define snap (make-f64vector 8 0.0))
(check "consistent read, no retries" (c-view-read-consistent! vals snap seq) 0)
(check "consistent read copied" (f64vector-ref snap 5) 42.0)
(c-view-set! seq 0 3)                    ; writer mid-update (odd)
(check "odd sequence never copies" (raises? (lambda () (c-view-read-consistent! vals snap seq 0 50))) #t)

; ── use after free ──
(c-free blk)
(check "ref after owner c-free raises" (raises? (lambda () (c-view-ref u 0))) #t)
(check "sub view after owner free raises" (raises? (lambda () (c-view-ref sub 0))) #t)
(check "copy! after free raises" (raises? (lambda () (c-view-copy! f dst))) #t)
(check "length after free raises" (raises? (lambda () (c-view-length u))) #t)
(check "c-free of a view keeps the owner" (begin (c-free seq) (c-view-ref vals 5)) 42.0)
(check "freed view raises" (raises? (lambda () (c-view-ref seq 0))) #t)

; ── raw pointers need a byte length ──
(define raw (c-opaque (+ (c-opaque->int shm) 8)))   ; interior address: size unknown
(check "raw pointer without length" (raises? (lambda () (c-view raw 0 1 'u64))) #t)
(check "raw pointer with length" (c-view-ref (c-view raw 40 1 'f64 64) 0) 42.0)
(check "c-alloc address via c-opaque keeps its size" (c-view-length (c-view (c-opaque (c-opaque->int shm)) 0 9 'u64)) 9)
(check "polling an address reuses its slot" (equal? (c-opaque 4096) (c-opaque 4096)) #t)

; ── bulk f64vector ops (boot prims) ──
(define x (f64v '(1.0 5.0 2.0 5.0)))
(define y (f64v '(0.5 1.0 1.0 2.0)))
(check "sum" (f64vector-sum x) 13.0)
(check "max-index first on ties" (f64vector-max-index x) 1)
(check "max-index empty" (f64vector-max-index (make-f64vector 0)) -1)
(define d (make-f64vector 4 0.0))
(f64vector-sub! d x y)
(check "sub!" (f64l d) '(0.5 4.0 1.0 3.0))
(f64vector-ewma! d y 0.5)
(check "ewma!" (f64l d) '(0.5 2.5 1.0 2.5))
(check "sub! length mismatch" (raises? (lambda () (f64vector-sub! d x (make-f64vector 3)))) #t)

; ── handles: finalizer runs exactly once ──
(define setenv (c-func -1 "setenv" "(String String Int) -> Int"))
(define getenv-p (c-func -1 "getenv" "(String) -> Int"))
(define strdup (c-func -1 "strdup" "(String) -> Opaque"))
(define unsetenv (c-func -1 "unsetenv" "(Opaque) -> Int"))
(setenv "AURA_4556_H" "1" 1)
(define h (c-handle (strdup "AURA_4556_H") unsetenv 'env-var))
(check "handle tag" (c-handle-tag h) "env-var")
(check "handle live" (c-handle-live? h) #t)
(check "not yet finalized" (= (getenv-p "AURA_4556_H") 0) #f)
(check "first close" (c-close! h) #t)
(check "finalizer ran" (getenv-p "AURA_4556_H") 0)
(setenv "AURA_4556_H" "1" 1)
(check "second close is a no-op" (c-close! h) #f)
(check "finalizer did not run twice" (= (getenv-p "AURA_4556_H") 0) #f)
(check "closed handle not live" (c-handle-live? h) #f)
(define h2 (c-handle (strdup "AURA_4556_H") unsetenv))
(define hv (c-view h2 0 4 'u8 12))
(check "view onto a handle" (c-view-ref hv 0) 65)
(c-free h2)                              ; c-free closes a handle
(check "c-free ran the finalizer" (getenv-p "AURA_4556_H") 0)
(check "view onto closed handle raises" (raises? (lambda () (c-view-ref hv 0))) #t)
(check "close non-handle raises" (raises? (lambda () (c-close! raw))) #t)
(check "no finalizer" (c-close! (c-handle 4096 #f)) #t)

; ── Issue #4597: f64vector ops on an 'f64 view ──
(define blk2 (c-alloc 64))
(define fv (c-view blk2 0 4 'f64))
(c-view-set! fv 0 1.5)
(c-view-set! fv 1 2.5)
(c-view-set! fv 2 3.5)
(c-view-set! fv 3 4.5)
(check "f64 view length" (f64vector-length fv) 4)
(check "f64 view ref" (f64vector-ref fv 1) 2.5)
(check "f64 view dot" (f64vector-dot fv fv) 41.0)
(define fvs (f64v '(1.5 2.5 3.5 4.5)))
(check "f64 view dot view/string" (f64vector-dot fv fvs) 41.0)
(check "f64 view dot string/view" (f64vector-dot fvs fv) 41.0)
(check "f64 view dot window" (f64vector-dot fv fv 1 1 2) 18.5)
(define u2 (c-view blk2 32 2 'u64))
(check "u64 view is not an f64vector" (raises? (lambda () (f64vector-length u2))) #t)
(check "f64vector-set! rejects a view" (raises? (lambda () (f64vector-set! fv 0 1.0))) #t)
(c-free blk2)
(check "f64 view ref after free" (raises? (lambda () (f64vector-ref fv 0))) #t)
(check "f64 view length after free" (raises? (lambda () (f64vector-length fv))) #t)
(check "f64 view dot after free" (raises? (lambda () (f64vector-dot fv fv))) #t)

; ── slot recycle: a stale value must not alias the new tenant ──
(define r1 (c-handle 8192 #f "rk.memtable"))
(check "recycle address" (c-opaque->int r1) 8192)
(check "recycle close" (c-close! r1) #t)
(define r2 (c-handle 16384 #f "rk.memtable"))
(check "recycled slot is a new value" (equal? r1 r2) #f)
(check "stale handle not live" (c-handle-live? r1) #f)
(check "stale close is a no-op" (c-close! r1) #f)
(check "new tenant address" (c-opaque->int r2) 16384)
(check "stale c-opaque->int raises" (raises? (lambda () (c-opaque->int r1))) #t)
(check "new handle live" (c-handle-live? r2) #t)

; ── Handle:tag on the c-func path ──
(define strlen-h (c-func -1 "strlen" "(Handle:rk.memtable) -> Int"))
(define strlen-o (c-func -1 "strlen" "(Opaque) -> Int"))
(define hi (c-handle (strdup "hi") #f "rk.memtable"))
(define hi-raw (c-opaque (c-opaque->int hi)))
(define hi-other (c-handle (strdup "hi") #f "other"))
(check "typed handle strlen" (strlen-h hi) 2)
(check "wrong tag raises" (raises? (lambda () (strlen-h hi-other))) #t)
(check "raw opaque is not a typed handle" (raises? (lambda () (strlen-h hi-raw))) #t)
(check "int is not a typed handle" (raises? (lambda () (strlen-h 1))) #t)
(check "typed handle message"
  (try (strlen-h hi-raw) (catch (e) e))
  "c-func strlen: argument 1: This argument must be an `rk.memtable` handle, got Opaque")
(check "opaque sig accepts a handle" (strlen-o hi) 2)
(check "opaque sig accepts a raw opaque" (strlen-o hi-raw) 2)

; ── file-mode reclaim finalizes an unreachable handle, once ──
(define (reclaim-4597)
  (setenv "AURA_4597_K" "1" 1)
  (setenv "AURA_4597_R" "1" 1)
  (define keep (c-handle (strdup "AURA_4597_K") unsetenv))
  (define drop (c-handle (strdup "AURA_4597_R") unsetenv))
  (set! drop #f)
  (let loop ((i 0))
    (if (< i 8192) (begin (cons i '()) (loop (+ i 1))) 0))
  (define keep-dead (= (getenv-p "AURA_4597_K") 0))
  (define drop-dead (= (getenv-p "AURA_4597_R") 0))
  (c-close! keep)
  (cons keep-dead drop-dead))
(define rr (reclaim-4597))
(check "reclaim keeps a live handle" (car rr) #f)
(check "reclaim finalizes an unreachable handle" (cdr rr) #t)

(if (and (= *fails* 0) (= *passes* 83))
    (display "OK-4556 native memory views, bulk f64vector ops and handles\n")
    (begin
      (display "FAIL-4556 fails=") (display *fails*)
      (display " passes=") (display *passes*) (newline)
      (exit 1)))
