; Issue #4549: std/list sort and list-sort keep Floats, sort strings, take
; a comparator, and raise otherwise. This file requires only std/list.
; std/sort's generic sort is a different binding and lives in sort_srfi_5133.
(require "std/test" all:)
(require "std/list" all:)
(test-file "list_sort_nonint_4549.aura")

(define (raises? th) (try (begin (th) #f) (catch (e) #t)))

(define big
  (let loop ((i 0) (acc (list)))
    (if (= i 500)
        acc
        (loop (+ i 1) (cons (* 1.5 (modulo (* i 7919) 500)) acc)))))

(test-case "ints and floats" (hash "issue" 4549)
  (check= (list 1 2 3) (list-sort (list 3 1 2)))
  (check= (list -7 -1 0 5 5) (list-sort (list 5 -1 5 0 -7)))
  (check= (list) (list-sort (list)))
  (check= (list 1.7 2.5 3.9) (list-sort (list 2.5 1.7 3.9)))
  (check (float? (car (list-sort (list 2.5 1.7)))))
  (define mixed (list-sort (list 3 1.5 2 0.25 -1)))
  (check= (list -1 0.25 1.5 2 3) mixed)
  (check (integer? (car mixed)))
  (check (float? (cadr mixed))))

(test-case "strings" (hash "issue" 4549)
  (check= (list "a" "b" "c") (list-sort (list "b" "a" "c")))
  (check= (list "" "a" "aa" "ab" "b") (list-sort (list "ab" "a" "b" "" "aa")))
  (check= (list "a" "b" "c") (sort (list "b" "a" "c")))
  (check= (list 1.7 2.5 3.9) (sort (list 2.5 1.7 3.9)))
  (check= (list 7 8 9) (sort (list 9 8 7)))
  (check= (list) (sort (list))))

(test-case "comparators" (hash "issue" 4549)
  (check= (list 3 2 1) (list-sort (list 3 1 2) >))
  (check= (list "a" "b" "c") (list-sort string<? (list "b" "a" "c")))
  (check= (list "ccc" "bb" "a")
          (list-sort (list "bb" "a" "ccc")
                     (lambda (x y) (> (string-length x) (string-length y)))))
  (check= (list 3 2 1) (sort (list 1 3 2) >))
  (check= (list (list 1 "b") (list 1 "d") (list 2 "a") (list 2 "c"))
          (list-sort (list (list 2 "a") (list 1 "b") (list 2 "c") (list 1 "d"))
                     (lambda (x y) (< (car x) (car y)))))
  (check= (list "k1" "k2")
          (map car (sort (list (cons "k2" 2) (cons "k1" 1))
                         (lambda (x y) (string<? (car x) (car y)))))))

(test-case "unsupported values raise" (hash "issue" 4549)
  (check (raises? (lambda () (list-sort (list 1 "x")))))
  (check (raises? (lambda () (list-sort (list #t #f)))))
  (check (raises? (lambda () (sort (list "a" 1)))))
  (check (raises? (lambda () (list-sort (list 1 2) 5)))))

(test-case "five hundred floats" (hash "issue" 4549)
  (define sorted-big (list-sort big))
  (check= 500 (length sorted-big))
  (check (let loop ((ys sorted-big))
           (cond ((null? (cdr ys)) #t)
                 ((> (car ys) (cadr ys)) #f)
                 (else (loop (cdr ys))))))
  (check= sorted-big (list-sort big <)))

(test-case "hot string sort" (hash "issue" 4549)
  (define (hot-sort) (list-sort (list "pear" "apple" "fig")))
  (let loop ((i 0) (ok #t))
    (if (< i 2000)
        (loop (+ i 1) (and ok (equal? (hot-sort) (list "apple" "fig" "pear"))))
        (check ok))))

(test-finish)
