; #5066: the integer fast path must stay exact under fibers.
; A local shadow of `+` is not the primitive. set! on a cell is re-read
; on later iterations. Floor modulo keeps the divisor's sign.
; Many fibers agree on the sum.
(require "std/test" all:)
(test-file "issue_5066_fiber_fastpath.aura")

(define (shadowed)
  (let ((+ (lambda (a b) 0)))
    (+ 1 2)))

(define W 10)

(define (bump)
  (let loop ((i 0) (a 0))
    (if (>= i 5) a
      (begin
        (set! W (+ W 1))
        (loop (+ i 1) (+ a W))))))

(define (floorm)
  (if (and (= (modulo -5 3) 1)
           (= (modulo 5 -3) -1)
           (= (modulo -5 -3) -2))
      1
      0))

(define WORK 3000)

(define (body)
  (let loop ((i 0) (a 0))
    (if (>= i WORK) a
      (loop (+ i 1) (+ a (modulo i 7))))))

(define (spawn-n n)
  (let loop ((i 0) (ids '()))
    (if (>= i n) ids
      (loop (+ i 1) (cons (fiber:spawn (lambda () (body))) ids)))))

(define (join-all xs acc)
  (if (null? xs) acc
    (join-all (cdr xs) (+ acc (fiber:join (car xs))))))

; #5304: a call inside the named let stays exact on a fiber. A literal
; function, vector-ref, and list-ref of a fresh literal list fold to the
; number. tick must still run once per step (its body is not a literal).
(define V5304 (vector 1 2 3 4 5 6 7 8))
(define (five5304) 5)
(define T5304 0)
(define (tick5304) (set! T5304 (+ T5304 1)) 1)
(define (sum-const5304 n)
  (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s 3)) s)))
(define (sum-five5304 n)
  (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (five5304))) s)))
(define (sum-vref5304 n)
  (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (vector-ref V5304 5))) s)))
(define (sum-mod5304 n)
  (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (modulo i 7))) s)))
(define (sum-lref5304 n)
  (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (list-ref (list 1 2 3) 2))) s)))
(define (sum-local5304 n)
  (let ((v (vector 1 2 3 4 5 6 7 8)))
    (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (vector-ref v 5))) s))))
(define (sum-tick5304 n)
  (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (tick5304))) s)))
(define (run-tick5304 n)
  (set! T5304 0)
  (let ((s (sum-tick5304 n)))
    (if (and (= s n) (= T5304 n)) 1 0)))

; #5304: a changing index stays exact. Length and car of a captured value
; are the same number the primitive returns. A local shadow is not folded.
(define (sum-idx5304 v n)
  (let loop ((i 0) (s 0))
    (if (>= i n) s (loop (+ i 1) (+ s (vector-ref v i))))))
(define (sum-off5304 v n)
  (let loop ((i 1) (s 0))
    (if (> i n) s (loop (+ i 1) (+ s (vector-ref v (- i 1)))))))
(define (sum-len5304 v n)
  (let loop ((i 0) (s 0))
    (if (>= i n) s (loop (+ i 1) (+ s (vector-length v))))))
(define (sum-car5304 p n)
  (let loop ((i 0) (s 0))
    (if (>= i n) s (loop (+ i 1) (+ s (car p))))))
(define (sum-shadow5304 v n)
  (let ((vector-ref (lambda (a b) 1)))
    (let loop ((i 0) (s 0))
      (if (>= i n) s (loop (+ i 1) (+ s (vector-ref v i)))))))
(define (sum-rebind5304)
  (let loop ((i 0) (s 0) (v (vector 4 5 6)))
    (if (>= i 3) s
      (loop (+ i 1) (+ s (vector-ref v i)) (vector 7 8 9)))))
(define P5304 (cons 6 0))

(test-case "named-let calls stay exact under fibers" (hash "issue" 5304)
  (check= 60 (sum-const5304 20))
  (check= 100 (sum-five5304 20))
  (check= 120 (sum-vref5304 20))
  (check= 57 (sum-mod5304 20))
  (check= 60 (sum-lref5304 20))
  (check= 120 (sum-local5304 20))
  (check= 1 (run-tick5304 20))
  (check= 100 (fiber:join (fiber:spawn (lambda () (sum-five5304 20)))))
  (check= 120 (fiber:join (fiber:spawn (lambda () (sum-vref5304 20)))))
  (check= 57 (fiber:join (fiber:spawn (lambda () (sum-mod5304 20)))))
  (check= 60 (fiber:join (fiber:spawn (lambda () (sum-lref5304 20)))))
  (check= 120 (fiber:join (fiber:spawn (lambda () (sum-local5304 20)))))
  (check= 1 (fiber:join (fiber:spawn (lambda () (run-tick5304 20)))))
  (check= 10 (sum-idx5304 (vector 1 2 3 4) 4))
  (check= 10 (sum-off5304 (vector 1 2 3 4) 4))
  (check= 40 (sum-len5304 (vector 1 2 3 4 5 6 7 8) 5))
  (check= 30 (sum-car5304 P5304 5))
  (set-car! P5304 8)
  (check= 40 (sum-car5304 P5304 5))
  (check= 4 (sum-shadow5304 (vector 9 9 9 9) 4))
  (check= 21 (sum-rebind5304))
  (check= 10 (fiber:join (fiber:spawn (lambda () (sum-idx5304 (vector 1 2 3 4) 4)))))
  (check= 40 (fiber:join (fiber:spawn (lambda () (sum-len5304 (vector 1 2 3 4 5 6 7 8) 5)))))
  (check= 18 (fiber:join (fiber:spawn (lambda () (sum-car5304 (cons 6 0) 3))))))

(test-case "integer fast path under fibers" (hash "issue" 5066)
  (define one (body))
  (check= 0 (fiber:join (fiber:spawn (lambda () (shadowed)))))
  (check= 65 (fiber:join (fiber:spawn (lambda () (bump)))))
  (check= 1 (fiber:join (fiber:spawn (lambda () (floorm)))))
  (check= (* 16 one) (join-all (spawn-n 16) 0)))

(test-finish)
