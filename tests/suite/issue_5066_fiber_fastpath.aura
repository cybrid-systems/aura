; #5066: the integer fast path must stay exact under fibers.
; A local shadow of `+` is not the primitive. set! on a cell is re-read
; on later iterations. Floor modulo keeps the divisor's sign.
; Many fibers agree on the sum.
(require "std/test" all:)
(test-file "issue_5066_fiber_fastpath.aura")

(define (shadowed)
  (let ((+ (lambda (a b) 0)))
    (+ 1 2)))

(define W 10)

(define (bump)
  (let loop ((i 0) (a 0))
    (if (>= i 5) a
      (begin
        (set! W (+ W 1))
        (loop (+ i 1) (+ a W))))))

(define (floorm)
  (if (and (= (modulo -5 3) 1)
           (= (modulo 5 -3) -1)
           (= (modulo -5 -3) -2))
      1
      0))

(define WORK 3000)

(define (body)
  (let loop ((i 0) (a 0))
    (if (>= i WORK) a
      (loop (+ i 1) (+ a (modulo i 7))))))

(define (spawn-n n)
  (let loop ((i 0) (ids '()))
    (if (>= i n) ids
      (loop (+ i 1) (cons (fiber:spawn (lambda () (body))) ids)))))

(define (join-all xs acc)
  (if (null? xs) acc
    (join-all (cdr xs) (+ acc (fiber:join (car xs))))))

(test-case "integer fast path under fibers" (hash "issue" 5066)
  (define one (body))
  (check= 0 (fiber:join (fiber:spawn (lambda () (shadowed)))))
  (check= 65 (fiber:join (fiber:spawn (lambda () (bump)))))
  (check= 1 (fiber:join (fiber:spawn (lambda () (floorm)))))
  (check= (* 16 one) (join-all (spawn-n 16) 0)))

(test-finish)
