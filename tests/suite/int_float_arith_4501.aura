;; expect: 2.0 2.25 0.5 1.75 8.0 3.5
;; Issue #4501: Int op Float after an earlier Float op Int expression
;; must not truncate the float operand.
(display (+ 1.0 1)) (display " ")
(display (+ 2 0.25)) (display " ")
(display (* 2 0.25)) (display " ")
(display (- 2 0.25)) (display " ")
(display (/ 2 0.25)) (display " ")
(display (+ 1 (* 2 1.25)))
