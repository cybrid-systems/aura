;; expect: OK-algorithm-native-sort
; std/algorithm sort-stable / sort-by call native list-sort (stable
; iterative merge). Sorted input, duplicate keys, and pairs must match
; the native order and must not blow the recursion limit.
(require "std/list" all:)
(require "std/algorithm" all:)

(define *fails* 0)
(define *passes* 0)
(define (check name got want)
  (if (equal? got want)
      (set! *passes* (+ *passes* 1))
      (begin (set! *fails* (+ *fails* 1))
             (display "  FAIL: ") (display name)
             (display " got ") (display got)
             (display " want ") (display want) (newline))))

(define (iota-range n)
  (range 0 n))

(define (sorted-ascending? xs)
  (let loop ((ys xs))
    (cond ((or (null? ys) (null? (cdr ys))) #t)
          ((> (car ys) (cadr ys)) #f)
          (else (loop (cdr ys))))))

; Already-sorted input used to recurse once per element and die at n=600.
(define s1 (sort-stable (iota-range 1000)))
(check "sorted 1k stable" s1 (iota-range 1000))
(check "sorted 1k order" (sorted-ascending? s1) #t)
(define s8 (sort-stable (iota-range 8000)))
(check "sorted 8k stable" s8 (iota-range 8000))
(check "sorted 8k = native" s8 (list-sort (iota-range 8000)))

(define by1 (sort-by (iota-range 1000) (lambda (x) x)))
(check "sorted 1k sort-by" by1 (list-sort (iota-range 1000)))

; Pairs: the old pivot sort compared with < and raised
; "type mismatch — expected Int".
(define pairs (list (cons 3 "c") (cons 1 "a") (cons 2 "b") (cons 1 "d")))
(define pairs-key (lambda (p) (car p)))
(define pairs-less (lambda (a b) (< (car a) (car b))))
(check "pairs sort-by" (sort-by pairs pairs-key) (list-sort pairs pairs-less))
(check "pairs stable order"
       (sort-by pairs pairs-key)
       (list (cons 1 "a") (cons 1 "d") (cons 2 "b") (cons 3 "c")))

; Reverse input, same order as native, including stability of equal keys.
(define rev (list (cons 2 "a") (cons 2 "b") (cons 1 "c") (cons 2 "d")))
(check "stable = native"
       (sort-by rev (lambda (p) (car p)))
       (list-sort rev (lambda (a b) (< (car a) (car b)))))
(check "stable keeps equals"
       (sort-by rev (lambda (p) (car p)))
       (list (cons 1 "c") (cons 2 "a") (cons 2 "b") (cons 2 "d")))

; First key is the minimum and keys repeat (modulo buckets). This used
; to recurse to depth n and overflow at 20000.
(define buckets (iota-range 20000))
(define bucket-key (lambda (x) (modulo x 1000)))
(define bucket-less (lambda (a b) (< (modulo a 1000) (modulo b 1000))))
(define by-bucket (sort-by buckets bucket-key))
(define native-bucket (list-sort buckets bucket-less))
(check "modulo 20k length" (length by-bucket) 20000)
(check "modulo 20k = native" by-bucket native-bucket)
(check "modulo 20k head" (bucket-key (car by-bucket)) 0)
(check "modulo 20k tail" (bucket-key (list-ref by-bucket 19999)) 999)

; sort-stable on a short mixed run matches list-sort, including strings.
(check "strings stable" (sort-stable (list "b" "a" "c")) (list-sort (list "b" "a" "c")))
(check "empty" (sort-stable (list)) (list))
(check "singleton sort-by" (sort-by (list (cons 4 "z")) car) (list (cons 4 "z")))

(if (and (= *fails* 0) (= *passes* 16))
    (display "OK-algorithm-native-sort\n")
    (begin
      (display "FAIL-algorithm-native-sort fails=") (display *fails*)
      (display " passes=") (display *passes*) (newline)
      (exit 1)))
