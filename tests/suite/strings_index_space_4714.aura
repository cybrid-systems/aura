; Issue #4714: string construction, append, length, substring, equal?,
; and string->number agree after the heap grows past its first capacity.
(require "std/test" all:)
(test-file "strings_index_space_4714.aura")

(define (mk i) (string-append "s" (number->string i)))

(define (len-sum n acc)
  (if (= n 0) acc (len-sum (- n 1) (+ acc (string-length (mk n))))))

(test-case "one accessor" (hash "issue" 4714)
  (check= "s42" (mk 42))
  (check= 5 (string-length (mk 4714)))
  (check (equal? (mk 7) (string-append "s" "7")))
  (check= "47" (substring (mk 4714) 1 3))
  (check= 47 (string->number (substring (mk 4714) 1 3)))
  (check= 292 (len-sum 100 0))
  (check= 8893 (len-sum 2000 0))
  (check= "s2000" (mk 2000))
  (check= "s1" (mk 1)))

(test-finish)
