;; expect: 0.5 -0.5 2.0 (1 . 2) (1.0 2) 0.5
; #4498: .5, -.5 and 1. are float literals; (1 . 2) is still a dotted pair.
(display .5) (display " ")
(display -.5) (display " ")
(display (+ 1. 1.)) (display " ")
(display (quote (1 . 2))) (display " ")
(display (list 1. 2)) (display " ")
(display (* 2 .25))
(newline)
