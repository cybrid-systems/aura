; Issue #5160: json-encode writes a vector as a JSON array.
; A vector used to become null, including inside a list or a hash.
(require "std/test" all:)
(test-file "json_encode_vector_5160.aura")

(test-case "encode vectors" (hash "issue" 5160)
  (check= "[1,2.5]" (json-encode (vector 1 2.5)))
  (check= "{\"pieces\":[[1,2]]}"
          (json-encode (hash "pieces" (list (vector 1 2)))))
  (check= "[]" (json-encode (vector)))
  (check= "[1,[2,3]]" (json-encode (list 1 (vector 2 3))))
  (check= "[[1],[2]]" (json-encode (vector (vector 1) (list 2))))
  (check= "[\"a\\\"b\"]" (json-encode (vector "a\"b"))))

(test-finish)
