;; Issue #5032: the math/regex registrations moved out of one 680-line function
;; into RegSplitParts helpers. The names, order and semantics must not move.
(define fails 0)
(define (check pred msg)
  (if pred
      #t
      (begin (set! fails (+ fails 1)) (display (format "FAIL ~a\n" msg)))))
(check (= 0.0 (sin 0)) "sin")
(check (= 2 (round 2.5)) "round half to even")
(check (= 2 (modulo -7 3)) "modulo sign")
(check (= 6 (gcd 12 18)) "gcd")
(check (= 42 (lcm 6 14)) "lcm")
(check (= 5 (max 1 5 2)) "max")
(check (= 1 (min 1 5 2)) "min")
(check (= 1 (regex-match? "b+" "abbc")) "regex-match?")
;; Issue #5322: every regex-* call used to pay a fixed 1 ms poll sleep in
;; the #2479 timed worker (~1.1 ms/call even for "a" against "a"). The
;; parked worker wakes on completion, so 200 short calls cost a few ms.
;; The pre-fix shape was ~230 ms; 50 ms keeps ~10x headroom for a loaded
;; box while still failing any return of the sleep floor.
(define (time-200 th)
  (th)
  (let ((t0 (monotonic-ms)))
    (let loop ((i 0)) (if (< i 200) (begin (th) (loop (+ i 1))) #f))
    (- (monotonic-ms) t0)))
(define match-ms (time-200 (lambda () (regex-match? "a" "a"))))
(define split-ms (time-200 (lambda () (regex-split "," "a,b,c,d"))))
(display (list "regex-match? x200 ms" match-ms "regex-split x200 ms" split-ms))
(newline)
(check (< match-ms 50) "regex-match? 200 short calls stay off the 1 ms poll floor")
(check (< split-ms 50) "regex-split 200 short calls stay off the 1 ms poll floor")

(if (> fails 0)
    (error "math split regression")
    (begin (display "math split ok") (newline)))
