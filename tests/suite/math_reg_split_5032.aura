;; Issue #5032: the math/regex registrations moved out of one 680-line function
;; into RegSplitParts helpers. The names, order and semantics must not move.
(define fails 0)
(define (check pred msg)
  (if pred
      #t
      (begin (set! fails (+ fails 1)) (display (format "FAIL ~a\n" msg)))))
(check (= 0.0 (sin 0)) "sin")
(check (= 2 (round 2.5)) "round half to even")
(check (= 2 (modulo -7 3)) "modulo sign")
(check (= 6 (gcd 12 18)) "gcd")
(check (= 42 (lcm 6 14)) "lcm")
(check (= 5 (max 1 5 2)) "max")
(check (= 1 (min 1 5 2)) "min")
(check (= 1 (regex-match? "b+" "abbc")) "regex-match?")
(if (> fails 0)
    (error "math split regression")
    (begin (display "math split ok") (newline)))
