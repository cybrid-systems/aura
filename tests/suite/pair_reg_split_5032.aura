;; Issue #5032: pair/list/string registrations moved into RegSplitParts.
(define fails 0)
(define (check pred msg)
  (if pred #t (begin (set! fails (+ fails 1)) (display (format "FAIL ~a\n" msg)))))
(define p (cons 1 (cons 2 '())))
(check (= 1 (car p)) "car")
(check (= 2 (car (cdr p))) "cdr/car")
(check (equal? "ab" (string-append "a" "b")) "string-append")
(check (= 42 (string->number "42")) "string->number")
(check (equal? "42" (number->string 42)) "number->string")
(check (equal? "abc" (list->string (string->list "abc"))) "string->list")
(if (> fails 0)
    (error "pair split regression")
    (begin (display "pair split ok") (newline)))
