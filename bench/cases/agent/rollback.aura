; Class 2 rollback. set-code, find the LiteralInt whose value is 0,
; mutate:replace-value to 7, read it back, workspace:rollback-latest, read again.
; Checksum is mid*10+after. A restored literal is 70.
(define (find-zero ids)
  (let ((rest ids) (found -1))
    (while (and (pair? rest) (< found 0))
      (let ((node (query :node (car rest))))
        (if (= (car (cdr node)) 0)
            (set! found (car rest))
            (set! rest (cdr rest)))))
    found))
(define src (getenv "BENCH_SRC"))
(if (not (string? src)) (set! src "(define x 0)"))
(define t0 (monotonic-ms))
(set-code src)
(eval-current)
(define id (find-zero (query:node-type "LiteralInt")))
(mutate:replace-value id 7 "rb")
(define mid (car (cdr (query :node id))))
(workspace:rollback-latest)
(define after (car (cdr (query :node id))))
(define t1 (monotonic-ms))
(display "BENCH rollback ")
(display (+ (* mid 10) after))
(display " ")
(display (- t1 t0))
(newline)
