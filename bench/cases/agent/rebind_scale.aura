; Issue #4598 / #4678: rebind latency vs workspace size W and caller fan-in D.
; BENCH_W filler defines, BENCH_D callers of f. 20 rebind+eval cycles.
; Checksum: sum over cycles i of (c0 100) after rebinding f to (+ x i)
; = 20*100 + (0+...+19) = 2190 when D>0, else sum of (f 100) (same).
(define W (let ((s (getenv "BENCH_W"))) (if (string? s) (string->number s) 100)))
(define D (let ((s (getenv "BENCH_D"))) (if (string? s) (string->number s) 1)))
(define (fill k acc)
  (if (= k 0) acc
      (fill (- k 1) (string-append acc "(define w" (number->string k) " (lambda (x) (* x " (number->string k) ")))\n"))))
(define (callers k acc)
  (if (= k 0) acc
      (callers (- k 1) (string-append acc "(define c" (number->string (- k 1)) " (lambda (x) (f x)))\n"))))
;; 20-clause body (never matches x=100) so the rebind takes the full
;; impact/relower path rather than the one-line light path (#4357).
(define (cl k acc)
  (if (= k 20) acc
      (cl (+ k 1) (string-append acc "((= x -" (number->string (+ k 1)) ") " (number->string k) ")"))))
(define (body v) (string-append "(lambda (x) (cond " (cl 0 "") " (else (+ x " (number->string v) "))))"))
(set-code (string-append "(define f " (body 0) ")\n" (callers (if (> D 0) D 1) "") (fill W "")))
(eval-current)
(define t0 (monotonic-ms))
(define sum 0)
(let loop ((i 0))
  (if (< i 20)
      (begin
        (mutate:rebind "f" (body i) "bench")
        (eval-current)
        (set! sum (+ sum (c0 100)))
        (loop (+ i 1)))))
(define t1 (monotonic-ms))
(display "BENCH rebind-scale ")
(display sum)
(display " ")
(display (- t1 t0))
(newline)
