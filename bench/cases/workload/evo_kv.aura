; Class 3 evo-kv style: hash set, full get, and a zrange over keys [100, 150).
; Values are key*3. n=500. full sum = 374250, zrange = 18675, checksum = 392925.
(define (kv n)
  (let ((h (hash)) (i 0) (s 0) (z 0) (k 100))
    (while (< i n)
      (hash-set! h i (* i 3))
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i n)
      (set! s (+ s (hash-ref h i)))
      (set! i (+ i 1)))
    (while (< k 150)
      (set! z (+ z (hash-ref h k)))
      (set! k (+ k 1)))
    (+ s z)))
(kv 160)
(define t0 (monotonic-ms))
(define r (kv 500))
(define t1 (monotonic-ms))
(display "BENCH evo-kv ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
