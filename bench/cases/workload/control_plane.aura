; Class 3 control plane: a SET/GET dispatch table over a hash, 400 keys.
; Checksum is the sum of the gets, 0..399 = 79800.
(define store (hash))
(define (dispatch op k v)
  (if (string=? op "SET")
      (begin (hash-set! store k v) v)
      (hash-ref store k)))
(define (run-plane n)
  (let ((i 0) (s 0))
    (while (< i n)
      (dispatch "SET" i i)
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i n)
      (set! s (+ s (dispatch "GET" i 0)))
      (set! i (+ i 1)))
    s))
(run-plane 4)
(define t0 (monotonic-ms))
(define r (run-plane 400))
(define t1 (monotonic-ms))
(display "BENCH control-plane ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
