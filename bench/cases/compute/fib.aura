; Class 1. Host prims only so `aura --jit` can run this source unchanged.
; Timer is monotonic-ms around fib(18). The fib(8) call is untimed warmup.
(define (fib n)
  (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(fib 8)
(define t0 (monotonic-ms))
(define r (fib 18))
(define t1 (monotonic-ms))
(display "BENCH fib ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
