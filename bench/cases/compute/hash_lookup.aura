; Class 1 hash insert then lookup. Checksum is the sum of the values.
(define (hash-work n)
  (let ((h (hash)) (i 0) (s 0))
    (while (< i n)
      (hash-set! h i i)
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i n)
      (set! s (+ s (hash-ref h i)))
      (set! i (+ i 1)))
    s))
(hash-work 10)
(define t0 (monotonic-ms))
(define r (hash-work 1500))
(define t1 (monotonic-ms))
(display "BENCH hash-lookup ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
