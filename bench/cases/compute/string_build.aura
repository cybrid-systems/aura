; Class 1 string building via repeated string-append.
(define (sbuild n)
  (let ((i 0) (s ""))
    (while (< i n)
      (set! s (string-append s "a"))
      (set! i (+ i 1)))
    (string-length s)))
(sbuild 20)
(define t0 (monotonic-ms))
(define r (sbuild 2000))
(define t1 (monotonic-ms))
(display "BENCH string-build ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
