; Class 1 integer n-body. Four bodies, 40 steps, force numerator scaled
; by 1000 so quotient is not stuck at 0. Checksum is sum of squares of
; positions (total momentum is invariant and would hide the integration).
; Keep this in lockstep with bench/ref_compute.py nbody().
(define (nbody steps)
  (let ((n 4)
        (x (make-vector 4 0))
        (y (make-vector 4 0))
        (vx (make-vector 4 0))
        (vy (make-vector 4 0))
        (scale 1000))
    (vector-set! x 1 40)
    (vector-set! x 3 -30)
    (vector-set! y 2 40)
    (vector-set! y 3 10)
    (vector-set! vx 1 1)
    (vector-set! vx 2 -1)
    (vector-set! vy 2 1)
    (vector-set! vy 3 -1)
    (while (> steps 0)
      (let ((ax (make-vector 4 0)) (ay (make-vector 4 0)) (i 0))
        (while (< i n)
          (let ((j 0))
            (while (< j n)
              (if (not (= i j))
                  (let ((dx (- (vector-ref x j) (vector-ref x i)))
                        (dy (- (vector-ref y j) (vector-ref y i))))
                    (let ((dist2 (+ (+ (* dx dx) (* dy dy)) 1)))
                      (vector-set! ax i (+ (vector-ref ax i) (quotient (* dx scale) dist2)))
                      (vector-set! ay i (+ (vector-ref ay i) (quotient (* dy scale) dist2)))))
                  0)
              (set! j (+ j 1))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i n)
          (vector-set! vx i (+ (vector-ref vx i) (vector-ref ax i)))
          (vector-set! vy i (+ (vector-ref vy i) (vector-ref ay i)))
          (vector-set! x i (+ (vector-ref x i) (vector-ref vx i)))
          (vector-set! y i (+ (vector-ref y i) (vector-ref vy i)))
          (set! i (+ i 1))))
      (set! steps (- steps 1)))
    (let ((i 0) (s 0))
      (while (< i n)
        (let ((px (vector-ref x i)) (py (vector-ref y i)))
          (set! s (+ s (+ (* px px) (* py py)))))
        (set! i (+ i 1)))
      s)))
(nbody 1)
(define t0 (monotonic-ms))
(define r (nbody 40))
(define t1 (monotonic-ms))
(display "BENCH nbody ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
