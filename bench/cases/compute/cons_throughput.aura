; Class 1 cons throughput: allocate n cells, then walk them.
; Walk is iterative so it stays under the recursion guard.
(define (build n)
  (let ((i 0) (xs '()))
    (while (< i n)
      (set! xs (cons i xs))
      (set! i (+ i 1)))
    xs))
(define (len xs)
  (let ((n 0))
    (while (pair? xs)
      (set! n (+ n 1))
      (set! xs (cdr xs)))
    n))
(len (build 20))
(define t0 (monotonic-ms))
(define r (len (build 4000)))
(define t1 (monotonic-ms))
(display "BENCH cons-throughput ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
