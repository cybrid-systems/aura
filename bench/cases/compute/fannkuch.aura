; Class 1 fannkuch max-flips. Iterative count permutation, n=5.
; n=7 exceeds 60s in the interpreter on this box. Checksum 7.
; Same order as bench/ref_compute.py fannkuch().
(define (fannkuch n)
  (let ((perm1 (make-vector n 0))
        (perm (make-vector n 0))
        (count (make-vector n 0))
        (i 0))
    (while (< i n)
      (vector-set! perm1 i i)
      (set! i (+ i 1)))
    (let ((r n) (maxf 0) (done #f))
      (while (not done)
        (while (not (= r 1))
          (vector-set! count (- r 1) r)
          (set! r (- r 1)))
        (set! i 0)
        (while (< i n)
          (vector-set! perm i (vector-ref perm1 i))
          (set! i (+ i 1)))
        (let ((flips 0) (k (vector-ref perm 0)))
          (while (not (= k 0))
            (let ((a 0) (b k))
              (while (< a b)
                (let ((va (vector-ref perm a)) (vb (vector-ref perm b)))
                  (vector-set! perm a vb)
                  (vector-set! perm b va))
                (set! a (+ a 1))
                (set! b (- b 1))))
            (set! flips (+ flips 1))
            (set! k (vector-ref perm 0)))
          (if (> flips maxf) (set! maxf flips) 0))
        (let ((rotating #t))
          (while rotating
            (if (= r n)
                (begin (set! done #t) (set! rotating #f))
                (begin
                  (let ((first (vector-ref perm1 0)) (j 0))
                    (while (< j r)
                      (vector-set! perm1 j (vector-ref perm1 (+ j 1)))
                      (set! j (+ j 1)))
                    (vector-set! perm1 r first))
                  (vector-set! count r (- (vector-ref count r) 1))
                  (if (> (vector-ref count r) 0)
                      (set! rotating #f)
                      (set! r (+ r 1))))))))
      maxf)))
(fannkuch 3)
(define t0 (monotonic-ms))
(define r (fannkuch 5))
(define t1 (monotonic-ms))
(display "BENCH fannkuch ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
