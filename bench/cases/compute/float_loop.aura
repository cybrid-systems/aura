; Class 1 float accumulation. Checksum is 6000 * 1.5.
(define (sumf n)
  (let ((i 0) (a 0.0))
    (while (< i n)
      (set! a (+ a 1.5))
      (set! i (+ i 1)))
    a))
(sumf 10)
(define t0 (monotonic-ms))
(define r (sumf 6000))
(define t1 (monotonic-ms))
(display "BENCH float-loop ")
(display r)
(display " ")
(display (- t1 t0))
(newline)
