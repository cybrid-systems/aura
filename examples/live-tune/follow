#!/usr/bin/env python3
"""Print a log file as it grows (the file is rewritten whole by Aura)."""
import sys, time
path, shown = sys.argv[1], 0
sys.stdout.write("\033[?25l")
while True:
    try:
        lines = open(path, encoding="utf-8").read().split("\n")[:-1]
    except OSError:
        lines = []
    if len(lines) < shown:
        shown = 0
    for l in lines[shown:]:
        print(l, flush=True)
    shown = len(lines)
    time.sleep(0.2)
