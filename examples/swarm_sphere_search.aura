; Example (#2874): pure parameter search with std/swarm (no network).
; Maximize -||x||^2 on R^2 using PSO for 30 generations.
;
;   ./build/aura --load examples/swarm_sphere_search.aura

(require "std/swarm" all:)

(define (sphere ind)
  (let loop ((xs ind) (s 0.0))
    (if (null? xs) (- 0.0 s)
      (loop (cdr xs) (+ s (* (car xs) (car xs)))))))

(swarm:init (hash "kind" "pso"
                  "dim" 2
                  "pop" 16
                  "bounds" (list (list -5.0 5.0) (list -5.0 5.0))
                  "seed" 20260809))

(display "swarm sphere search (PSO)\n")
(let loop ((i 0))
  (if (>= i 30) #t
    (begin
      (swarm:step! sphere)
      (if (= (modulo i 10) 0)
          (begin
            (display "  gen=") (display (swarm:gen))
            (display " best=") (display (swarm:best))
            (display " fit=") (display (hash-ref (swarm:report) "best-fit"))
            (newline))
          #f)
      (loop (+ i 1)))))

(display "final: ") (display (swarm:export)) (newline)
(display "OK swarm example\n")
