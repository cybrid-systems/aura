        "eval_top_level_forms",
        "struct FormSplit",
        "unclosed '(' (missing ')')",
        "unexpected ')'"
      ]
    },
    {
      "ac": "AC2-serve-async-exec-splits-the-chunk",
      "path": "src/serve/serve_async.cpp",
      "contains": [
        "detail::split_top_level_forms(code)",
        "detail::eval_top_level_forms(",
        "parse error: no complete form in exec chunk"
      ]
    },
    {
      "ac": "AC3-sync-serve-exec-splits-the-chunk",
      "path": "src/main.cpp",
      "contains": [
        "aura::serve::detail::split_top_level_forms(code)",
        "aura::serve::detail::eval_top_level_forms("
      ]
    },
    {
      "ac": "AC4-regression-guard",
      "path": "tests/serve/test_serve_legacy_issue_batch.cpp",
      "contains": [
