        "AC2: an unclosed '(' is rejected",
        "AC3: both defines of the chunk are bound (1 2)",
        "AC4: the function define is callable"
      ]
    },
    {
      "ac": "AC-no-issue-dir",
      "forbid": [
        "tests/issues/test_issue_4702.cpp",
        "tests/compiler/test_issue_4702.cpp",
        "tests/serve/test_issue_4702.cpp",
        "docs/design/4702-serve-exec-chunk-forms.md"
      ]
    }
  ]
}
