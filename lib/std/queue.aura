; queue.aura — FIFO queue (two-list, immutable, amortized O(1))
; Import with: (import "std/queue")
;
; The queue is (front back): front holds the FIFO prefix in order, back the
; reversed suffix. enqueue conses onto back; dequeue pops front and refills
; it from back (reverse) when it runs dry. #5328: the old representation was
; a plain list whose enqueue appended the whole queue per element, so n
; enqueues cost O(n^2) (16000 -> 4806 ms in the report).

(export
  make-queue enqueue dequeue queue-front queue-rest
  queue-empty? queue-length queue->list list->queue)

; #5328: the queue is (front back) — front is the FIFO prefix in order,
; back is the reversed suffix. enqueue conses onto back (O(1)) and dequeue
; refills front from back when it runs dry (amortized O(1)). The old shape
; was a plain list whose enqueue appended the whole queue per element:
; 16000 enqueues cost 4806 ms. queue->list / list->queue are conversions
; now, not the identity (#5328 checked: no in-tree caller indexes a queue
; as a list).
(define (make-queue) (list (list) (list)))

(define (queue-front-list q) (car q))
(define (queue-back-list q) (car (cdr q)))

(define (enqueue q elem)
  (list (queue-front-list q) (cons elem (queue-back-list q))))

(define (queue-empty? q)
  (and (null? (queue-front-list q)) (null? (queue-back-list q))))

(define (dequeue q)
  (if (null? (queue-front-list q))
    (if (null? (queue-back-list q))
      (list () (make-queue))
      (let ((f (reverse (queue-back-list q))))
        (list (car f) (list (cdr f) (list)))))
    (list (car (queue-front-list q))
          (list (cdr (queue-front-list q)) (queue-back-list q)))))

(define (queue-front q)
  (if (queue-empty? q) () (car (dequeue q))))

(define (queue-rest q)
  (if (queue-empty? q) (make-queue) (car (cdr (dequeue q)))))

(define (queue-length q)
  (+ (length (queue-front-list q)) (length (queue-back-list q))))

(define (queue->list q)
  (append (queue-front-list q) (reverse (queue-back-list q))))

(define (list->queue lst)
  (list lst (list)))
