; socket.aura — TCP socket library (client + server)
; (require "std/socket" all:)
;
; Uses native C++ socket primitives (not FFI). Thin OS transport E.
;
; Client (#1975):
;   (tcp-connect host port) → socket-fd | ()
;   (tcp-send sock data)    → bytes-sent | -1
;   (tcp-recv sock maxlen)  → string | ()
;   (tcp-close sock)        → void   (also closes listeners)
;
; Server (#2771 multi-host denseness):
;   (tcp-listen port)              → listener-fd | ()  ; 127.0.0.1; port 0 = ephemeral
;   (tcp-local-port sock)          → port | ()         ; getsockname (ephemeral)
;   (tcp-accept listener)          → client-fd | ()    ; blocking
;   (tcp-accept-timeout l sec)     → client-fd | ()    ; poll+accept; 0 = try once
;
; Ownership: caller closes both listener and accepted client fds.
; Errors are void/() — catchable values, not process abort.
; Loopback-only bind keeps denseness probes off the public interface.
;
; Issue #2865: re-export host prims as **value aliases** (same pattern as
; std/io `file-exists?`). Same-name procedure wrappers that call themselves
; in the body shadow the host primitive and recurse → always ().
; Do not reintroduce that pattern. Value aliases resolve the host prim into
; the module cell (#2570 void→prim fallthrough / fill).

(export tcp-connect tcp-send tcp-recv tcp-close
        tcp-listen tcp-local-port tcp-accept tcp-accept-timeout)

(define tcp-connect tcp-connect)
(define tcp-send tcp-send)
(define tcp-recv tcp-recv)
(define tcp-close tcp-close)
(define tcp-listen tcp-listen)
(define tcp-local-port tcp-local-port)
(define tcp-accept tcp-accept)
(define tcp-accept-timeout tcp-accept-timeout)
