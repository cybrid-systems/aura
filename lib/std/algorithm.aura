; Aura standard algorithm library
; Import with: (import "std/algorithm")
; Requires: std/list
;
; sort-stable and sort-by both call the native list-sort (iterative
; stable merge). list-sort accepts a comparator and keeps equal keys in
; input order, so these sorts are stable and do not recurse per element.

(export sort-stable sort-by binary-search merge-sorted
        merge sorted? unique min-by max-by
        permutations combinations)

(require "std/list" all:)
; sorted? is std/sort's (sorted? seq [less?]). One function, so either
; require order accepts the optional comparator (default <).
(require "std/sort" all:)

; ── Sorting extensions ──────────────────────────────

; (sort-by lst key) — stable ascending sort by (key x). The native
; comparator is (lambda (a b) (< (key a) (key b))); equal keys stay in
; input order. key may return any values < accepts, including the car
; of a pair.
(define (sort-by lst key)
  (list-sort lst (lambda (a b) (< (key a) (key b)))))

; (sort-stable lst) — stable sort. Same order as (list-sort lst):
; numbers numerically, strings lexicographically. For any other element
; type, pass a key to sort-by or a comparator to list-sort.
(define (sort-stable lst)
  (list-sort lst))

; ── Merge ────────────────────────────────────────────

(define (merge-sorted a b)
  (cond ((null? a) b)
        ((null? b) a)
        ((< (car a) (car b))
         (cons (car a) (merge-sorted (cdr a) b)))
        (else
         (cons (car b) (merge-sorted a (cdr b))))))

; ── Search ─────────────────────────────────────────

(define (binary-search target lst)
  (let loop ((low 0) (high (- (length lst) 1)))
    (if (> low high) #f
      (let* ((mid (quotient (+ low high) 2))
             (val (list-ref lst mid)))
        (cond ((= val target) mid)
              ((< val target) (loop (+ mid 1) high))
              (else (loop low (- mid 1))))))))

; ── Set operations (on sorted lists) ────────────────

(define (unique lst)
  (if (< (length lst) 2) lst
    (let loop ((prev (car lst)) (rest (cdr lst)) (acc (list (car lst))))
      (if (null? rest) (reverse acc)
        (if (= (car rest) prev)
          (loop prev (cdr rest) acc)
          (loop (car rest) (cdr rest) (cons (car rest) acc)))))))

; ── Aggregations ───────────────────────────────────

(define (min-by lst key)
  (if (null? lst) #f
    (foldl (lambda (a b) (if (< (key a) (key b)) a b))
           (car lst) (cdr lst))))

(define (max-by lst key)
  (if (null? lst) #f
    (foldl (lambda (a b) (if (> (key a) (key b)) a b))
           (car lst) (cdr lst))))

; ── Combinatorics ──────────────────────────────────

(define (permutations lst)
  (if (null? lst) (list (list))
    (apply append
      (map (lambda (x)
             (map (lambda (p) (cons x p))
                  (permutations (filter (lambda (y) (not (= y x))) lst))))
           lst))))

(define (combinations n k)
  (if (or (= k 0) (= k n)) 1
    (+ (combinations (- n 1) (- k 1))
       (combinations (- n 1) k))))
