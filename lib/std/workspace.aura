; lib/std/workspace.aura — Workspace utilities (Issue #563 / #4274)
;
; High-level workspace operations that work around the current C++
; workspace:merge (which does set-code(child-source) — string overwrite).
;
; Provides:
;   ws:merge-symbols child-id    — True per-symbol merge via workspace:sync-from
;   ws:diff child-id             — Show differences between child and parent
;   ws:snapshot-current          — Capture current workspace state
;   ws:list-snapshots            — List all available snapshots
;   ws:rollback-latest           — Roll back to latest snapshot
;   ws:memory-pressure           — Memory pressure indicator
;   ws:current-stats             — Combined stats for AI context
;   ws:state                     — Human-readable workspace snapshot (#5144)
;
(export ws:merge-symbols ws:diff ws:snapshot-current
        ws:list-snapshots ws:rollback-latest
        ws:memory-pressure ws:current-stats
        ws:state)

; ── ws:merge-symbols child-id ──
; Merges individual symbols from child workspace into the active parent.
; Calls (mutate :sync-from child-id name) once per child define name.
; Rejected rebinds are omitted from the returned list (#4274).
; Returns the list of successfully synced define names.
;
(define (ws:merge-symbols child-id)
  (workspace :switch child-id)
  (define defs (stats:get "ast:defs"))
  (workspace :switch 0)
  (define merged '())
  (let iter ((ds (if (pair? defs) defs '())))
    (if (pair? ds)
      (begin
        (define entry (car ds))
        (define name (if (pair? entry) (car entry) #f))
        (when (and (string? name)
                   (mutate :sync-from child-id name))
          (set! merged (cons name merged)))
        (iter (cdr ds)))
      #f))
  merged)

; ── ws:diff ──
; Show what symbols differ between child and parent
(define (ws:diff child-id)
  (list "ws:diff not yet implemented" child-id))

; ── ws:snapshot-current ──
; Capture the current workspace state as a snapshot for
; later rollback. Wraps (mutate :snapshot 0).
(define (ws:snapshot-current)
  (mutate :snapshot 0))

; ── ws:list-snapshots ──
; Return ((id . name) ...) oldest first via stats catalog (#4274).
; Direct (ast:list-snapshots) is unbound — register_stats_impl only.
(define (ws:list-snapshots)
  (stats:get "ast:list-snapshots"))

; ── helper: newest snapshot id from ((id . name) ...) ──
; List is oldest-first; newest id is the last pair's car.
(define (ws:newest-snapshot-id)
  (let ((snaps (stats:get "ast:list-snapshots")))
    (if (not (pair? snaps))
        #f
        (let loop ((s snaps) (last #f))
          (if (null? s)
              last
              (let ((entry (car s)))
                (loop (cdr s)
                      (if (pair? entry) (car entry) last))))))))

; ── ws:rollback-latest ──
; Restore the newest snapshot id (not id 0 / oldest) (#4274).
; No snapshots → #f. Does NOT call workspace:rollback-latest
; (that undoes one mutation-log record, not a named snapshot).
(define (ws:rollback-latest)
  (let ((id (ws:newest-snapshot-id)))
    (if id (mutate :restore id) #f)))

; ── ws:memory-pressure ──
; Return one of "low" / "medium" / "high" based on the
; workspace memory used vs limit. Pure stdlib.
(define (ws:memory-pressure)
  (let ((used (query :memory-used))
        (limit (query :memory-limit)))
    (cond
      ((or (null? limit) (= limit 0)) "unknown")
      ((> (/ used limit) 0.9) "high")
      ((> (/ used limit) 0.6) "medium")
      (else "low"))))

; ── ws:current-stats ──
; Combined stats for AI Agent context windows. Mutation / COW
; counters are stats-catalog only (#4274) — use stats:get.
(define (ws:current-stats)
  (list
    (list "mutation-count" (stats:get "workspace:mutation-count"))
    (list "memory-used"    (query :memory-used))
    (list "memory-limit"   (query :memory-limit))
    (list "cow-refused"    (stats:get "workspace:cow-refused-count"))))


; ── ws:state ──
; Human-readable workspace snapshot for the Agent / EDSL (#5144). The
; retired (workspace-state) primitive printed exactly this text; the
; std formatter rebuilds it from (stats:get "ast:defs") and the intend
; timeline so the output stays byte-identical:
;   WORKSPACE: <n> defines      one header line, <n> = DEFINE: line count
;   DEFINE: <name>              one per define, in workspace (flat) order
;   (no defines)                placeholder when there is no define
;   MUTATIONS (last 10):        timeline section header
;     <i>:<line>                last ten entries, index-prefixed
;   (none)                      placeholder when the timeline is empty
; No workspace AST loaded -> the same WORKSPACE-ERROR line as the engine.
(define (ws:state)
  (define defs (stats:get "ast:defs"))
  (if (void? defs)
      "WORKSPACE-ERROR: no workspace AST loaded"
      (let ((ds (if (pair? defs) defs '())))
        (string-append "WORKSPACE: " (number->string (ws:define-count ds)) " defines\n"
                       (if (= (ws:define-count ds) 0)
                           "(no defines)\n"
                           (ws:define-lines ds))
                       "MUTATIONS (last 10):\n"
                       (ws:last-timeline)))))

; Count the (name . node-id) entries; defensive against a bare name.
(define (ws:define-count ds)
  (let loop ((rest ds) (n 0))
    (if (null? rest)
        n
        (loop (cdr rest) (if (pair? (car rest)) (+ n 1) n)))))

; One "DEFINE: <name>" line per entry, in flat (registration) order.
(define (ws:define-lines ds)
  (let loop ((rest ds) (out ""))
    (if (null? rest)
        out
        (let ((entry (car rest)))
          (loop (cdr rest)
                (if (pair? entry)
                    (string-append out "DEFINE: " (car entry) "\n")
                    out))))))

; Last ten timeline entries, "  <i>:<line>" each. The intend timeline
; snapshot is "i:line\n" per entry with absolute indexes, so keeping the
; prefix and indenting reproduces the engine's timeline_tail(10) text.
(define (ws:last-timeline)
  (let ((hist (intend-history)))
    (if (string=? hist "(empty)")
        "  (none)\n"
        (let* ((lines (ws:split-newlines hist))
               (n (length lines))
               (tail (if (> n 10) (ws:drop (- n 10) lines) lines)))
          (ws:indent-lines tail)))))

; Split on #\newline and drop the trailing empty piece (the final "\n").
(define (ws:split-newlines s)
  (let ((n (string-length s)))
    (let loop ((i 0) (start 0) (acc '()))
      (if (>= i n)
          (let ((piece (substring s start i)))
            (reverse (if (string=? piece "") acc (cons piece acc))))
          (if (= (string-ref s i) 10)
              (loop (+ i 1) (+ i 1) (cons (substring s start i) acc))
              (loop (+ i 1) start acc))))))

; "  " + line + "\n" for each line, concatenated.
(define (ws:indent-lines lines)
  (let loop ((rest lines) (out ""))
    (if (null? rest)
        out
        (loop (cdr rest)
              (string-append out "  " (car rest) "\n")))))

; Drop the first n elements (tail-recursive; keeps the list when short).
(define (ws:drop n lst)
  (if (or (= n 0) (null? lst))
      lst
      (ws:drop (- n 1) (cdr lst))))
