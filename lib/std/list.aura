; Aura standard list library
; Import with: (import "std/list")
;
; Hot-path guidance (#923 / #928 / #1549) for production AI Agents:
;   - Prefer foldl, range, take/skip, zip*, any/all, sort (list-sort),
;     flatten, intersperse — all iterative / constant stack.
;   - foldr is iterative (reverse + foldl); still O(n) heap for reverse.
;   - Avoid deep user recursion over large lists; compose foldl instead.
;   - Native list-sort is preferred over sort-merge for large inputs.

(export foldr foldl map for-each member? zip zip3 take skip take-while drop-while
        partition sort range sum product last flatten intersperse
        intersperse-iterative any all
        make-list list-tail find count remove delete
        assoc assq iota vector-map vector-fill! vector-copy
        values call-with-values)

; foldl: left fold (iterative — constant stack; preferred hot path #923/#928)
(define (foldl f init lst)
  (let loop ((acc init) (xs lst))
    (if (null? xs)
      acc
      (loop (f acc (car xs)) (cdr xs)))))

; foldr: right fold via reverse + foldl (iterative stack; #1549)
; foldr f init (a b c) ≡ f(a, f(b, f(c, init)))
(define (foldr f init lst)
  (foldl (lambda (acc x) (f x acc)) init (reverse lst)))
(define (for-each f lst)
  (let loop ((xs lst))
    (if (null? xs) #t
      (begin (f (car xs)) (loop (cdr xs))))))

(define (member? elem lst)
  (let loop ((xs lst))
    (if (null? xs) #f
      (if (equal? (car xs) elem) #t
        (loop (cdr xs))))))

(define (zip a b)
  (let loop ((xs a) (ys b) (acc (list)))
    (if (or (null? xs) (null? ys))
      (reverse acc)
      (loop (cdr xs) (cdr ys) (cons (list (car xs) (car ys)) acc)))))

(define (zip3 a b c)
  (let loop ((xs a) (ys b) (zs c) (acc (list)))
    (if (or (null? xs) (null? ys) (null? zs))
      (reverse acc)
      (loop (cdr xs) (cdr ys) (cdr zs)
            (cons (list (car xs) (car ys) (car zs)) acc)))))

(define (take-while pred lst)
  (let loop ((xs lst) (acc (list)))
    (if (or (null? xs) (not (pred (car xs))))
      (reverse acc)
      (loop (cdr xs) (cons (car xs) acc)))))

(define (drop-while pred lst)
  (let loop ((xs lst))
    (if (or (null? xs) (not (pred (car xs))))
      xs
      (loop (cdr xs)))))

(define (partition pred lst)
  (list (filter pred lst) (filter (lambda (x) (not (pred x))) lst)))

;
; sort: native list-sort (#923 C++ iterative, stable).
; Issue #4549: (sort xs) orders numbers numerically (Int and Float mixed,
; each element keeps its type) and strings lexicographically; (sort xs less?)
; takes a (less? a b) comparator. Any other list raises an error. It used to
; come back as () — a silent data loss, since () passed the list? fallback.
(define (sort lst . less)
  (cond ((null? lst) lst)
        ((null? less) (list-sort lst))
        (else (list-sort lst (car less)))))

(define (sort-merge lst)
  (if (or (null? lst) (null? (cdr lst)))
    lst
    (let* ((n (length lst))
           (mid (quotient n 2))
           (left (take lst mid))
           (right (skip mid lst)))
      (merge (sort-merge left) (sort-merge right)))))

(define (merge a b)
  (let loop ((xs a) (ys b) (acc (list)))
    (cond
      ((null? xs) (append (reverse acc) ys))
      ((null? ys) (append (reverse acc) xs))
      ((<= (car xs) (car ys))
       (loop (cdr xs) ys (cons (car xs) acc)))
      (else
       (loop xs (cdr ys) (cons (car ys) acc))))))

; range: iterative construction (constant stack for large spans)
(define (range start end)
  (let loop ((i start) (acc (list)))
    (if (>= i end)
      (reverse acc)
      (loop (+ i 1) (cons i acc)))))

; take: R7RS / SRFI-1 (lst k) — align with native #4177; Soft oneshot
; previously shadowed native with count-first (take n lst) (#4221).
; A non-integer count must be an error value. Coercing it through
; (- k 1) prints a type mismatch and returns a list, so error? is false.
(define (take lst n)
  (if (integer? n)
    (if (>= n 0)
      (let loop ((k n) (xs lst) (acc (list)))
        (if (or (= k 0) (null? xs))
          (reverse acc)
          (loop (- k 1) (cdr xs) (cons (car xs) acc))))
      (error "take: count must be a non-negative integer"))
    (error "take: count must be a non-negative integer")))

(define (skip n lst)
  (let loop ((k n) (xs lst))
    (if (or (= k 0) (null? xs)) xs
      (loop (- k 1) (cdr xs)))))

(define (sum lst) (foldl + 0 lst))
(define (product lst) (foldl * 1 lst))

(define (last lst)
  (if (null? lst) (list)
    (let loop ((xs lst))
      (if (null? (cdr xs)) (car xs)
        (loop (cdr xs))))))

; flatten: fully iterative stack walk (#1549 — no recursive flatten)
; Traverses nested pairs without growing the call stack.
(define (flatten lst)
  (let loop ((stack (list lst)) (acc (list)))
    (if (null? stack)
      (reverse acc)
      (let ((cur (car stack))
            (stk (cdr stack)))
        (cond
          ((null? cur) (loop stk acc))
          ((pair? cur)
           (loop (cons (car cur) (cons (cdr cur) stk)) acc))
          (else
           (loop stk (cons cur acc))))))))

; intersperse: iterative (#1549 — was recursive; xs bug fixed + hot path)
; (intersperse 0 '(1 2 3)) → (1 0 2 0 3)
(define (intersperse sep lst)
  (if (or (null? lst) (null? (cdr lst)))
    lst
    (let loop ((xs lst) (acc (list)))
      (if (null? (cdr xs))
        (reverse (cons (car xs) acc))
        (loop (cdr xs) (cons sep (cons (car xs) acc)))))))

; Alias for callers that want an explicit iterative name (AC #1549).
(define intersperse-iterative intersperse)

; any / all: iterative (Issue #928 TCO-friendly)
(define (any pred lst)
  (let loop ((xs lst))
    (if (null? xs) #f
      (if (pred (car xs)) #t (loop (cdr xs))))))

(define (all pred lst)
  (let loop ((xs lst))
    (if (null? xs) #t
      (if (pred (car xs)) (loop (cdr xs)) #f))))

; R7RS make-list — Soft oneshot gap (#4189/#4203). Iterative O(1) stack.
(define (make-list n fill)
  (if (<= n 0)
    (list)
    (let loop ((k n) (acc (list)))
      (if (<= k 0)
        acc
        (loop (- k 1) (cons fill acc))))))

; R7RS list-tail ≡ skip with (lst n) arg order (#4194). Soft skip is (skip n lst).
(define (list-tail lst n)
  (skip n lst))

; SRFI-1 find — Soft oneshot gap (#4220). Soft empty convention: () when
; not found (not #f). Iterative O(1) stack.
(define (find pred lst)
  (let loop ((xs lst))
    (if (null? xs)
      (list)
      (if (pred (car xs))
        (car xs)
        (loop (cdr xs))))))

; SRFI-1 count — Soft oneshot gap (#4222). Iterative O(1) stack.
(define (count pred lst)
  (let loop ((xs lst) (n 0))
    (if (null? xs)
      n
      (loop (cdr xs) (if (pred (car xs)) (+ n 1) n)))))

; SRFI-1 remove — Soft oneshot gap (#4224). Complement of filter; iterative
; O(1) stack. Elements for which pred is true are dropped.
(define (remove pred lst)
  (let loop ((xs lst) (acc (list)))
    (if (null? xs)
      (reverse acc)
      (if (pred (car xs))
        (loop (cdr xs) acc)
        (loop (cdr xs) (cons (car xs) acc))))))

; SRFI-1 delete — Soft oneshot gap (#4226). equal?-based; iterative O(1)
; stack. Optional = comparator deferred.
(define (delete x lst)
  (let loop ((xs lst) (acc (list)))
    (if (null? xs)
      (reverse acc)
      (if (equal? (car xs) x)
        (loop (cdr xs) acc)
        (loop (cdr xs) (cons (car xs) acc))))))

; ── Issue #4496: common R7RS list/vector bindings ─────────────────

; (assoc key alist) — first pair whose car is equal? to key, else #f
(define (assoc key alist)
  (let loop ((xs alist))
    (cond ((null? xs) #f)
          ((equal? (car (car xs)) key) (car xs))
          (else (loop (cdr xs))))))

; (assq key alist) — like assoc with eq?
(define (assq key alist)
  (let loop ((xs alist))
    (cond ((null? xs) #f)
          ((eq? (car (car xs)) key) (car xs))
          (else (loop (cdr xs))))))

; (iota n [start [step]]) — n numbers start, start+step, ...
(define (iota n . opt)
  (let ((start (if (null? opt) 0 (car opt)))
        (step (if (or (null? opt) (null? (cdr opt))) 1 (car (cdr opt)))))
    (let loop ((i (- n 1)) (acc (list)))
      (if (< i 0) acc
        (loop (- i 1) (cons (+ start (* i step)) acc))))))

; (vector-map f v1 v2 ...) — new vector of f applied elementwise; the
; result is as long as the shortest vector
(define (vector-map f v . vs)
  (let* ((all (cons v vs))
         (len (foldl (lambda (m x) (min m (vector-length x))) (vector-length v) vs))
         (out (make-vector len 0)))
    (let loop ((i 0))
      (if (>= i len) out
        (begin
          (vector-set! out i (apply f (map (lambda (x) (vector-ref x i)) all)))
          (loop (+ i 1)))))))

; (vector-fill! v x) — set every element to x; returns v
(define (vector-fill! v x)
  (let loop ((i 0))
    (if (>= i (vector-length v)) v
      (begin (vector-set! v i x) (loop (+ i 1))))))

; (vector-copy v [start [end]]) — fresh vector with elements start..end-1
(define (vector-copy v . opt)
  (let* ((start (if (null? opt) 0 (car opt)))
         (end (if (or (null? opt) (null? (cdr opt))) (vector-length v) (car (cdr opt))))
         (out (make-vector (max 0 (- end start)) 0)))
    (let loop ((i start))
      (if (>= i end) out
        (begin (vector-set! out (- i start) (vector-ref v i)) (loop (+ i 1)))))))

; (values x ...) — one value is returned as is; several are packed in a
; list that let-values / call-with-values unpack. Aura has no native
; multiple values.
(define (values . xs)
  (if (and (pair? xs) (null? (cdr xs))) (car xs) xs))

(define (call-with-values producer consumer)
  (let ((v (producer)))
    (if (list? v) (apply consumer v) (consumer v))))
