; lib/std/encoding.aura — Encoding utilities
;
; (require "std/encoding" all:)
;
; API:
;   (hex-encode data)       → hex string  (lowercase)
;   (hex-decode hex-str)    → string of decoded bytes | ""
;   (base64-encode data)    → base64 string
;   (base64-decode b64-str) → decoded string | ""
;
; Issue #4055: these delegate to the native %hex-encode / %hex-decode /
; %base64-encode / %base64-decode prims (one string_heap_ entry per call).
; The previous EDSL folds appended each chunk to an immutable accumulator
; string — O(n²) copy where every intermediate became a string_heap_ entry;
; a 64 KB http-post response under Soft --serve-async denseness retained
; ~42.8 GB RSS and wedged/OOM-killed Soft mid-batch (third concurrent
; MiniMax batch → serve_session_timeout → serve_sock_missing).
;
; Semantics note: the native base64-decode stops at the first non-base64
; character (the old fold emitted zero bytes past it); hex/base64 decoders
; stop at the first invalid char instead of emitting zeros.

(export hex-encode hex-decode base64-encode base64-decode)

(define (hex-encode data) (encoding:hex-encode data))
(define (hex-decode hex) (encoding:hex-decode hex))
(define (base64-encode data) (encoding:base64-encode data))
(define (base64-decode b64) (encoding:base64-decode b64))
