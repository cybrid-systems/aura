; lib/std/orchestrator.aura — one release of forwarding to std/orch (#5004)
;
; The implementation moved to lib/std/orch.aura, which depends only on
; fiber:spawn / channel:send / channel:recv / fiber:join / fiber:cancel.
; This module keeps the pre-#5004 import path working for one release:
;
;   (require "std/orchestrator" all:)   ; old name, still green
;   (require "std/orch" all:)           ; new name, same surface
;
; Forwarded surface
;   orch:*  — define-role / step / pipeline / conduct / parallel /
;             parallel-with-yield / supervise / registry-epoch
;   agent:* — spawn / ask / list / status / stop / restart (lifecycle)
;   orch:run — the named pipeline form #2768 callers use
;
; The orch--* captures happen once, right after the require, so the
; forwards below cannot call themselves (same trap as #4500). Roles,
; orch:if and orch:retry are value constructors and stay local.
;
; Issue #2768 / #2766: export before require, so module-private cells
; bind correctly on the stdin denseness host. Do not reintroduce a
; require above this export without a free-var regression covering
; agent:spawn / agent:ask / agent:list.
;
; Removal: delete this file one release after v0.2.0 callers move to
; std/orch (see docs/stdlib/orch.md).

(export orch:define-role orch:step orch:pipeline orch:conduct
        orch:parallel orch:parallel-with-yield orch:supervise orch:run
        agent:spawn agent:ask agent:list
        agent:status agent:stop agent:restart
        orch:role orch:step* orch:if orch:retry
        orch:registry-epoch)

(require "std/orch" all:)

; ── one-time captures (#4500) ──
(define orch--define-role orch:define-role)
(define orch--step orch:step)
(define orch--pipeline orch:pipeline)
(define orch--conduct orch:conduct)
(define orch--parallel orch:parallel)
(define orch--parallel-with-yield orch:parallel-with-yield)
(define orch--supervise orch:supervise)
(define orch--registry-epoch orch:registry-epoch)

; ── forwarding ──
(define (orch:registry-epoch) (orch--registry-epoch))
(define (orch:define-role name config) (orch--define-role name config))
(define (orch:step role input) (orch--step role input))
(define (orch:pipeline steps input) (orch--pipeline steps input))
(define (orch:conduct steps input) (orch--conduct steps input))

(define (orch:parallel fns input . timeout-arg)
  (if (pair? timeout-arg)
    (orch--parallel fns input (car timeout-arg))
    (orch--parallel fns input)))

(define (orch:parallel-with-yield fns input . timeout-arg)
  (if (pair? timeout-arg)
    (orch--parallel-with-yield fns input (car timeout-arg))
    (orch--parallel-with-yield fns input)))

(define (orch:supervise fns input . args)
  (if (pair? args)
    (orch--supervise fns input (car args))
    (orch--supervise fns input)))

; ── orch:run — named pipeline (kept for #2768 callers) ──
(define (orch:run name steps input)
  (orch:pipeline steps input))

; ── agent:* — pre-#5004 names over the orch actors ──
; A local spawn returns the name (old contract); a serve-mode spawn
; returns the session string or #f (#3961: no silent echo agent).
(define (agent:spawn name . handler-arg)
  (if (pair? handler-arg)
    (begin (orch:spawn name (car handler-arg)) name)
    (orch:spawn name)))

(define (agent:ask target input . timeout-args)
  (if (pair? timeout-args)
    (orch:ask target input (car timeout-args))
    (orch:ask target input)))

(define (agent:list) (orch:list))
(define (agent:status name) (orch:status name))
(define (agent:stop name) (orch:stop name))

(define (agent:restart name . handler-arg)
  (if (pair? handler-arg)
    (begin (orch:restart name (car handler-arg)) name)
    (orch:restart name)))

; ── value constructors (no implementation to forward) ──
(define (orch:role action . extra)
  (if (null? extra) (cons action "direct") (cons action extra)))

(define (orch:step* . args)
  (let ((role (try (hash-ref (car args) "role") (catch (e) "unknown")))
        (strategy (try (hash-ref (car args) "strategy") (catch (e) "direct"))))
    (cons (lambda (x) x)
          (if (string=? strategy "agent")
            (list strategy
                  (try (hash-ref (car args) "agent-id") (catch (e) "")))
            (list strategy)))))

(define (orch:if pred then else) (list 'if pred then else))
(define (orch:retry step . max) (list 'retry step (if (pair? max) (car max) 3)))
