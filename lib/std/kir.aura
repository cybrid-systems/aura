; kir.aura — 类型化 kernel IR（Issue #4802 第二阶段）
;
; A kernel is a plain datum (homoiconic: set-code / mutate / ast:snapshot apply),
; type-checked by kir-check and lowered by printers (C here; CUDA / PTX / Triton
; in std/kir-gpu). Schedule rewrites live in std/kir-sched.
;
;   (kernel NAME (params P ...) STMT ...)        ; void entry point
;   (func NAME RET (params P ...) STMT ...)      ; helper callable via (call NAME ...)
;   (module NAME ITEM ...)                       ; kernels + funcs
;   P     = (name TYPE [:in | :out | :inout])     ; pointer access mode, default :inout
;   TYPE  = i32 | i64 | f32 | f64 | bool | (ptr TYPE)
;   STMT  = (let v TYPE [e]) | (set lv e) | (+= lv e) (-= ..) (*= ..) (/= ..)
;         | (for (i lo hi [step]) STMT ...) | (simd-for (i lo hi [step]) STMT ...)
;         | (pfor (i lo hi) STMT ...)            ; data-parallel axis, kernel top level only
;         | (if c STMT [STMT]) | (when c STMT ...) | (begin STMT ...)
;         | (return [e]) | (expr e)
;   EXPR  = integer | float (f64) | (f32 x) | symbol | (ref p i) | (cast TYPE e) | (? c a b)
;         | (+ - * / % min max a b ...) | (< <= > >= == != a b) | (and or a b ...) | (not a) | (neg a)
;         | (sqrt e) (exp e) (log e) (fabs e) (fmax a b) (fmin a b) | (call f arg ...)
;
; Contracts (kir-check, enforced before any lowering): declare-before-use, no
; shadowing, operand types agree (no implicit promotion; int literals adapt,
; float literals are f64 — write (f32 x)), integer indices, :in pointers and
; loop variables are read-only, one top-level pfor whose pointer stores are
; indexed by the parallel variable and which writes no outer scalar, calls
; match the callee signature.
(export
  kir-name kir-head kir-items kir-find kir-ty kir-params kir-body kir-ret kir-kind
  kir-check kir-check! kir-type-of kir-mentions? kir-subst kir-map-stmts kir-outer-writes kir-join
  kir->c kir->c-proto kir->c-unit kir-ctype kir-callees kir-dependents
  kir-env-of kir-c-block kir-c-expr kir-c-param)
(require "std/cgen" all:)

(define (kir-name x) (format "~a" x))
(define (kir-head e) (if (pair? e) (kir-name (car e)) ""))
(define (kir-member? s lst)
  (cond ((null? lst) #f) ((equal? s (car lst)) #t) (else (kir-member? s (cdr lst)))))
(define (kir-assoc k al)
  (cond ((null? al) #f) ((equal? k (car (car al))) (car al)) (else (kir-assoc k (cdr al)))))

; ---- item accessors -------------------------------------------------------
(define (kir-kind it) (kir-head it))
(define (kir-items m) (if (equal? (kir-head m) "module") (cddr m) (list m)))
(define (kir-find m name)
  (let loop ((xs (kir-items m)))
    (cond ((null? xs) #f)
          ((equal? (kir-name (cadr (car xs))) (kir-name name)) (car xs))
          (else (loop (cdr xs))))))
(define (kir-params it)
  (let ((p (if (equal? (kir-kind it) "func") (cadr (cddr it)) (car (cddr it)))))
    (if (equal? (kir-head p) "params") (cdr p) (error "kir: missing (params ...)"))))
(define (kir-body it) (if (equal? (kir-kind it) "func") (cdr (cdr (cddr it))) (cdr (cddr it))))
(define (kir-ret it) (if (equal? (kir-kind it) "func") (kir-ty (car (cddr it))) "void"))

; ---- types ----------------------------------------------------------------
; Internal type strings: "i32" "i64" "f32" "f64" "bool" "ptr:T" "void";
; literal pseudo-types "ilit" / "flit" unify with a concrete operand.
(define kir-scalars (list "i32" "i64" "f32" "f64" "bool"))
(define (kir-ty t)
  (cond ((and (pair? t) (equal? (kir-head t) "ptr")) (string-append "ptr:" (kir-ty (cadr t))))
        ((kir-member? (kir-name t) (append kir-scalars (list "void"))) (kir-name t))
        (else (error (string-append "kir: unknown type " (kir-name t))))))
(define (kir-ptr? t) (and (> (string-length t) 4) (equal? (substring t 0 4) "ptr:")))
(define (kir-elem t) (substring t 4 (string-length t)))
(define (kir-int? t) (kir-member? t (list "i32" "i64" "ilit")))
(define (kir-float? t) (kir-member? t (list "f32" "f64" "flit")))
(define (kir-num? t) (or (kir-int? t) (kir-float? t)))
(define (kir-concrete t) (cond ((equal? t "ilit") "i64") ((equal? t "flit") "f64") (else t)))
; unify two operand types; #f when they disagree
(define (kir-unify a b)
  (cond ((equal? a b) a)
        ((and (equal? a "ilit") (kir-num? b)) b)
        ((and (equal? b "ilit") (kir-num? a)) a)
        ((and (equal? a "flit") (equal? b "f64")) b)
        ((and (equal? b "flit") (equal? a "f64")) a)
        (else #f)))
(define (kir-ctype t)
  (cond ((equal? t "i32") "int32_t") ((equal? t "i64") "int64_t") ((equal? t "f32") "float")
        ((equal? t "f64") "double") ((equal? t "bool") "int") ((equal? t "void") "void")
        ((equal? t "ilit") "int64_t") ((equal? t "flit") "double")
        ((kir-ptr? t) (string-append (kir-ctype (kir-elem t)) "*"))
        (else (error (string-append "kir: no C type for " t)))))

; ---- environments ---------------------------------------------------------
; env entry: (name type mode) ; mode "in" "out" "inout" "var" "loop" "param"
(define (kir-param-entry p)
  (let* ((t (kir-ty (cadr p)))
         (m (if (null? (cddr p)) (if (kir-ptr? t) "inout" "param")
                (let ((s (kir-name (car (cddr p)))))
                  (if (equal? (substring s 0 1) ":") (substring s 1 (string-length s)) s)))))
    (list (kir-name (car p)) t m)))
(define (kir-env-of it) (map kir-param-entry (kir-params it)))

; ---- type inference -------------------------------------------------------
(define kir-arith (list "+" "-" "*" "/" "%" "min" "max"))
(define kir-cmp (list "<" "<=" ">" ">=" "==" "!="))
(define kir-logic (list "and" "or" "&&" "||"))  ; and/or: the reader cannot read && / ||
(define kir-math1 (list "sqrt" "exp" "log" "fabs"))
(define kir-math2 (list "fmax" "fmin"))

; (kir-type-of e env module) -> type string; errors raise "kir: ..."
(define (kir-fail msg) (error (string-append "kir: " msg)))
(define (kir-type-of e env m)
  (cond
    ((float? e) "flit")
    ((integer? e) "ilit")
    ((boolean? e) "bool")
    ((string? e) (kir-fail (string-append "raw text not allowed in IR: " e)))
    ((not (pair? e))
     (let ((b (kir-assoc (kir-name e) env)))
       (if b (cadr b) (kir-fail (string-append "undeclared " (kir-name e))))))
    (else
     (let ((h (kir-head e)) (args (cdr e)))
       (cond
         ((equal? h "f32") (if (number? (car args)) "f32" (kir-fail "f32 needs a numeric literal")))
         ((and (equal? h "-") (= (length args) 1)) (kir-type-of (car args) env m))
         ((equal? h "neg")
          (let ((t (kir-type-of (car args) env m)))
            (if (kir-num? t) t (kir-fail "neg needs a number"))))
         ((kir-member? h kir-arith)
          (if (< (length args) 2) (kir-fail (string-append h " needs 2+ operands")))
          (let loop ((xs (cdr args)) (t (kir-type-of (car args) env m)))
            (if (null? xs)
                (begin
                  (if (not (kir-num? t)) (kir-fail (string-append h " needs numbers, got " t)))
                  (if (and (equal? h "%") (kir-float? t)) (kir-fail "% needs integers"))
                  t)
                (let* ((t2 (kir-type-of (car xs) env m)) (u (kir-unify t t2)))
                  (if u (loop (cdr xs) u)
                      (kir-fail (string-append "type mismatch in (" h "): " t " vs " t2 " (use cast)")))))))
         ((kir-member? h kir-cmp)
          (let* ((a (kir-type-of (car args) env m)) (b (kir-type-of (cadr args) env m)))
            (if (kir-unify a b) "bool"
                (kir-fail (string-append "type mismatch in (" h "): " a " vs " b " (use cast)")))))
         ((kir-member? h kir-logic)
          (for-each (lambda (x) (if (not (equal? (kir-type-of x env m) "bool"))
                                    (kir-fail (string-append h " needs bool operands")))) args)
          "bool")
         ((equal? h "not")
          (if (equal? (kir-type-of (car args) env m) "bool") "bool" (kir-fail "not needs bool")))
         ((equal? h "ref")
          (let ((p (kir-type-of (car args) env m)) (i (kir-type-of (cadr args) env m)))
            (if (not (kir-ptr? p)) (kir-fail (string-append "ref of non-pointer " (kir-name (car args)))))
            (if (not (kir-int? i)) (kir-fail (string-append "index of " (kir-name (car args)) " must be integer, got " i)))
            (kir-elem p)))
         ((equal? h "cast")
          (let ((t (kir-ty (car args))) (s (kir-type-of (cadr args) env m)))
            (if (or (kir-ptr? t) (kir-ptr? s)) (kir-fail "cast between pointers is not allowed"))
            t))
         ((equal? h "?")
          (if (not (equal? (kir-type-of (car args) env m) "bool")) (kir-fail "? needs a bool condition"))
          (let* ((a (kir-type-of (cadr args) env m)) (b (kir-type-of (car (cddr args)) env m)) (u (kir-unify a b)))
            (if u u (kir-fail (string-append "? branches disagree: " a " vs " b)))))
         ((kir-member? h kir-math1)
          (let ((t (kir-type-of (car args) env m)))
            (cond ((kir-member? t (list "f32" "f64")) t) ((equal? t "flit") "f64")
                  (else (kir-fail (string-append h " needs f32/f64, got " t))))))
         ((kir-member? h kir-math2)
          (let* ((a (kir-type-of (car args) env m)) (b (kir-type-of (cadr args) env m)) (u (kir-unify a b)))
            (cond ((not u) (kir-fail (string-append h " operands disagree: " a " vs " b)))
                  ((kir-float? u) (kir-concrete u))
                  (else (kir-fail (string-append h " needs floats"))))))
         ((equal? h "call")
          (let ((f (if m (kir-find m (car args)) #f)))
            (if (or (not f) (not (equal? (kir-kind f) "func")))
                (kir-fail (string-append "call to unknown func " (kir-name (car args)))))
            (let ((ps (kir-env-of f)) (as (cdr args)))
              (if (not (= (length ps) (length as)))
                  (kir-fail (string-append "call " (kir-name (car args)) ": arity mismatch")))
              (for-each (lambda (p a)
                          (let ((ta (kir-type-of a env m)))
                            (if (not (kir-unify (cadr p) ta))
                                (kir-fail (string-append "call " (kir-name (car args)) ": arg " (car p)
                                                         " wants " (cadr p) ", got " ta)))))
                        ps as)
              (kir-ret f))))
         (else (kir-fail (string-append "unknown expression form " h))))))))
; a float datum written as 2.0 is still a float literal
(define (kir-float-text? x) (float? x))

; ---- free-variable helpers --------------------------------------------------
(define (kir-mentions? e v)
  (cond ((pair? e) (or (kir-mentions? (car e) v) (kir-mentions? (cdr e) v)))
        ((null? e) #f)
        ((or (number? e) (string? e) (boolean? e)) #f)
        (else (equal? (kir-name e) (kir-name v)))))
; substitute symbol v -> datum r everywhere (expressions and statements)
(define (kir-subst e v r)
  (cond ((pair? e) (cons (kir-subst (car e) v r) (kir-subst (cdr e) v r)))
        ((null? e) e)
        ((or (number? e) (string? e) (boolean? e)) e)
        ((equal? (kir-name e) (kir-name v)) r)
        (else e)))
; apply f to every statement list (bottom-up); f : stmts -> stmts
(define kir-block-heads (list "for" "simd-for" "pfor" "when" "begin"))
(define (kir-map-stmts f stmts)
  (f (map (lambda (s)
            (let ((h (kir-head s)))
              (cond ((kir-member? h (list "for" "simd-for" "pfor"))
                     (cons (car s) (cons (cadr s) (kir-map-stmts f (cddr s)))))
                    ((equal? h "when") (cons (car s) (cons (cadr s) (kir-map-stmts f (cddr s)))))
                    ((equal? h "begin") (cons (car s) (kir-map-stmts f (cdr s))))
                    ((equal? h "if")
                     (cons (car s) (cons (cadr s) (map (lambda (b) (car (kir-map-stmts f (list b)))) (cddr s)))))
                    (else s))))
          stmts)))

; ---- statement checking ----------------------------------------------------
; ctx: (list item module pfor-var outer-names depth)
(define *kir-errs* '())
(define (kir-err! msg) (set! *kir-errs* (cons msg *kir-errs*)))
(define (kir-try thunk)
  (try (thunk) (catch (e) (begin (kir-err! (kir-errtext e)) #f))))
(define (kir-errtext e)
  (let ((s (format "~a" e)))
    (if (and (> (string-length s) 5) (equal? (substring s 0 5) "kir: ")) (substring s 5 (string-length s)) s)))

(define (kir-declare env name t mode)
  (if (kir-assoc (kir-name name) env)
      (begin (kir-err! (string-append "redeclared or shadowed " (kir-name name))) env)
      (cons (list (kir-name name) t mode) env)))

(define (kir-check-lv lv env ctx)
  (let ((m (cadr ctx)) (pv (car (cddr ctx))) (outer (cadr (cddr ctx))))
    (cond
      ((and (pair? lv) (equal? (kir-head lv) "ref"))
       (let ((b (kir-assoc (kir-name (cadr lv)) env)))
         (cond ((not b) (kir-err! (string-append "undeclared " (kir-name (cadr lv)))) #f)
               ((equal? (car (cddr b)) "in")
                (kir-err! (string-append "write to read-only (:in) " (kir-name (cadr lv)))) #f)
               (else
                (if (and pv (not (equal? pv "pfor-done")) (not (kir-mentions? (car (cddr lv)) pv)))
                    (kir-err! (string-append "pfor store to " (kir-name (cadr lv))
                                             " is not indexed by " pv " (data race)")))
                (kir-try (lambda () (kir-type-of lv env m)))))))
      ((pair? lv) (kir-err! "invalid assignment target") #f)
      (else
       (let ((b (kir-assoc (kir-name lv) env)))
         (cond ((not b) (kir-err! (string-append "undeclared " (kir-name lv))) #f)
               ((equal? (car (cddr b)) "loop") (kir-err! (string-append "assignment to loop variable " (kir-name lv))) #f)
               ((kir-ptr? (cadr b)) (kir-err! (string-append "assignment to pointer " (kir-name lv))) #f)
               ((and pv (not (equal? pv "pfor-done")) (kir-member? (kir-name lv) outer))
                (kir-err! (string-append "pfor body writes outer scalar " (kir-name lv) " (data race)")) #f)
               (else (cadr b))))))))

(define (kir-check-expr e env ctx want)
  (let ((t (kir-try (lambda () (kir-type-of e env (cadr ctx))))))
    (if (and t want (not (kir-unify want t)))
        (kir-err! (string-append "expected " want ", got " t " in " (format "~a" e))))
    t))

(define (kir-check-loop s env ctx par?)
  (let* ((sp (cadr s)) (v (car sp)) (m (cadr ctx))
         (thi (kir-try (lambda () (kir-type-of (car (cddr sp)) env m))))
         (tlo (kir-try (lambda () (kir-type-of (cadr sp) env m))))
         (lt (cond ((and thi (not (equal? thi "ilit"))) thi)
                   ((and tlo (not (equal? tlo "ilit"))) tlo)
                   (else "i64"))))
    (if (not (and thi tlo (kir-int? thi) (kir-int? tlo) (kir-unify thi tlo)))
        (kir-err! (string-append "loop " (kir-name v) " bounds must be integers of one type")))
    (if (not (null? (cdr (cddr sp))))
        (let ((st (car (cdr (cddr sp)))))
          (kir-check-expr st env ctx lt)
          (if (and (integer? st) (<= st 0)) (kir-err! (string-append "loop " (kir-name v) " step must be positive")))))
    (if (and par? (not (null? (cdr (cddr sp))))) (kir-err! "pfor takes no step"))
    (let ((env2 (kir-declare env v lt "loop")))
      (if par?
          (kir-check-block (cddr s) env2
                           (list (car ctx) m (kir-name v) (map car env) (+ 1 (car (cddr (cddr ctx))))))
          (kir-check-block (cddr s) env2
                           (list (car ctx) m (car (cddr ctx)) (cadr (cddr ctx)) (+ 1 (car (cddr (cddr ctx))))))))))

(define (kir-nested ctx) (list (car ctx) (cadr ctx) (car (cddr ctx)) (cadr (cddr ctx)) (+ 1 (car (cddr (cddr ctx))))))

; returns the extended env (let is visible to the following statements)
(define (kir-check-stmt s env ctx)
  (let ((h (kir-head s)) (m (cadr ctx)))
    (cond
      ((equal? h "let")
       (let ((t (kir-try (lambda () (kir-ty (car (cddr s)))))))
         (if (and t (kir-ptr? t)) (kir-err! (string-append "local pointer " (kir-name (cadr s)) " not allowed")))
         (if (and t (not (null? (cdr (cddr s))))) (kir-check-expr (cadr (cddr s)) env ctx t))
         (kir-declare env (cadr s) (if t t "i64") "var")))
      ((kir-member? h (list "set" "+=" "-=" "*=" "/="))
       (let ((lt (kir-check-lv (cadr s) env ctx)))
         (if (and lt (not (equal? h "set")) (not (kir-num? lt)))
             (kir-err! (string-append h " needs a numeric target")))
         (kir-check-expr (car (cddr s)) env ctx lt)
         env))
      ((equal? h "simd-for")
       (for-each (lambda (w)
                   (if (and (not (equal? (car w) "+=")) (kir-assoc (cadr w) env))
                       (kir-err! (string-append "simd-for body writes outer scalar " (cadr w) " with " (car w)
                                                " (only += reductions)"))
                       #f))
                 (kir-outer-writes (cddr s)))
       (kir-check-loop s env ctx #f) env)
      ((equal? h "for") (kir-check-loop s env ctx #f) env)
      ((equal? h "pfor")
       (cond ((not (equal? (kir-kind (car ctx)) "kernel")) (kir-err! "pfor only allowed in a kernel"))
             ((> (car (cddr (cddr ctx))) 0) (kir-err! "pfor must be at kernel top level"))
             ((car (cddr ctx)) (kir-err! "only one pfor per kernel"))
             (else #f))
       (kir-check-loop s env ctx #t) env)
      ((equal? h "if")
       (kir-check-expr (cadr s) env ctx "bool")
       (for-each (lambda (b) (kir-check-block (list b) env (kir-nested ctx))) (cddr s))
       env)
      ((equal? h "when")
       (kir-check-expr (cadr s) env ctx "bool")
       (kir-check-block (cddr s) env (kir-nested ctx)) env)
      ((equal? h "begin") (kir-check-block (cdr s) env (kir-nested ctx)) env)
      ((equal? h "return")
       (let ((rt (kir-ret (car ctx))))
         (cond ((and (equal? rt "void") (not (null? (cdr s)))) (kir-err! "kernel returns no value"))
               ((and (not (equal? rt "void")) (null? (cdr s))) (kir-err! "func must return a value"))
               ((not (null? (cdr s))) (kir-check-expr (cadr s) env ctx rt))
               (else #f)))
       env)
      ((equal? h "expr") (kir-check-expr (cadr s) env ctx #f) env)
      (else (kir-err! (string-append "unknown statement form " h)) env))))

(define (kir-check-block stmts env ctx)
  ; pfor-seen is tracked by ctx slot 2 for nested; top-level count handled here
  (let loop ((xs stmts) (env env) (ctx ctx))
    (if (null? xs) env
        (let* ((s (car xs)) (env2 (kir-check-stmt s env ctx)))
          (loop (cdr xs) env2
                (if (equal? (kir-head s) "pfor")
                    (list (car ctx) (cadr ctx) "pfor-done" (cadr (cddr ctx)) (car (cddr (cddr ctx))))
                    ctx))))))

; (kir-check item [module]) -> list of error strings ('() = ok)
(define (kir-check it . rest)
  (let ((m (if (null? rest) #f (car rest))))
    (set! *kir-errs* '())
    (cond
      ((equal? (kir-kind it) "module")
       (let ((names (map (lambda (x) (kir-name (cadr x))) (kir-items it))))
         (let dup ((ns names))
           (if (not (null? ns))
               (begin (if (kir-member? (car ns) (cdr ns)) (kir-err! (string-append "duplicate item " (car ns))))
                      (dup (cdr ns))))))
       (let ((acc *kir-errs*))
         (for-each (lambda (x)
                     (let ((es (kir-check x it)))
                       (set! acc (append acc (map (lambda (e) (string-append (kir-name (cadr x)) ": " e)) es)))))
                   (kir-items it))
         (set! *kir-errs* acc)
         acc))
      ((not (kir-member? (kir-kind it) (list "kernel" "func")))
       (list (string-append "not a kernel/func/module: " (kir-kind it))))
      (else
       (let ((env (kir-try (lambda () (kir-env-of it)))))
         (if env
             (begin
               (let dup ((ps (map car env)))
                 (if (not (null? ps))
                     (begin (if (kir-member? (car ps) (cdr ps)) (kir-err! (string-append "duplicate param " (car ps))))
                            (dup (cdr ps)))))
               (if (equal? (kir-kind it) "func") (kir-try (lambda () (kir-ret it))))
               (kir-check-block (kir-body it) env (list it m #f '() 0)))))
       (reverse *kir-errs*)))))

(define (kir-check! it . rest)
  (let ((es (if (null? rest) (kir-check it) (kir-check it (car rest)))))
    (if (null? es) it
        (error (string-append "kir-check failed: " (kir-join es "; "))))))
(define (kir-join xs sep)
  (if (null? xs) "" (let loop ((r (cdr xs)) (acc (car xs)))
                      (if (null? r) acc (loop (cdr r) (string-append acc sep (car r)))))))

; scalar writes in STMTS to names not declared by a let inside STMTS: ((op name) ...)
(define (kir-outer-writes stmts)
  (let ((decl '()) (writes '()))
    (let walk ((xs stmts))
      (for-each (lambda (s)
                  (let ((h (kir-head s)))
                    (cond ((equal? h "let") (set! decl (cons (kir-name (cadr s)) decl)))
                          ((kir-member? h (list "set" "+=" "-=" "*=" "/="))
                           (if (not (pair? (cadr s))) (set! writes (cons (list h (kir-name (cadr s))) writes)) #f))
                          ((kir-member? h (list "for" "simd-for" "pfor" "when")) (walk (cddr s)))
                          ((equal? h "begin") (walk (cdr s)))
                          ((equal? h "if") (walk (cddr s)))
                          (else #f))))
                xs))
    (let dedup ((ws (reverse writes)) (acc '()))
      (cond ((null? ws) (reverse acc))
            ((or (kir-member? (cadr (car ws)) decl) (kir-member? (car ws) acc)) (dedup (cdr ws) acc))
            (else (dedup (cdr ws) (cons (car ws) acc)))))))

; ---- call graph (for #4803 invalidation) -------------------------------------
(define (kir-callees it)
  (let ((acc '()))
    (let walk ((e (kir-body it)))
      (cond ((pair? e)
             (if (and (equal? (kir-head e) "call") (pair? (cdr e)))
                 (let ((n (kir-name (cadr e)))) (if (not (kir-member? n acc)) (set! acc (cons n acc)))))
             (if (pair? (car e)) (walk (car e)))
             (walk (cdr e)))
            (else #f)))
    (reverse acc)))
; transitive callers of NAME inside module M (the units to rebuild when its signature changes)
(define (kir-dependents m name)
  (let loop ((frontier (list (kir-name name))) (seen '()))
    (if (null? frontier) (reverse seen)
        (let* ((n (car frontier))
               (callers (map (lambda (x) (kir-name (cadr x)))
                             (filter (lambda (x) (kir-member? n (kir-callees x))) (kir-items m))))
               (new (filter (lambda (c) (not (kir-member? c seen))) callers)))
          (loop (append (cdr frontier) new) (append (reverse new) seen))))))

; ---- C lowering ---------------------------------------------------------------
; Lower an IR expression to a std/cgen datum, using types for intrinsics/literals.
(define (kir-c-expr e env m)
  (cond
    ((or (number? e)) e)
    ((boolean? e) (if e 1 0))
    ((not (pair? e)) (kir-name e))
    (else
     (let ((h (kir-head e)) (args (cdr e)) (sub (lambda (x) (kir-c-expr x env m))))
       (cond
         ((equal? h "f32") (list (car e) (exact->inexact (car args))))
         ((kir-member? h (list "min" "max"))
          (let loop ((acc (sub (car args))) (xs (cdr args)))
            (if (null? xs) acc
                (loop (list (string->symbol "?") (list (string->symbol (if (equal? h "min") "<" ">")) acc (sub (car xs)))
                            acc (sub (car xs)))
                      (cdr xs)))))
         ((kir-member? h (append kir-math1 kir-math2))
          (let ((t (kir-type-of e env m)))
            (cons (string->symbol "call")
                  (cons (string->symbol (if (equal? t "f32") (string-append h "f") h)) (map sub args)))))
         ((equal? h "and") (cons (string->symbol "&&") (map sub args)))
         ((equal? h "or") (cons (string->symbol "||") (map sub args)))
         ((equal? h "cast") (list (string->symbol "cast") (kir-ctype (kir-ty (car args))) (sub (cadr args))))
         ((equal? h "call") (cons (car e) (cons (kir-name (car args)) (map sub (cdr args)))))
         (else (cons (car e) (map sub args))))))))

(define (kir-c-param p restrict-kw)
  (let* ((en (kir-param-entry p)) (t (cadr en)))
    (list (if (kir-ptr? t)
              (string-append (if (equal? (car (cddr en)) "in") "const " "") (kir-ctype (kir-elem t)) "* " restrict-kw)
              (kir-ctype t))
          (car en))))

(define (kir-c-block stmts env m)
  (let loop ((xs stmts) (env env) (out '()))
    (if (null? xs) (reverse out)
        (let* ((s (car xs)) (h (kir-head s)))
          (cond
            ((equal? h "let")
             (let ((t (kir-ty (car (cddr s)))))
               (loop (cdr xs) (cons (list (kir-name (cadr s)) t "var") env)
                     (cons (if (null? (cdr (cddr s)))
                               (list 'decl (kir-ctype t) (kir-name (cadr s)))
                               (list 'decl (kir-ctype t) (kir-name (cadr s)) (kir-c-expr (cadr (cddr s)) env m)))
                           out))))
            (else (loop (cdr xs) env (cons (kir-c-stmt s env m) out))))))))

(define (kir-c-loop s env m)
  (let* ((sp (cadr s)) (v (kir-name (car sp)))
         (thi (kir-type-of (car (cddr sp)) env m))
         (lt (if (equal? thi "ilit") (let ((tl (kir-type-of (cadr sp) env m))) (if (equal? tl "ilit") "i64" tl)) thi))
         (env2 (cons (list v lt "loop") env))
         (lo (kir-c-expr (cadr sp) env m)) (hi (kir-c-expr (car (cddr sp)) env m))
         (step (if (null? (cdr (cddr sp))) 1 (kir-c-expr (car (cdr (cddr sp))) env m))))
    (cons 'for (cons (list (string->symbol v) lo hi step) (kir-c-block (cddr s) env2 m)))))

(define (kir-c-stmt s env m)
  (let ((h (kir-head s)) (x (lambda (e) (kir-c-expr e env m))))
    (cond
      ((kir-member? h (list "set" "+=" "-=" "*=" "/=")) (list (car s) (x (cadr s)) (x (car (cddr s)))))
      ((kir-member? h (list "for" "pfor")) (kir-c-loop s env m))
      ((equal? h "simd-for")
       (let ((reds (map cadr (filter (lambda (w) (equal? (car w) "+=")) (kir-outer-writes (cddr s))))))
         (list 'begin
               (list 'pragma (if (null? reds) "omp simd"
                                 (string-append "omp simd reduction(+:" (kir-join reds ",") ")")))
               (kir-c-loop s env m))))
      ((equal? h "if")
       (cons 'if (cons (x (cadr s)) (map (lambda (b) (cons 'begin (kir-c-block (list b) env m))) (cddr s)))))
      ((equal? h "when") (cons 'when (cons (x (cadr s)) (kir-c-block (cddr s) env m))))
      ((equal? h "begin") (cons 'begin (kir-c-block (cdr s) env m)))
      ((equal? h "return") (if (null? (cdr s)) (list 'return) (list 'return (x (cadr s)))))
      ((equal? h "expr") (list 'expr (x (cadr s))))
      (else (error (string-append "kir->c: unknown statement " h))))))

; (kir->c item [module]) -> C function text (checked first)
(define (kir->c it . rest)
  (let ((m (if (null? rest) #f (car rest))))
    (if m (kir-check! it m) (kir-check! it))
    (cgen-fn (kir-ctype (kir-ret it)) (kir-name (cadr it))
             (map (lambda (p) (kir-c-param p "restrict")) (kir-params it))
             (kir-c-block (kir-body it) (kir-env-of it) m))))
(define (kir->c-proto it)
  (string-append (kir-ctype (kir-ret it)) " " (kir-name (cadr it)) "("
                 (if (null? (kir-params it)) "void"
                     (kir-join (map (lambda (p) (let ((cp (kir-c-param p "restrict")))
                                                         (string-append (car cp) " " (cadr cp))))
                                          (kir-params it)) ", "))
                 ");\n"))
(define kir-c-includes (list "stdint.h" "math.h"))
; whole module as one C translation unit (prototypes first, so call order is free)
(define (kir->c-unit m)
  (kir-check! m)
  (string-append
   (cgen-unit kir-c-includes '())
   (apply string-append (map kir->c-proto (kir-items m)))
   "\n"
   (kir-join (map (lambda (it) (kir->c it m)) (kir-items m)) "\n")))
