; Aura std/rule — 代码规范系统 (P2)
;
; (require "std/rule" all:)
;
; 规则 = query:pattern + 相应 mutate 的组合.
; P2 新增: :scope 支持, rule:save / rule:load, 出口过滤
;
; Issue #4835: rule:define validates its keyword arguments, rule:apply /
; rule:enable / rule:disable / rule:remove raise on an unknown rule, and
; rules live in a name-keyed hash so define / find are O(1) instead of
; scanning the whole list (and formatting every entry) per call.

(export rule:define rule:apply rule:apply-all
        rule:list rule:list-violations
        rule:remove rule:enable rule:disable
        rule:status rule:save rule:load)

; ── 规则存储 ──────────────────────────────────────────────
; name(string) -> rule record, plus the insertion order for listing.
(define *rule-index* (make-hash))
(define *rule-order* '())
(define *rule-valid-keywords*
  '("pattern" "replace" "condition" "description" "enabled" "scope"))

;; Issue #1585: rule:apply-all + rule:list-violations use `for-each` which
;; isn't bound by any require in this file (map happens to be in scope
;; via std/list, but for-each is missing). Define a local for-each with
;; the standard Scheme contract (applies fn to each list element for
;; side effects, returns unspecified when done).
(define (for-each fn lst)
  (let loop ((rest lst))
    (if (null? rest) #f
      (begin
        (fn (car rest))
        (loop (cdr rest))))))

; ── 内部: 名字规范化 / 查找 ──────────────────────────────
(define (rule-key name)
  (if (string? name) name (symbol->string name)))

(define (rule-name-display name)
  (if (string? name) name (format "~a" name)))

(define (find-rule name)
  (let ((k (rule-key name)))
    (if (hash-has-key? *rule-index* k)
      (hash-ref *rule-index* k)
      #f)))

(define (rules-in-order)
  (map (lambda (k) (hash-ref *rule-index* k)) *rule-order*))

; ── 内部: 校验辅助 ───────────────────────────────────────
(define (value-kind v)
  (cond ((string? v) "string")
        ((symbol? v) "symbol")
        ((number? v) "number")
        ((boolean? v) "boolean")
        ((pair? v) "list")
        ((vector? v) "vector")
        (else "value")))

(define (rule-error name msg)
  (error (string-append "rule:define " (rule-name-display name) ": " msg)))

(define (rule-keyword-name k)
  (if (keyword? k) (keyword->string k) (format "~a" k)))

(define (min3 a b c)
  (let ((m (if (< a b) a b)))
    (if (< c m) c m)))

; Levenshtein distance — only used for a "did you mean" hint on a
; mistyped keyword. Short strings, so the simple recursion is fine.
(define (edit-distance a b)
  (let ((la (string-length a)) (lb (string-length b)))
    (cond ((= la 0) lb)
          ((= lb 0) la)
          ((equal? (substring a 0 1) (substring b 0 1))
           (edit-distance (substring a 1 la) (substring b 1 lb)))
          (else
           (+ 1 (min3 (edit-distance (substring a 1 la) b)
                      (edit-distance a (substring b 1 lb))
                      (edit-distance (substring a 1 la) (substring b 1 lb))))))))

(define (closest-rule-keyword key)
  (let ((name (rule-keyword-name key)))
    (let loop ((cands *rule-valid-keywords*) (best #f) (best-d 99))
      (if (null? cands)
        (if best (string-append ":" best) #f)
        (let ((d (edit-distance name (car cands))))
          (if (and (< d best-d) (<= d 2))
            (loop (cdr cands) (car cands) d)
            (loop (cdr cands) best best-d)))))))

; ── 内部: 规则结构 ─────────────────────────────────────────
; 规则 = (name pattern replacement condition description enabled scope)
(define (rule-name r)         (list-ref r 0))
(define (rule-pattern r)      (list-ref r 1))
(define (rule-replace r)      (list-ref r 2))
(define (rule-condition r)    (list-ref r 3))
(define (rule-desc r)         (list-ref r 4))
(define (rule-enabled? r)     (list-ref r 5))
(define (rule-scope r)        (list-ref r 6))  ; :workspace or :function name

; ── rule:define — 注册规则 ─────────────────────────────────
(define (rule:define name . args)
  (if (not (or (symbol? name) (string? name)))
    (error (string-append "rule:define: name must be a symbol or string, got "
                          (value-kind name))))
  (let ((pattern "")
        (replacement "")
        (condition #t)
        (description "")
        (enabled #t)
        (scope :workspace))

    (let parse ((remaining args))
      (cond
        ((null? remaining) #t)
        ((null? (cdr remaining))
         (rule-error name (string-append "odd number of arguments; missing value for "
                                         (rule-keyword-name (car remaining)))))
        (else
         (let ((key (car remaining))
               (val (cadr remaining)))
           (cond
             ((eq? key :pattern)
              (if (not (string? val))
                (rule-error name (string-append ":pattern must be a string, got "
                                                (value-kind val)))
                (set! pattern val)))
             ((eq? key :replace)
              (if (not (string? val))
                (rule-error name (string-append ":replace must be a string, got "
                                                (value-kind val)))
                (set! replacement val)))
             ((eq? key :condition)
              (if (not (or (string? val) (boolean? val)))
                (rule-error name (string-append ":condition must be a string or boolean, got "
                                                (value-kind val)))
                (set! condition val)))
             ((eq? key :description)
              (if (not (string? val))
                (rule-error name (string-append ":description must be a string, got "
                                                (value-kind val)))
                (set! description val)))
             ((eq? key :enabled)
              (if (not (boolean? val))
                (rule-error name (string-append ":enabled must be a boolean, got "
                                                (value-kind val)))
                (set! enabled val)))
             ((eq? key :scope)
              (if (not (or (keyword? val) (symbol? val) (string? val)))
                (rule-error name (string-append ":scope must be a keyword, symbol or string, got "
                                                (value-kind val)))
                (set! scope val)))
             (else
              (let ((near (closest-rule-keyword key)))
                (rule-error name
                  (string-append "unknown keyword " (rule-keyword-name key)
                                 " (valid: :pattern :replace :condition :description :enabled :scope"
                                 (if near (string-append "; did you mean " near "?") "")
                                 ")")))))
           (parse (cddr remaining))))))

    ; Reject a :pattern that cannot even be read as a datum, naming the rule
    ; and the field instead of failing later with an internal type error.
    (if (not (equal? pattern ""))
      (try (read-from-string pattern)
           (catch (e)
             (rule-error name (string-append ":pattern cannot be parsed: "
                                             (if (string? e) e (format "~a" e)))))))

    (let ((k (rule-key name)))
      (if (not (hash-has-key? *rule-index* k))
        (set! *rule-order* (cons k *rule-order*)))
      (hash-set! *rule-index* k
                 (list name pattern replacement condition description enabled scope))
      name)))

; ── rule:remove — 移除规则 ────────────────────────────────
(define (rule:remove name)
  (let ((k (rule-key name)))
    (if (not (hash-has-key? *rule-index* k))
      (error (string-append "rule:remove: no such rule: " (rule-name-display name)))
      (begin
        (hash-remove! *rule-index* k)
        (set! *rule-order* (filter (lambda (x) (not (equal? x k))) *rule-order*))
        name))))

; ── rule:enable / rule:disable — 开关规则 ─────────────────
(define (rule:set-enabled name flag)
  (let ((r (find-rule name)))
    (hash-set! *rule-index* (rule-key name)
               (list (rule-name r) (rule-pattern r) (rule-replace r)
                     (rule-condition r) (rule-desc r) flag (rule-scope r)))
    #t))

(define (rule:enable name)
  (if (find-rule name)
    (rule:set-enabled name #t)
    (error (string-append "rule:enable: no such rule: " (rule-name-display name)))))

(define (rule:disable name)
  (if (find-rule name)
    (rule:set-enabled name #f)
    (error (string-append "rule:disable: no such rule: " (rule-name-display name)))))

; ── rule:list — 列出规则 ───────────────────────────────────
(define (rule:list)
  (map (lambda (r)
    (list :name (car r) :enabled (list-ref r 5) :scope (list-ref r 6)))
    (rules-in-order)))

; ── rule:status — 规则详情 ────────────────────────────────
(define (rule:status name)
  (let ((r (find-rule name)))
    (if r
      (list :name (rule-name r)
            :pattern (rule-pattern r)
            :replace (rule-replace r)
            :condition (rule-condition r)
            :description (rule-desc r)
            :enabled (rule-enabled? r)
            :scope (rule-scope r))
      #f)))

; ── 内部: 检查条件是否满足 ────────────────────────────────
(define (check-condition cond-fn node-id)
  (if (eq? cond-fn #t) #t
    (try
      (let ((expr (string-append
        "(let ((node " (number->string node-id) ")) "
        (if (string? cond-fn) cond-fn "")
        ")")))
        (eval expr))
      (catch (e) #f))))

; ── 内部: 检查节点是否在 scope 内 ──────────────────────────
(define (in-scope? scope node-id)
  (if (eq? scope :workspace) #t
    (if (symbol? scope)
      ; Scope is a function name — check if node is inside it
      (let ((defs (query :def-use (symbol->string scope))))
        (if (pair? (car defs))
          ; Node is in scope if it's a child of the define
          #t
          #f))
      #t)))

; ── 内部: 应用单条规则到 workspace（带 scope 过滤）─────────
(define (apply-rule r)
  (if (not (rule-enabled? r)) 0
    (let ((pattern (rule-pattern r))
          (replacement (rule-replace r))
          (cond-fn (rule-condition r))
          (scope (rule-scope r)))
      (define matches (query:pattern pattern))
      (if (not (pair? matches)) 0
        (let ((fixed 0))
          (for-each
            (lambda (node)
              (if (and (check-condition cond-fn node)
                       (in-scope? scope node))
                (let ((result
                      (try
                        (if (string? replacement)
                          (begin
                            (mutate :rebind (string-append "_fix_"
                              (number->string node))
                              replacement "rule-fix")
                            #t)
                          #f)
                        (catch (e) #f))))
                  (if result (set! fixed (+ fixed 1))))
                #f))
            matches)
          fixed)))))

; ── rule:apply — 应用单条规则 ──────────────────────────────
(define (rule:apply name)
  (let ((r (find-rule name)))
    (if (not r)
      (error (string-append "rule:apply: no such rule: " (rule-name-display name)))
      (apply-rule r))))

; ── rule:apply-all — 应用所有启用规则 ──────────────────────
(define (rule:apply-all)
  (let ((total 0))
    (for-each
      (lambda (r)
        (if (rule-enabled? r)
          (set! total (+ total (apply-rule r)))
          #f))
      (rules-in-order))
    total))

; ── rule:list-violations — 审计模式 ─────────────────────────
(define (rule:list-violations)
  (let ((violations '()))
    (for-each
      (lambda (r)
        (if (rule-enabled? r)
          (let ((pattern (rule-pattern r))
                (cond-fn (rule-condition r))
                (scope (rule-scope r)))
            (define matches (query:pattern pattern))
            (define valid-matches
              (filter (lambda (node)
                (and (check-condition cond-fn node)
                     (in-scope? scope node)))
                matches))
            (if (pair? valid-matches)
              (set! violations (cons
                (list :rule (rule-name r)
                      :count (length valid-matches)
                      :nodes valid-matches
                      :scope scope
                      :description (rule-desc r))
                violations))
              #f))
          #f))
      (rules-in-order))
    violations))

; ── rule:save — 保存规则到 JSON 文件 ───────────────────────
(define (rule:save filename)
  (define json-str (string-append "[" (apply string-append
    (map (lambda (r)
      (string-append
        "{"
        "\\\"name\\\":\\\"" (if (string? (car r)) (car r) (symbol->string (car r))) "\\\","
        "\\\"pattern\\\":\\\"" (list-ref r 1) "\\\","
        "\\\"replace\\\":\\\"" (list-ref r 2) "\\\","
        "\\\"condition\\\":\\\"" (if (string? (list-ref r 3)) (list-ref r 3) "#t") "\\\","
        "\\\"description\\\":\\\"" (list-ref r 4) "\\\","
        "\\\"enabled\\\":" (if (list-ref r 5) "true" "false") ","
        "\\\"scope\\\":\\\"" (if (eq? (list-ref r 6) :workspace) "workspace"
                               (if (string? (list-ref r 6)) (list-ref r 6) (symbol->string (list-ref r 6)))) "\\\""
        "}"))
      (rules-in-order))) "]"))
  (write-file filename json-str)
  (display "Saved ")(display (length (rules-in-order)))(display " rules to ")
  (display filename)(newline)
  (length (rules-in-order)))

; ── rule:load — 从 JSON 文件加载规则 ───────────────────────
(define (rule:load filename)
  (define content (read-file filename))
  (if (string? content)
    (let ((data (json-parse content)))
      (if (list? data)
        (begin
          (set! *rule-index* (make-hash))
          (set! *rule-order* '())
          (for-each (lambda (entry)
            (let* ((name (hash-ref entry "name"))
                   (pattern (hash-ref entry "pattern"))
                   (replace (hash-ref entry "replace"))
                   (cond-str (hash-ref entry "condition"))
                   (desc (hash-ref entry "description"))
                   (enabled-str (hash-ref entry "enabled"))
                   (scope-str (hash-ref entry "scope"))
                   (condition (if (string? cond-str) cond-str #t))
                   (enabled (if (string? enabled-str) (equal? enabled-str "true") #t))
                   (scope (if (and (string? scope-str) (equal? scope-str "workspace"))
                            :workspace
                            (if (string? scope-str) (string->symbol scope-str) :workspace)))
                   (k (rule-key name)))
              (hash-set! *rule-index* k
                         (list name pattern replace condition desc enabled scope))
              (set! *rule-order* (append *rule-order* (list k)))))
            data)
          (display "Loaded ")(display (length *rule-order*))(display " rules from ")
          (display filename)(newline)
          (length *rule-order*)))
      0)
    0))
