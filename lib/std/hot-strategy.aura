; lib/std/hot-strategy.aura — Issue #2582 (Aether denseness H7)
;
; Pure-Aura **hot strategy** surface for agent closed-loops.
; This is intentionally NOT AOT / .so reload — use std/hot-update for that.
;
; Pattern (Aether example 04 / denseness Axis D):
;   1. Seed workspace with a named strategy define (set-code + eval-current)
;   2. (hot-strategy:snapshot! "tag") before risky swaps
;   3. (hot-strategy:swap! name body summary) via mutate:rebind
;   4. On failure: (hot-strategy:heal!) restores that name's last-good
;
; Version counter is process-local (not persisted). Each name keeps its
; own last-good body and ast:snapshot id (-1 = none). No-arg readers report
; the active name (the latest successful register! or swap!).
; (hot-strategy:heal!) rolls back that name. (hot-strategy:heal! name)
; rolls back one name and leaves every other rule where it is.
;
; Form order (#2769): export before require — *hs-version* / *hs-name*
; free-vars. Host tolerates either order (#2766); export-first is canonical.

(export hot-strategy:version
        hot-strategy:last-good-body
        hot-strategy:last-good-snap
        hot-strategy:active-name
        hot-strategy:snapshot!
        hot-strategy:register!
        hot-strategy:swap!
        hot-strategy:heal!
        hot-strategy:call
        hot-strategy:aot?
        hot-strategy:help)

(require "std/mutate" all:)


; ── Process-local strategy registry. One record per name (#5288). ──
; *hs-name* is the active name. *hs-rules* maps a name to
; (body snap rollback-body). body is the last successful register/swap.
; snap is that name's checkpoint. rollback-body is what heal rebinds
; when other names are also registered, so a workspace restore cannot
; rewind them.
(define *hs-version* 0)
(define *hs-name* "")
(define *hs-rules* (hash))

(define (hs-pick-name rest)
  (if (and (pair? rest) (string? (car rest)))
    (car rest)
    *hs-name*))

(define (hs-rec name)
  (let ((r (hash-ref *hs-rules* name #f)))
    (if (pair? r) r (list "" -1 ""))))

(define (hs-body name) (car (hs-rec name)))
(define (hs-snap name) (car (cdr (hs-rec name))))
(define (hs-rollback name) (car (cdr (cdr (hs-rec name)))))

(define (hs-rule-count) (length (hash-keys *hs-rules*)))

(define (hot-strategy:version) *hs-version*)
(define (hot-strategy:last-good-body . rest) (hs-body (hs-pick-name rest)))
(define (hot-strategy:last-good-snap . rest) (hs-snap (hs-pick-name rest)))
(define (hot-strategy:active-name) *hs-name*)

; AOT hot-update is a different surface (std/hot-update + aot:reload).
(define (hot-strategy:aot?) #f)

(define (hot-strategy:help)
  "Pure-Aura hot strategy: register! / swap! / heal! / snapshot!. Each name keeps its own last-good; (heal! name) rolls back that name only. For AOT .so reload use std/hot-update.")

; (hot-strategy:snapshot! tag) → snapshot-id (int)
(define (hot-strategy:snapshot! tag)
  (mutate :snapshot (if (string? tag) tag "hot-strategy")))

; Record last-good without rebinding (after a known-good eval).
; (hot-strategy:register! name body-string [tag])
(define (hot-strategy:register! name body)
  (set! *hs-name* name)
  (set! *hs-version* (+ *hs-version* 1))
  (let ((snap (hot-strategy:snapshot! (string-append "hs-reg-" name))))
    (hash-set! *hs-rules* name (list body snap body))
    (list #t *hs-version* snap)))

; Atomic-ish swap: snapshot → mutate:rebind → eval-current.
; Returns (ok version snap-id) where ok is #t/#f.
; Does NOT auto-heal; caller may (hot-strategy:heal!) on failure.
(define (hot-strategy:swap! name body summary)
  ; Issue #4275: mutate:rebind returns #f on reject (no throw). eval-current
  ; errors must fail the swap - do not catch them as success. Only promote
  ; last-good / version when rebind is true AND eval-current does not raise.
  (let ((pre (hot-strategy:snapshot! (string-append "hs-pre-" name)))
        (sum (if (string? summary) summary "hot-strategy:swap")))
    (let ((ok (try
                (let ((rebound (mutate :rebind name body sum)))
                  ; Only exact #t is success — reject may be #f or an error
                  ; object (truthy), neither of which must promote last-good.
                  (if (equal? rebound #t)
                      (begin (eval-current) #t)
                      #f))
                (catch (e) #f))))
      (if ok
          (begin
            (set! *hs-name* name)
            (set! *hs-version* (+ *hs-version* 1))
            (let ((prev (hs-body name)))
              (hash-set! *hs-rules* name
                         (list body pre (if (string=? prev "") "" prev))))
            (list #t *hs-version* pre))
          (list #f *hs-version* pre)))))

; One name, and the checkpoint is a whole-workspace snapshot: restore it.
; Several names: rebind only this name's rollback body.
(define (hs-heal-rebind name rollback)
  (if (or (not (string? name))
          (string=? name "")
          (not (string? rollback))
          (string=? rollback ""))
    #f
    (try
      (let ((rebound (mutate :rebind name rollback "hot-strategy:heal")))
        (if (equal? rebound #t)
          (begin (try (eval-current) (catch (e) #t)) #t)
          #f))
      (catch (e) #f))))

(define (hs-heal-snapshot name body snap)
  (let ((restored
         (if (>= snap 0)
           (try (mutate :restore snap) (catch (e) #f))
           #f)))
    (if restored
      (begin
        (try (eval-current) (catch (e) #f))
        #t)
      (hs-heal-rebind name body))))

(define (hs-heal-one name)
  (if (or (not (string? name)) (string=? name ""))
    #f
    (if (<= (hs-rule-count) 1)
      (hs-heal-snapshot name (hs-body name) (hs-snap name))
      (hs-heal-rebind name (hs-rollback name)))))

(define (hot-strategy:heal! . rest)
  (hs-heal-one (hs-pick-name rest)))

; Optional call helper if strategy is already bound as a procedure name.
; Agents usually call the strategy symbol directly after swap.
(define (hot-strategy:call fn arg)
  (fn arg))
