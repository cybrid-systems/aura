; lib/std/agent.aura — one closed loop, six phases (#5004)
;
; The Aura layer of the agent public surface. One round is a sequence of
; phases, each a value in and a value out:
;
;   observe  → (agent:observe target)        query + source + live metrics
;   propose  → (agent:propose ...)           ops to apply
;   check    → (agent:check observed)        commit / back-off / escalate
;   apply    → (agent:apply proposal snap)   atomic mutation batch
;   verify   → (agent:verify applied src)    eval-current + post metrics
;   record   → (agent:record round summary)  evo:record! worldline entry
;
; (agent:round ...) threads those six and returns the pre-#5004 round
; alist; agent:closed-loop-once / auto-grow / edsl-fix are its callers.
;
; Agent surface exports
;   round    : agent:closed-loop-once agent:round agent:decide
;              agent:decision-metrics agent:loop-stats agent:loop-stats-reset!
;   phases   : agent:observe agent:propose agent:check agent:apply
;              agent:verify agent:record
;   recovery : agent:recover-plan agent:recover!
;   replace  : agent:hot-replace agent:replace-step
;   llm      : llm-ask llm:extract-code safe-eval (optional model IO)
;   legacy   : auto-grow edsl-fix
;
; The four hot-update modules (std/hot-update, std/hot-update-monitor,
; std/hot-update-region, std/hot-update-reload) are steps behind
; agent:hot-replace, not separate public surfaces.
;
; The experience layer (std/evo) reads what agent:record writes; the
; multi-agent layer is std/orch.
;
; Import: (require "std/agent" all:)
;         (require std/agent)

(export auto-grow edsl-fix safe-eval llm-ask llm:extract-code
        agent-alist-ref agent:decision-metrics agent:decide agent:loop-stats
        agent:loop-stats-reset! agent:closed-loop-once agent:round
        agent:observe agent:propose agent:check agent:apply agent:verify
        agent:record agent:recover-plan agent:recover!
        agent:hot-replace agent:replace-step)

(require std/json)
(require std/string)
(require "std/mutate" all:)
; #5004: experience layer (worldline selectors) + replacement steps.
(require "std/evo" all:)
(require "std/hot-update" all:)
(require "std/hot-update-monitor" all:)
(require "std/hot-update-region" all:)
; #1551: sanitize + structured parse for production LLM path
(require "std/llm" all:)

; ── Configuration ──────────────────────────────────────────────
(define api-key (getenv "LLM_API_KEY"))
(define api-url (getenv "LLM_API_URL"))
(define llm-model (getenv "LLM_MODEL"))

(if (void? api-url) (set! api-url "https://api.deepseek.com/chat/completions"))
(if (void? llm-model) (set! llm-model "deepseek-chat"))

; Decision thresholds (Issue #1461 contract — tunable)
; long-hold is cumulative process-wide (holds-over-1ms); use a noise
; floor so a single healthy mutate does not permanently back-off.
(define *agent-rollback-rate-max* 50)   ; percent; ≥ → back-off
(define *agent-panic-max* 1)            ; absolute; ≥ → escalate
(define *agent-long-hold-max* 50)       ; holds-over-1ms; > → back-off
; #1553: extra thresholds for yield-skip / quota / boundary depth
(define *agent-yield-skip-max* 20)      ; safe-yield skipped-held; > → back-off
(define *agent-quota-violation-max* 1)  ; longrunning quota-violations; ≥ → escalate
(define *agent-fiber-rollback-max* 50)  ; fiber Guard rollbacks; > → back-off

; Loop telemetry for tests / dashboards (does not depend on engine).
; Hash tables grow (#2654); keep this catalog at 8 keys so dashboards stay
; stable. Display occupancy is hash-length (#3916), not the table index.
(define *agent-loop-stats*
  (hash "query-calls" 0
        "atomic-batch-calls" 0
        "metrics-calls" 0
        "decisions" 0
        "commits" 0
        "rollbacks" 0
        "back-offs" 0
        "escalations" 0))

(define (agent:loop-stats)
  *agent-loop-stats*)

(define (agent:loop-stats-reset!)
  (set! *agent-loop-stats*
    (hash "query-calls" 0
          "atomic-batch-calls" 0
          "metrics-calls" 0
          "decisions" 0
          "commits" 0
          "rollbacks" 0
          "back-offs" 0
          "escalations" 0))
  *agent-loop-stats*)

(define (agent-bump! key)
  (hash-set! *agent-loop-stats* key
             (+ 1 (hash-ref *agent-loop-stats* key 0))))

; ── Safe number / alist helpers ────────────────────────────────
(define (agent-num v default)
  (if (number? v) v default))

(define (agent-hash-num h key default)
  (if (hash? h)
    (agent-num (hash-ref h key default) default)
    default))

; assq/assoc are not always bound; local alist lookup.
; Keys are strings (":ok", ":decision", …) — use equal? not eq?.
(define (agent-alist-ref key lst default)
  (if (null? lst)
    default
    (if (equal? (car (car lst)) key)
      (cdr (car lst))
      (agent-alist-ref key (cdr lst) default))))

; ── LLM API call (#1551: sanitize user prompt; json-encode body) ──
(define (llm-ask prompt)
  (if (llm:injection-risk? (if (string? prompt) prompt ""))
    "injection-blocked"
    (let* ((clean (llm:sanitize-prompt (if (string? prompt) prompt "")))
           (body (json-encode
                   (hash "model" llm-model
                         "messages"
                         (list
                           (hash "role" "system"
                                 "content"
                                 "You are Aura Lisp. Return ONLY valid Aura code. No markdown, no explanation.")
                           (hash "role" "user" "content" clean)))))
           (resp (aura-llm-call body)))
      resp)))

; ── Extract code from LLM response (#1551: llm:extract-content) ──
; #3920: string-find is exported from std/string (fence path). MiniMax-M3
; often wraps in <think>…</think> without fences — peel that first.
; #3928: do not string-split on "```" (first-char backtick). Peel the
; opening/closing fence with string-find of the whole marker so the
; extracted body is not "…\n```".
(define (llm:extract-code-rtrim s)
  (define n (string-length s))
  (let ((hi n))
    (while (lambda ()
             (and (> hi 0)
                  (let ((c (string-ref s (- hi 1))))
                    (or (= c 32) (= c 10) (= c 13) (= c 9)))))
      (lambda () (set! hi (- hi 1))))
    (substring s 0 hi)))
(define (llm:extract-code response)
  (let ((parsed (llm:extract-content response)))
    (let ((content (if (and (string? parsed) (> (string-length parsed) 0))
                     parsed
                     (if (string? response) response ""))))
      (if (not (string? content))
        ""
        (begin
          (define te (string-find content "</think>"))
          (define stripped
            (if (>= te 0)
              (substring content (+ te 8) (string-length content))
              content))
          (define open (string-find stripped "```"))
          (if (>= open 0)
            (let* ((after-open (substring stripped (+ open 3)
                                          (string-length stripped)))
                   (close (string-find after-open "```"))
                   (body (if (>= close 0)
                           (substring after-open 0 close)
                           after-open))
                   (nl (string-find body "\n")))
              (llm:extract-code-rtrim
                (if (>= nl 0)
                  (substring body (+ nl 1) (string-length body))
                  body)))
            (begin
              (define lam (string-find stripped "(lambda"))
              (if (>= lam 0)
                (substring stripped lam (string-length stripped))
                stripped))))))))
; ── Safe eval with error handling ─────────────────────────────
(define (safe-eval code)
  (try
    (let ((result (eval code)))
      (cons 1 result))
    (catch (e)
      (cons 0 e))))

; ═══════════════════════════════════════════════════════════════
; Agent Decision Metrics (Issue #1460 AC2 + minimal #1461 contract)
;
; Stable entry point agents MUST call before every commit.
; Wraps live engine observability — never invents counters.
; ═══════════════════════════════════════════════════════════════
(define (agent:decision-metrics)
  (agent-bump! "metrics-calls")
  (try
    (let* ((ml (try (query "qr:mutation-log-summary")
                    (catch (e) (hash "total" 0 "committed" 0 "rolled-back" 0))))
           ; #1449: atomic-batch:stats is facade-only — prefer stats:get
           (ab (try (stats:get "atomic-batch:stats")
                    (catch (e) (hash "batch-count" 0 "rollback-count" 0))))
           (hold (try (stats:get "query:mutation-boundary-hold-stats")
                      (catch (e) (void))))
           (fiber (try (stats:get "query:fiber-boundary-violation-stats")
                       (catch (e) (void))))
           ; #1553: safe-yield + quota + boundary depth (live engine surfaces)
           (sy (try (stats:get "query:mutation-boundary-safe-yield-stats")
                    (catch (e) (void))))
           (lr (try (stats:get "query:longrunning-infra-stats")
                    (catch (e) (void))))
           (bdepth (try (mutate:boundary-depth) (catch (e) 0)))
           (total (agent-hash-num ml "total" 0))
           (rolled (agent-hash-num ml "rolled-back" 0))
           ; Integer division: compute (* 100 n)/d so rates are not truncated to 0.
           (ml-rate (if (= total 0) 0
                      (let ((pct (/ (* 100 rolled) total)))
                        (if (< pct 0) 0 (if (> pct 100) 100 pct)))))
           ; #1461: atomic-batch outcomes are always live; fold into rate so
           ; agents do not depend solely on mutation-log RolledBack status.
           (ab-ok (agent-hash-num ab "batch-count" 0))
           (ab-rb (agent-hash-num ab "rollback-count" 0))
           (ab-tot (+ ab-ok ab-rb))
           (ab-rate (if (= ab-tot 0) 0
                      (let ((pct (/ (* 100 ab-rb) ab-tot)))
                        (if (< pct 0) 0 (if (> pct 100) 100 pct)))))
           (rb-rate (if (> ab-rate ml-rate) ab-rate ml-rate))
           ; panic-count ← recovery-failures (fiber resume / Guard recovery)
           ; #1553: also fold longrunning quota-violations into escalate path
           (rec-fail (agent-hash-num fiber "recovery-failures" 0))
           (quota-v (agent-hash-num lr "quota-violations" 0))
           (panic-n (if (>= quota-v *agent-quota-violation-max*)
                      (+ rec-fail quota-v)
                      rec-fail))
           (hold-us (agent-hash-num hold "hold-time-us-total" 0))
           (long-hold (agent-hash-num hold "holds-over-1ms" 0))
           (sy-skip (agent-hash-num sy "safe-yield-skipped-held-total" 0))
           (fiber-rb (agent-hash-num fiber "rollbacks" 0))
           ; Fold boundary/yield pressure into long-hold signal so schema
           ; stays 8 keys (Aura hash capacity) while #1553 gates fire.
           (pressure-hold
             (+ long-hold
                (if (> bdepth 0) 1 0)
                (if (> sy-skip *agent-yield-skip-max*)
                  *agent-long-hold-max* 0)
                (if (> fiber-rb *agent-fiber-rollback-max*)
                  *agent-long-hold-max* 0)))
           (rec
             (cond
               ((>= panic-n *agent-panic-max*) "escalate")
               ((>= rb-rate *agent-rollback-rate-max*) "back-off")
               ((> pressure-hold *agent-long-hold-max*) "back-off")
               ((> bdepth 0) "back-off")  ; never commit under nested Guard
               (else "commit"))))
      ; Exactly 8 keys (Aura hash capacity). recommendation first so
      ; it is never dropped if the table fills under collision pressure.
      ; long-hold-count reports pressure-hold so dashboards see #1553 fold-ins.
      (hash "recommendation" rec
            "schema" 1461
            "panic-count" panic-n
            "rollback-rate" rb-rate
            "hold-time-us" hold-us
            "long-hold-count" pressure-hold
            "atomic-batch-commits" ab-ok
            "atomic-batch-rollbacks" ab-rb))
    (catch (e)
      ;; Issue #3962: fail-closed — when live metrics are unavailable we
      ;; do NOT know the surface is safe, so recommend hold (never commit).
      (hash "recommendation" "hold"
            "schema" 1461
            "panic-count" 0
            "rollback-rate" 0
            "hold-time-us" 0
            "long-hold-count" 0
            "atomic-batch-commits" 0
            "atomic-batch-rollbacks" 0))))

; Map recommendation string → symbol for callers
(define (agent:decide)
  (agent-bump! "decisions")
  (let ((rec (hash-ref (agent:decision-metrics) "recommendation" "hold")))
    (cond
      ((equal? rec "escalate") 'escalate)
      ((equal? rec "back-off") 'back-off)
      (else 'commit))))

; ── Query phase (observability + workspace awareness) ─────────
(define (agent-query-workspace target-name)
  (agent-bump! "query-calls")
  (try
    (let* ((root (query :root))
           (found (if (string? target-name)
                    (try (query :find target-name) (catch (e) '()))
                    '()))
           (du (if (string? target-name)
                 (try (query :def-use target-name) (catch (e) '()))
                 '())))
      (list (cons ":root" root)
            (cons ":find" found)
            (cons ":def-use" du)))
    (catch (e)
      (list (cons ":root" 0)
            (cons ":find" '())
            (cons ":def-use" '())))))

; ── Apply atomic mutations (#1553: prefer safe batch wrapper) ─
; ops: list of (list "mutate:rebind" name body summary) etc.
; Uses mutate:atomic-batch-safe so boundary depth / held Guard refuse
; the batch and a cooperative yield runs before MutationBoundaryGuard.
(define (agent-atomic-mutate! ops summary)
  (agent-bump! "atomic-batch-calls")
  (try
    (if (null? ops)
      #f
      (mutate:atomic-batch-safe ops summary))
    (catch (e) #f)))

; Build a single rebind op list for convenience
(define (agent-rebind-ops name body summary)
  (list (list "mutate:rebind" name body summary)))

; Restore workspace from saved source string
(define (agent-restore-source! src)
  (if (string? src)
    (begin
      (set-code src)
      (try (eval-current) (catch (e) #f))
      #t)
    #f))

; ═══════════════════════════════════════════════════════════════
; One round, six phases (#5004): observe → propose → check →
; apply → verify → record. agent:round threads a value between them;
; the alist it returns is the pre-#5004 contract.
; ═══════════════════════════════════════════════════════════════

(define (agent:observe target)
  (hash "query" (agent-query-workspace target)
        "source" (try (current-source) (catch (e) #f))
        "metrics" (agent:decision-metrics)))

(define (agent:propose mutations rebind-name rebind-body summary)
  (let ((s (if (string? summary) summary "closed-loop")))
    (hash "summary" s
          "ops" (cond ((pair? mutations) mutations)
                      ((and (string? rebind-name) (string? rebind-body))
                       (agent-rebind-ops rebind-name rebind-body s))
                      (else (quote ())))
          "rebind" (if (string? rebind-name) rebind-name #f)
          "body" (if (string? rebind-body) rebind-body #f))))

(define (agent:check observed)
  (let ((rec (hash-ref (hash-ref observed "metrics" (hash))
                       "recommendation" "hold")))
    (cond
      ((equal? rec "escalate") 'escalate)
      ((equal? rec "back-off") 'back-off)
      (else 'commit))))

(define (agent:apply proposal snap)
  (let ((ok (agent-atomic-mutate! (hash-ref proposal "ops" (quote ()))
                                  (hash-ref proposal "summary" "closed-loop"))))
    (hash "applied" (if ok #t #f)
          "snapshot" (if (number? snap) snap -1)
          "ops" (hash-ref proposal "ops" (quote ())))))

(define (agent:verify applied pre-src)
  (let ((eval-ok (try (begin (eval-current) #t) (catch (e) #f))))
    ; #1553: post-mutate cooperative yield before post metrics.
    (try (mutate:safe-yield) (catch (e) #f))
    (hash "eval-ok" eval-ok
          "snapshot" (hash-ref applied "snapshot" -1)
          "metrics" (agent:decision-metrics))))

; ── agent:record — one worldline entry per round ──
; KEEP when the round committed, ROLLBACK otherwise. evo:record! is the
; #4910 primitive; when AURA_EVO_LOG is off it returns #f and this phase
; is a no-op (std/evo then reads an empty worldline).
(define (agent:record round summary)
  (let ((d (agent-alist-ref ":decision" round 'rollback)))
    (try (evo:record! "agent:closed-loop"
                      (if (agent-alist-ref ":ok" round #f) "KEEP" "ROLLBACK")
                      (symbol->string (if (symbol? d) d 'rollback))
                      (hash "summary" (if (string? summary) summary "closed-loop")
                            "eval-ok" (if (agent-alist-ref ":eval-ok" round #f)
                                        #t #f)))
         (catch (e) #f)))
  round)

(define (agent-round-result ok decision eval-ok metrics summary bump)
  (if (string? bump) (agent-bump! bump) #f)
  (agent:record
    (list (cons ":ok" ok)
          (cons ":decision" decision)
          (cons ":eval-ok" eval-ok)
          (cons ":metrics" metrics))
    summary))

; ── agent:round — one closed loop round ──
; (agent:round source mutations rebind-name rebind-body summary skip-set-code?)
; Returns ((:ok . bool) (:decision . sym) (:eval-ok . bool) (:metrics . hash)).
(define (agent:round source mutations rebind-name rebind-body summary
                     skip-set-code?)
  ; 1) observe: load source
  (if (and (string? source) (not skip-set-code?))
    (begin (set-code source) (try (eval-current) (catch (e) #f)))
    #f)
  ; #1553: yield before deciding / mutating.
  (try (mutate:safe-yield) (catch (e) #f))
  (let* ((pre-src (try (current-source) (catch (e) source)))
         (observed (agent:observe rebind-name))
         (pre-metrics (hash-ref observed "metrics" (hash)))
         (gate (agent:check observed)))
    (cond
      ; 2) check refused the round
      ((eq? gate 'escalate)
       (agent-round-result #f 'escalate #f pre-metrics summary "escalations"))
      ((eq? gate 'back-off)
       (agent-round-result #f 'back-off #f pre-metrics summary "back-offs"))
      (else
       (let* ((proposal (agent:propose mutations rebind-name rebind-body summary))
              ; 3) apply
              (snap (try (mutate :snapshot (hash-ref proposal "summary" "closed-loop"))
                         (catch (e) -1)))
              (applied (agent:apply proposal snap))
              (mut-ok (hash-ref applied "applied" #f))
              ; 4) verify
              (verified (agent:verify applied pre-src))
              (eval-res (hash-ref verified "eval-ok" #f))
              (snap2 (hash-ref verified "snapshot" -1))
              (post-metrics (hash-ref verified "metrics" (hash)))
              (post-rec (hash-ref post-metrics "recommendation" "hold")))
         (cond
           ((not mut-ok)
            (agent-restore-source! pre-src)
            (agent-round-result #f 'rollback eval-res post-metrics summary
                                "rollbacks"))
           ((not eval-res)
            (if (and (number? snap2) (>= snap2 0))
              (try (mutate :restore snap2) (catch (e) (agent-restore-source! pre-src)))
              (agent-restore-source! pre-src))
            (agent-round-result #f 'rollback #f post-metrics summary "rollbacks"))
           ((equal? post-rec "escalate")
            (if (and (number? snap2) (>= snap2 0))
              (try (mutate :restore snap2) (catch (e) (agent-restore-source! pre-src)))
              (agent-restore-source! pre-src))
            (agent-round-result #f 'escalate #t post-metrics summary
                                "escalations"))
           ((equal? post-rec "back-off")
            (if (and (number? snap2) (>= snap2 0))
              (try (mutate :restore snap2) (catch (e) (agent-restore-source! pre-src)))
              (agent-restore-source! pre-src))
            (agent-round-result #f 'back-off #t post-metrics summary "back-offs"))
           (else
            ; 5) record a committed round
            (agent-round-result #t 'commit #t post-metrics summary "commits"))))))))

; Positional core — kept for auto-grow / edsl-fix callers; same round.
(define (agent-closed-loop-core source mutations rebind-name rebind-body
                                summary skip-set-code?)
  (agent:round source mutations rebind-name rebind-body summary skip-set-code?))

; ── recovery policy (#5004: agent:recover-from-error strategy lives here) ──
; The engine primitive owns diagnose → fix → clear-hold (#2917). This is
; the policy over its result: (ok status cause fix-type fixed).
; → 'commit | 'escalate | 'back-off | 'retry
(define (agent:recover-plan result)
  (if (not (pair? result))
    'escalate
    (let ((ok (car result))
          (status (if (pair? (cdr result)) (car (cdr result)) 5)))
      (cond
        ((and (boolean? ok) ok) 'commit)
        ((= status 3) 'escalate)   ; no-diagnosis: nothing to apply
        ((= status 4) 'back-off)   ; guard-fail: hold, do not retry now
        ((= status 2) 'retry)      ; diagnosis failed, a new proposal may work
        (else 'escalate)))))

; ── agent:recover! — run recovery and land it on the worldline ──
(define (agent:recover! error-text code)
  (let* ((result (try (agent:recover-from-error error-text code)
                      (catch (e) #f)))
         (plan (agent:recover-plan result))
         (round (list (cons ":ok" (if (eq? plan 'commit) #t #f))
                      (cons ":decision" plan)
                      (cons ":eval-ok" #f)
                      (cons ":metrics" (agent:decision-metrics)))))
    (agent:record round (string-append "recover:" (symbol->string plan)))))

; ── replacement step: the four hot-update modules, composed ──
; One call: isolate the region → reload → poll health → restore region.
; Returns a hash; never raises (a missing/invalid .so is a refused reload).
(define (agent:hot-replace path . args)
  (define agent-id (if (pair? args) (car args) 0))
  (define polls (if (and (pair? args) (pair? (cdr args))) (cadr args) 1))
  (define prev-region (try (region:get) (catch (e) 0)))
  (define isolated (try (region:isolate! agent-id) (catch (e) #f)))
  (define reloaded (try (hot-update:reload path) (catch (e) #f)))
  (define monitor (try (make-hot-update-monitor (lambda (stats) stats))
                       (catch (e) #f)))
  (define health (try (monitor:run-n monitor polls) (catch (e) #f)))
  (try (if (and (number? prev-region) (not (= prev-region 0)))
         (hot-update:set-region! prev-region)
         (region:clear!))
       (catch (e) #f))
  (hash "ok" (if reloaded #t #f)
        "path" (if (string? path) path "")
        "isolated" (if isolated #t #f)
        "reload" (if reloaded #t #f)
        "health" health
        "region" (if (number? prev-region) prev-region 0)))

(define (agent:replace-step path . args)
  (cond
    ((null? args) (agent:hot-replace path))
    ((null? (cdr args)) (agent:hot-replace path (car args)))
    (else (agent:hot-replace path (car args) (cadr args)))))

; Keyword wrapper for agents / tests (single-shot rest-args is OK).
(define (agent:closed-loop-once . args)
  (let ((source #f)
        (mutations '())
        (rebind-name #f)
        (rebind-body #f)
        (summary "closed-loop")
        (skip-set-code? #f))
    (let parse ((a args))
      (cond
        ((null? a) #f)
        ((eq? (car a) :source)
         (set! source (cadr a)) (parse (cddr a)))
        ((eq? (car a) :mutations)
         (set! mutations (cadr a)) (parse (cddr a)))
        ((eq? (car a) :rebind)
         (set! rebind-name (cadr a))
         (set! rebind-body (if (pair? (cddr a)) (caddr a) #f))
         (parse (if (pair? (cddr a)) (cdddr a) (cddr a))))
        ((eq? (car a) :summary)
         (set! summary (cadr a)) (parse (cddr a)))
        ((eq? (car a) :skip-set-code)
         (set! skip-set-code? #t) (parse (cdr a)))
        (else (parse (cdr a)))))
    (agent-closed-loop-core source mutations rebind-name rebind-body
                            summary skip-set-code?)))

; ── Prompt-only loop (compat — not the default) ───────────────
(define (auto-grow-prompt-only task tries)
  (display (string-append "\n=== Auto-grow [prompt-only]: " task " ===\n"))
  (let loop ((n 1))
    (if (> n tries)
      (begin
        (display "  Failed after ")
        (display tries)
        (display " attempts\n")
        #f)
      (begin
        (display "  [")
        (display n)
        (display "/")
        (display tries)
        (display "] LLM generating...\n")
        (define response (llm-ask task))
        (define code (llm:extract-code response))
        (define result (safe-eval code))
        (if (= (car result) 1)
          (begin
            (display "  Success!\n")
            (cdr result))
          (begin
            (display "  Error: ")
            (display (cdr result))
            (newline)
            (loop (+ n 1))))))))

; ═══════════════════════════════════════════════════════════════
; auto-grow — default EDSL closed-loop (Issue #1460)
;
; (auto-grow task)
; (auto-grow task max-tries)
; (auto-grow task :prompt-only)
; (auto-grow task 5 :prompt-only)
; (auto-grow task
;    :source "(define (f x) (+ x 1))"
;    :rebind "f" "(lambda (x) (* x 2))"
;    :max-tries 3)
; (auto-grow task :source "..." :mutations ops-list)
;
; Returns:
;   success value / #t on EDSL commit
;   #f on failure / escalate
;   'back-off / 'escalate symbols when safety gate fires
; ═══════════════════════════════════════════════════════════════
(define (auto-grow task . args)
  (let ((tries 5)
        (prompt-only? #f)
        (source #f)
        (mutations '())
        (rebind-name #f)
        (rebind-body #f)
        (summary "auto-grow"))
    ; first positional number → max-tries
    (let parse ((a args))
      (cond
        ((null? a) #f)
        ((number? (car a))
         (set! tries (car a)) (parse (cdr a)))
        ((or (eq? (car a) :prompt-only)
             (eq? (car a) 'prompt-only))
         (set! prompt-only? #t) (parse (cdr a)))
        ((eq? (car a) :max-tries)
         (set! tries (cadr a)) (parse (cddr a)))
        ((eq? (car a) :source)
         (set! source (cadr a)) (parse (cddr a)))
        ((eq? (car a) :mutations)
         (set! mutations (cadr a)) (parse (cddr a)))
        ((eq? (car a) :rebind)
         (set! rebind-name (cadr a))
         (set! rebind-body (if (pair? (cddr a)) (caddr a) #f))
         (parse (if (pair? (cddr a)) (cdddr a) (cddr a))))
        ((eq? (car a) :summary)
         (set! summary (cadr a)) (parse (cddr a)))
        (else (parse (cdr a)))))

    (if prompt-only?
      (auto-grow-prompt-only task tries)
      (begin
        (display (string-append "\n=== Auto-grow [EDSL]: " task " ===\n"))
        (let loop ((n 1))
          (if (> n tries)
            (begin
              (display "  Failed after ")
              (display tries)
              (display " EDSL rounds\n")
              #f)
            (let* ((gate (agent:decide))
                   (_d1 (begin
                          (display "  [")
                          (display n)
                          (display "/")
                          (display tries)
                          (display "] closed-loop round...\n")
                          #f)))
              (cond
                ((eq? gate 'escalate)
                 (display "  escalate: decision metrics require human\n")
                 'escalate)
                ((eq? gate 'back-off)
                 (display "  back-off: high rollback / long-hold; stopping\n")
                 'back-off)
                (else
                 (let* ((ops mutations)
                        (rname rebind-name)
                        (rbody rebind-body)
                        ; Optional LLM assist when no structured ops given
                        (_llm
                         (if (and (null? ops)
                                  (not (string? rbody))
                                  (string? task)
                                  (not (void? api-key)))
                           (let* ((prompt
                                   (string-append
                                     "EDSL only. Task: " task
                                     ". Return ONLY a single Aura lambda body "
                                     "for mutate:rebind (no markdown)."))
                                  (resp (try (llm-ask prompt) (catch (e) "")))
                                  (code (try (llm:extract-code resp) (catch (e) ""))))
                             (if (and (string? code) (> (string-length code) 0))
                               (begin
                                 (if (not (string? rname)) (set! rname "main") #f)
                                 (set! rbody code)
                                 #t)
                               #f))
                           #f))
                        (round
                         (agent-closed-loop-core
                           source ops rname rbody
                           (string-append summary "-r" (number->string n))
                           (> n 1)))
                        (ok (agent-alist-ref ":ok" round #f))
                        (dec (agent-alist-ref ":decision" round 'rollback)))
                   (cond
                     ((eq? dec 'escalate)
                      (display "  escalate after metrics\n")
                      'escalate)
                     ((eq? dec 'back-off)
                      (display "  back-off after metrics\n")
                      'back-off)
                     (ok
                      (display "  commit ok\n")
                      #t)
                     (else
                      (display "  round failed; retry\n")
                      (loop (+ n 1))))))))))))))

; ═══════════════════════════════════════════════════════════════
; edsl-fix — upgraded to mutate:atomic-batch (Issue #1460 AC4)
;
; (edsl-fix task source)
; (edsl-fix task source :mutations ops)
; (edsl-fix task source :rebind "f" "(lambda (x) 0)")
; ═══════════════════════════════════════════════════════════════
(define (edsl-fix task source . args)
  (let ((mutations '())
        (rebind-name #f)
        (rebind-body #f)
        (summary "edsl-fix"))
    (let parse ((a args))
      (cond
        ((null? a) #f)
        ((eq? (car a) :mutations)
         (set! mutations (cadr a)) (parse (cddr a)))
        ((eq? (car a) :rebind)
         (set! rebind-name (cadr a))
         (set! rebind-body (if (pair? (cddr a)) (caddr a) #f))
         (parse (if (pair? (cddr a)) (cdddr a) (cddr a))))
        ((eq? (car a) :summary)
         (set! summary (cadr a)) (parse (cddr a)))
        (else (parse (cdr a)))))

    (display "  [EDSL] closed-loop fix...\n")

    ; If no structured ops, ask LLM for a rebind body (not free eval)
    (if (and (null? mutations)
             (not (and (string? rebind-name) (string? rebind-body))))
      (begin
        (display "  [EDSL] LLM proposing rebind body...\n")
        (let* ((prompt
                (string-append task
                               " Current source is loaded. Return ONLY the new body "
                               "expression for the primary define (no markdown)."))
               (response (try (llm-ask prompt) (catch (e) "")))
               (body (try (llm:extract-code response) (catch (e) ""))))
          (if (and (string? body) (> (string-length body) 0))
            (begin
              (set! rebind-name "main")
              (set! rebind-body body))
            #f)))
      #f)

    (let ((round
           (agent-closed-loop-core source mutations rebind-name rebind-body
                                   summary #f)))
      (display "  [EDSL] decision=")
      (display (agent-alist-ref ":decision" round "unknown"))
      (newline)
      (current-source))))
