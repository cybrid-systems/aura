; lib/std/pareto.aura — Issue #4940 (v0.2 P1): algorithm-independent Pareto
; archive, non-dominated sorting, crowding distance, exact 2/3-objective
; hypervolume and the constrained commit gate the v0.2 search stack uses.
;
; Everything here is a VALUE in the #4939 sense: (pareto:archive ...) returns
; a hash, insert!/trim! mutate that hash in place exactly like evo-core's
; handles do, and nothing lives in a module variable. Candidates are
; std/evo-core candidates (evo:candidate / evo:child) — this module never
; defines a parallel candidate type.
;
; Public surface
;   (pareto:archive (hash "dirs" (list "max" "min") "cap" 64
;                         "trim" "crowding"|"hv"|"epsilon" "eps" 0.01))
;   (pareto:insert! a cand objs)     -> #t when the point entered the front
;   (pareto:entries a) (pareto:front a) (pareto:size a)
;   (pareto:dominates? x y dirs) (pareto:cd-dominates? x y opts)
;   (pareto:nd-sort items [opts])    -> list of fronts (items, input order)
;   (pareto:crowding front [opts])   -> distances aligned with front
;   (pareto:hypervolume front ref [opts]) ; exact 2/3, fixed-seed MC > 3
;   (pareto:ref-point front dirs margin)  ; a ref worse than every point
;   (pareto:igd front ref-front [opts])
;   (pareto:improves? a objs [opts]) (pareto:accept? a cand ev)
;   (pareto:representative a [weights]) ; knee by default
;   (pareto:report-svg front [opts])    ; 2-objective scatter + KEEP trail
;   NSGA-II baseline in the same module:
;   (nsga2:make opts) (nsga2:ask s k) (nsga2:tell! s cands objs)
;   (nsga2:run! s eval-fn evals) (nsga2:front s) (nsga2:report s)
;
; ── Conventions ─────────────────────────────────────────────────────
; * Objective vectors are lists of numbers in PROBLEM space. "dirs" is a
;   list of "max"/"min" (shorter than the vector = remaining objectives
;   are "max"). Internally every comparison happens in MAXIMIZE space
;   (a "min" objective is negated), so one comparator serves both.
; * Constraint domination is Deb's rule: a feasible point dominates an
;   infeasible one; two infeasible points compare by total violation; two
;   feasible points compare by objectives. The archive keeps feasible
;   points only — that is the gate contract ("enters the front AND every
;   hard constraint is 0").
; * Hypervolume: exact sweep for 2 and 3 objectives; for more, a fixed-seed
;   Monte-Carlo estimate on a reference box that does not depend on the
;   front, which keeps the estimate monotone when points are added.
;
; Form order (#2769): export before anything else.

(export pareto:archive pareto:archive? pareto:insert! pareto:entries pareto:front
        pareto:size pareto:dominates? pareto:cd-dominates? pareto:nd-sort
        pareto:crowding pareto:hypervolume pareto:igd pareto:improves?
        pareto:accept? pareto:representative pareto:report-svg pareto:ref-point
        pareto:help pareto:schema
        nsga2:make nsga2:ask nsga2:tell! nsga2:run! nsga2:front nsga2:report)

(require "std/evo-core" all:)

(define pareto-schema-version 1)

(define (pareto:help)
  "std/pareto (#4940): (pareto:archive (hash \"dirs\" (list \"max\" \"min\") \"cap\" 64 \"trim\" \"crowding\")) -> a; (pareto:insert! a cand (list 0.9 120)) -> #t|#f; (pareto:nd-sort cands (hash \"objectives\" (list \"success\" \"tokens\") \"dirs\" (list \"max\" \"min\"))) -> fronts; (pareto:crowding front); (pareto:hypervolume front ref (hash \"dirs\" ...)); (pareto:igd front ref-front); (pareto:accept? a cand ev) is the constrained commit gate; (pareto:representative a [weights]) picks the live representative (knee by default); (pareto:report-svg front). NSGA-II: (nsga2:make (hash \"dim\" 30 \"pop\" 100)) (nsga2:ask s 100) (nsga2:tell! s cands objs) (nsga2:run! s eval 20000).")

(define (pareto:schema) pareto-schema-version)

; ═══════════════════════════════════════════════════════════════════
; Small helpers (private; no dependency beyond std/evo-core)
; ═══════════════════════════════════════════════════════════════════

(define (pa-opt h k d)
  ; An explicit () default: hash-ref without one raises on a missing key
  ; (#4855), and an optional field must read as absent, not abort.
  (if (hash? h)
      (let ((v (hash-ref h k ())))
        (if (null? v) d v))
      d))

(define (pa-num v)
  (cond ((number? v) (if (inexact? v) v (exact->inexact v)))
        (else 0.0)))

(define (pa-filter p xs)
  (let loop ((ys xs) (acc (list)))
    (if (null? ys)
        (reverse acc)
        (if (p (car ys))
            (loop (cdr ys) (cons (car ys) acc))
            (loop (cdr ys) acc)))))

(define (pa-fold f acc xs)
  (if (null? xs) acc (pa-fold f (f acc (car xs)) (cdr xs))))

(define (pa-sum xs) (pa-fold + 0.0 xs))

(define (pa-iota n)
  (let loop ((i 0) (acc (list)))
    (if (>= i n) (reverse acc) (loop (+ i 1) (cons i acc)))))

(define (pa-repeat v n)
  (let loop ((i 0) (acc (list)))
    (if (>= i n) acc (loop (+ i 1) (cons v acc)))))

(define (pa-set-at lst i v)
  (cond ((null? lst) (list))
        ((= i 0) (cons v (cdr lst)))
        (else (cons (car lst) (pa-set-at (cdr lst) (- i 1) v)))))

(define (pa-dir-at dirs i)
  (if (< i (length dirs)) (list-ref dirs i) "max"))

(define (pa-sign d)
  (if (and (string? d) (string=? d "min")) -1.0 1.0))

(define (pa-maxvec objs dirs)
  (let loop ((i 0) (xs objs) (acc (list)))
    (if (null? xs)
        (reverse acc)
        (loop (+ i 1) (cdr xs)
              (cons (* (pa-sign (pa-dir-at dirs i)) (pa-num (car xs))) acc)))))

(define (pa-neg xs) (map (lambda (x) (- 0.0 (pa-num x))) xs))

; MAXIMIZE-space dominance: >= everywhere and > somewhere.
(define (pa-dom-max a b)
  (let loop ((xs a) (ys b) (strict #f))
    (cond ((or (null? xs) (null? ys)) strict)
          ((< (car xs) (car ys)) #f)
          ((> (car xs) (car ys)) (loop (cdr xs) (cdr ys) #t))
          (else (loop (cdr xs) (cdr ys) strict)))))

(define (pa-vec= a b)
  (cond ((and (null? a) (null? b)) #t)
        ((or (null? a) (null? b)) #f)
        ((= (pa-num (car a)) (pa-num (car b))) (pa-vec= (cdr a) (cdr b)))
        (else #f)))

(define (pa-lex-less a b)
  (cond ((and (null? a) (null? b)) #f)
        ((null? a) #t)
        ((null? b) #f)
        ((< (pa-num (car a)) (pa-num (car b))) #t)
        ((> (pa-num (car a)) (pa-num (car b))) #f)
        (else (pa-lex-less (cdr a) (cdr b)))))

; Total violation of an item: an evo candidate/measure carries a
; "constraints" hash (evo:violations), an archive entry carries "viol".
(define (pa-viol-of item)
  (cond ((not (hash? item)) 0.0)
        ((number? (pa-opt item "viol" #f)) (pa-num (pa-opt item "viol" 0)))
        ((hash? (pa-opt item "constraints" #f)) (evo:violations item))
        (else 0.0)))

; Objectives of an item: a raw vector, an archive entry ("objs"), or an
; evo candidate (objectives hash read in "objectives" order, else sorted).
(define (pa-objs-of item order)
  (cond ((and (list? item) (not (hash? item))) item)
        ((hash? item)
         (let ((o (pa-opt item "objs" #f)))
           (cond ((list? o) o)
                 ((hash? (pa-opt item "objectives" (hash)))
                  (let* ((h (pa-opt item "objectives" (hash)))
                         (ks (if (and (list? order) (not (null? order)))
                                 order
                                 (sort (hash-keys h) string<?))))
                    (map (lambda (k) (pa-num (hash-ref h k 0.0))) ks)))
                 (else (list)))))
        (else (list))))

(define (pa-max-item item order dirs)
  (let ((mx (pa-opt item "max" #f)))
    (if (list? mx) mx (pa-maxvec (pa-objs-of item order) dirs))))

(define (pa-objs-text objs)
  (let loop ((xs objs) (acc ""))
    (if (null? xs)
        acc
        (loop (cdr xs)
              (string-append acc (if (string=? acc "") "" ",")
                             (number->string (pa-num (car xs))))))))

(define (pa-id-of item objs)
  (cond ((evo:candidate? item) (evo:candidate-id item))
        ((string? (pa-opt item "id" #f)) (pa-opt item "id" ""))
        (else (string-append "o" (pa-objs-text objs)))))

; ═══════════════════════════════════════════════════════════════════
; Archive
; ═══════════════════════════════════════════════════════════════════

(define (pareto:archive opts)
  (let* ((o (if (hash? opts) opts (hash)))
         (dirs (let ((d (pa-opt o "dirs" (list))))
                 (if (list? d) d (list))))
         (cap0 (pa-opt o "cap" 64))
         (cap (if (and (number? cap0) (>= cap0 1))
                  (if (integer? cap0) cap0 (round cap0))
                  64))
         (trim (let ((t (pa-opt o "trim" "crowding")))
                 (if (string? t) t "crowding")))
         (eps (pa-num (pa-opt o "eps" 0.01))))
    (hash "kind" "pareto-archive" "schema" pareto-schema-version
          "dirs" dirs "cap" cap "trim" trim "eps" eps
          "points" (list) "seen" (hash) "seq" 0)))

(define (pareto:archive? v)
  (and (hash? v) (string=? (pa-opt v "kind" "") "pareto-archive")))

(define (pareto:entries a) (pa-opt a "points" (list)))
(define (pareto:size a) (length (pa-opt a "points" (list))))

(define (pa-entry cand objs dirs viol id seq)
  (hash "id" id "cand" cand "objs" objs
        "max" (pa-maxvec objs dirs) "viol" viol "seq" seq))

(define (pa-max-equal? mv pts)
  (cond ((null? pts) #f)
        ((pa-vec= mv (pa-opt (car pts) "max" (list))) #t)
        (else (pa-max-equal? mv (cdr pts)))))

(define (pa-dominated-by? mv pts)
  (cond ((null? pts) #f)
        ((pa-dom-max (pa-opt (car pts) "max" (list)) mv) #t)
        (else (pa-dominated-by? mv (cdr pts)))))

; (pareto:insert! a cand objs) -> #t when the point entered the front.
; Refused when the candidate violates a hard constraint, when its id or its
; objective vector is already archived, or when an archived point dominates
; it. Dominated archived points are removed (the archive is a front).
(define (pa-insert-entry! a cand objs viol id)
  (if (not (pareto:archive? a))
      #f
      (let* ((dirs (pa-opt a "dirs" (list)))
             (mv (pa-maxvec objs dirs))
             (pts (pa-opt a "points" (list)))
             (seen (pa-opt a "seen" (hash))))
        (cond ((null? objs) #f)
              ((> viol 0.0) #f)
              ((hash-ref seen id #f) #f)
              ((pa-dominated-by? mv pts) #f)
              ((pa-max-equal? mv pts) #f)
              (else
               (let* ((seq (pa-opt a "seq" 0))
                      (e (pa-entry cand objs dirs viol id seq))
                      (kept (pa-filter
                              (lambda (x) (not (pa-dom-max mv (pa-opt x "max" (list)))))
                              pts)))
                 (hash-set! a "points" (append kept (list e)))
                 (hash-set! a "seq" (+ seq 1))
                 (hash-set! seen id #t)
                 (hash-set! a "seen" seen)
                 (pa-trim! a)
                 #t))))))

(define (pareto:insert! a cand objs)
  (let ((objs* (if (and (list? objs) (not (null? objs)))
                   objs
                   (pa-objs-of cand (list)))))
    (pa-insert-entry! a cand objs* (pa-viol-of cand) (pa-id-of cand objs*))))

; ── Trimming ────────────────────────────────────────────────────────
; "crowding" drops the least-crowded point, "hv" drops the smallest
; hypervolume contributor, "epsilon" keeps one point per eps cell.
(define (pa-drop-at pts i)
  (let loop ((xs pts) (k 0) (acc (list)))
    (cond ((null? xs) (reverse acc))
          ((= k i) (loop (cdr xs) (+ k 1) acc))
          (else (loop (cdr xs) (+ k 1) (cons (car xs) acc))))))

(define (pa-min-index xs)
  (if (null? xs)
      0
      (let loop ((ys (cdr xs)) (i 1) (bi 0) (bv (car xs)))
        (if (null? ys)
            bi
            (if (< (car ys) bv)
                (loop (cdr ys) (+ i 1) i (car ys))
                (loop (cdr ys) (+ i 1) bi bv))))))

(define (pa-drop-crowding pts a)
  (pa-min-index (pareto:crowding pts (hash "dirs" (pa-opt a "dirs" (list))))))

(define (pa-hv-of pts a)
  (if (null? pts)
      0.0
      (let* ((m (length (pa-opt (car pts) "max" (list))))
             (ref (let loop ((i 0) (acc (list)))
                    (if (>= i m) (reverse acc)
                        (loop (+ i 1) (cons 2.0 acc))))))
        (pareto:hypervolume pts ref (hash "dirs" (list))))))

(define (pa-drop-hv pts a)
  (if (<= (length pts) 1)
      0
      (let* ((all (pa-hv-of pts a))
             (n (length pts))
             (contribs
               (map (lambda (i) (- all (pa-hv-of (pa-drop-at pts i) a)))
                    (pa-iota n))))
        (pa-min-index contribs))))

(define (pa-eps-cell e eps)
  (let loop ((xs (pa-opt e "max" (list))) (acc ""))
    (if (null? xs)
        acc
        (loop (cdr xs)
              (string-append acc "|"
                             (number->string
                               (if (> eps 0.0) (floor (/ (pa-num (car xs)) eps)) 0)))))))

(define (pa-drop-epsilon pts a)
  (let* ((eps (pa-opt a "eps" 0.01))
         (n (length pts))
         (cells (map (lambda (e) (pa-eps-cell e eps)) pts)))
    (let loop ((i 0))
      (if (>= i n)
          (pa-drop-crowding pts a)
          (let ((j (pa-index-of (list-ref cells i) cells)))
            (if (and (>= j 0) (not (= j i)))
                ; two points share a cell: drop the older (larger seq)
                (let ((a1 (list-ref pts i)) (b1 (list-ref pts j)))
                  (if (> (pa-opt a1 "seq" 0) (pa-opt b1 "seq" 0)) i j))
                (loop (+ i 1))))))))

(define (pa-index-of v xs)
  (let loop ((ys xs) (i 0))
    (cond ((null? ys) -1)
          ((string=? v (car ys)) i)
          (else (loop (cdr ys) (+ i 1))))))

(define (pa-drop-one pts a)
  (let ((mode (pa-opt a "trim" "crowding")))
    (cond ((string=? mode "hv") (pa-drop-hv pts a))
          ((string=? mode "epsilon") (pa-drop-epsilon pts a))
          (else (pa-drop-crowding pts a)))))

(define (pa-trim! a)
  (let* ((cap (pa-opt a "cap" 64))
         (pts (pa-opt a "points" (list))))
    (let loop ((xs pts))
      (if (<= (length xs) cap)
          (begin (hash-set! a "points" xs) xs)
          (let ((i (pa-drop-one xs a)))
            (loop (pa-drop-at xs (if (and (number? i) (< i (length xs))) i 0))))))))

; The front, ordered by the first MAXIMIZE coordinate (then the rest, then
; insertion order) so two archives built in different orders print the same.
(define (pareto:front a)
  (sort (pa-opt a "points" (list))
        (lambda (x y)
          (let ((mx (pa-opt x "max" (list)))
                (my (pa-opt y "max" (list))))
            (cond ((pa-lex-less mx my) #t)
                  ((pa-lex-less my mx) #f)
                  (else (<= (pa-opt x "seq" 0) (pa-opt y "seq" 0))))))))

; ═══════════════════════════════════════════════════════════════════
; Dominance, constrained dominance, non-dominated sorting
; ═══════════════════════════════════════════════════════════════════

(define (pareto:dominates? x y dirs)
  (pa-dom-max (pa-maxvec (pa-objs-of x (list)) dirs)
              (pa-maxvec (pa-objs-of y (list)) dirs)))

; Constraint domination (Deb): feasible > infeasible, then total violation,
; then objectives. opts: "objectives" order, "dirs".
(define (pareto:cd-dominates? x y opts)
  (let* ((o (if (hash? opts) opts (hash)))
         (order (pa-opt o "objectives" #f))
         (dirs (pa-opt o "dirs" (list)))
         (vx (pa-viol-of x))
         (vy (pa-viol-of y))
         (fx (<= vx 0.0))
         (fy (<= vy 0.0)))
    (cond ((and fx (not fy)) #t)
          ((and fy (not fx)) #f)
          ((not fx) (< vx vy))
          (else (pa-dom-max (pa-max-item x order dirs)
                            (pa-max-item y order dirs))))))

; (pareto:nd-sort items [opts]) -> list of fronts, each in input order.
; O(M N^2) fast non-dominated sort with constrained dominance (Deb).
; Constrained dominance on pre-extracted columns (no hash lookup in the
; O(N^2) loop; this is what keeps 200-generation runs inside the budget).
(define (pa-index-hash xs)
  (let loop ((ys xs) (i 0) (h (hash)))
    (if (null? ys)
        h
        (begin (hash-set! h i (car ys))
               (loop (cdr ys) (+ i 1) h)))))

(define (pa-cd-dom-idx i j maxh violh)
  (let ((vx (hash-ref violh i 0.0))
        (vy (hash-ref violh j 0.0)))
    (cond ((and (<= vx 0.0) (> vy 0.0)) #t)
          ((and (<= vy 0.0) (> vx 0.0)) #f)
          ((> vx 0.0) (< vx vy))
          (else
           ; 2-objective fast path: the bi-objective sort is the hottest
           ; loop in a 20k-evaluation run, so skip the generic list walk.
           (let ((a (hash-ref maxh i (list)))
                 (b (hash-ref maxh j (list))))
             (if (and (not (null? a)) (not (null? (cdr a)))
                      (not (null? b)) (not (null? (cdr b)))
                      (null? (cdr (cdr a))) (null? (cdr (cdr b))))
                 (let ((a0 (pa-num (car a))) (a1 (pa-num (car (cdr a))))
                       (b0 (pa-num (car b))) (b1 (pa-num (car (cdr b)))))
                   (and (>= a0 b0) (>= a1 b1) (or (> a0 b0) (> a1 b1))))
                 (pa-dom-max a b)))))))

(define (pa-rank-row! maxh violh counts doms n i j)
  (if (>= j n)
      #t
      (begin
        (cond ((pa-cd-dom-idx i j maxh violh)
               (hash-set! doms i (cons j (hash-ref doms i (list))))
               (hash-set! counts j (+ 1 (hash-ref counts j 0))))
              ((pa-cd-dom-idx j i maxh violh)
               (hash-set! doms j (cons i (hash-ref doms j (list))))
               (hash-set! counts i (+ 1 (hash-ref counts i 0))))
              (else #t))
        (pa-rank-row! maxh violh counts doms n i (+ j 1)))))

(define (pa-rank-rows! maxh violh counts doms n i)
  (if (>= i n)
      #t
      (begin (pa-rank-row! maxh violh counts doms n i (+ i 1))
             (pa-rank-rows! maxh violh counts doms n (+ i 1)))))

(define (pa-relax-one! counts doms ds)
  (if (null? ds)
      (list)
      (let* ((j (car ds))
             (c (- (hash-ref counts j 0) 1)))
        (hash-set! counts j c)
        (if (= c 0)
            (cons j (pa-relax-one! counts doms (cdr ds)))
            (pa-relax-one! counts doms (cdr ds))))))

(define (pa-relax! counts doms ks)
  (if (null? ks)
      (list)
      (append (pa-relax-one! counts doms (hash-ref doms (car ks) (list)))
              (pa-relax! counts doms (cdr ks)))))

(define (pa-peel items counts doms cur acc)
  (if (null? cur)
      (reverse acc)
      (let ((idx (sort cur <)))
        (pa-peel items counts doms
                 (sort (pa-relax! counts doms idx) <)
                 (cons (map (lambda (i) (list-ref items i)) idx) acc)))))

(define (pareto:nd-sort items . rest)
  (let* ((o (if (and (pair? rest) (hash? (car rest))) (car rest) (hash)))
         (order (pa-opt o "objectives" #f))
         (dirs (pa-opt o "dirs" (list)))
         (n (length items))
         (counts (hash))
         (doms (hash)))
    (let loop ((i 0))
      (if (>= i n)
          #t
          (begin (hash-set! counts i 0)
                 (hash-set! doms i (list))
                 (loop (+ i 1)))))
    (pa-rank-rows! (pa-index-hash (map (lambda (it) (pa-max-item it order dirs)) items))
                   (pa-index-hash (map pa-viol-of items))
                   counts doms n 0)
    (pa-peel items counts doms
             (pa-filter (lambda (i) (= 0 (hash-ref counts i 0))) (pa-iota n))
             (list))))

; ═══════════════════════════════════════════════════════════════════
; Crowding distance
; ═══════════════════════════════════════════════════════════════════

(define (pareto:crowding front . rest)
  (let* ((o (if (and (pair? rest) (hash? (car rest))) (car rest) (hash)))
         (order (pa-opt o "objectives" #f))
         (dirs (pa-opt o "dirs" (list)))
         (n (length front))
         (maxs (pa-index-hash (map (lambda (x) (pa-max-item x order dirs)) front))))
    (cond ((<= n 1) (map (lambda (x) 1000000000.0) front))
          ((< n 3) (map (lambda (x) 1000000000.0) front))
          (else
           (let ((m (if (null? front) 0 (length (hash-ref maxs 0 (list))))))
             (let loop ((d 0) (dist (pa-repeat 0.0 n)))
               (if (>= d m)
                   dist
                   (let* ((sorted
                            (sort (pa-iota n)
                                  (lambda (i j)
                                    (let ((vi (list-ref (hash-ref maxs i (list)) d))
                                          (vj (list-ref (hash-ref maxs j (list)) d)))
                                      (cond ((< vi vj) #t)
                                            ((> vi vj) #f)
                                            (else (< i j)))))))
                          (lo (list-ref (hash-ref maxs (car sorted) (list)) d))
                          (hi (list-ref (hash-ref maxs (car (reverse sorted)) (list)) d))
                          (span (- hi lo)))
                     (if (<= span 0.0)
                         (loop (+ d 1) dist)
                         (let* ((d1 (pa-set-at dist (car sorted) 1000000000.0))
                                (last (list-ref sorted (- n 1)))
                                (d2 (pa-set-at d1 last 1000000000.0)))
                           (let inner ((k 1) (acc d2))
                             (if (>= k (- n 1))
                                 (loop (+ d 1) acc)
                                 (let* ((i (list-ref sorted k))
                                        (pv (list-ref (hash-ref maxs (list-ref sorted (- k 1)) (list)) d))
                                        (nv (list-ref (hash-ref maxs (list-ref sorted (+ k 1)) (list)) d))
                                        (cur (list-ref acc i)))
                                   (inner (+ k 1)
                                          (pa-set-at acc i (+ cur (/ (- nv pv) span)))))))))))))))))

; ═══════════════════════════════════════════════════════════════════
; Hypervolume (exact 2/3 objectives, fixed-seed MC above that)
; ═══════════════════════════════════════════════════════════════════

; 2-objective sweep in MAXIMIZE space: every point is dominated by ref.
; Slice [f1_i, f1_{i+1}] is covered by points 0..i, whose y extent is
; [min f2, r2].
(define (pa-hv2 pts ref)
  (let* ((r1 (pa-num (car ref)))
         (r2 (pa-num (car (cdr ref))))
         (ps (pa-filter (lambda (p) (and (< (pa-num (car p)) r1)
                                         (< (pa-num (car (cdr p))) r2)))
                        pts))
         (srt (sort ps (lambda (a b) (< (pa-num (car a)) (pa-num (car b))))))
         (n (length srt)))
    (if (= n 0)
        0.0
        (let loop ((i 0) (minf2 r2) (area 0.0))
          (if (>= i n)
              area
              (let* ((p (list-ref srt i))
                     (f1 (pa-num (car p)))
                     (f2 (pa-num (car (cdr p))))
                     (m (min minf2 f2))
                     (next (if (= i (- n 1)) r1 (pa-num (car (list-ref srt (+ i 1))))))
                     (width (- next f1)))
                (loop (+ i 1) m (+ area (* width (- r2 m))))))))))

; 3-objective sweep in MAXIMIZE space: sort by x ascending; the slice
; [x_i, x_{i+1}] is covered by points 0..i, so its area is the 2-D
; hypervolume of their (y,z) projections.
(define (pa-hv3 pts ref)
  (let* ((r1 (pa-num (car ref)))
         (r2 (pa-num (car (cdr ref))))
         (r3 (pa-num (car (cdr (cdr ref)))))
         (ps (pa-filter (lambda (p) (and (< (pa-num (car p)) r1)
                                         (< (pa-num (car (cdr p))) r2)
                                         (< (pa-num (car (cdr (cdr p)))) r3)))
                        pts))
         (srt (sort ps (lambda (a b) (< (pa-num (car a)) (pa-num (car b))))))
         (n (length srt)))
    (if (= n 0)
        0.0
        (let loop ((i 0) (seen (list)) (area 0.0))
          (if (>= i n)
              area
              (let* ((p (list-ref srt i))
                     (seen2 (cons (list (pa-num (car (cdr p)))
                                        (pa-num (car (cdr (cdr p)))))
                                  seen))
                     (next (if (= i (- n 1)) r1 (pa-num (car (list-ref srt (+ i 1))))))
                     (width (- next (pa-num (car p))))
                     (a2 (pa-hv2 seen2 (list r2 r3))))
                (loop (+ i 1) seen2 (+ area (* width a2)))))))))

(define (pa-mc-next st)
  (let ((x (modulo (+ (* (hash-ref st "s" 1) 1103515245) 12345) 2147483647)))
    (hash-set! st "s" x)
    (/ x 2147483647.0)))

(define (pa-covers? p x)
  (let loop ((ps p) (xs x))
    (cond ((null? ps) #t)
          ((null? xs) #t)
          ((<= (pa-num (car ps)) (pa-num (car xs))) (loop (cdr ps) (cdr xs)))
          (else #f))))

(define (pa-any-covers? pts x)
  (cond ((null? pts) #f)
        ((pa-covers? (car pts) x) #t)
        (else (pa-any-covers? (cdr pts) x))))

; Fixed sample set in a box that depends only on ref (never on the front),
; so the estimated volume is monotone when points are inserted.
(define (pa-hv-mc pts ref opts)
  (let* ((o (if (hash? opts) opts (hash)))
         (s0 (pa-opt o "samples" 20000))
         (samples (if (and (number? s0) (>= s0 1)) s0 20000))
         (scales (map (lambda (r) (+ (abs (pa-num r)) 1.0)) ref))
         (vol (pa-fold * 1.0 scales))
         (st (hash "s" (+ 1 (pa-opt o "seed" 7)))))
    (let loop ((i 0) (hit 0))
      (if (>= i samples)
          (* vol (/ hit samples))
          (let ((x (map (lambda (r sc)
                          (- (pa-num r) (* (pa-mc-next st) sc)))
                        ref scales)))
            (loop (+ i 1) (if (pa-any-covers? pts x) (+ hit 1) hit)))))))

(define (pareto:hypervolume front ref . rest)
  (let* ((o (if (and (pair? rest) (hash? (car rest))) (car rest) (hash)))
         (order (pa-opt o "objectives" #f))
         (dirs (pa-opt o "dirs" (list)))
         (m (if (null? front) 0 (length (pa-max-item (car front) order dirs))))
         (refm (cond ((number? ref) (pa-neg (pa-maxvec (list ref) dirs)))
                     ((list? ref) (pa-neg (pa-maxvec ref dirs)))
                     (else (list))))
         (pts (map (lambda (x) (pa-neg (pa-max-item x order dirs))) front)))
    (cond ((or (null? pts) (null? refm) (= m 0)) 0.0)
          ((not (= (length (car pts)) (length refm))) 0.0)
          ((= m 2) (pa-hv2 pts refm))
          ((= m 3) (pa-hv3 pts refm))
          (else (pa-hv-mc pts refm o)))))

(define (pa-dist a b)
  (let loop ((xs a) (ys b) (s 0.0))
    (if (or (null? xs) (null? ys))
        (sqrt s)
        (let ((d (- (pa-num (car xs)) (pa-num (car ys)))))
          (loop (cdr xs) (cdr ys) (+ s (* d d)))))))

(define (pa-min-dist q ps)
  (if (null? ps)
      0.0
      (let loop ((xs (cdr ps)) (m (pa-dist q (car ps))))
        (if (null? xs)
            m
            (loop (cdr xs) (min m (pa-dist q (car xs))))))))

; (pareto:igd front ref-front) -> average distance from every reference
; point to its nearest front point (objective space, problem values).
(define (pareto:igd front ref-front . rest)
  (let* ((o (if (and (pair? rest) (hash? (car rest))) (car rest) (hash)))
         (order (pa-opt o "objectives" #f))
         (ps (map (lambda (x) (pa-objs-of x order)) front))
         (qs (map (lambda (x) (pa-objs-of x order)) ref-front)))
    (if (or (null? ps) (null? qs))
        0.0
        (/ (pa-sum (map (lambda (q) (pa-min-dist q ps)) qs)) (length qs)))))

; A reference point that is worse than every point of a front, in PROBLEM
; space and respecting "dirs": hypervolume is only meaningful against such
; a point, and a hard-coded (1.1 1.1) silently returns 0 for any problem
; whose objectives are not in [0,1] (#4940 MOEA/DD report). "margin" is a
; fraction of the front's own span (at least 1.0 so a degenerate front
; still has volume).
(define (pareto:ref-point front dirs margin)
  (let* ((objs (map (lambda (x) (pa-objs-of x (list))) front))
         (m (if (null? objs) 0 (length (car objs))))
         (mg (if (and (number? margin) (> margin 0.0)) margin 0.1)))
    (let loop ((d 0) (acc (list)))
      (if (>= d m)
          (reverse acc)
          (let* ((col (map (lambda (o) (pa-num (list-ref o d))) objs))
                 (lo (pa-fold min (car col) col))
                 (hi (pa-fold max (car col) col))
                 (span (if (> (- hi lo) 0.0) (- hi lo) 1.0))
                 (d* (pa-dir-at dirs d))
                 (v (if (string=? d* "min")
                        (+ hi (* mg span))
                        (- lo (* mg span)))))
            (loop (+ d 1) (cons v acc)))))))

; ═══════════════════════════════════════════════════════════════════
; Gate + representative
; ═══════════════════════════════════════════════════════════════════

(define (pareto:improves? a objs opts)
  (let* ((o (if (hash? opts) opts (hash)))
         (dirs (pa-opt a "dirs" (list)))
         (viol (pa-num (pa-opt o "viol" 0)))
         (id (pa-opt o "id" #f))
         (mv (pa-maxvec objs dirs))
         (pts (pa-opt a "points" (list))))
    (and (<= viol 0.0)
         (not (and (string? id) (hash-ref (pa-opt a "seen" (hash)) id #f)))
         (not (pa-dominated-by? mv pts))
         (not (pa-max-equal? mv pts)))))

; The v0.2 commit gate: a candidate may go live only when every hard
; constraint is 0 AND it enters the Pareto front. Refusals leave the
; archive untouched.
(define (pareto:accept? a cand ev)
  (let* ((o (if (hash? ev) (pa-opt ev "objectives" (hash)) (hash)))
         (order (if (hash? o)
                    (if (pa-opt a "objectives" #f)
                        (pa-opt a "objectives" (list))
                        (sort (hash-keys o) string<?))
                    (list)))
         (objs (if (list? ev) ev (pa-objs-of ev order)))
         (viol (if (hash? ev) (pa-viol-of ev) 0.0))
         (id (pa-id-of cand objs)))
    (and (hash? ev)
         (evo:feasible? ev)
         (pareto:improves? a objs (hash "viol" viol "id" id))
         (pa-insert-entry! a cand objs viol id))))

(define (pa-weight-of w i d)
  (cond ((number? w) (pa-num w))
        ((and (list? w) (< d (length w))) (pa-num (list-ref w d)))
        (else 1.0)))

; Normalise MAXIMIZE-space objectives to [0,1] across the front.
(define (pa-normalize front order dirs)
  (let* ((maxs (map (lambda (e) (pa-max-item e order dirs)) front))
         (m (if (null? maxs) 0 (length (car maxs))))
         (lo (let loop ((d 0) (acc (list)))
               (if (>= d m) (reverse acc)
                   (loop (+ d 1)
                         (cons (pa-fold min (list-ref (car maxs) d)
                                        (map (lambda (e) (list-ref e d)) maxs))
                               acc)))))
         (hi (let loop ((d 0) (acc (list)))
               (if (>= d m) (reverse acc)
                   (loop (+ d 1)
                         (cons (pa-fold max (list-ref (car maxs) d)
                                        (map (lambda (e) (list-ref e d)) maxs))
                               acc)))))
         (span (map (lambda (a b) (if (> (- b a) 0.0) (- b a) 1.0)) lo hi)))
    (map (lambda (e)
           (let loop ((xs (pa-max-item e order dirs)) (ls lo) (ss span) (acc (list)))
             (if (null? xs)
                 (reverse acc)
                 (loop (cdr xs) (cdr ls) (cdr ss)
                       (cons (/ (- (pa-num (car xs)) (car ls)) (car ss)) acc)))))
         front)))

(define (pa-weighted norm weights)
  (let loop ((xs norm) (ws weights) (i 0) (s 0.0))
    (if (null? xs)
        s
        (loop (cdr xs) (if (null? ws) ws (cdr ws)) (+ i 1)
              (+ s (* (pa-weight-of (if (null? ws) 1.0 (car ws)) i 0) (car xs)))))))

; Knee on a normalized 2-D front: the point farthest from the chord
; between the two extreme points. Above two objectives (and for < 3
; points) the equal-weight point is the documented fallback.
(define (pa-knee front order dirs)
  (let* ((norm (pa-normalize front order dirs))
         (n (length norm)))
    (cond ((<= n 1) (if (null? front) #f (car front)))
          ((= (length (car norm)) 2)
           (let* ((i1 (pa-argmin (map (lambda (v) (car v)) norm)))
                  (i2 (pa-argmin (map (lambda (v) (car (cdr v))) norm)))
                  (ax (list-ref (list-ref norm i1) 0))
                  (ay (list-ref (list-ref norm i1) 1))
                  (bx (list-ref (list-ref norm i2) 0))
                  (by (list-ref (list-ref norm i2) 1))
                  (dx (- bx ax))
                  (dy (- by ay))
                  (len (sqrt (+ (* dx dx) (* dy dy)))))
             (if (<= len 0.0)
                 (car front)
                 (let* ((dists (map (lambda (v)
                                      (let ((px (- (car v) ax))
                                            (py (- (car (cdr v)) ay)))
                                        (/ (abs (- (* px dy) (* py dx))) len)))
                                    norm))
                        (bi (pa-argmax dists)))
                   (list-ref front bi)))))
          (else
           (let* ((sc (map (lambda (v) (pa-weighted v (list))) norm))
                  (bi (pa-argmax sc)))
             (list-ref front bi))))))

(define (pa-argmin xs)
  (if (null? xs) 0
      (let loop ((ys (cdr xs)) (i 1) (bi 0) (bv (car xs)))
        (if (null? ys) bi
            (if (< (car ys) bv) (loop (cdr ys) (+ i 1) i (car ys))
                (loop (cdr ys) (+ i 1) bi bv))))))

(define (pa-argmax xs)
  (if (null? xs) 0
      (let loop ((ys (cdr xs)) (i 1) (bi 0) (bv (car xs)))
        (if (null? ys) bi
            (if (> (car ys) bv) (loop (cdr ys) (+ i 1) i (car ys))
                (loop (cdr ys) (+ i 1) bi bv))))))

; The one point the live worldline keeps. Preference weights are optional;
; with none the knee is used (issue #4940).
(define (pareto:representative a . rest)
  (let* ((weights (if (and (pair? rest) (list? (car rest)) (not (null? (car rest)))
                        (not (hash? (car rest))))
                    (car rest) #f))
         (front (pareto:front a))
         (order (pa-opt a "objectives" #f))
         (dirs (pa-opt a "dirs" (list))))
    (cond ((null? front) #f)
          ((and (list? weights) (not (null? weights)))
           (let* ((norm (pa-normalize front order dirs))
                  (sc (map (lambda (v) (pa-weighted v weights)) norm)))
             (list-ref front (pa-argmax sc))))
          (else (pa-knee front order dirs)))))

; ═══════════════════════════════════════════════════════════════════
; Report rendering (pure; the HTML page embeds this SVG)
; ═══════════════════════════════════════════════════════════════════

(define (pa-min-list xs)
  (pa-fold min (car xs) xs))
(define (pa-max-list xs)
  (pa-fold max (car xs) xs))

(define (pa-svg-num x)
  (let ((s (number->string (* 1.0 (pa-num x)))))
    (if (string=? s "inf") "0" (if (string=? s "-inf") "0" (if (string=? s "nan") "0" s)))))

; (pareto:report-svg front (hash "width" 360 "height" 260
;                                "trail" (list (list f1 f2) ...)
;                                "title" "Pareto front"))
; front entries (or raw vectors) with dirs; "trail" is the KEEP
; representative path in the same objective space.
(define (pareto:report-svg front . rest)
  (let* ((o (if (and (pair? rest) (hash? (car rest))) (car rest) (hash)))
         (order (pa-opt o "objectives" #f))
         (dirs (pa-opt o "dirs" (list)))
         (w (pa-opt o "width" 360))
         (h (pa-opt o "height" 260))
         (pad 34)
         (pts (map (lambda (x) (pa-objs-of x order)) front))
         (trail (let ((t (pa-opt o "trail" (list))))
                  (if (list? t) t (list))))
         (all (append pts trail)))
    (if (null? all)
        "<svg viewBox=\"0 0 360 260\" width=\"360\" height=\"260\" role=\"img\" aria-label=\"empty pareto front\"></svg>"
        (let* ((xs (map (lambda (p) (pa-num (car p))) all))
               (ys (map (lambda (p) (pa-num (car (cdr p)))) all))
               (x0 (pa-min-list xs))
               (x1 (pa-max-list xs))
               (y0 (pa-min-list ys))
               (y1 (pa-max-list ys))
               (sw (if (> (- x1 x0) 0.0) (- x1 x0) 1.0))
               (sh (if (> (- y1 y0) 0.0) (- y1 y0) 1.0))
               (px (lambda (x) (+ pad (* (/ (- (pa-num x) x0) sw) (- w (* 2 pad))))))
               (py (lambda (y) (- h pad (* (/ (- (pa-num y) y0) sh) (- h (* 2 pad)))))))
          (string-append
            "<svg viewBox=\"0 0 " (pa-svg-num w) " " (pa-svg-num h)
            "\" width=\"" (pa-svg-num w) "\" height=\"" (pa-svg-num h)
            "\" role=\"img\" aria-label=\"pareto front\">"
            "<rect x=\"0\" y=\"0\" width=\"" (pa-svg-num w) "\" height=\""
            (pa-svg-num h) "\" fill=\"#fff\"/>"
            "<line x1=\"" (pa-svg-num pad) "\" y1=\"" (pa-svg-num (- h pad))
            "\" x2=\"" (pa-svg-num (- w pad)) "\" y2=\"" (pa-svg-num (- h pad))
            "\" stroke=\"#888\"/>"
            "<line x1=\"" (pa-svg-num pad) "\" y1=\"" (pa-svg-num pad)
            "\" x2=\"" (pa-svg-num pad) "\" y2=\"" (pa-svg-num (- h pad))
            "\" stroke=\"#888\"/>"
            (let loop ((ps pts) (acc ""))
              (if (null? ps)
                  acc
                  (loop (cdr ps)
                        (string-append
                          acc
                          "<circle cx=\"" (pa-svg-num (px (car (car ps))))
                          "\" cy=\"" (pa-svg-num (py (car (cdr (car ps)))))
                          "\" r=\"3.2\" fill=\"#2563eb\"><title>"
                          (pa-objs-text (car ps)) "</title></circle>"))))
            ; KEEP representative trail (#4940): a real polyline, not bare
            ; coordinates. Before this the points were appended as text
            ; content of the <svg>, so nothing was drawn.
            (if (null? trail)
                ""
                (string-append
                  "<polyline fill=\"none\" stroke=\"#b45309\" stroke-width=\"1.6\" points=\""
                  (let loop ((ts trail) (acc ""))
                    (if (null? ts)
                        acc
                        (loop (cdr ts)
                              (string-append acc (if (string=? acc) "" " ")
                                             (pa-svg-num (px (car (car ts)))) ","
                                             (pa-svg-num (py (car (cdr (car ts)))))))))
                  "\"/>"
                  (let loop ((ts trail) (acc ""))
                    (if (null? ts)
                        acc
                        (loop (cdr ts)
                              (string-append
                                acc
                                "<circle cx=\"" (pa-svg-num (px (car (car ts))))
                                "\" cy=\"" (pa-svg-num (py (car (cdr (car ts)))))
                                "\" r=\"2\" fill=\"#b45309\"><title>keep "
                                (pa-objs-text (car ts)) "</title></circle>"))))))
            "</svg>")))))

; ═══════════════════════════════════════════════════════════════════
; NSGA-II — the #4940 baseline next to MOEA/D (no free lunch: the P8
; portfolio picks per instance, this module only supplies the algorithm)
; ═══════════════════════════════════════════════════════════════════

(define (pa-take xs n)
  (let loop ((ys xs) (k 0) (acc (list)))
    (if (or (null? ys) (>= k n))
        (reverse acc)
        (loop (cdr ys) (+ k 1) (cons (car ys) acc)))))

(define (pa-drop-n xs n)
  (let loop ((ys xs) (k 0))
    (if (or (null? ys) (>= k n)) ys (loop (cdr ys) (+ k 1)))))

; Local LCG stream: (hash 0 state). evo:rng-float! costs ~12 us per
; draw through three layers of hash access; this one is ~2 us and keeps the
; same constants, so a run is still reproducible from (seed, gen, slot).
(define (pa-rng seed gen slot)
  (hash 0 (hash-ref (evo:rng seed gen slot) "state" 1)))

(define (pa-rand! r)
  (let ((n (modulo (+ (* (hash-ref r 0 1) 1103515245) 12345) 2147483647)))
    (hash-set! r 0 n)
    (/ n 2147483647.0)))

(define (pa-rand-int! r n)
  (if (<= n 1) 0 (inexact->exact (floor (* (pa-rand! r) n)))))

(define (pa-bounds-at bounds i)
  (let ((b (if (< i (length bounds)) (list-ref bounds i) #f)))
    (cond ((and (list? b) (>= (length b) 2) (number? (car b)))
           (list (pa-num (car b)) (pa-num (car (cdr b)))))
          (else (list 0.0 1.0)))))

(define (pa-clamp x b)
  (let ((lo (car b)) (hi (car (cdr b))))
    (if (< x lo) lo (if (> x hi) hi x))))

; 64-bit numeric fingerprint of a real-valued genome. The generic
; evo:candidate id prints and FNV-hashes the whole genome text (~500 chars
; for 30 variables); in the walker that is ~4 ms per candidate, which
; dominates a 20k-evaluation run. Numeric algorithms therefore pass an
; explicit id: still content-addressed (two different genomes collide with
; probability ~2^-62), still pure integer arithmetic on every face.
(define (pa-fingerprint g)
  (let loop ((xs g) (a 2166136261) (b 5381))
    (if (null? xs)
        (string-append "n" (number->string a) "_" (number->string b))
        (let* ((v (if (number? (car xs))
                      (inexact->exact (floor (* 1000000.0 (pa-num (car xs)))))
                      0))
               (a2 (modulo (+ (* (modulo a 1000003) 31) (modulo v 1000003))
                           2147483647))
               (b2 (modulo (+ (* (modulo b 1000033) 131) (modulo v 1000033))
                           2147483629)))
          (loop (cdr xs) a2 b2)))))

(define (pa-numeric-candidate g opts)
  (hash-set! opts "id" (pa-fingerprint g))
  (evo:candidate g opts))

(define (pa-genome dim bounds r)
  (let loop ((i 0) (acc (list)))
    (if (>= i dim)
        (reverse acc)
        (let ((b (pa-bounds-at bounds i)))
          (loop (+ i 1)
                (cons (+ (car b)
                         (* (evo:rng-float! r) (- (car (cdr b)) (car b))))
                      acc))))))

; Simulated binary crossover (Deb & Agrawal). Returns both children.
; Bounds matter: the raw child formula leaves [lo,hi] whenever the parents
; sit near a bound, and a ZDT1 run then evaluates x1 > 1 — an out-of-domain
; point that wins the f1 race and drags the front with it. Children are
; clamped into the box, which is what the bounded operator does.
(define (pa-sbx p1 p2 bounds eta pc r)
  (let loop ((xs p1) (ys p2) (bs bounds) (i 0) (c1 (list)) (c2 (list)))
    (if (or (null? xs) (null? ys))
        (list (reverse c1) (reverse c2))
        (let* ((b (pa-bounds-at bounds i))
               (x1 (pa-num (car xs)))
               (x2 (pa-num (car ys)))
               (u (pa-rand! r)))
          (if (or (> u pc) (< (abs (- x1 x2)) 1e-12))
              (loop (cdr xs) (cdr ys) (if (null? bs) bs (cdr bs)) (+ i 1)
                    (cons (pa-clamp x1 b) c1) (cons (pa-clamp x2 b) c2))
              (let* ((u2 (pa-rand! r))
                     (e (/ 1.0 (+ eta 1.0)))
                     (beta (if (<= u2 0.5)
                               (expt (* 2.0 u2) e)
                               (expt (/ 0.5 (- 1.0 u2)) e)))
                     (y1 (* 0.5 (+ (* (+ 1.0 beta) x1) (* (- 1.0 beta) x2))))
                     (y2 (* 0.5 (+ (* (- 1.0 beta) x1) (* (+ 1.0 beta) x2)))))
                (loop (cdr xs) (cdr ys) (if (null? bs) bs (cdr bs)) (+ i 1)
                      (cons (pa-clamp y1 b) c1) (cons (pa-clamp y2 b) c2))))))))

; Polynomial mutation (Deb & Goyal), bounded by the genome's bounds.
(define (pa-poly-mut g bounds eta pm r)
  (let loop ((xs g) (i 0) (acc (list)))
    (if (null? xs)
        (reverse acc)
        (let* ((b (pa-bounds-at bounds i))
               (x (pa-num (car xs)))
               (lo (car b))
               (hi (car (cdr b)))
               (u (pa-rand! r)))
          (if (or (> u pm) (<= (- hi lo) 0.0))
              (loop (cdr xs) (+ i 1) (cons x acc))
              (let* ((d1 (/ (- x lo) (- hi lo)))
                     (d2 (/ (- hi x) (- hi lo)))
                     (u2 (pa-rand! r))
                     (e (/ 1.0 (+ eta 1.0)))
                     (dq (if (<= u2 0.5)
                             (- (expt (+ (* 2.0 u2)
                                         (* (- 1.0 (* 2.0 u2))
                                            (expt (- 1.0 d1) (+ eta 1.0))))
                                      e)
                                1.0)
                             (- 1.0
                                (expt (+ (* 2.0 (- 1.0 u2))
                                         (* (- (* 2.0 u2) 1.0)
                                            (expt (- 1.0 d2) (+ eta 1.0))))
                                      e)))))
                (loop (cdr xs) (+ i 1)
                      (cons (pa-clamp (+ x (* dq (- hi lo))) b) acc))))))))

; Binary tournament on constrained dominance. The direction table is the
; state's own: passing (hash) here silently compares a MINIMIZE problem in
; MAXIMIZE space, so the tournament prefers the worse parent two times out
; of three and the run drifts instead of converging (#4940).
(define (pa-tournament entries r dirs)
  (if (null? entries)
      #f
      (let* ((n (length entries))
             (a (list-ref entries (pa-rand-int! r n)))
             (b (list-ref entries (pa-rand-int! r n)))
             (opts (hash "dirs" dirs)))
        (cond ((pareto:cd-dominates? a b opts) a)
              ((pareto:cd-dominates? b a opts) b)
              ((< (pa-rand! r) 0.5) a)
              (else b)))))

(define (nsga2:make opts)
  (let* ((o (if (hash? opts) opts (hash)))
         (dim0 (pa-opt o "dim" 10))
         (dim (if (and (integer? dim0) (>= dim0 1)) dim0 10))
         (pop0 (pa-opt o "pop" 100))
         (pop (if (and (integer? pop0) (>= pop0 1)) pop0 100))
         (bounds (let ((b (pa-opt o "bounds" (list (list 0.0 1.0)))))
                   (if (list? b) b (list (list 0.0 1.0)))))
         (seed (pa-opt o "seed" 42))
         (r (evo:rng seed 0 0))
         (pending (let loop ((i 0) (acc (list)))
                    (if (>= i pop)
                        (reverse acc)
                        (loop (+ i 1)
                              (cons (pa-numeric-candidate
                                      (pa-genome dim bounds r)
                                      (hash "gen" 0 "slot" i
                                            "meta" (hash "init" #t)))
                                    acc))))))
    (hash "kind" "nsga2" "schema" pareto-schema-version
          "seed" seed "dim" dim "pop" pop "bounds" bounds
          "eta-c" (pa-num (pa-opt o "eta-c" 15))
          "eta-m" (pa-num (pa-opt o "eta-m" 20))
          "pc" (pa-num (pa-opt o "pc" 0.9))
          "pm" (pa-num (pa-opt o "pm" (/ 1.0 dim)))
          "objectives" (pa-opt o "objectives" #f)
          "dirs" (pa-opt o "dirs" (list))
          "ref" (let ((rf (pa-opt o "ref" #f))) (if (list? rf) rf #f))
          "pending" pending "popu" (list) "offspring" (list)
          "measured" (hash) "gen" 0 "slot" pop "nfe" 0)))

(define (nsga2-valid? s)
  (and (hash? s) (string=? (pa-opt s "kind" "") "nsga2")))

(define (nsga2-offspring s k)
  (let* ((popu (pa-opt s "popu" (list)))
         (gen (pa-opt s "gen" 0))
         (slot0 (pa-opt s "slot" 0))
         (dim (pa-opt s "dim" 10))
         (bounds (pa-opt s "bounds" (list (list 0.0 1.0))))
         (eta-c (pa-opt s "eta-c" 15))
         (eta-m (pa-opt s "eta-m" 20))
         (pc (pa-opt s "pc" 0.9))
         (pm (pa-opt s "pm" (/ 1.0 dim)))
         (dirs (pa-opt s "dirs" (list)))
         (seed (pa-opt s "seed" 42)))
    (let loop ((i 0) (acc (list)))
      (if (>= i k)
          (reverse acc)
          (let* ((r (pa-rng seed gen (+ slot0 i)))
                 (p1 (pa-tournament popu r dirs))
                 (p2 (pa-tournament popu r dirs))
                 (kids (if (and p1 p2)
                           (pa-sbx (evo:candidate-genome (pa-opt p1 "cand" #f))
                                   (evo:candidate-genome (pa-opt p2 "cand" #f))
                                   bounds eta-c pc r)
                           (list (pa-genome dim bounds r)
                                 (pa-genome dim bounds r))))
                 (g (pa-poly-mut (if (< (pa-rand-int! r 2) 1)
                                     (car kids)
                                     (car (cdr kids)))
                                 bounds eta-m pm r))
                 (c (pa-numeric-candidate
                      g
                      (hash "gen" gen "slot" (+ slot0 i)
                            "parents" (if p1
                                          (list (pa-opt (pa-opt p1 "cand" #f) "id" ""))
                                          (list))))))
            (loop (+ i 1) (cons c acc)))))))

(define (nsga2:ask s k)
  (if (not (nsga2-valid? s))
      (list)
      (let ((pend (pa-opt s "pending" (list))))
        (if (null? pend)
            (nsga2-offspring s (if (< k 1) 0 k))
            (let ((take (if (> k (length pend)) (length pend) k)))
              (hash-set! s "pending" (pa-drop-n pend take))
              (pa-take pend take))))))

(define (nsga2-entry c os order)
  (let* ((objs (if (list? os) os (pa-objs-of os order)))
         (viol (if (list? os) 0.0 (pa-viol-of os))))
    (hash "cand" c "objs" objs "viol" viol "id" (evo:candidate-id c))))

(define (nsga2-select! s)
  (let* ((pop (pa-opt s "pop" 100))
         (popu (pa-opt s "popu" (list)))
         (off (pa-opt s "offspring" (list)))
         (all (append popu off))
         (opts (hash "objectives" (pa-opt s "objectives" #f)
                     "dirs" (pa-opt s "dirs" (list))))
         (fronts (pareto:nd-sort all opts))
         (sel (let loop ((fs fronts) (acc (list)))
                (if (null? fs)
                    acc
                    (let ((f (car fs)))
                      (if (<= (+ (length acc) (length f)) pop)
                          (loop (cdr fs) (append acc f))
                          (let* ((need (- pop (length acc)))
                                 (cd (pareto:crowding f opts))
                                 (idx (sort (pa-iota (length f))
                                            (lambda (a b)
                                              (let ((da (list-ref cd a))
                                                    (db (list-ref cd b)))
                                                (if (= da db) (< a b) (> da db)))))))
                            (append acc (map (lambda (i) (list-ref f i))
                                             (pa-take idx need))))))))))
    (hash-set! s "popu" sel)
    (hash-set! s "offspring" (list))
    (hash-set! s "gen" (+ 1 (pa-opt s "gen" 0)))
    (hash-set! s "slot" (+ (pa-opt s "slot" 0) pop))
    #t))

(define (nsga2:tell! s cands objs)
  (if (not (nsga2-valid? s))
      #f
      (let* ((order (pa-opt s "objectives" #f))
             (off (pa-opt s "offspring" (list))))
        (let loop ((cs (if (list? cands) cands (list)))
                   (os (if (list? objs) objs (list)))
                   (acc (list)))
          (if (or (null? cs) (null? os))
              (let* ((all (append off (reverse acc)))
                     (pop (pa-opt s "pop" 100)))
                (hash-set! s "offspring" all)
                (hash-set! s "nfe" (+ (pa-opt s "nfe" 0) (length acc)))
                (if (>= (length all) pop)
                    (nsga2-select! s)
                    #t))
              (loop (cdr cs) (cdr os)
                    (cons (nsga2-entry (car cs) (car os) order) acc)))))))

(define (nsga2-run-batch! s eval-fn k)
  (let* ((cs (nsga2:ask s k))
         (es (map (lambda (c) (eval-fn c)) cs)))
    (nsga2:tell! s cs es)))

(define (nsga2:run! s eval-fn total)
  (let ((pop (pa-opt s "pop" 100)))
    (let loop ((done 0))
      (cond ((>= done total) s)
            (else
             (let ((k (min pop (- total done))))
               (nsga2-run-batch! s eval-fn k)
               (loop (+ done k))))))))

(define (nsga2:front s)
  (let ((popu (pa-opt s "popu" (list))))
    (if (null? popu)
        (list)
        (let ((fronts (pareto:nd-sort popu
                                      (hash "objectives" (pa-opt s "objectives" #f)
                                            "dirs" (pa-opt s "dirs" (list))))))
          (car fronts)))))

(define (nsga2:report s)
  (let* ((front (nsga2:front s))
         (popu (pa-opt s "popu" (list)))
         (dirs (pa-opt s "dirs" (list)))
         (ref (pa-opt s "ref" #f))
         (hv (if (null? popu)
                 0.0
                 (pareto:hypervolume front (if (list? ref) ref (pareto:ref-point front dirs 0.1))
                                     (hash "dirs" dirs)))))
    (hash "kind" "nsga2" "gen" (pa-opt s "gen" 0) "nfe" (pa-opt s "nfe" 0)
          "pop" (length popu) "front-size" (length front)
          "hypervolume" hv)))
