; lib/std/ant.aura -- mutation-type pheromone ranking + colony:search
;
; Model (Issue #2876 / #444): **not** classical graph ACO. Trails score
; *mutation operator types* (edsl-lit-tweak, …) for denseness / strategy
; control. colony:search still does local workspace search.
;
; Swarm bridge: (require "std/swarm") with kind "ant" uses pheromone:rank
; + pheromone:update from fitness feedback; optional pheromone:evaporate!.
;
(export pheromone:init pheromone:update pheromone:rank pheromone:score
        pheromone:export pheromone:evaporate! pheromone:types
        colony:search)

; ── Local utility functions (no external deps) ───────────────────

(define string-index
  (lambda (text substr start)
    (let ((n (string-length text))
          (m (string-length substr)))
      (let loop ((i start))
        (if (> i (- n m)) -1
            (if (string=? (substring text i (+ i m)) substr) i
                (loop (+ i 1))))))))

(define string-contains?
  (lambda (text substr)
    (not (= (string-index text substr 0) -1))))

(define string-trim
  (lambda (str)
    (let ((n (string-length str)))
      (let loop ((i 0) (j (- n 1)))
        (cond
          ((> i j) "")
          ((or (= (string-ref str i) 32) (= (string-ref str i) 9)
               (= (string-ref str i) 10) (= (string-ref str i) 13))
           (loop (+ i 1) j))
          ((or (= (string-ref str j) 32) (= (string-ref str j) 9)
               (= (string-ref str j) 10) (= (string-ref str j) 13))
           (loop i (- j 1)))
          (#t (substring str i (+ j 1))))))))

; ── Pheromone system ──────────────────────────────────────────────

(define *pheromone-table* (hash))

(define *default-pheromones*
  (lambda ()
    (hash "edsl-disp-ref" 2.0
          "full-hash-wrap" 1.8
          "full-disp-bool" 1.5
          "edsl-body-wrap" 1.0
          "full-disp-ref" 1.0
          "edsl-lit-tweak" 0.8
          "edsl-op-swap" 0.6)))

(define (pheromone:init)
  (set! *pheromone-table* (*default-pheromones*)))

(define (pheromone:score type-name)
  ; hash-ref missing → () which is truthy; treat null as default 0.1
  (let ((v (hash-ref *pheromone-table* type-name)))
    (if (or (null? v) (not (number? v))) 0.1 v)))

(define (pheromone:update type-name delta)
  (let ((current (pheromone:score type-name)))
    (hash-set! *pheromone-table* type-name
               (+ (* current 0.95)
                  (if (> delta 0.0) delta -0.05)))))

; Global evaporation (Issue #2876): multiply all trails by rho in (0,1].
(define (pheromone:evaporate! rho)
  (let ((r (if (and (number? rho) (> rho 0.0) (<= rho 1.0)) rho 0.95))
        (ks (hash-keys *pheromone-table*)))
    (let loop ((xs ks))
      (if (null? xs) #t
        (begin
          (hash-set! *pheromone-table* (car xs)
                     (* (pheromone:score (car xs)) r))
          (loop (cdr xs)))))))

; Registered mutation-type names (for swarm kind:ant default ops).
(define (pheromone:types)
  (hash-keys *pheromone-table*))

; Iterative insertion sort by score (avoid recursive filter quicksort hang
; on large/equal lists under multi-define load paths).
(define (pheromone:rank mutation-type-list)
  (let insert-all ((xs mutation-type-list) (acc (list)))
    (if (null? xs) acc
      (let ((x (car xs)))
        (insert-all (cdr xs)
                    (let insert ((ys acc))
                      (cond
                        ((null? ys) (list x))
                        ((>= (pheromone:score x) (pheromone:score (car ys)))
                         (cons x ys))
                        (#t (cons (car ys) (insert (cdr ys)))))))))))

(define (pheromone:export)
  (let ((keys (hash-keys *pheromone-table*)))
    (string-append "{"
      (let build ((ks keys) (first #t))
        (if (null? ks) ""
          (string-append
            (if first "" ",")
            "\"" (car ks) "\":" (number->string (pheromone:score (car ks)))
            (build (cdr ks) #f))))
      "}")))

; ── Colony Search (pure Aura, Phase 2) ───────────────────────────
;
; (colony:search expected-str max-variants)
; Returns (found? output debug-msg) list.
; Called from Python serve.exec() — one call does all search.

; Find function names: supports (define (fn ...) ...) and (define fn (lambda ...))
(define fn-name-list
  (lambda (src)
    (let ((n (string-length src)))
      (let scan ((i 0) (names (list)))
        (let ((m (string-index src "(define " i)))
          (if (= m -1) names
            (let ((start (+ m 8)))
              (if (and (< start n) (= (string-ref src start) 40))
                  (let* ((fn-start (+ start 1))
                         (fn-end (string-index src " " fn-start)))
                    (if (= fn-end -1) names
                      (let ((name (substring src fn-start fn-end)))
                        (scan fn-end (cons name names)))))
                  (let ((name-end (string-index src " " start)))
                    (if (= name-end -1) names
                      (let ((name (substring src start name-end)))
                        (scan name-end (cons name names)))))))))))))


; Find first numeric value in expected string
(define find-first-ref
  (lambda (expected-str)
    (let ((n (string-length expected-str)))
      (let search ((i 0))
        (if (>= i n) #f
          (let ((c (string-ref expected-str i)))
            (if (or (and (>= c 48) (<= c 57)) (= c 45))
                (let num-end ((j i))
                  (if (or (>= j n)
                          (not (or (and (>= (string-ref expected-str j) 48)
                                        (<= (string-ref expected-str j) 57))
                                   (= (string-ref expected-str j) 46)
                                   (= (string-ref expected-str j) 45))))
                      (let ((num-str (substring expected-str i j))
                            (len (- j i)))
                        (if (and (> len 0) (not (= len 0)))
                            (string->number num-str)
                            #f))
                      (num-end (+ j 1))))
                (search (+ i 1)))))))))

; Output match check
(define output-contains-any?
  (lambda (output expected-str)
    (if (string=? expected-str "") #t
      (let ((kws (string-split expected-str)))
        (let check ((ks kws))
          (if (null? ks) #f
            (if (string-contains? output (string-trim (car ks)))
              #t (check (cdr ks)))))))))

; String split (comma delimited)
(define string-split
  (lambda (str)
    (let ((n (string-length str)))
      (let lp ((i 0) (result (list)))
        (if (>= i n) (reverse result)
          (let ((comma (string-index str "," i)))
            (if (= comma -1)
              (reverse (cons (substring str i n) result))
              (lp (+ comma 1) (cons (substring str i comma) result)))))))))

; ── Helper: literal node ids inside one define (#4738) ──
; The fn-name argument is honoured: an empty name keeps the workspace-wide
; census, a real name walks that define's own subtree, so colony:search
; never tweaks a literal in an unrelated define. (:defined-by filters to
; Define nodes, so the subtree walk is what actually scopes a function.)
(define (colony-list-append a b)
  (if (null? a) b (cons (car a) (colony-list-append (cdr a) b))))

(define (colony-find-define name)
  (let loop ((ids (query:node-type "Define")))
    (if (null? ids) #f
      (let ((info (query :node (car ids))))
        (if (and (string? (car (cdr info)))
                 (string=? (car (cdr info)) name))
            (car ids)
            (loop (cdr ids)))))))

; (query :node id) does not expose a stable tag id for value-carrying
; literals, so scope by subtree membership instead of by tag comparison:
; take the workspace-wide census for TAG-NAME and keep only the ids that
; live inside the define's subtree.
(define (colony-collect-ids id)
  (let walk ((pending (list id)) (acc (list)))
    (if (null? pending) (reverse acc)
      (let* ((cur (car pending))
             (kids (query :children cur))
             (ks (if (list? kids) kids (list))))
        (walk (colony-list-append ks (cdr pending)) (cons cur acc))))))

(define (colony-id-member? x xs)
  (if (null? xs) #f
    (if (= x (car xs)) #t (colony-id-member? x (cdr xs)))))

(define (colony-filter-ids keep xs)
  (let loop ((ys xs) (acc (list)))
    (if (null? ys) (reverse acc)
      (if (colony-id-member? (car ys) keep)
          (loop (cdr ys) (cons (car ys) acc))
          (loop (cdr ys) acc)))))

(define (colony-literals-in name tag-name)
  (let ((def (colony-find-define name)))
    (if (not def) (list)
      (colony-filter-ids (colony-collect-ids def)
                         (query:node-type tag-name)))))

(define find-literal-ints
  (lambda (fn-name)
    (if (string=? fn-name "")
        (query:node-type "LiteralInt")
        (colony-literals-in fn-name "LiteralInt"))))

(define find-literal-floats
  (lambda (fn-name)
    (if (string=? fn-name "")
        (query:node-type "LiteralFloat")
        (colony-literals-in fn-name "LiteralFloat"))))

; ── Helper: try a mutation, return (success? output) ──
(define try-mutation
  (lambda (src expected-str)
    (let ((result (eval-current-output)))
      (if (and (string? result) (output-contains-any? result expected-str))
          (list #t result)
          (list #f result)))))

; ── Budgeted strategy runners (#4738) ────────────────────────────
; Each returns (found? tried output message). Every attempt — including the
; ±1/±2 deltas of one literal — is charged against the caller's
; max-variants budget, so the budget is a hard cap and not a per-strategy
; and per-literal allowance.

; Strategy 1: display-ref — replace body with (display <ref>)
(define (colony-try-refs src fns ref expected-str budget)
  (let loop ((fns-left fns) (tried 0))
    (if (or (null? fns-left) (>= tried budget))
        (list #f tried "" "")
      (let ((fn-name (car fns-left))
            (rest-fns (cdr fns-left))
            (new-body (string-append "(lambda (x) (display "
                                     (number->string ref) "))")))
        (set-code src)
        (mutate:rebind fn-name new-body "colony:display-ref")
        (let ((res (try-mutation src expected-str)))
          (if (car res)
              (list #t (+ tried 1) (car (cdr res))
                    (string-append "colony:ref-" (number->string ref)))
              (loop rest-fns (+ tried 1))))))))

; Strategy 2: integer literals inside each named function, ±1/±2.
(define (colony-try-ints src lit-groups expected-str budget tried0)
  (let loop ((groups lit-groups) (tried tried0))
    (if (or (null? groups) (>= tried budget))
        (list #f tried "" "")
      (let ((lit-ids (cdr (car groups)))
            (rest-groups (cdr groups)))
        (let try-lits ((ids lit-ids) (tried tried))
          (if (or (null? ids) (>= tried budget))
              (loop rest-groups tried)
            (let try-deltas ((ds (list 1 -1 2 -2)) (tried tried))
              (if (or (null? ds) (>= tried budget))
                  (try-lits (cdr ids) tried)
                (let ((delta (car ds)))
                  (set-code src)
                  (mutate:tweak-literal (car ids) delta "colony:lit-tweak")
                  (let ((res (try-mutation src expected-str)))
                    (if (car res)
                        (list #t (+ tried 1) (car (cdr res))
                              (string-append "colony:tweak-"
                                             (number->string delta)))
                        (try-deltas (cdr ds) (+ tried 1)))))))))))))

; Strategy 3: float literals inside each named function, relative factors
; (#4738: thresholds like 0.15 were never searched). mutate:tweak-literal
; treats a float delta on a LiteralFloat as a relative factor:
; new = old * (1 + factor).
(define (colony-try-floats src lit-groups expected-str budget tried0)
  (let loop ((groups lit-groups) (tried tried0))
    (if (or (null? groups) (>= tried budget))
        (list #f tried "" "")
      (let ((lit-ids (cdr (car groups)))
            (rest-groups (cdr groups)))
        (let try-lits ((ids lit-ids) (tried tried))
          (if (or (null? ids) (>= tried budget))
              (loop rest-groups tried)
            (let try-factors ((fs (list 0.1 -0.1 0.25 -0.25 0.5 -0.5)) (tried tried))
              (if (or (null? fs) (>= tried budget))
                  (try-lits (cdr ids) tried)
                (let ((factor (car fs)))
                  (set-code src)
                  (mutate:tweak-literal (car ids) factor "colony:float-tweak")
                  (let ((res (try-mutation src expected-str)))
                    (if (car res)
                        (list #t (+ tried 1) (car (cdr res))
                              (string-append "colony:float-"
                                             (number->string factor)))
                        (try-factors (cdr fs) (+ tried 1)))))))))))))

; Main search: display-ref + lit-tweak for each named function
;
; Reads (current-source :workspace) — the user's set-code'd script —
; rather than the default per-eval source. Rationale: colony:search is
; designed to mutate the user's workspace script. In Phase 1 dual-workspace,
; the default (current-source) returns the AST being evaluated RIGHT NOW,
; which is the surrounding `begin`/eval form, not the script set via
; (set-code ...). That makes fn-name-list see the require'd module's
; defines and miss the "no defines" case the test expects.
; See dual-workspace design (archived: git tag docs-archive-pre-2026-06).
; #4738: literal node-id groups, queried from the PRISTINE workspace
; before any attempt (set-code re-parses the same source, so the ids stay
; valid for every attempt). Group = (fn-name . literal-ids).
(define (colony-literal-groups fns)
  (let loop ((fs fns) (acc (list)))
    (if (null? fs) (reverse acc)
      (loop (cdr fs)
            (cons (cons (car fs) (find-literal-ints (car fs))) acc)))))

(define (colony-float-groups fns)
  (let loop ((fs fns) (acc (list)))
    (if (null? fs) (reverse acc)
      (loop (cdr fs)
            (cons (cons (car fs) (find-literal-floats (car fs))) acc)))))

(define (colony:search expected-str max-variants)
  (let* ((src (current-source :workspace))
         (fns (fn-name-list src))
         (ref (find-first-ref expected-str))
         ;; #4738: entry checkpoint. Restored on every non-success exit so a
         ;; failed search never leaves its last mutation installed.
         (snap (ast:snapshot))
         ;; Queried before the first attempt (pristine workspace).
         (groups (colony-literal-groups fns))
         (fgroups (colony-float-groups fns)))
    (if (null? fns)
        (begin (ast:restore snap)
               (list #f "" "colony:no-fns"))
      (let* ((r1 (if ref (colony-try-refs src fns ref expected-str max-variants)
                     (list #f 0 "" "")))
             (tried1 (car (cdr r1))))
        (if (car r1)
            (list #t (car (cdr (cdr r1))) (car (cdr (cdr (cdr r1)))))
          (let* ((r2 (colony-try-ints src groups expected-str max-variants tried1))
                 (tried2 (car (cdr r2))))
            (if (car r2)
                (list #t (car (cdr (cdr r2))) (car (cdr (cdr (cdr r2)))))
              (let* ((r3 (colony-try-floats src fgroups expected-str max-variants tried2))
                     (tried3 (car (cdr r3))))
                (if (car r3)
                    (list #t (car (cdr (cdr r3))) (car (cdr (cdr (cdr r3)))))
                  (begin
                    (ast:restore snap)
                    ;; Output is "" — the restored workspace is the entry
                    ;; state, so no partial-run output is meaningful.
                    (list #f ""
                          (string-append "colony:"
                                         (number->string tried3) "var")))))))))))
