; lib/std/safe-refactor.aura — verification-gated refactoring
;
; Wraps a refactor operation with:
;   1. a (mutate :snapshot …) for rollback
;   2. a dry-run (mutate :check …) type gate on the candidate
;   3. AURA_CONTRACT_POST verifier (user-supplied)
;   4. auto-restore on failure
;
; API:
;   (safe-refactor:with-snapshot tag thunk) → result or rolled-back
;     tag:    string, snapshot name
;     thunk:  0-arg procedure
;     Returns thunk's result on success, or (list 'rolled-back "reason")
;
;   (safe-refactor:check-and-apply pre-verify post-verify apply-fn) → status
;     pre-verify:  0-arg, returns #t/#f
;     post-verify: 0-arg, returns #t/#f
;     apply-fn:    0-arg, performs refactor
;     Returns (list 'applied result), (list 'rejected "reason"),
;             (list 'rolled-back "reason"), or (list 'error "reason")
;             — including (list 'error "post-verify-error-raised") when
;             post-verify throws (Issue #4266: the snapshot is restored
;             in that case, never left mutated).
;
;   (safe-refactor:replace-fn fn-name new-body) → status
;     fn-name:  string
;     new-body: string, complete (define (name args) body) form
;     Returns (list 'applied snap-id) or (list 'rejected "reason")
;
;   (safe-refactor:rollback) → bool
;     Roll back the most recent safe-refactor snapshot.
;
; NOTE: Uses list (not cons) for status values, working around a
; cons-corruption bug in module-loaded functions.

(export safe-refactor:with-snapshot
        safe-refactor:replace-fn
        safe-refactor:check-and-apply
        safe-refactor:rollback
        safe-refactor:contract-pre
        safe-refactor:contract-post)

; #5253: every mutation helper below consults the active contract set
; before it commits. With no active set (contract:active) = #f and the
; helpers return #f, so a caller that never declared constraints sees the
; pre-#5253 behavior exactly.
(require "std/contract" all:)
; #5255: the one acceptance gate.
(require "std/gate" all:)

; ── (#5253) contract gate ──────────────────────────────────────────
; pre  : protected names / operator allow lists, before any write.
; post : the user's predicate invariants over the program view.
; Both yield the report hash (queryable, never #f) only when refused;
; #f means "no active set, nothing to say".
(define (safe-refactor:contract-pre op name)
  (if (contract:active)
      (contract:check-mutation (contract:active) op name)
      #f))

; A generic wrapper does not know which name it is about to touch, so
; the post check also compares the protected defines against "before".
(define (safe-refactor:contract-before)
  (if (contract:active)
      (let ((v (contract:view)))
        (let ((d (hash-ref v "defines" (quote ()))))
          (if (list? d) d (quote ()))))
      (quote ())))

(define (safe-refactor:contract-post before)
  (if (contract:active)
      (contract:check (contract:active)
                      (hash "before" (if (list? before) before (quote ()))))
      #f))

(define (safe-refactor:contract-refused? report)
  (and (hash? report) (not (contract:report-ok? report))))

; ── safe-refactor:with-snapshot — snapshot/restore wrapper ──
(define (safe-refactor:with-snapshot tag thunk)
  (let ((snap-id (mutate :snapshot tag))
        (before (safe-refactor:contract-before)))
    (let ((result (try (thunk) (catch (e) 'error-raised))))
      (cond
        ((equal? result 'error-raised)
         (begin
           (mutate :restore snap-id)
           (list 'rolled-back "error-raised")))
        ((equal? result 'fail)
         (begin
           (mutate :restore snap-id)
           (list 'rolled-back "explicit-fail")))
        (else
         ; #5253: the wrapped thunk's post-state must satisfy the set.
         (let ((cref (safe-refactor:contract-post before)))
           (if (safe-refactor:contract-refused? cref)
               (begin
                 (mutate :restore snap-id)
                 (list 'rolled-back cref))
               result)))))))

; ── safe-refactor:check-and-apply — pre/post verification gate ──
(define (safe-refactor:check-and-apply pre-verify post-verify apply-fn)
  (cond
    ((not (pre-verify))
     (list 'rejected "pre-verify-failed"))
    (else
     (let* ((snap-id (mutate :snapshot "safe-refactor-check"))
            (before (safe-refactor:contract-before))
            (apply-result
              (try (apply-fn) (catch (e) 'apply-error-raised))))
       (cond
         ((equal? apply-result 'apply-error-raised)
          (begin
            (mutate :restore snap-id)
            (list 'error "apply-error-raised")))
         ; Issue #4266: post-verify runs INSIDE the restore path — it used
         ; to sit outside every try, so a throwing post-verify escaped
         ; without restoring the snapshot and reported nothing.
         (else
          (let ((pv (try (post-verify) (catch (e) 'post-verify-error-raised))))
            (cond
              ((equal? pv 'post-verify-error-raised)
               (begin
                 (mutate :restore snap-id)
                 (list 'error "post-verify-error-raised")))
              ((not pv)
               (begin
                 (mutate :restore snap-id)
                 (list 'rolled-back "post-verify-failed")))
              (else
               ; #5253: post-verify passed, the contract set still decides.
               (let ((cref (safe-refactor:contract-post before)))
                 (if (safe-refactor:contract-refused? cref)
                     (begin
                       (mutate :restore snap-id)
                       (list 'rolled-back cref))
                     ; #5255: and the unified gate. typecheck-status passing
                     ; is not by itself a KEEP; a configured gate can still
                     ; roll the workspace back.
                     (let* ((fb (gate:feedback
                                  (hash "transform" (hash "operator" "safe-refactor"
                                                          "target" ""
                                                          "applied" #t)
                                        "exec" (hash "result" "ok"
                                                     "error-kind" "none"
                                                     "error-code" "" "message" "")
                                        "contract" (if (hash? cref) cref "none")
                                        "count" (if (number? apply-result) apply-result 1))))
                            (verdict (gate:evaluate (gate:installed) fb)))
                       (if (gate:keep? verdict)
                           (list 'applied apply-result)
                           (begin
                             (mutate :restore snap-id)
                             (list 'rolled-back verdict)))))))))))))))

; ── safe-refactor:rollback — restore last safe-refactor snapshot ──
;
; Convenience: rolls back the most recent safe-refactor snapshot.
; Returns #t on success, #f if no snapshot exists.
(define (safe-refactor:rollback)
  ; Issue #4274: ast:list-snapshots is stats-catalog only; list is
  ; ((id . name) ...) oldest-first. Restore the newest id (last pair's
  ; car), never (car snaps) which is the oldest pair (and not an int).
  (let ((snaps (stats:get "ast:list-snapshots")))
    (if (not (pair? snaps))
        #f
        (let loop ((s snaps) (last-id #f))
          (if (null? s)
              (if last-id (mutate :restore last-id) #f)
              (let ((entry (car s)))
                (loop (cdr s)
                      (if (pair? entry) (car entry) last-id))))))))

; ── mutate error text ──
;
; A mutate:* rejection is (kind . (message . 0)) — a pair, never thrown.
; Render it as "kind: message" so the reason slot is useful to an Agent.
(define (safe-refactor:mutate-reason v)
  (cond
    ((and (pair? v) (string? (car v)))
     (if (and (pair? (cdr v)) (string? (car (cdr v))))
         (string-append (car v) ": " (car (cdr v)))
         (car v)))
    ((string? v) v)
    (else "mutate-rejected")))

; ── safe-refactor:replace-fn — atomic function replacement with a type gate ──
;
; Replaces the definition of fn-name with the (define …) form in new-body.
;
; Issue #5252: the old body appended new-body to the whole workspace source
; and pushed it back with (set-code rebuilt) — a full-file rewrite that left
; a duplicate define (and, for a body without a define wrapper, a nested
; begin) behind. It was also one whole-file mutation, so it could not be
; rolled back as a small step.
;
; Now it is two registered small-step ops:
;   1. (mutate :check fn-name new-body) — dry-run gate: strict parse of the
;      candidate plus a call-local typecheck of workspace+candidate, diffed
;      against the workspace baseline. Nothing is installed (no mutation,
;      no epoch bump), so an ill-typed body is refused *before* any write.
;      This does not go through (typecheck-status) (#5250: that oracle can
;      under-report); it is the mutate gate itself.
;   2. (mutate :rebind fn-name new-body) — replaces the define's value in
;      the live AST (hygiene + structural rollback log + post-mutate
;      typecheck under a Hard gate).
;
; (typecheck-status) is kept as the final whole-workspace acceptance gate so
; the #4266 contract (never report applied over a diagnostics report) holds
; even when a pre-existing error lives outside the candidate.
;
; When fn-name has no define yet, (mutate :rebind) appends one — the append
; path behaved the same way, so an unknown name is an add, not a silent
; no-op.
;
; Returns:
;   (list 'applied snap-id)        — refactor applied, whole workspace clean
;   (list 'rejected "reason")      — empty body, parse error, type error
;                                    (the diagnostics report rides the
;                                    reason slot, Issue #4266), or a mutate
;                                    rejection
;   (list 'error "reason")         — unexpected internal status
(define (safe-refactor:replace-fn fn-name new-body)
  (cond
    ((not (string? fn-name))
     (list 'rejected "bad-fn-name"))
    ((not (string? new-body))
     (list 'rejected "empty-source-or-body"))
    ((or (= (string-length fn-name) 0) (= (string-length new-body) 0))
     (list 'rejected "empty-source-or-body"))
    (else
     ; #5253: a protected name is refused before the dry-run gate even runs.
     (let* ((cref (safe-refactor:contract-pre "safe-refactor:replace-fn" fn-name))
            (gate (try (mutate :check fn-name new-body) (catch (e) 'check-error-raised))))
       (cond
         ((safe-refactor:contract-refused? cref)
          (list 'rejected cref))
         ((equal? gate 'check-error-raised)
          (list 'rejected "check-error-raised"))
         ((equal? gate #t)
          ; Candidate parses and adds no new diagnostics — install it.
          (let* ((snap-id (mutate :snapshot (string-append "replace-" fn-name)))
                 (before (safe-refactor:contract-before))
                 (apply-result
                   (try (mutate :rebind fn-name new-body)
                        (catch (e) 'apply-error-raised)))
                 (tc (if (equal? apply-result #t)
                         (try (typecheck-status) (catch (e) 'tc-error-raised))
                         #f)))
            (cond
              ((equal? apply-result 'apply-error-raised)
               (begin
                 (mutate :restore snap-id)
                 (list 'rejected "apply-error-raised")))
              ((not (equal? apply-result #t))
               (begin
                 (mutate :restore snap-id)
                 (list 'rejected (safe-refactor:mutate-reason apply-result))))
              ((equal? tc 'tc-error-raised)
               (begin
                 (mutate :restore snap-id)
                 (list 'rejected "typecheck-failed")))
              ; Issue #4266: applied ONLY on the structured ok status (#t).
              ; Anything else (diagnostics report / #f) restores the snapshot
              ; and is reported as rejected — the report rides the reason slot
              ; so Agents get the details without parsing English to branch.
              ((equal? tc #t)
               ; #5253: the installed workspace must satisfy the set.
               (let ((cref2 (safe-refactor:contract-post before)))
                 (if (safe-refactor:contract-refused? cref2)
                     (begin
                       (mutate :restore snap-id)
                       (list 'rejected cref2))
                     (list 'applied snap-id))))
              (else
               (begin
                 (mutate :restore snap-id)
                 (list 'rejected
                       ; Issue #5250: (typecheck-status) yields a structured
                       ; diagnostic list on failure; keep string or list detail.
                       (if (or (string? tc) (list? tc))
                           tc
                           "typecheck-status-not-ok")))))))
         ; ("parse-error" msg) / ("type-error" report) from the dry-run gate.
         ((and (pair? gate) (string? (car gate)))
          (let ((tag (car gate))
                (detail (if (and (pair? (cdr gate)) (string? (car (cdr gate))))
                            (car (cdr gate))
                            "")))
            (cond
              ((string=? tag "type-error")
               ; #4266 reason shape: carries a diagnostics block.
               (list 'rejected (string-append "type-error\ndiagnostics:\n" detail)))
              ((string=? tag "parse-error")
               (list 'rejected (string-append "parse-error: " detail)))
              (else (list 'rejected (string-append tag ": " detail))))))
         (else
          (list 'rejected (safe-refactor:mutate-reason gate))))))))
