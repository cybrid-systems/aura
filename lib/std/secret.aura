; lib/std/secret — a minimal-disclosure credential store (#5417)
;
; A secret is a named file under one directory. The file holds the value
; base64-encoded, the directory is 0700 and each file is 0600, so a
; same-user reader is the only path to the plaintext. No value is ever
; stored in an exported handle, an audit record or an error message.
;
; Import: (require "std/secret" all:)
;
; Canonical use:
;   (define store (secret:default-store))
;   (secret:put! store "llm-api-key" key)          ; admin, needs exec+write
;   (secret:use (secret:get store "llm-api-key")   ; read, needs io-read
;     (lambda (k) (call-with-key k)))
;
; LLM_API_KEY stays a compatibility import source, never the recommended
; long-term store (secret:import-env! migrates one value).

(export secret:store secret:default-store secret:get secret:handle-name?
        secret:put! secret:import-file! secret:import-env!
        secret:use secret:use-raw secret:redact secret:contains-known? secret:audit
        secret:list secret:exists?)

(require "std/string" all:)
(require "std/encoding" all:)
(require "std/list" all:)
(require "std/char" all:)
(require "std/io" all:)
(require "std/process" all:)

; ── path/name validation ────────────────────────────────────────
; No quoting: a store path and a secret name are restricted to the
; characters below before they reach a shell command.

(define (sec-safe-char? c)
  (or (char-alphabetic? c)
      (char-numeric? c)
      (= c 47) ; /
      (= c 46) ; .
      (= c 95) ; _
      (= c 45))) ; -

(define (sec-safe-path? s)
  (and (string? s)
       (> (string-length s) 0)
       (not (string-contains? s ".."))
       (let loop ((i 0))
         (if (>= i (string-length s))
           #t
           (and (sec-safe-char? (string-ref s i))
                (loop (+ i 1)))))))

(define (sec-safe-name? s)
  (and (string? s)
       (> (string-length s) 0)
       (not (= (string-ref s 0) 46))
       (let loop ((i 0))
         (if (>= i (string-length s))
           #t
           (and (sec-safe-char? (string-ref s i))
                (loop (+ i 1)))))))

; ── audit + known-value registry (in-process, no plaintext) ─────

(define *secret-audit* '())
(define *secret-known* '())

(define (sec-audit! name action ok)
  (set! *secret-audit*
        (cons (hash "name" name "action" action "ok" ok
                    "time" (current-time))
              *secret-audit*))
  #t)

(define (sec-remember! value)
  (if (and (string? value) (> (string-length value) 0))
    (if (member? value *secret-known*)
      #t
      (begin
        (set! *secret-known* (cons value *secret-known*))
        #t))
    #t))

(define (secret:audit) *secret-audit*)

; Mask every value this process has seen through put!/import/use. A
; returned string can therefore be safely logged.
(define (secret:redact s)
  (if (not (string? s))
    s
    (let loop ((xs *secret-known*) (acc s))
      (if (null? xs)
        acc
        (loop (cdr xs)
              (if (string-contains? acc (car xs))
                (string-replace acc (car xs) "***")
                acc))))))

(define (secret:contains-known? s)
  (and (string? s)
       (let loop ((xs *secret-known*))
         (cond ((null? xs) #f)
               ((string-contains? s (car xs)) #t)
               (else (loop (cdr xs)))))))

; ── store and handle construction ──────────────────────────────

(define (secret:store path)
  (if (sec-safe-path? path)
    (hash "kind" "secret-store" "path" path)
    (hash "kind" "secret-store" "path" "" "error" "bad-store-path")))

(define (secret:default-store)
  (let ((from-env (try (getenv "AURA_SECRET_STORE") (catch (e) #f))))
    (if (and (string? from-env) (> (string-length from-env) 0))
      (secret:store from-env)
      (let ((home (try (getenv "HOME") (catch (e) #f))))
        (if (and (string? home) (> (string-length home) 0))
          (secret:store (string-append home "/.aura/secrets"))
          (secret:store "/tmp/aura-secrets"))))))

(define (secret:handle-name? h)
  (and (hash? h) (equal? (hash-ref h "kind" #f) "secret")))

(define (sec-store-path store)
  (if (and (hash? store)
           (equal? (hash-ref store "kind" #f) "secret-store")
           (string? (hash-ref store "path" #f))
           (> (string-length (hash-ref store "path" "")) 0))
    (hash-ref store "path")
    #f))

(define (secret:get store name)
  (let ((dir (sec-store-path store)))
    (cond
      ((not dir) (hash "kind" "secret-error" "error" "bad-store"))
      ((not (sec-safe-name? name)) (hash "kind" "secret-error" "error" "bad-name"))
      (else (hash "kind" "secret"
                  "name" name
                  "path" (string-append dir "/" name ".secret"))))))

(define (sec-handle-path h)
  (if (secret:handle-name? h) (hash-ref h "path" #f) #f))

(define (sec-read-value h)
  (let* ((p (sec-handle-path h))
         (raw (if p (try (read-file p) (catch (e) #f)) #f)))
    (if (string? raw)
      (try (base64-decode raw) (catch (e) #f))
      #f)))

; ── read surface ───────────────────────────────────────────────

; The value is handed to proc and never returned by this module itself.
; A missing value or a sandbox without io-read is secret-unavailable;
; neither answer names the file's contents. A string result is redacted
; on the way out, so returning the value by accident prints ***.
(define (sec-use h proc mask)
  (if (not (procedure? proc))
    (hash "ok" #f "error" "bad-proc")
    (let ((v (sec-read-value h)))
      (if (not (string? v))
        (begin
          (sec-audit! (if (secret:handle-name? h) (hash-ref h "name" "?") "?")
                      "use" #f)
          (hash "ok" #f "error" "secret-unavailable"))
        (begin
          (sec-remember! v)
          (let ((r (try (proc v)
                        (catch (e) (hash "ok" #f "error" "secret-use-failed")))))
            (sec-audit! (hash-ref h "name" "?") "use"
                        (not (and (hash? r) (equal? (hash-ref r "ok" #t) #f))))
            (if (and mask (string? r)) (secret:redact r) r)))))))

(define (secret:use h proc)
  (sec-use h proc #t))

; Last-resort unmasked read for a module that must hand the key to a
; transport (std/llm does this). Keep its result out of logs and source.
(define (secret:use-raw h proc)
  (sec-use h proc #f))

(define (secret:exists? store name)
  (let ((p (sec-handle-path (secret:get store name))))
    (if p (string? (try (read-file p) (catch (e) #f))) #f)))

(define (secret:list store)
  (let ((dir (sec-store-path store)))
    (if (not dir)
      '()
      (let ((entries (try (directory-list dir) (catch (e) #f))))
        (if (not (pair? entries))
          '()
          (let loop ((xs entries) (acc '()))
            (cond
              ((null? xs) (reverse acc))
              ((and (string-suffix? (car xs) ".secret")
                    (> (string-length (car xs)) 7))
               (loop (cdr xs)
                     (cons (substring (car xs) 0 (- (string-length (car xs)) 7)) acc)))
              (else (loop (cdr xs) acc)))))))))

; ── write/import surface (admin) ───────────────────────────────

(define (sec-write! store name value)
  (let* ((dir (sec-store-path store))
         (p (secret:get store name)))
    (cond
      ((not dir) (hash "ok" #f "error" "bad-store"))
      ((not (secret:handle-name? p)) p)
      ((not (string? value)) (hash "ok" #f "error" "bad-value"))
      ((= (string-length value) 0) (hash "ok" #f "error" "bad-value"))
      (else
       (let* ((final (hash-ref p "path"))
              (tmp (string-append final ".tmp"))
              (mk (try (shell (string-append "mkdir -p " dir " && chmod 700 " dir))
                       (catch (e) -1))))
         (cond
           ((not (and (number? mk) (= mk 0)))
            (hash "ok" #f "error" "store-create-failed"))
           (else
            (let ((w (try (file-write tmp (base64-encode value)) (catch (e) #f))))
              (cond
                ((error? w) (hash "ok" #f "error" "secret-write-failed"))
                (else
                 (let ((mv (try (shell (string-append "chmod 600 " tmp " && mv " tmp " " final))
                                (catch (e) -1))))
                   (if (and (number? mv) (= mv 0))
                     (begin
                       (sec-remember! value)
                       (sec-audit! name "put" #t)
                       #t)
                     (begin
                       (try (shell (string-append "rm -f " tmp)) (catch (e) #f))
                       (hash "ok" #f "error" "secret-write-failed"))))))))))))))

(define (secret:put! store name value)
  (sec-write! store name value))

(define (secret:import-file! store name path)
  (let ((raw (try (read-file path) (catch (e) #f))))
    (if (not (string? raw))
      (hash "ok" #f "error" "import-unavailable")
      (sec-write! store name (string-trim raw)))))

; Deprecated migration source: LLM_API_KEY and friends can be imported,
; but the docs and the LLM path treat the store as the durable home.
(define (secret:import-env! store name env-name)
  (let ((raw (try (getenv env-name) (catch (e) #f))))
    (if (not (string? raw))
      (hash "ok" #f "error" "import-unavailable")
      (sec-write! store name (string-trim raw)))))
