; Compatibility shim for std/test (#5224). New cases use test-case.
; section / it / describe / summary stay for old call sites. They record
; through test-record and do not exit. (summary) is #t when nothing failed.
;
;   (require "std/edsl-test-harness" all:)
;   (section "Query")
;   (it "def-use" (= 1 1))
;   (summary)

(export section it describe report summary
        total-pass total-fail reset-totals
        fixture-set-code expect-hash-bool)
(require "std/test" all:)

(define total-pass 0)
(define total-fail 0)
(define current-section "")

(define (reset-totals)
  (set! total-pass 0)
  (set! total-fail 0)
  (set! current-section "")
  #t)

(define (section title)
  (newline)
  (display "── ")
  (display title)
  (display " ──\n")
  (set! current-section title)
  title)

;; (it name ok) — one immediate assertion. ok is already a value.
(define (it name ok)
  (display "  ")
  (display name)
  (display ": ")
  (if ok
      (begin (display "✅\n") (set! total-pass (+ total-pass 1)))
      (begin (display "❌\n") (set! total-fail (+ total-fail 1))))
  (test-record (if (string? name) name "it") ok)
  ok)

(define (report name ok) (it name ok))

(define (describe title body-thunk)
  (section title)
  (body-thunk)
  title)

(define (fixture-set-code src)
  (set-code src))

(define (expect-hash-bool h key expected)
  (and (hash? h)
       (let ((v (hash-ref h key)))
         (and (boolean? v) (if expected v (not v))))))

(define (summary)
  (newline)
  (display "═══ Results ═══\n")
  (display total-pass)
  (display " passed, ")
  (display total-fail)
  (display " failed\n")
  (if (= total-fail 0)
      (begin (display "✅ All tests passed!\n") #t)
      (begin
        (display "❌ ")
        (display total-fail)
        (display " test(s) failed\n")
        #f)))
