; kir-gpu.aura — GPU 后端：CUDA C / PTX / Triton（Issue #4802 第三阶段）
;
; The same checked kernel IR (std/kir) lowered to three GPU targets. The one
; top-level (pfor (i lo hi) ...) of a kernel is the data-parallel axis:
;
;   CUDA C  : i = lo + blockIdx.x*blockDim.x + threadIdx.x; if (i < hi) {...}
;             funcs -> extern "C" __device__, kernels -> extern "C" __global__
;   PTX     : direct emission (ld.param / cvta.to.global / ld.global / setp+bra),
;             funcs -> .func with .param passing; validated offline by ptxas
;   Triton  : i = lo + program_id(0)*KIR_BLOCK + tl.arange(0, KIR_BLOCK),
;             _mask = i < hi; loads/stores masked; divergent if/when are
;             if-converted (tl.where for locals, mask for stores)
;
; GPU contracts (kir-gpu-check, on top of kir-check): a kernel has exactly one
; top-level pfor; only let / scalar set may precede it (they run in every
; thread / program) and nothing may follow it. Target limits are reported as
; errors, never silently miscompiled: PTX has no f64 exp/log; Triton needs
; uniform loop bounds, no return inside pfor and funcs without ref.
;
;   (kir-gpu-check 'cuda|'ptx|'triton item [module]) -> list of error strings
;   (kir->cuda item [module])  (kir->cuda-unit module-or-item)    -> CUDA C text
;   (kir->ptx module-or-item [arch "sm_80"])                       -> PTX text
;   (kir->triton module-or-item)                                   -> Python text
;        (also defines launch_<kernel>(..., block=256) when the pfor bounds
;         only use scalar params)
(export kir-gpu-check kir->cuda kir->cuda-unit kir->ptx kir->triton kir-float-text)
(require "std/kir" all:)
(require "std/cgen" all:)

(define (kg-member? s lst)
  (cond ((null? lst) #f) ((equal? s (car lst)) #t) (else (kg-member? s (cdr lst)))))
(define (kg-assoc k al)
  (cond ((null? al) #f) ((equal? k (car (car al))) (car al)) (else (kg-assoc k (cdr al)))))
(define (kg-ptr? t) (and (> (string-length t) 4) (equal? (substring t 0 4) "ptr:")))
(define (kg-elem t) (substring t 4 (string-length t)))
(define (kg-lit? t) (or (equal? t "ilit") (equal? t "flit")))
(define (kg-conc t) (cond ((equal? t "ilit") "i64") ((equal? t "flit") "f64") (else t)))
(define (kg-int? t) (kg-member? t (list "i32" "i64" "ilit")))
(define (kg-float? t) (kg-member? t (list "f32" "f64" "flit")))
(define (kg-sym s) (string->symbol s))
(define (kg-has-char? s ch)
  (let loop ((i 0))
    (cond ((>= i (string-length s)) #f) ((equal? (string-ref s i) ch) #t) (else (loop (+ i 1))))))
(define (kg-char-pos s ch)
  (let loop ((i 0))
    (cond ((>= i (string-length s)) #f) ((equal? (string-ref s i) ch) i) (else (loop (+ i 1))))))
; decimal float text that always has a '.', e.g. 2 -> "2.0", 1e-05 -> "1.0e-05"
(define (kir-float-text x)
  (let ((s (number->string (exact->inexact x))))
    (cond ((kg-has-char? s #\.) s)
          ((kg-char-pos s #\e)
           (let ((p (kg-char-pos s #\e))) (string-append (substring s 0 p) ".0" (substring s p (string-length s)))))
          (else (string-append s ".0")))))
(define (kg-loop-type sp env m)
  (let ((thi (kir-type-of (car (cddr sp)) env m)))
    (if (equal? thi "ilit")
        (let ((tl (kir-type-of (cadr sp) env m))) (if (equal? tl "ilit") "i64" tl))
        thi)))
(define (kg-errtext e) (format "~a" e))

; ---- structural GPU contract ---------------------------------------------------
(define (kg-structure it)
  (cond
    ((equal? (kir-kind it) "kernel")
     (let loop ((xs (kir-body it)) (seen #f) (errs '()))
       (cond
         ((null? xs) (reverse (if seen errs (cons "gpu kernel needs one top-level pfor" errs))))
         (else
          (let* ((s (car xs)) (h (kir-head s)))
            (cond
              ((equal? h "pfor") (loop (cdr xs) #t errs))
              (seen (loop (cdr xs) seen (cons (string-append "gpu kernel: statement after pfor (" h ")") errs)))
              ((or (equal? h "let") (and (equal? h "set") (not (pair? (cadr s))))) (loop (cdr xs) seen errs))
              (else (loop (cdr xs) seen
                          (cons (string-append "gpu kernel: only let / scalar set may precede pfor, got " h) errs)))))))))
    (else '())))

(define (kg-target-name t) (kir-name t))
(define (kir-gpu-check target it . rest)
  (let* ((m (if (null? rest) #f (car rest)))
         (errs (if m (kir-check it m) (kir-check it))))
    (cond
      ((not (null? errs)) errs)
      ((equal? (kir-kind it) "module")
       (let ((acc '()))
         (for-each (lambda (x)
                     (set! acc (append acc (map (lambda (e) (string-append (kir-name (cadr x)) ": " e))
                                                (kir-gpu-check target x it)))))
                   (kir-items it))
         acc))
      (else
       (let ((se (kg-structure it)))
         (if (not (null? se)) se
             (let ((tg (kg-target-name target)))
               (try (begin
                      (cond ((equal? tg "ptx") (kp-item it m))
                            ((equal? tg "triton") (kt-item it m))
                            ((equal? tg "cuda") (kg-cuda-item it m))
                            (else (error (string-append "kir-gpu: unknown target " tg))))
                      '())
                    (catch (e) (list (kg-errtext e)))))))))))
(define (kg-check! target it m)
  (let ((es (if m (kir-gpu-check target it m) (kir-gpu-check target it))))
    (if (null? es) it
        (error (string-append "kir-gpu-check failed (" (kir-name target) "): " (kir-join es "; "))))))

; ==== CUDA C ====================================================================
(define (kg-cuda-body it m)
  (let ((env (kir-env-of it)))
    (map (lambda (s)
           (if (equal? (kir-head s) "pfor")
               (let* ((sp (cadr s)) (v (car sp)) (lt (kg-loop-type sp env m)))
                 (list (kg-sym "begin")
                       (list (kg-sym "let") v (kg-sym lt)
                             (list (kg-sym "+") (cadr sp)
                                   (list (kg-sym "*") (list (kg-sym "cast") (kg-sym lt) (kg-sym "blockIdx.x"))
                                         (list (kg-sym "cast") (kg-sym lt) (kg-sym "blockDim.x")))
                                   (list (kg-sym "cast") (kg-sym lt) (kg-sym "threadIdx.x"))))
                       (cons (kg-sym "when") (cons (list (kg-sym "<") v (car (cddr sp))) (cddr s)))))
               s))
         (kir-body it))))
(define (kg-cuda-params it)
  (map (lambda (p) (kir-c-param p "__restrict__")) (kir-params it)))
(define (kg-cuda-item it m)
  (string-append "extern \"C\" " (if (equal? (kir-kind it) "kernel") "__global__ " "__device__ ")
                 (cgen-fn (kir-ctype (kir-ret it)) (kir-name (cadr it)) (kg-cuda-params it)
                          (kir-c-block (kg-cuda-body it m) (kir-env-of it) m))))
(define (kir->cuda it . rest)
  (let ((m (if (null? rest) #f (car rest))))
    (kg-check! "cuda" it m)
    (kg-cuda-item it m)))
(define kg-cuda-prelude (string-append
  "// Generated by Aura std/kir-gpu (kir->cuda), Issue #4802.\n"
  "// Launch each __global__ kernel 1-D: grid = ceil((hi - lo) / block), any block size.\n"
  "#include <stdint.h>\n"
  "#ifdef AURA_KIR_NOCUDAINC\n"
  "// device-only validation without the CUDA SDK (clang -nocudainc -nocudalib)\n"
  "#include \"__clang_cuda_builtin_vars.h\"\n"
  "#define __global__ __attribute__((global))\n"
  "#define __device__ __attribute__((device))\n"
  "#define sqrtf __builtin_sqrtf\n#define sqrt __builtin_sqrt\n"
  "#define fabsf __builtin_fabsf\n#define fabs __builtin_fabs\n"
  "#define fmaxf __builtin_fmaxf\n#define fmax __builtin_fmax\n"
  "#define fminf __builtin_fminf\n#define fmin __builtin_fmin\n"
  "#define expf(x) __nvvm_ex2_approx_f((x) * 1.4426950408889634f)\n"
  "#define logf(x) (__nvvm_lg2_approx_f(x) * 0.6931471805599453f)\n"
  "#endif\n\n"))
(define (kir->cuda-unit m)
  (kg-check! "cuda" m #f)
  (let ((items (kir-items m)) (mm (if (equal? (kir-kind m) "module") m #f)))
    (string-append
     kg-cuda-prelude
     (apply string-append
            (map (lambda (f)
                   (string-append "extern \"C\" __device__ " (kir-ctype (kir-ret f)) " " (kir-name (cadr f)) "("
                                  (if (null? (kir-params f)) "void"
                                      (kir-join (map (lambda (cp) (string-append (car cp) " " (cadr cp)))
                                                     (kg-cuda-params f)) ", "))
                                  ");\n"))
                 (filter (lambda (x) (equal? (kir-kind x) "func")) items)))
     "\n"
     (kir-join (map (lambda (it) (kg-cuda-item it mm)) items) "\n"))))

; ==== PTX =======================================================================
(define *kp-lines* '())
(define *kp-vars* '())
(define *kp-r* 0) (define *kp-rd* 0) (define *kp-f* 0) (define *kp-fd* 0) (define *kp-p* 0)
(define *kp-lbl* 0)
(define (kp-fail msg) (error (string-append "kir->ptx: " msg)))
(define (kp! s) (set! *kp-lines* (cons (string-append "\t" s) *kp-lines*)))
(define (kp-label! l) (set! *kp-lines* (cons (string-append l ":") *kp-lines*)))
(define (kp-new-label) (set! *kp-lbl* (+ *kp-lbl* 1)) (string-append "$L__" (number->string *kp-lbl*)))
(define (kp-sfx t)
  (cond ((equal? t "i32") "s32") ((equal? t "i64") "s64") ((equal? t "f32") "f32") ((equal? t "f64") "f64")
        ((equal? t "bool") "pred") ((kg-ptr? t) "u64") (else (kp-fail (string-append "no PTX type for " t)))))
(define (kp-mem t) (if (equal? t "bool") "s32" (kp-sfx t)))
(define (kp-size t) (if (kg-member? t (list "i64" "f64")) 8 (if (kg-ptr? t) 8 4)))
(define (kp-pw t) (if (= (kp-size t) 8) ".b64" ".b32"))
(define (kp-regdecl t)
  (cond ((equal? t "i32") ".b32") ((equal? t "f32") ".f32") ((equal? t "f64") ".f64") ((equal? t "bool") ".pred")
        (else ".b64")))
(define (kp-tmp t)
  (cond ((equal? t "i32") (set! *kp-r* (+ *kp-r* 1)) (string-append "%r" (number->string *kp-r*)))
        ((equal? t "f32") (set! *kp-f* (+ *kp-f* 1)) (string-append "%f" (number->string *kp-f*)))
        ((equal? t "f64") (set! *kp-fd* (+ *kp-fd* 1)) (string-append "%fd" (number->string *kp-fd*)))
        ((equal? t "bool") (set! *kp-p* (+ *kp-p* 1)) (string-append "%p" (number->string *kp-p*)))
        (else (set! *kp-rd* (+ *kp-rd* 1)) (string-append "%rd" (number->string *kp-rd*)))))
(define (kp-var-reg name) (string-append "%v_" (kir-name name)))
(define (kp-var! name t)
  (set! *kp-vars* (cons (string-append "\t.reg " (kp-regdecl t) " " (kp-var-reg name) ";") *kp-vars*))
  (kp-var-reg name))
(define (kp-mov t dst src) (kp! (string-append "mov." (if (kg-ptr? t) "u64" (kp-sfx t)) " " dst ", " src ";")))
(define (kp-lit x t)
  (if (kg-float? t) (kir-float-text x)
      (if (integer? x) (number->string x) (kp-fail "float literal in integer context"))))
(define (kp-ty e env m want)
  (let ((t (kir-type-of e env m)))
    (if (and want (kg-lit? t)) want (kg-conc t))))
(define (kp-cmp-type a b) (if (kg-lit? a) (kg-conc b) (kg-conc a)))

(define (kp-expr e env m want)
  (let ((t (kp-ty e env m want)))
    (cond
      ((number? e) (let ((r (kp-tmp t))) (kp-mov t r (kp-lit e t)) r))
      ((boolean? e) (let ((r (kp-tmp "bool"))) (kp! (string-append "setp.ne.s32 " r ", " (if e "1" "0") ", 0;")) r))
      ((not (pair? e)) (kp-var-reg e))
      (else (kp-form e (kir-head e) (cdr e) t env m)))))

(define (kp-arith-op h t)
  (cond ((equal? h "+") "add") ((equal? h "-") "sub")
        ((equal? h "*") (if (kg-int? t) "mul.lo" "mul"))
        ((equal? h "/") (if (kg-int? t) "div" "div.rn"))
        ((equal? h "%") "rem") ((equal? h "min") "min") ((equal? h "max") "max")
        (else (kp-fail (string-append "no PTX op for " h)))))
(define (kp-cmp-op h t)
  (cond ((equal? h "<") "lt") ((equal? h "<=") "le") ((equal? h ">") "gt") ((equal? h ">=") "ge")
        ((equal? h "==") "eq") ((equal? h "!=") (if (kg-float? t) "neu" "ne"))
        (else (kp-fail (string-append "no PTX compare for " h)))))

(define (kp-addr p i env m)
  (let* ((base (kp-expr p env m #f))
         (et (kg-elem (kir-type-of p env m)))
         (it (kg-conc (kir-type-of i env m)))
         (idx (kp-expr i env m it))
         (idx64 (if (equal? it "i32") (let ((w (kp-tmp "i64"))) (kp! (string-append "cvt.s64.s32 " w ", " idx ";")) w) idx))
         (off (kp-tmp "i64")) (addr (kp-tmp "ptr:u")))
    (kp! (string-append "mul.lo.s64 " off ", " idx64 ", " (number->string (kp-size et)) ";"))
    (kp! (string-append "add.s64 " addr ", " base ", " off ";"))
    addr))

(define (kp-convert r s t)
  (cond
    ((equal? s t) r)
    ((and (equal? t "bool") (kg-int? s))
     (let ((p (kp-tmp "bool"))) (kp! (string-append "setp.ne." (kp-sfx s) " " p ", " r ", 0;")) p))
    ((and (equal? t "bool") (kg-float? s))
     (let ((p (kp-tmp "bool"))) (kp! (string-append "setp.neu." (kp-sfx s) " " p ", " r ", 0.0;")) p))
    ((equal? s "bool")
     (let ((d (kp-tmp t)))
       (kp! (string-append "selp." (kp-sfx t) " " d ", " (if (kg-float? t) "1.0, 0.0, " "1, 0, ") r ";")) d))
    (else
     (let ((d (kp-tmp t)))
       (kp! (string-append
             (cond ((and (kg-int? s) (kg-int? t)) "cvt.")
                   ((kg-int? s) "cvt.rn.")
                   ((kg-int? t) "cvt.rzi.")
                   ((equal? t "f32") "cvt.rn.")
                   (else "cvt."))
             (kp-sfx t) "." (kp-sfx s) " " d ", " r ";"))
       d))))

(define (kp-form e h args t env m)
  (let ((sub (lambda (x w) (kp-expr x env m w))))
    (cond
      ((equal? h "f32") (let ((r (kp-tmp "f32"))) (kp-mov "f32" r (kir-float-text (car args))) r))
      ((or (equal? h "neg") (and (equal? h "-") (= (length args) 1)))
       (let ((a (sub (car args) t)) (r (kp-tmp t))) (kp! (string-append "neg." (kp-sfx t) " " r ", " a ";")) r))
      ((kg-member? h (list "+" "-" "*" "/" "%" "min" "max"))
       (let loop ((acc (sub (car args) t)) (xs (cdr args)))
         (if (null? xs) acc
             (let* ((b (sub (car xs) t)) (r (kp-tmp t)))
               (kp! (string-append (kp-arith-op h t) "." (kp-sfx t) " " r ", " acc ", " b ";"))
               (loop r (cdr xs))))))
      ((kg-member? h (list "<" "<=" ">" ">=" "==" "!="))
       (let* ((u (kp-cmp-type (kir-type-of (car args) env m) (kir-type-of (cadr args) env m)))
              (a (sub (car args) u)) (b (sub (cadr args) u)) (r (kp-tmp "bool")))
         (cond
           ((equal? u "bool")
            (cond ((equal? h "!=") (kp! (string-append "xor.pred " r ", " a ", " b ";")) r)
                  ((equal? h "==")
                   (let ((x (kp-tmp "bool")))
                     (kp! (string-append "xor.pred " x ", " a ", " b ";"))
                     (kp! (string-append "not.pred " r ", " x ";")) r))
                  (else (kp-fail (string-append "ordering compare (" h ") on bool")))))
           (else (kp! (string-append "setp." (kp-cmp-op h u) "." (kp-sfx u) " " r ", " a ", " b ";")) r))))
      ((kg-member? h (list "and" "or" "&&" "||"))
       (let ((r (kp-tmp "bool")) (end (kp-new-label)) (and? (kg-member? h (list "and" "&&"))))
         (kp-mov "bool" r (sub (car args) "bool"))
         (for-each (lambda (x)
                     (kp! (string-append (if and? "@!" "@") r " bra " end ";"))
                     (kp-mov "bool" r (sub x "bool")))
                   (cdr args))
         (kp-label! end)
         r))
      ((equal? h "not")
       (let ((a (sub (car args) "bool")) (r (kp-tmp "bool"))) (kp! (string-append "not.pred " r ", " a ";")) r))
      ((equal? h "ref")
       (let* ((addr (kp-addr (car args) (cadr args) env m)))
         (if (equal? t "bool")
             (let ((x (kp-tmp "i32")) (r (kp-tmp "bool")))
               (kp! (string-append "ld.global.s32 " x ", [" addr "];"))
               (kp! (string-append "setp.ne.s32 " r ", " x ", 0;")) r)
             (let ((r (kp-tmp t))) (kp! (string-append "ld.global." (kp-mem t) " " r ", [" addr "];")) r))))
      ((equal? h "cast")
       (let* ((tt (kir-ty (car args))) (x (cadr args)) (s (kir-type-of x env m)))
         (cond
           ((and (number? x) (equal? tt "bool")) (sub (not (= x 0)) #f))
           ((and (equal? s "ilit") (number? x)) (sub x tt))
           (else (kp-convert (sub x (kg-conc s)) (kg-conc s) tt)))))
      ((equal? h "?")
       (let ((r (kp-tmp t)) (els (kp-new-label)) (end (kp-new-label)) (c (sub (car args) "bool")))
         (kp! (string-append "@!" c " bra " els ";"))
         (kp-mov t r (sub (cadr args) t))
         (kp! (string-append "bra.uni " end ";"))
         (kp-label! els)
         (kp-mov t r (sub (car (cddr args)) t))
         (kp-label! end)
         r))
      ((kg-member? h (list "sqrt" "fabs" "exp" "log"))
       (let ((a (sub (car args) t)) (r (kp-tmp t)))
         (cond
           ((equal? h "sqrt") (kp! (string-append "sqrt.rn." (kp-sfx t) " " r ", " a ";")))
           ((equal? h "fabs") (kp! (string-append "abs." (kp-sfx t) " " r ", " a ";")))
           ((equal? t "f64") (kp-fail (string-append h " on f64 has no PTX instruction (use kir->cuda)")))
           ((equal? h "exp")
            (let ((x (kp-tmp "f32")))
              (kp! (string-append "mul.f32 " x ", " a ", 0f3FB8AA3B;"))
              (kp! (string-append "ex2.approx.f32 " r ", " x ";"))))
           (else
            (let ((x (kp-tmp "f32")))
              (kp! (string-append "lg2.approx.f32 " x ", " a ";"))
              (kp! (string-append "mul.f32 " r ", " x ", 0f3F317218;")))))
         r))
      ((kg-member? h (list "fmax" "fmin"))
       (let* ((a (sub (car args) t)) (b (sub (cadr args) t)) (r (kp-tmp t)))
         (kp! (string-append (if (equal? h "fmax") "max." "min.") (kp-sfx t) " " r ", " a ", " b ";")) r))
      ((equal? h "call") (kp-call (kir-name (car args)) (cdr args) env m))
      (else (kp-fail (string-append "unknown expression form " h))))))

(define (kp-call fname args env m)
  (let* ((f (kir-find m fname)) (ps (kir-env-of f)) (rt (kir-ret f))
         (regs (map (lambda (p a)
                      (let ((r (kp-expr a env m (cadr p))))
                        (if (equal? (cadr p) "bool")
                            (let ((x (kp-tmp "i32"))) (kp! (string-append "selp.s32 " x ", 1, 0, " r ";")) x)
                            r)))
                    ps args))
         (names (let loop ((k 0) (xs ps) (acc '()))
                  (if (null? xs) (reverse acc)
                      (loop (+ k 1) (cdr xs) (cons (string-append "param" (number->string k)) acc))))))
    (kp! "{")
    (for-each (lambda (p r n)
                (kp! (string-append ".param " (kp-pw (cadr p)) " " n ";"))
                (kp! (string-append "st.param." (kp-mem (cadr p)) " [" n "], " r ";")))
              ps regs names)
    (if (not (equal? rt "void")) (kp! (string-append ".param " (kp-pw rt) " retval0;")))
    (kp! (string-append "call.uni " (if (equal? rt "void") "" "(retval0), ") fname ", (" (kir-join names ", ") ");"))
    (let ((res (cond
                 ((equal? rt "void") "")
                 ((equal? rt "bool")
                  (let ((x (kp-tmp "i32")) (r (kp-tmp "bool")))
                    (kp! (string-append "ld.param.s32 " x ", [retval0];"))
                    (kp! (string-append "setp.ne.s32 " r ", " x ", 0;")) r))
                 (else (let ((r (kp-tmp rt))) (kp! (string-append "ld.param." (kp-mem rt) " " r ", [retval0];")) r)))))
      (kp! "}")
      res)))

(define (kp-store lv v env m)
  (let* ((et (kir-type-of lv env m)) (addr (kp-addr (cadr lv) (car (cddr lv)) env m)))
    (if (equal? et "bool")
        (let ((x (kp-tmp "i32")))
          (kp! (string-append "selp.s32 " x ", 1, 0, " v ";"))
          (kp! (string-append "st.global.s32 [" addr "], " x ";")))
        (kp! (string-append "st.global." (kp-mem et) " [" addr "], " v ";")))))

(define (kp-block stmts env m f)
  (let loop ((xs stmts) (env env))
    (if (null? xs) env (loop (cdr xs) (kp-stmt (car xs) env m f)))))

(define (kp-loop-head s env m)
  (let* ((sp (cadr s)) (v (kir-name (car sp))) (lt (kg-loop-type sp env m)))
    (kp-var! v lt)
    (list v lt (cons (list v lt "loop") env))))

(define (kp-stmt s env m f)
  (let ((h (kir-head s)))
    (cond
      ((equal? h "let")
       (let ((t (kir-ty (car (cddr s)))) (v (kir-name (cadr s))))
         (kp-var! v t)
         (if (not (null? (cdr (cddr s)))) (kp-mov t (kp-var-reg v) (kp-expr (cadr (cddr s)) env m t)))
         (cons (list v t "var") env)))
      ((kg-member? h (list "set" "+=" "-=" "*=" "/="))
       (let* ((lv (cadr s))
              (e (if (equal? h "set") (car (cddr s))
                     (list (kg-sym (substring h 0 1)) lv (car (cddr s)))))
              (lt (kir-type-of lv env m))
              (v (kp-expr e env m lt)))
         (if (pair? lv) (kp-store lv v env m) (kp-mov lt (kp-var-reg lv) v))
         env))
      ((kg-member? h (list "for" "simd-for"))
       (let* ((hd (kp-loop-head s env m)) (v (car hd)) (lt (cadr hd)) (env2 (car (cddr hd)))
              (sp (cadr s)) (top (kp-new-label)) (end (kp-new-label)))
         (kp-mov lt (kp-var-reg v) (kp-expr (cadr sp) env m lt))
         (kp-label! top)
         (let ((hi (kp-expr (car (cddr sp)) env2 m lt)) (p (kp-tmp "bool")))
           (kp! (string-append "setp.ge." (kp-sfx lt) " " p ", " (kp-var-reg v) ", " hi ";"))
           (kp! (string-append "@" p " bra " end ";")))
         (kp-block (cddr s) env2 m f)
         (let ((st (if (null? (cdr (cddr sp))) "1" (kp-expr (car (cdr (cddr sp))) env2 m lt))))
           (kp! (string-append "add." (kp-sfx lt) " " (kp-var-reg v) ", " (kp-var-reg v) ", " st ";")))
         (kp! (string-append "bra.uni " top ";"))
         (kp-label! end)
         env))
      ((equal? h "pfor")
       (let* ((hd (kp-loop-head s env m)) (v (car hd)) (lt (cadr hd)) (env2 (car (cddr hd)))
              (sp (cadr s)) (end (kp-new-label))
              (a (kp-tmp "i32")) (b (kp-tmp "i32")) (c (kp-tmp "i32")))
         (kp! (string-append "mov.u32 " a ", %ctaid.x;"))
         (kp! (string-append "mov.u32 " b ", %ntid.x;"))
         (kp! (string-append "mov.u32 " c ", %tid.x;"))
         (let ((g (if (equal? lt "i32")
                      (let ((g (kp-tmp "i32"))) (kp! (string-append "mad.lo.s32 " g ", " a ", " b ", " c ";")) g)
                      (let ((w (kp-tmp "i64")) (c64 (kp-tmp "i64")) (g (kp-tmp "i64")))
                        (kp! (string-append "mul.wide.u32 " w ", " a ", " b ";"))
                        (kp! (string-append "cvt.u64.u32 " c64 ", " c ";"))
                        (kp! (string-append "add.s64 " g ", " w ", " c64 ";")) g)))
               (lo (kp-expr (cadr sp) env m lt)))
           (kp! (string-append "add." (kp-sfx lt) " " (kp-var-reg v) ", " g ", " lo ";")))
         (let ((hi (kp-expr (car (cddr sp)) env2 m lt)) (p (kp-tmp "bool")))
           (kp! (string-append "setp.ge." (kp-sfx lt) " " p ", " (kp-var-reg v) ", " hi ";"))
           (kp! (string-append "@" p " bra " end ";")))
         (kp-block (cddr s) env2 m f)
         (kp-label! end)
         env))
      ((equal? h "if")
       (let ((c (kp-expr (cadr s) env m "bool")) (els (kp-new-label)) (end (kp-new-label)))
         (kp! (string-append "@!" c " bra " els ";"))
         (kp-block (list (car (cddr s))) env m f)
         (kp! (string-append "bra.uni " end ";"))
         (kp-label! els)
         (if (not (null? (cdr (cddr s)))) (kp-block (list (cadr (cddr s))) env m f))
         (kp-label! end)
         env))
      ((equal? h "when")
       (let ((c (kp-expr (cadr s) env m "bool")) (end (kp-new-label)))
         (kp! (string-append "@!" c " bra " end ";"))
         (kp-block (cddr s) env m f)
         (kp-label! end)
         env))
      ((equal? h "begin") (kp-block (cdr s) env m f) env)
      ((equal? h "return")
       (if (not (null? (cdr s)))
           (let* ((rt (kir-ret f)) (v (kp-expr (cadr s) env m rt)) (fn (string-append (kir-name (cadr f)) "_ret")))
             (if (equal? rt "bool")
                 (let ((x (kp-tmp "i32")))
                   (kp! (string-append "selp.s32 " x ", 1, 0, " v ";"))
                   (kp! (string-append "st.param.s32 [" fn "], " x ";")))
                 (kp! (string-append "st.param." (kp-mem rt) " [" fn "], " v ";"))))
           #f)
       (kp! "ret;")
       env)
      ((equal? h "expr") (kp-expr (cadr s) env m #f) env)
      (else (kp-fail (string-append "unknown statement " h))))))

(define (kp-header it)
  (let* ((name (kir-name (cadr it))) (kernel? (equal? (kir-kind it) "kernel"))
         (ps (kir-env-of it)) (rt (kir-ret it))
         (pdecls (let loop ((k 0) (xs ps) (acc '()))
                   (if (null? xs) (reverse acc)
                       (let ((t (cadr (car xs))))
                         (loop (+ k 1) (cdr xs)
                               (cons (string-append ".param "
                                                    (if kernel?
                                                        (cond ((kg-ptr? t) ".u64") ((equal? t "bool") ".u32")
                                                              (else (string-append "." (kp-sfx t))))
                                                        (kp-pw t))
                                                    " " name "_param_" (number->string k))
                                     acc)))))))
    (string-append (if kernel? ".visible .entry " ".visible .func ")
                   (if (or kernel? (equal? rt "void")) "" (string-append "(.param " (kp-pw rt) " " name "_ret) "))
                   name "(" (if (null? pdecls) "" (string-append "\n\t" (kir-join pdecls ",\n\t"))) ")")))

(define (kp-decls)
  (let ((d (lambda (n cls ty) (if (> n 0) (list (string-append "\t.reg " ty " %" cls "<" (number->string (+ n 1)) ">;")) '()))))
    (append (d *kp-p* "p" ".pred") (d *kp-r* "r" ".b32") (d *kp-rd* "rd" ".b64")
            (d *kp-f* "f" ".f32") (d *kp-fd* "fd" ".f64") (reverse *kp-vars*))))

(define (kp-item it m)
  (set! *kp-lines* '()) (set! *kp-vars* '())
  (set! *kp-r* 0) (set! *kp-rd* 0) (set! *kp-f* 0) (set! *kp-fd* 0) (set! *kp-p* 0)
  (let* ((name (kir-name (cadr it))) (kernel? (equal? (kir-kind it) "kernel")) (ps (kir-env-of it)))
    (let loop ((k 0) (xs ps))
      (if (not (null? xs))
          (let* ((p (car xs)) (t (cadr p)) (v (kp-var! (car p) t))
                 (pn (string-append "[" name "_param_" (number->string k) "]")))
            (cond
              ((and kernel? (kg-ptr? t))
               (let ((x (kp-tmp "i64")))
                 (kp! (string-append "ld.param.u64 " x ", " pn ";"))
                 (kp! (string-append "cvta.to.global.u64 " v ", " x ";"))))
              ((equal? t "bool")
               (let ((x (kp-tmp "i32")))
                 (kp! (string-append "ld.param." (if kernel? "u32 " "s32 ") x ", " pn ";"))
                 (kp! (string-append "setp.ne.s32 " v ", " x ", 0;"))))
              (else (kp! (string-append "ld.param." (kp-mem t) " " v ", " pn ";"))))
            (loop (+ k 1) (cdr xs)))
          #f))
    (kp-block (kir-body it) ps m it)
    (kp! "ret;")
    (string-append (kp-header it) "\n{\n" (kir-join (kp-decls) "\n") "\n\n"
                   (kir-join (reverse *kp-lines*) "\n") "\n}\n")))

(define (kir->ptx mod . rest)
  (let ((arch (if (null? rest) "sm_80" (kir-name (car rest))))
        (mm (if (equal? (kir-kind mod) "module") mod #f)))
    (kg-check! "ptx" mod #f)
    (set! *kp-lbl* 0)
    (let ((items (kir-items mod)))
      (string-append
       "//\n// Generated by Aura std/kir-gpu (kir->ptx), Issue #4802\n//\n\n"
       ".version 7.0\n.target " arch "\n.address_size 64\n\n"
       (apply string-append
              (map (lambda (f) (string-append (kp-header f) ";\n"))
                   (filter (lambda (x) (equal? (kir-kind x) "func")) items)))
       "\n"
       (kir-join (map (lambda (it) (kp-item it mm)) items) "\n")))))

; ==== Triton ====================================================================
(define *kt-lines* '())
(define *kt-tmp* 0)
(define (kt-fail msg) (error (string-append "kir->triton: " msg)))
(define (kt-pad n) (if (<= n 0) "" (string-append "    " (kt-pad (- n 1)))))
(define (kt! ind s) (set! *kt-lines* (cons (string-append (kt-pad ind) s) *kt-lines*)))
(define (kt-dtype t)
  (cond ((equal? t "i32") "tl.int32") ((equal? t "i64") "tl.int64") ((equal? t "f32") "tl.float32")
        ((equal? t "f64") "tl.float64") ((equal? t "bool") "tl.int1")
        (else (kt-fail (string-append "no Triton dtype for " t)))))
(define (kt-and g c) (if g (string-append "(" g " & " c ")") c))
(define (kt-negate c) (string-append "(" c " == 0)"))
; ctx: (module mode mask dc uniform-names) ; mode "kernel" | "pfor" | "func"
(define (kt-ctx m mode mask dc uni) (list m mode mask dc uni))
(define (kt-m c) (car c)) (define (kt-mode c) (cadr c)) (define (kt-mask c) (car (cddr c)))
(define (kt-dc c) (cadr (cddr c))) (define (kt-uni c) (car (cddr (cddr c))))
(define (kt-guard c) (if (kt-dc c) (kt-and (kt-mask c) (kt-dc c)) (kt-mask c)))

(define (kt-uniform? e uni)
  (cond ((or (number? e) (boolean? e)) #t)
        ((not (pair? e)) (kg-member? (kir-name e) uni))
        (else
         (let ((h (kir-head e)))
           (cond ((kg-member? h (list "ref" "call")) #f)
                 ((equal? h "f32") #t)
                 ((equal? h "cast") (kt-uniform? (cadr (cdr e)) uni))
                 (else (let loop ((xs (cdr e)))
                         (cond ((null? xs) #t) ((kt-uniform? (car xs) uni) (loop (cdr xs))) (else #f)))))))))

(define (kt-expr e env c g)
  (let ((m (kt-m c)) (sub (lambda (x) (kt-expr x env c g))))
    (cond
      ((integer? e) (number->string e))
      ((float? e) (kir-float-text e))
      ((boolean? e) (if e "True" "False"))
      ((not (pair? e)) (kir-name e))
      (else
       (let ((h (kir-head e)) (args (cdr e)))
         (cond
           ((equal? h "f32") (kir-float-text (car args)))
           ((or (equal? h "neg") (and (equal? h "-") (= (length args) 1))) (string-append "(-" (sub (car args)) ")"))
           ((kg-member? h (list "min" "max"))
            (let loop ((acc (sub (car args))) (xs (cdr args)))
              (if (null? xs) acc
                  (loop (string-append (if (equal? h "min") "tl.minimum(" "tl.maximum(") acc ", " (sub (car xs)) ")")
                        (cdr xs)))))
           ((kg-member? h (list "+" "-" "*" "/" "%"))
            (let ((op (if (and (equal? h "/") (kg-int? (kir-type-of e env m))) "//" h)))
              (string-append "(" (kir-join (map sub args) (string-append " " op " ")) ")")))
           ((kg-member? h (list "<" "<=" ">" ">=" "==" "!="))
            (string-append "(" (sub (car args)) " " h " " (sub (cadr args)) ")"))
           ((kg-member? h (list "and" "or" "&&" "||"))
            (let ((and? (kg-member? h (list "and" "&&")))) (let loop ((acc (sub (car args))) (xs (cdr args)))
              (if (null? xs) acc
                  (let ((b (kt-expr (car xs) env c (kt-and g (if and? acc (kt-negate acc))))))
                    (loop (string-append "(" acc (if and? " & " " | ") b ")") (cdr xs)))))))
           ((equal? h "not") (kt-negate (sub (car args))))
           ((equal? h "ref")
            (string-append "tl.load(" (sub (car args)) " + (" (sub (cadr args)) ")"
                           (if g (string-append ", mask=" g ", other=0") "") ")"))
           ((equal? h "cast")
            (let ((tt (kir-ty (car args))) (x (cadr args)))
              (cond ((and (number? x) (kg-float? tt)) (kir-float-text x))
                    ((and (integer? x) (kg-int? tt)) (number->string x))
                    (else (string-append "(" (sub x) ").to(" (kt-dtype tt) ")")))))
           ((equal? h "?")
            (let ((cc (sub (car args))))
              (string-append "tl.where(" cc ", " (kt-expr (cadr args) env c (kt-and g cc)) ", "
                             (kt-expr (car (cddr args)) env c (kt-and g (kt-negate cc))) ")")))
           ((equal? h "sqrt") (string-append "tl.sqrt(" (sub (car args)) ")"))
           ((equal? h "exp") (string-append "tl.exp(" (sub (car args)) ")"))
           ((equal? h "log") (string-append "tl.log(" (sub (car args)) ")"))
           ((equal? h "fabs") (string-append "tl.abs(" (sub (car args)) ")"))
           ((equal? h "fmax") (string-append "tl.maximum(" (sub (car args)) ", " (sub (cadr args)) ")"))
           ((equal? h "fmin") (string-append "tl.minimum(" (sub (car args)) ", " (sub (cadr args)) ")"))
           ((equal? h "call") (string-append (kir-name (car args)) "(" (kir-join (map sub (cdr args)) ", ") ")"))
           (else (kt-fail (string-append "unknown expression form " h)))))))))

(define (kt-block stmts env c ind)
  (let loop ((xs stmts) (env env) (c c))
    (if (null? xs) env
        (let* ((s (car xs)) (r (kt-stmt s env c ind)))
          (loop (cdr xs) (car r) (cdr r))))))
; a block that must produce at least one Python statement
(define (kt-body stmts env c ind)
  (let ((n (length *kt-lines*)))
    (kt-block stmts env c ind)
    (if (= n (length *kt-lines*)) (kt! ind "pass"))))

; returns (env . ctx): kernel-level lets extend the uniform set
(define (kt-stmt s env c ind)
  (let ((h (kir-head s)) (m (kt-m c)) (g (kt-guard c)) (ex (lambda (e) (kt-expr e env c (kt-guard c)))))
    (cond
      ((equal? h "let")
       (let* ((t (kir-ty (car (cddr s)))) (v (kir-name (cadr s))) (init? (not (null? (cdr (cddr s)))))
              (init (if init? (cadr (cddr s)) #f)))
         (cond
           ((equal? (kt-mode c) "pfor")
            (kt! ind (string-append v " = tl.zeros([KIR_BLOCK], dtype=" (kt-dtype t) ")"
                                    (if init? (string-append (if (equal? t "bool") " | " " + ") (ex init)) ""))))
           ((or (not init?) (number? init) (boolean? init) (equal? (kir-head init) "f32"))
            (kt! ind (string-append v " = tl.full([], " (if init? (ex init) "0") ", " (kt-dtype t) ")")))
           (else (kt! ind (string-append v " = " (ex init)))))
         (cons (cons (list v t "var") env)
               (if (equal? (kt-mode c) "kernel")
                   (kt-ctx m (kt-mode c) (kt-mask c) (kt-dc c) (cons v (kt-uni c)))
                   c))))
      ((kg-member? h (list "set" "+=" "-=" "*=" "/="))
       (let* ((lv (cadr s))
              (e (if (equal? h "set") (car (cddr s)) (list (kg-sym (substring h 0 1)) lv (car (cddr s)))))
              (val (ex e)))
         (cond
           ((pair? lv)
            (if (not (equal? (kt-mode c) "pfor")) (kt-fail "pointer store outside pfor"))
            (kt! ind (string-append "tl.store(" (ex (cadr lv)) " + (" (ex (car (cddr lv))) "), " val
                                    (if g (string-append ", mask=" g) "") ")")))
           ((kt-dc c) (kt! ind (string-append (kir-name lv) " = tl.where(" (kt-dc c) ", " val ", " (kir-name lv) ")")))
           (else (kt! ind (string-append (kir-name lv) " = " val))))
         (cons env c)))
      ((kg-member? h (list "for" "simd-for"))
       (let* ((sp (cadr s)) (v (kir-name (car sp))) (lt (kg-loop-type sp env m))
              (bounds (cons (cadr sp) (cons (car (cddr sp)) (cdr (cddr sp))))))
         (for-each (lambda (b) (if (not (kt-uniform? b (kt-uni c)))
                                   (kt-fail (string-append "loop " v " bound " (format "~a" b)
                                                           " is not uniform across the block"))))
                   bounds)
         (kt! ind (string-append "for " v " in range(" (kir-join (map ex bounds) ", ") "):"))
         (kt-body (cddr s) (cons (list v lt "loop") env)
                  (kt-ctx m (kt-mode c) (kt-mask c) (kt-dc c) (cons v (kt-uni c))) (+ ind 1))
         (cons env c)))
      ((equal? h "pfor")
       (let* ((sp (cadr s)) (v (kir-name (car sp))) (lt (kg-loop-type sp env m)))
         (kt! ind "_pid = tl.program_id(0)")
         (kt! ind (string-append v " = " (ex (cadr sp)) " + _pid" (if (equal? lt "i64") ".to(tl.int64)" "")
                                 " * KIR_BLOCK + tl.arange(0, KIR_BLOCK)"))
         (kt! ind (string-append "_mask = " v " < " (ex (car (cddr sp)))))
         (kt-body (cddr s) (cons (list v lt "loop") env) (kt-ctx m "pfor" "_mask" #f (kt-uni c)) ind)
         (cons env c)))
      ((kg-member? h (list "if" "when"))
       (let* ((cnd (cadr s))
              (thn (if (equal? h "if") (list (car (cddr s))) (cddr s)))
              (els (if (and (equal? h "if") (not (null? (cdr (cddr s))))) (list (cadr (cddr s))) '())))
         (if (or (equal? (kt-mode c) "kernel") (and (not (kt-dc c)) (kt-uniform? cnd (kt-uni c))))
             (begin
               (kt! ind (string-append "if " (ex cnd) ":"))
               (kt-body thn env c (+ ind 1))
               (if (not (null? els)) (begin (kt! ind "else:") (kt-body els env c (+ ind 1))) #f))
             (begin
               (set! *kt-tmp* (+ *kt-tmp* 1))
               (let ((cv (string-append "_c" (number->string *kt-tmp*))))
                 (kt! ind (string-append cv " = " (ex cnd)))
                 (kt-block thn env (kt-ctx m (kt-mode c) (kt-mask c) (kt-and (kt-dc c) cv) (kt-uni c)) ind)
                 (kt-block els env (kt-ctx m (kt-mode c) (kt-mask c) (kt-and (kt-dc c) (kt-negate cv)) (kt-uni c)) ind))))
         (cons env c)))
      ((equal? h "begin") (kt-block (cdr s) env c ind) (cons env c))
      ((equal? h "return")
       (cond ((equal? (kt-mode c) "pfor") (kt-fail "return inside pfor"))
             ((kt-dc c) (kt-fail "return under a per-element condition"))
             ((null? (cdr s)) (kt! ind "return"))
             (else (kt! ind (string-append "return " (ex (cadr s))))))
       (cons env c))
      ((equal? h "expr") (kt! ind (ex (cadr s))) (cons env c))
      (else (kt-fail (string-append "unknown statement " h))))))

(define (kt-has-ref? e)
  (cond ((pair? e) (or (equal? (kir-head e) "ref") (kt-has-ref? (car e)) (kt-has-ref? (cdr e))))
        (else #f)))
(define (kt-host e params)
  (cond ((integer? e) (number->string e))
        ((not (pair? e)) (if (kg-member? (kir-name e) params) (kir-name e) (kt-fail "launcher bound uses a local")))
        (else
         (let ((h (kir-head e)) (xs (map (lambda (x) (kt-host x params)) (cdr e))))
           (cond ((kg-member? h (list "+" "-" "*")) (string-append "(" (kir-join xs (string-append " " h " ")) ")"))
                 ((equal? h "/") (string-append "(" (kir-join xs " // ") ")"))
                 ((equal? h "min") (string-append "min(" (kir-join xs ", ") ")"))
                 ((equal? h "max") (string-append "max(" (kir-join xs ", ") ")"))
                 (else (kt-fail (string-append "launcher bound uses " h))))))))

(define (kt-item it m)
  (set! *kt-lines* '())
  (let* ((name (kir-name (cadr it))) (kernel? (equal? (kir-kind it) "kernel")) (ps (kir-env-of it))
         (pnames (map car ps))
         (scalars (map car (filter (lambda (p) (not (kg-ptr? (cadr p)))) ps))))
    (if (and (not kernel?) (kt-has-ref? (kir-body it)))
        (kt-fail (string-append "func " name " uses ref (Triton helpers take loaded values, not pointers)")))
    (kt! 0 "@triton.jit")
    (kt! 0 (string-append "def " name "(" (kir-join (if kernel? (append pnames (list "KIR_BLOCK: tl.constexpr")) pnames) ", ") "):"))
    (kt-body (kir-body it) ps (kt-ctx m (if kernel? "kernel" "func") #f #f (if kernel? scalars '())) 1)
    (if kernel?
        (let* ((pf (car (filter (lambda (s) (equal? (kir-head s) "pfor")) (kir-body it))))
               (sp (cadr pf))
               (span (try (string-append "(" (kt-host (car (cddr sp)) scalars) " - " (kt-host (cadr sp) scalars) ")")
                          (catch (e) #f))))
          (if span
              (begin
                (kt! 0 "")
                (kt! 0 (string-append "def launch_" name "(" (kir-join (append pnames (list "block=256")) ", ") "):"))
                (kt! 1 (string-append "grid = (triton.cdiv(max(" span ", 0), block),)"))
                (kt! 1 (string-append "if grid[0] > 0:"))
                (kt! 2 (string-append name "[grid](" (kir-join (append pnames (list "KIR_BLOCK=block")) ", ") ")")))
              (kt! 0 (string-append "# launch " name ": grid = (cdiv(hi - lo, KIR_BLOCK),)"))))
        #f)
    (string-append (kir-join (reverse *kt-lines*) "\n") "\n")))

(define (kir->triton mod)
  (let ((mm (if (equal? (kir-kind mod) "module") mod #f)))
    (kg-check! "triton" mod #f)
    (set! *kt-tmp* 0)
    (let ((items (kir-items mod)))
      (string-append
       "# Generated by Aura std/kir-gpu (kir->triton), Issue #4802\n"
       "import triton\nimport triton.language as tl\n\n"
       (kir-join (map (lambda (it) (kt-item it mm))
                      (append (filter (lambda (x) (equal? (kir-kind x) "func")) items)
                              (filter (lambda (x) (equal? (kir-kind x) "kernel")) items)))
                 "\n\n")))))
