; Aura JSON library -- product names over C++ hot-path prims (#1440).
; Engine registers (json-parse) / (json-encode); this module re-exports
; stable names for Agent / app code. Prefer (require "std/json" all:).
;
; (json-stringify v) is the product alias of (json-encode v).

; json-parse / json-encode stay engine prims (available without require).
; json-parse refuses nesting deeper than 512 (json-parse: nesting too deep).
; A vector encodes as a JSON array, the same shape as a list (#5160).
; This module adds product helpers + (json-stringify) alias.
(export json-stringify json-escape json-value c2s json-arr-items json-obj-items)

(define (c2s c) (list->string (list c)))

; ── Product alias for encode ──
(define (json-stringify v) (json-encode v))

; ── json-escape -- interior of a JSON string (no surrounding quotes) ──
; Delegates to json-encode so the escape table cannot drift from the
; engine. json-encode wraps the string in quotes; this strips them.
; Quotes, backslashes, and every control character < 0x20 (\b \f \n \r
; \t, otherwise \u00XX) are escaped. json-obj-items / json-arr-items
; call this for object keys.
(define (json-escape s)
  (let ((enc (json-encode s)))
    (substring enc 1 (- (string-length enc) 1))))

; ── json-value -- value → JSON string (uses builtin json-encode) ─
(define (json-value v) (json-stringify v))

; ── json-arr-items / json-obj-items -- kept for backward compat ──
(define (json-arr-items lst json-fn)
  (if (null? lst) "" (string-append (json-fn (car lst)) (if (null? (cdr lst)) "" (string-append (c2s 44) (json-arr-items (cdr lst) json-fn))))))

(define (json-obj-items h keys json-fn)
  (if (null? keys) "" (string-append (c2s 34) (json-escape (car keys)) (c2s 34) (c2s 58) (json-fn (hash-ref h (car keys))) (if (null? (cdr keys)) "" (string-append (c2s 44) (json-obj-items h (cdr keys) json-fn))))))
