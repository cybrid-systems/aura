; Aura Testing Framework
;
; The only L1 API (#5224). Append one independent case to a theme file.
; The case body is the caller's own forms (hygienic splice), not a
; test-suite quote, so data_to_flat is not on this path. A failure is
; reported and the rest of the file still runs. (test-finish) then
; exits non-zero when any selected case failed.
;
;   (require "std/test" all:)
;   (test-file "string.aura")
;   (test-case "join-empty" (hash "issue" 5185 "tags" (list "string"))
;     (check= "" (string-join (list) " ")))
;   (test-case "join-one" (hash)
;     (check= "a" (string-join (list "a") ",")))
;   (test-finish)
;
; The second argument is a metadata hash. (hash) means no issue and no
; tags. Put locals in let. A define in a case is visible to later cases.
;
; Report line: string.aura:join-empty (#5185) FAILED
; plus `expected:` / `actual:` lines. Other cases each print PASS or FAILED.
;
; Run a subset (unset means all):
;   AURA_TEST_CASE=join-empty
;   AURA_TEST_ISSUE=5185
;   AURA_TEST_TAG=string
;
; (test-finish) also prints one JSON object on a line by itself:
;   {"file":"string.aura","passed":N,"failed":M,"cases":[...]}
;
; `check` / `check=` here are the case assertions (equal? values, else
; error). The kernel primitives of the same names remain what quoted
; `(test-suite ...)` bodies hit if something still calls `(run-tests)`.
; New cases should not use test-suite. std/edsl-test-harness is a shim.

; Issue #5006: `check-success` is a std function, not a kernel primitive.
; The engine registration stays for one release cycle as a deprecated alias;
; requiring this module installs the implementation that wins at call time.
(export check-success test-suite
        test-file test-case test-case-run test-finish test-record
        check check=
        test-check test-check=)
(require "std/char" all:)

; (check-success output expected) → #t | #f
;
; True when `output` contains at least one of the `expected` keywords, with
; two guards so a failure message cannot read as a success:
;   - inside error-like output a short keyword must sit on a word boundary,
;     and the five generic words (error / kind / parse / syntax / type) never
;     match;
;   - `output` must be a string and `expected` a non-empty list of strings.
; One pair of surrounding quotes on the output is ignored, so "42" and 42
; formed captures compare the same way.

(define test-generic-error-word?
  (lambda (kw)
    (or (string=? kw "error") (string=? kw "kind") (string=? kw "parse")
        (string=? kw "syntax") (string=? kw "type"))))

; [A-Za-z0-9_] — the C++ std::isalnum + underscore boundary set.
(define (test-word-char? c)
  (or (char-alphabetic? c) (char-numeric? c) (= c 95)))

(define (test-trim-quotes s)
  (let* ((n (string-length s))
         (s1 (if (and (> n 0) (or (= (string-ref s 0) 34) (= (string-ref s 0) 39)))
               (substring s 1 n)
               s))
         (n1 (string-length s1)))
    (if (and (> n1 0) (or (= (string-ref s1 (- n1 1)) 34) (= (string-ref s1 (- n1 1)) 39)))
      (substring s1 0 (- n1 1))
      s1)))

(define (test-error-like? lower)
  (or (>= (string-find lower "error:") 0)
      (>= (string-find lower "parse error") 0)
      (>= (string-find lower "unbound variable") 0)
      (>= (string-find lower "type error") 0)
      (>= (string-find lower "syntax error") 0)
      (>= (string-find lower "invalid syntax") 0)
      (>= (string-find lower "expected expression") 0)
      (and (> (string-length lower) 1)
           (= (string-ref lower 0) 40)   ; (
           (= (string-ref lower 1) 34)))) ; "

; A short keyword inside error output must be a whole word.
(define (test-word-boundary? text kw)
  (let* ((pos (string-find text kw))
         (len (string-length kw))
         (n (string-length text)))
    (and (if (> pos 0) (not (test-word-char? (string-ref text (- pos 1)))) #t)
         (if (< (+ pos len) n) (not (test-word-char? (string-ref text (+ pos len)))) #t))))

(define (check-success output expected)
  (if (or (not (string? output)) (not (pair? expected)))
    #f
    (let* ((norm (test-trim-quotes output))
           (lower (string-downcase norm))
           (err (test-error-like? lower)))
      (let loop ((xs expected))
        (cond ((null? xs) #f)
              ((not (string? (car xs))) (loop (cdr xs)))
              ((< (string-find norm (car xs)) 0) (loop (cdr xs)))
              ((and err (<= (string-length (car xs)) 5))
               (if (or (test-generic-error-word? (car xs))
                       (not (test-word-boundary? norm (car xs))))
                 (loop (cdr xs))
                 #t))
              (else #t))))))

; ── Immediate cases (#5224). Framework counters are not case state. ──

(define *test-file* "suite.aura")
(define *test-passed* 0)
(define *test-failed* 0)
(define *test-skipped* 0)
(define *test-log* '())
(define *test-expected* "?")
(define *test-actual* "?")

(define (test-file name)
  (set! *test-file* name)
  name)

(define (test-env-string key)
  (let ((v (try (getenv key) (catch (e) #f))))
    (if (and (string? v) (> (string-length v) 0)) v #f)))

(define (test-tag-member? tag tags)
  (let loop ((xs tags))
    (cond ((not (pair? xs)) #f)
          ((and (string? (car xs)) (string=? (car xs) tag)) #t)
          (else (loop (cdr xs))))))

(define (test-selected? name issue tags)
  (let ((want-name (test-env-string "AURA_TEST_CASE"))
        (want-issue (test-env-string "AURA_TEST_ISSUE"))
        (want-tag (test-env-string "AURA_TEST_TAG")))
    (and (or (not want-name) (string=? want-name name))
         (or (not want-issue)
             (and (number? issue) (string=? want-issue (number->string issue))))
         (or (not want-tag) (test-tag-member? want-tag tags)))))

(define (test-show-case name issue status)
  (display *test-file*)
  (display ":")
  (display name)
  (if (number? issue)
      (begin (display " (#") (display issue) (display ")"))
      #f)
  (display " ")
  (display status)
  (display "\n"))

(define (check pred)
  (if pred
      1
      (begin
        (set! *test-expected* #t)
        (set! *test-actual* pred)
        (error "check"))))

(define (check= expected actual)
  (if (equal? expected actual)
      1
      (begin
        (set! *test-expected* expected)
        (set! *test-actual* actual)
        (error "check="))))

; Stable aliases. A later (require) can bind the bare names `check` /
; `check=` (std/validate's schema checker does). Each case puts these
; back before its body. Inside a case that requires that module, call
; test-check / test-check= after the require.
(define test-check check)
(define test-check= check=)

(define (test-case-run name meta thunk)
  (let ((issue (hash-ref meta "issue" #f))
        (tags (hash-ref meta "tags" '())))
    (if (not (test-selected? name issue tags))
        (begin (set! *test-skipped* (+ *test-skipped* 1)) #f)
        (begin
          (set! *test-expected* "?")
          (set! *test-actual* "?")
          (let ((failed
                 (try
                   (begin (thunk) #f)
                   (catch (e)
                     (begin
                       (test-show-case name issue "FAILED")
                       (display "  expected: ")
                       (display *test-expected*)
                       (display "\n  actual: ")
                       (display *test-actual*)
                       (display "\n")
                       #t)))))
            (set! *test-log* (cons (list name issue (not failed)) *test-log*))
            (if failed
                (begin (set! *test-failed* (+ *test-failed* 1)) #f)
                (begin
                  (test-show-case name issue "PASS")
                  (set! *test-passed* (+ *test-passed* 1))
                  #t)))))))

; (test-case "name" meta body...)
; meta is (hash) or (hash "issue" N "tags" (list "t")).
; Hygienic: the body forms stay the caller's AST. A legacy defmacro
; would rebuild them through data_to_flat and drop define / let (#1452).
; The set! runs in the caller, so a previous case's require cannot
; leave `check` pointing at another module's function.
(define-hygienic-macro (test-case name meta . body)
  (test-case-run name meta
    (lambda ()
      (begin
        (set! check test-check)
        (set! check= test-check=)
        body))))

; Record a result without raising. edsl-test-harness uses this so a
; failed (it ...) does not force the process to exit.
(define (test-record name ok)
  (set! *test-log* (cons (list name #f ok) *test-log*))
  (if ok
      (set! *test-passed* (+ *test-passed* 1))
      (begin
        (test-show-case name #f "FAILED")
        (set! *test-failed* (+ *test-failed* 1))))
  ok)

(define (test-json-escape s)
  (let loop ((i 0) (out ""))
    (if (>= i (string-length s))
        out
        (let ((c (string-ref s i)))
          (loop (+ i 1)
                (string-append out
                  (cond ((= c 34) "\\\"")
                        ((= c 92) "\\\\")
                        ((= c 10) "\\n")
                        (else (substring s i (+ i 1))))))))))

(define (test-reverse xs)
  (let loop ((ys xs) (acc '()))
    (if (pair? ys) (loop (cdr ys) (cons (car ys) acc)) acc)))

(define (test-finish)
  (display *test-file*)
  (display ": ")
  (display *test-passed*)
  (display " passed, ")
  (display *test-failed*)
  (display " failed")
  (if (> *test-skipped* 0)
      (begin (display ", ") (display *test-skipped*) (display " skipped"))
      #f)
  (display "\n")
  (display "{\"file\":\"")
  (display (test-json-escape *test-file*))
  (display "\",\"passed\":")
  (display *test-passed*)
  (display ",\"failed\":")
  (display *test-failed*)
  (display ",\"cases\":[")
  (let loop ((rows (test-reverse *test-log*)) (first #t))
    (if (pair? rows)
        (let ((row (car rows)))
          (if first #f (display ","))
          (display "{\"name\":\"")
          (display (test-json-escape (car row)))
          (display "\",\"issue\":")
          (if (number? (car (cdr row)))
              (display (car (cdr row)))
              (display "null"))
          (display ",\"ok\":")
          (display (if (car (cdr (cdr row))) "true" "false"))
          (display "}")
          (loop (cdr rows) #f))
        #f))
  (display "]}\n")
  (if (> *test-failed* 0) (exit 1) '()))

; test-suite macro: stores check forms as quoted data for run-tests.
; (run-tests) evaluates each stored form one by one.
; Format: ("name" form1 form2 ...) as flat pair chain.
; Compatibility only. New cases use test-case (above), which does not quote.
(defmacro (test-suite name . body)
  (let ((collect-name (string-append "test:" name)))
    (list 'begin
      (list 'define collect-name
        (list 'cons name (list 'quote body)))
      collect-name)))
