; lib/std/swarm.aura — Issue #2874 / #2875 pluggable swarm control family
;
; Pure-Aura population search next to std/ant. Callers own fitness and apply;
; this module only searches parameter individuals (list of numbers / genes).
;
;   (require "std/swarm" all:)
;   (swarm:init (hash "kind" "grid" "dim" 2 "pop" 16
;                     "bounds" (list (list -5.0 5.0) (list -5.0 5.0))))
;   (swarm:step! (lambda (ind) (- 0.0 (fitness-of ind))))  ; higher better
;   (swarm:best) (swarm:population) (swarm:report) (swarm:export)
;
; kinds: "grid" | "pso" | "ant" | "abc" | "boids" | "fss"
;   grid (#2875 baseline): discrete linspace product (Unify policy-scan shape)
;   abc  (#2878): employ / onlooker / scout continuous neighborhood search
;   boids (#2879): separation / alignment / cohesion coordination
;   fss  (#2880): fish school search — feeding + collective + volitive step
; Optional: "parallel" #t → flat fiber:spawn all then join on caller (no join-in-worker)
;
; Form order (#2769): export before require.

(export swarm:init swarm:step! swarm:best swarm:population
        swarm:report swarm:export
        swarm:kind swarm:gen swarm:parallel!
        swarm:front swarm:scalarize swarm:last-errors
        swarm:archive-size
        swarm:help)

(require "std/ant" all:)
(require "std/boids" all:)

; ── Process-local swarm state ───────────────────────────────────
(define *swarm-kind* "grid")
(define *swarm-dim* 1)
(define *swarm-pop* 8)
(define *swarm-bounds* (list (list -1.0 1.0)))
(define *swarm-gen* 0)
(define *swarm-inds* (list))
(define *swarm-fits* (list))
(define *swarm-best-ind* (list))
(define *swarm-best-fit* -1000000000.0)
(define *swarm-vels* (list))
(define *swarm-pbest* (list))
(define *swarm-pbest-fit* (list))
(define *swarm-pso-w* 0.7)   ; #2877 inertia
(define *swarm-pso-c1* 1.4)  ; cognitive
(define *swarm-pso-c2* 1.4)  ; social
(define *swarm-parallel* #f)
(define *swarm-seed* 424242)
(define *swarm-bins* 8) ; grid discrete bins per dim
(define *swarm-grid-full* (list)) ; full discrete grid (kind:grid)
(define *swarm-grid-cursor* 0)    ; window start into *swarm-grid-full*
; kind:ant (#2876) — mutation-type ranking, not continuous bins
(define *swarm-ant-ops* (list))   ; candidate operator type names
(define *swarm-ant-evap* 0.95)    ; evaporation rho per step (1.0 = off)
; kind:abc (#2878) — artificial bee colony
(define *swarm-abc-trials* (list)) ; trial counters per food source
(define *swarm-abc-limit* 5)       ; abandon after this many fails
(define *swarm-abc-neighbor* "gaussian") ; or "classic"
; kind:boids (#2879) — flocking weights
(define *swarm-boids-sep* 1.0)
(define *swarm-boids-align* 0.5)
(define *swarm-boids-cohere* 0.3)
(define *swarm-boids-radius* 0.5)
; kind:fss (#2880) — fish school search
(define *swarm-fss-step* 0.1)       ; base individual swim step (fraction of span)
(define *swarm-fss-volitive* 1.0)   ; exploratory scale (expands on stagnation)
(define *swarm-fss-weights* (list)) ; feeding weights per fish
(define *swarm-fss-prev-sum* -1000000000.0)
(define *swarm-fss-vol-min* 0.25)
(define *swarm-fss-vol-max* 4.0)
(define *swarm-boids-max-speed* 0.25)
; multi-objective (#4740) — vector fitness + bounded Pareto archive
(define *swarm-objectives* 0)      ; 0 = scalar fitness
(define *swarm-directions* (list)) ; "max" | "min" per objective
(define *swarm-weights* (list))    ; optional scalarization weights
(define *swarm-archive* (list))    ; non-dominated entries (hash, see insert)
(define *swarm-archive-max* 64)    ; archive cap (crowding-distance trim)
(define *swarm-best-fit-raw* (list)) ; raw (vector) fitness at the best
(define *swarm-hv-ref* (list))     ; hypervolume reference point (optional)
; bounded / isolated parallel evaluation (#4741)
(define *swarm-parallel-opts* #f)  ; #f = legacy flat fanout, hash = bounded
(define *swarm-last-errors* (list)) ; (index . message) of failed individuals

; ── Tiny PRNG (inline; avoid std/random internal-define footgun) ──
(define (swarm-rand!)
  (set! *swarm-seed*
        (modulo (+ (* *swarm-seed* 1103515245) 12345) 2147483647))
  *swarm-seed*)

(define (swarm-rand-float!)
  (/ (swarm-rand!) 2147483647.0))

(define (swarm-rand-range! lo hi)
  (+ lo (* (swarm-rand-float!) (- hi lo))))

(define (swarm-rand-int! n)
  (if (<= n 1) 0 (modulo (swarm-rand!) n)))

; ── List helpers (iterative where hot) ──────────────────────────
(define (swarm-list-ref lst i)
  (let loop ((xs lst) (k i))
    (if (null? xs) #f
      (if (= k 0) (car xs) (loop (cdr xs) (- k 1))))))

(define (swarm-list-set lst i val)
  (if (null? lst) (list)
    (if (= i 0) (cons val (cdr lst))
      (cons (car lst) (swarm-list-set (cdr lst) (- i 1) val)))))

(define (swarm-map f lst)
  (if (null? lst) (list)
    (cons (f (car lst)) (swarm-map f (cdr lst)))))

(define (swarm-length lst)
  (let loop ((xs lst) (n 0))
    (if (null? xs) n (loop (cdr xs) (+ n 1)))))

(define (swarm-iota n)
  (let loop ((i 0) (acc (list)))
    (if (>= i n) (reverse acc) (loop (+ i 1) (cons i acc)))))

(define (swarm-max a b) (if (> a b) a b))
(define (swarm-min a b) (if (< a b) a b))
(define (swarm-abs x) (if (< x 0.0) (- 0.0 x) x))

(define (swarm-bound-for d)
  (let ((b *swarm-bounds*))
    (if (null? b) (list -1.0 1.0)
      (if (< d (swarm-length b))
          (swarm-list-ref b d)
          (car b)))))

(define (swarm-clip x lo hi)
  (if (< x lo) lo (if (> x hi) hi x)))

; ── Individual construction ─────────────────────────────────────
(define (swarm-rand-ind)
  (let loop ((d 0) (acc (list)))
    (if (>= d *swarm-dim*) (reverse acc)
      (let ((bh (swarm-bound-for d)))
        (loop (+ d 1)
              (cons (swarm-rand-range! (car bh) (car (cdr bh))) acc))))))

(define (swarm-zero-ind)
  (let loop ((d 0) (acc (list)))
    (if (>= d *swarm-dim*) (reverse acc)
      (loop (+ d 1) (cons 0.0 acc)))))

(define (swarm-rand-vel)
  (let loop ((d 0) (acc (list)))
    (if (>= d *swarm-dim*) (reverse acc)
      (let* ((bh (swarm-bound-for d))
             (span (- (car (cdr bh)) (car bh)))
             (v (swarm-rand-range! (- 0.0 (* 0.1 span)) (* 0.1 span))))
        (loop (+ d 1) (cons v acc))))))

; ant: discrete genes 0..bins-1
(define (swarm-rand-genes)
  (let loop ((d 0) (acc (list)))
    (if (>= d *swarm-dim*) (reverse acc)
      (loop (+ d 1) (cons (swarm-rand-int! *swarm-bins*) acc)))))

(define (swarm-genes->ind genes)
  (let loop ((d 0) (gs genes) (acc (list)))
    (if (null? gs) (reverse acc)
      (let* ((bh (swarm-bound-for d))
             (lo (car bh))
             (hi (car (cdr bh)))
             (g (car gs))
             (t (/ (+ g 0.5) *swarm-bins*))
             (x (+ lo (* t (- hi lo)))))
        (loop (+ d 1) (cdr gs) (cons x acc))))))

; ── Fitness evaluation (optional flat fiber fanout) ─────────────
; #4740: a fitness is a number (scalar) or a list of objectives.
(define (swarm-eval-one fitness-fn ind)
  (let ((f (fitness-fn ind)))
    (if (number? f) f
      (if (list? f) f -1000000000.0))))

; ── Multi-objective helpers (#4740) ─────────────────────────────
(define (swarm-dir-sign dirs i)
  (let ((d (swarm-list-ref dirs i)))
    (if (and (string? d) (string=? d "min")) -1.0 1.0)))

; (swarm:scalarize fit [weights [directions]]) — weighted sum in
; MAXIMIZE space (a "min" objective is negated). Scalars pass through.
(define (swarm:scalarize fit . rest)
  (if (not (list? fit))
      (if (number? fit) fit -1000000000.0)
    (let* ((weights (if (and (not (null? rest)) (list? (car rest)))
                        (car rest) *swarm-weights*))
           (dirs (if (and (not (null? rest)) (not (null? (cdr rest)))
                          (list? (car (cdr rest))))
                     (car (cdr rest)) *swarm-directions*)))
      (let loop ((ds dirs) (fs fit) (i 0) (s 0.0))
        (if (null? fs) s
          (let* ((sign (swarm-dir-sign ds 0))
                 (w (let ((ww (swarm-list-ref weights i)))
                      (if (number? ww) ww 1.0)))
                 (v (car fs)))
            (loop (if (null? ds) ds (cdr ds)) (cdr fs) (+ i 1)
                  (+ s (* w sign (if (number? v) v 0.0))))))))))

; Scalar guidance score for any fitness shape (internal).
(define (swarm-score fit)
  (if (number? fit) fit
    (if (list? fit) (swarm:scalarize fit) -1000000000.0)))

; Fitness vector → MAXIMIZE space (min objectives negated) (#4740).
(define (swarm-vec-max fit)
  (let loop ((d 0) (xs fit) (acc (list)))
    (if (null? xs) (reverse acc)
      (loop (+ d 1) (cdr xs)
            (cons (* (swarm-dir-sign *swarm-directions* d)
                     (if (number? (car xs)) (car xs) 0.0))
                  acc)))))

(define (swarm-vec= a b)
  (let loop ((xs a) (ys b))
    (cond ((or (null? xs) (null? ys)) #t)
          ((= (car xs) (car ys)) (loop (cdr xs) (cdr ys)))
          (#t #f))))

(define (swarm-dominates? a b)
  ; a dominates b: >= in every objective and > in at least one.
  (let loop ((xs a) (ys b) (strict #f))
    (cond ((or (null? xs) (null? ys)) strict)
          ((< (car xs) (car ys)) #f)
          ((> (car xs) (car ys)) (loop (cdr xs) (cdr ys) #t))
          (#t (loop (cdr xs) (cdr ys) strict)))))

(define (swarm-archive-has-max? mv entries)
  (if (null? entries) #f
    (if (swarm-vec= (hash-ref (car entries) "max") mv) #t
      (swarm-archive-has-max? mv (cdr entries)))))

(define (swarm-archive-dominated? mv entries)
  (if (null? entries) #f
    (if (swarm-dominates? (hash-ref (car entries) "max") mv) #t
      (swarm-archive-dominated? mv (cdr entries)))))

; Crowding distance over the archive (sum of per-objective neighbor gaps).
(define (swarm-crowding-dist entries)
  (let ((n (swarm-length entries)))
    (if (< n 3) (let loop ((k 0) (acc (list)))
                  (if (>= k n) (reverse acc) (loop (+ k 1) (cons 1000000000.0 acc))))
      (let loop ((d 0) (dist (swarm-abc-zeros n)))
        (if (>= d *swarm-objectives*) dist
          (let* ((idx (let iloop ((k 0) (acc (list)))
                        (if (>= k n) (reverse acc) (iloop (+ k 1) (cons k acc)))))
                 (sorted (swarm-sort-by-obj idx entries d))
                 (vals (swarm-map (lambda (k) (swarm-list-ref (hash-ref (swarm-list-ref entries k) "max") d)) sorted))
                 (lo (let vloop ((xs vals) (m (car vals)))
                       (if (null? xs) m (vloop (cdr xs) (swarm-min m (car xs))))))
                 (hi (let vloop ((xs vals) (m (car vals)))
                       (if (null? xs) m (vloop (cdr xs) (swarm-max m (car xs))))))
                 (span (- hi lo)))
            (if (<= span 0.0) (loop (+ d 1) dist)
              (let* ((n1 (swarm-length sorted))
                     (d1 (swarm-set-add dist (car sorted) 1000000000.0))
                     (d2 (swarm-set-add d1 (swarm-list-ref sorted (- n1 1)) 1000000000.0)))
                (let inner ((k 1) (acc d2))
                  (if (>= k (- n1 1)) (loop (+ d 1) acc)
                    (let* ((prev (swarm-list-ref vals (- k 1)))
                           (next (swarm-list-ref vals (+ k 1)))
                           (cur (swarm-list-ref dist (swarm-list-ref sorted k)))
                           (gap (/ (- next prev) span)))
                      (inner (+ k 1)
                             (swarm-set-add acc (swarm-list-ref sorted k) (+ cur gap))))))))))))))

(define (swarm-set-add lst i delta)
  (swarm-list-set lst i (+ (swarm-list-ref lst i) delta)))

; Insertion sort of indices by objective d (ascending).
(define (swarm-sort-by-obj idx entries d)
  (let insert-all ((xs idx) (acc (list)))
    (if (null? xs) acc
      (let ((x (car xs)))
        (insert-all (cdr xs)
                    (let insert ((ys acc))
                      (cond
                        ((null? ys) (list x))
                        ((<= (swarm-list-ref (hash-ref (swarm-list-ref entries x) "max") d)
                             (swarm-list-ref (hash-ref (swarm-list-ref entries (car ys)) "max") d))
                         (cons x ys))
                        (#t (cons (car ys) (insert (cdr ys)))))))))))

; Trim the archive to its cap by dropping the least-crowded entry.
(define (swarm-archive-trim!)
  (let loop ((n (swarm-length *swarm-archive*)))
    (if (<= n *swarm-archive-max*) *swarm-archive*
      (let* ((dists (swarm-crowding-dist *swarm-archive*))
             (drop (let iloop ((k 0) (bi 0) (bv 1000000000.0))
                     (if (>= k n) bi
                       (let ((v (swarm-list-ref dists k)))
                         (if (< v bv) (iloop (+ k 1) k v) (iloop (+ k 1) bi bv)))))))
        (set! *swarm-archive*
              (let drop-loop ((es *swarm-archive*) (i 0) (acc (list)))
                (if (null? es) (reverse acc)
                  (if (= i drop) (drop-loop (cdr es) (+ i 1) acc)
                    (drop-loop (cdr es) (+ i 1) (cons (car es) acc))))))
        (loop (- n 1))))))

; Non-dominated insert (#4740). A scalar fitness never enters the archive.
(define (swarm-archive-insert! ind fit)
  (if (or (not (list? fit)) (< *swarm-objectives* 1))
      #f
    (let ((mv (swarm-vec-max fit)))
      (if (or (swarm-archive-dominated? mv *swarm-archive*)
              (swarm-archive-has-max? mv *swarm-archive*))
          #f
        (begin
          (set! *swarm-archive*
                (let loop ((es *swarm-archive*) (acc (list)))
                  (if (null? es) (reverse acc)
                    (if (swarm-dominates? mv (hash-ref (car es) "max"))
                        (loop (cdr es) acc)
                      (loop (cdr es) (cons (car es) acc))))))
          (set! *swarm-archive*
                (cons (hash "ind" ind "fitness" fit "max" mv
                            "scalar" (swarm:scalarize fit))
                      *swarm-archive*))
          (swarm-archive-trim!)
          #t)))))

; Register every evaluated candidate in the archive (kept generation-best
; view is orthogonal: the archive accumulates across generations).
(define (swarm-archive-record! inds fits)
  (if (< *swarm-objectives* 1) #f
    (let loop ((is inds) (fs fits))
      (if (or (null? is) (null? fs)) #t
        (begin
          (swarm-archive-insert! (car is) (car fs))
          (loop (cdr is) (cdr fs)))))))

(define (swarm:front) *swarm-archive*)
; Per-individual failures from the last bounded/isolated wave (#4741):
; a list of (index . message) pairs, most recent first.
(define (swarm:last-errors) *swarm-last-errors*)
(define (swarm:archive-size) (swarm-length *swarm-archive*))

; Hypervolume of the archive in MAXIMIZE space. Exact for 2 objectives;
; 0.0 (documented) for other arities.
(define (swarm-hv-ref-point)
  (if (and (list? *swarm-hv-ref*) (= (swarm-length *swarm-hv-ref*) *swarm-objectives*) (> *swarm-objectives* 1))
      *swarm-hv-ref*
    ;; default: a point strictly BELOW the front's lower-left corner in
    ;; maximize space — min observed minus a 10% margin (or 1.0 when the
    ;; objective has no spread), so a non-degenerate front scores > 0.
    (let loop ((d 0) (acc (list)))
      (if (>= d *swarm-objectives*) (reverse acc)
        (let* ((mn (let iloop ((es *swarm-archive*) (m 0.0) (first #t))
                     (if (null? es) m
                       (let ((v (swarm-list-ref (hash-ref (car es) "max") d)))
                         (iloop (cdr es) (if first v (swarm-min m v)) #f)))))
               (mx (let iloop ((es *swarm-archive*) (m 0.0) (first #t))
                     (if (null? es) m
                       (let ((v (swarm-list-ref (hash-ref (car es) "max") d)))
                         (iloop (cdr es) (if first v (swarm-max m v)) #f)))))
               (span (- mx mn))
               (margin (if (> span 0.0) (* 0.1 span) 1.0)))
          (loop (+ d 1) (cons (- mn margin) acc)))))))

(define (swarm-hypervolume)
  (if (not (= *swarm-objectives* 2)) 0.0
    (let* ((ref (swarm-hv-ref-point))
           (r1 (car ref))
           (r2 (car (cdr ref)))
           (pts (let loop ((es *swarm-archive*) (acc (list)))
                  (if (null? es) (reverse acc)
                    (let ((m (hash-ref (car es) "max")))
                      (loop (cdr es) (cons m acc))))))
           ;; descending by first objective
           (sorted (let insert-all ((xs pts) (acc (list)))
                     (if (null? xs) acc
                       (let ((x (car xs)))
                         (insert-all (cdr xs)
                                     (let insert ((ys acc))
                                       (cond
                                         ((null? ys) (list x))
                                         ((>= (car x) (car (car ys))) (cons x ys))
                                         (#t (cons (car ys) (insert (cdr ys))))))))))))
      ; Strip sweep: walk points high-x → low-x; between two x values the
      ; region spans the best y seen so far.
      (let loop ((ps sorted) (prev #f) (seen r2) (hv 0.0))
        (if (null? ps) hv
          (let* ((pt (car ps))
                 (x (car pt))
                 (y (car (cdr pt))))
            (if (or (<= x r1) (<= y r2))
                (loop (cdr ps) prev seen hv)
              (if prev
                  (loop (cdr ps) x (swarm-max seen y)
                        (+ hv (* (- prev x) (- seen r2))))
                  (loop (cdr ps) x (swarm-max seen y) hv)))))))))

; ── Bounded / isolated parallel evaluation (#4741) ──────────────
(define (swarm-list-take lst n)
  (let loop ((xs lst) (k n) (acc (list)))
    (if (or (= k 0) (null? xs)) (reverse acc)
      (loop (cdr xs) (- k 1) (cons (car xs) acc)))))

(define (swarm-list-append a b)
  (if (null? a) b
    (cons (car a) (swarm-list-append (cdr a) b))))

(define (swarm-eval-one-isolated fitness-fn ind isolate)
  ; #4741: the error arm must still close the overlay it opened, otherwise
  ; the body returns with a live private region and a later fiber teardown
  ; frees it twice (double free, observed on the failing-fitness AC).
  (let ((guarded
          (lambda ()
            (try
              (swarm-eval-one fitness-fn ind)
              (catch (e) (hash "swarm-error" #t "msg" "fitness-fn raised"))))))
    (if isolate
        (begin
          ;; #4715 overlay: the candidate's defines stay private to this
          ;; body and are rolled back before it returns (#4741 AC2).
          (fiber:overlay-begin)
          (let ((res (guarded)))
            (fiber:overlay-rollback)
            res))
        (guarded))))

(define (swarm-collect-results vals start onerr)
  (let loop ((vs vals) (i start) (acc (list)))
    (if (null? vs) (reverse acc)
      (let ((v (car vs)))
        (if (and (hash? v) (hash-ref v "swarm-error"))
            (begin
              (set! *swarm-last-errors*
                    (cons (cons i (hash-ref v "msg")) *swarm-last-errors*))
              (loop (cdr vs) (+ i 1)
                    (cons (if (string=? onerr "reject") #f -1000000000.0) acc)))
          (loop (cdr vs) (+ i 1) (cons v acc)))))))

; Waves of at most max-fibers concurrent bodies; every body is guarded so a
; raise becomes a per-individual record instead of aborting the step.
(define (swarm-eval-pop-bounded fitness-fn inds)
  (let* ((cfg *swarm-parallel-opts*)
         (k (let ((v (swarm-opt cfg "max-fibers" 8)))
              (if (and (number? v) (>= v 1)) v 8)))
         (isolate (swarm-opt cfg "isolate" #f))
         (onerr (let ((v (swarm-opt cfg "on-error" "reject")))
                  (if (string? v) v "reject")))
         (n (swarm-length inds)))
    (set! *swarm-last-errors* (list))
    (let wave ((i 0) (acc (list)))
      (if (>= i n) (reverse acc)
        (let* ((batch (swarm-list-take (swarm-list-drop inds i) k))
               (fids (swarm-map
                       (lambda (ind)
                         (fiber:spawn
                           (lambda ()
                             (swarm-eval-one-isolated fitness-fn ind isolate))))
                       batch))
               (vals (swarm-map (lambda (fid) (fiber:join fid)) fids)))
          (wave (+ i k) (swarm-list-append acc
                                           (swarm-collect-results vals i onerr))))))))

(define (swarm-list-drop lst n)
  (if (or (= n 0) (null? lst)) lst
    (swarm-list-drop (cdr lst) (- n 1))))

(define (swarm-eval-pop fitness-fn inds)
  (let ((fits
          (cond
            (*swarm-parallel-opts* (swarm-eval-pop-bounded fitness-fn inds))
            ((and *swarm-parallel* (not (null? inds)))
             ;; Flat fanout: spawn all on caller, join all on caller — never
             ;; fiber:join inside a worker (#2869 residual).
             (let ((fids (swarm-map
                           (lambda (ind)
                             (fiber:spawn (lambda () (swarm-eval-one fitness-fn ind))))
                           inds)))
               (swarm-map (lambda (fid) (fiber:join fid)) fids)))
            (#t (swarm-map (lambda (ind) (swarm-eval-one fitness-fn ind)) inds)))))
    (swarm-archive-record! inds fits)
    fits))

(define (swarm-argmax fits)
  (let loop ((xs fits) (i 0) (best-i 0) (best-v -10000000000.0))
    (if (null? xs) best-i
      (let ((v (swarm-score (car xs))))
        (if (> v best-v)
            (loop (cdr xs) (+ i 1) i v)
            (loop (cdr xs) (+ i 1) best-i best-v))))))

(define (swarm-note-best! inds fits)
  (let* ((bi (swarm-argmax fits))
         (bf (swarm-list-ref fits bi))
         (bs (swarm-score bf))
         (bind (swarm-list-ref inds bi)))
    ; #4740: guidance compares the scalarized score; the raw fitness
    ; (a vector under multi-objective) travels as "best-fitness".
    (if (> bs *swarm-best-fit*)
        (begin
          (set! *swarm-best-fit* bs)
          (set! *swarm-best-ind* bind)
          (set! *swarm-best-fit-raw* bf))
        #f)))

; ── Diversity (mean pairwise L1; string ops → distinct fraction) ─
(define (swarm-diversity)
  (let ((n (swarm-length *swarm-inds*)))
    (if (< n 2) 0.0
      (if (string=? *swarm-kind* "ant")
          ; unique names / n
          (let loop ((xs *swarm-inds*) (seen (list)) (u 0))
            (if (null? xs) (/ u n)
              (if (swarm-member? (car xs) seen)
                  (loop (cdr xs) seen u)
                  (loop (cdr xs) (cons (car xs) seen) (+ u 1)))))
          (let loop ((i 0) (sum 0.0) (cnt 0))
            (if (>= i n) (if (= cnt 0) 0.0 (/ sum cnt))
              (let ((ai (swarm-list-ref *swarm-inds* i)))
                (let jloop ((j (+ i 1)) (s sum) (c cnt))
                  (if (>= j n) (loop (+ i 1) s c)
                    (let* ((bj (swarm-list-ref *swarm-inds* j))
                           (d (swarm-l1 ai bj)))
                      (jloop (+ j 1) (+ s d) (+ c 1))))))))))))

(define (swarm-member? x lst)
  (if (null? lst) #f
    (if (equal? x (car lst)) #t (swarm-member? x (cdr lst)))))

(define (swarm-l1 a b)
  (if (or (not (list? a)) (not (list? b))) 0.0
    (let loop ((xs a) (ys b) (s 0.0))
      (if (or (null? xs) (null? ys)) s
        (loop (cdr xs) (cdr ys) (+ s (swarm-abs (- (car xs) (car ys)))))))))

; ── Backends ────────────────────────────────────────────────────
; grid (#2875): discrete linspace product (Unify policy-scan baseline).
; Full grid stored in *swarm-grid-full*; each step evaluates a window of
; size pop, advances cursor, keeps global best across the scan.

(define (swarm-grid-point d g bins)
  (let* ((bh (swarm-bound-for d))
         (lo (car bh))
         (hi (car (cdr bh)))
         (t (if (<= bins 1) 0.5 (/ (+ g 0.5) bins))))
    (+ lo (* t (- hi lo)))))

; bins^remaining after dim d (for row-major index decode)
(define (swarm-grid-stride d bins)
  (let loop ((k (+ d 1)) (v 1))
    (if (>= k *swarm-dim*) v
      (loop (+ k 1) (* v bins)))))

; Decode linear index i → continuous individual (row-major over dims).
(define (swarm-grid-ind-at i bins)
  (let loop ((d 0) (rest i) (coords (list)))
    (if (>= d *swarm-dim*) (reverse coords)
      (let* ((str (swarm-grid-stride d bins))
             (g (if (<= str 1) (modulo rest bins)
                  (modulo (floor (/ rest str)) bins)))
             (r (if (<= str 1) 0
                  (- rest (* g str)))))
        (loop (+ d 1) r
              (cons (swarm-grid-point d g bins) coords))))))

; Full discrete grid: product of bins per dim, capped at max-n.
(define (swarm-build-grid-full bins max-n)
  (let* ((total (let loop ((d 0) (t 1))
                  (if (>= d *swarm-dim*) t
                    (loop (+ d 1) (* t bins)))))
         (n (if (< total max-n) total max-n)))
    (let loop ((i 0) (out (list)))
      (if (>= i n) (reverse out)
        (loop (+ i 1)
              (cons (swarm-grid-ind-at i bins) out))))))

(define (swarm-grid-window start n)
  (let ((full *swarm-grid-full*)
        (flen (swarm-length *swarm-grid-full*)))
    (if (= flen 0) (list)
      (let loop ((k 0) (acc (list)))
        (if (>= k n) (reverse acc)
          (let ((idx (modulo (+ start k) flen)))
            (loop (+ k 1)
                  (cons (swarm-list-ref full idx) acc))))))))

(define (swarm-step-grid! fitness-fn)
  (let* ((fits (swarm-eval-pop fitness-fn *swarm-inds*)))
    (set! *swarm-fits* fits)
    (swarm-note-best! *swarm-inds* fits)
    ; advance window for next generation (full scan over gens)
    (let ((flen (swarm-length *swarm-grid-full*)))
      (if (= flen 0) #t
        (begin
          (set! *swarm-grid-cursor*
                (modulo (+ *swarm-grid-cursor* *swarm-pop*) flen))
          (set! *swarm-inds*
                (swarm-grid-window *swarm-grid-cursor* *swarm-pop*))
          #t)))))

; pso (#2877): classical velocity update
;   v ← w·v + c1·r1·(pbest−x) + c2·r2·(gbest−x)
;   x ← clamp(x+v, bounds)
; Defaults: w=0.7, c1=c2=1.4 (overridable via swarm:init opts).
(define (swarm-step-pso! fitness-fn)
  (let* ((fits (swarm-eval-pop fitness-fn *swarm-inds*))
         (_ (set! *swarm-fits* fits))
         (_2 (swarm-note-best! *swarm-inds* fits))
         (n (swarm-length *swarm-inds*)))
    ; update personal bests
    (let loop ((i 0))
      (if (>= i n) #t
        (let ((f (swarm-list-ref fits i))
              (pf (swarm-list-ref *swarm-pbest-fit* i)))
          (if (> f pf)
              (begin
                (set! *swarm-pbest-fit* (swarm-list-set *swarm-pbest-fit* i f))
                (set! *swarm-pbest*
                      (swarm-list-set *swarm-pbest* i
                                      (swarm-list-ref *swarm-inds* i))))
              #f)
          (loop (+ i 1)))))
    ; move particles
    (let loop ((i 0) (new-inds (list)) (new-vels (list)))
      (if (>= i n)
          (begin
            (set! *swarm-inds* (reverse new-inds))
            (set! *swarm-vels* (reverse new-vels))
            #t)
        (let* ((x (swarm-list-ref *swarm-inds* i))
               (v (swarm-list-ref *swarm-vels* i))
               (pb (swarm-list-ref *swarm-pbest* i))
               (gb *swarm-best-ind*)
               (nv (swarm-pso-vel v x pb gb))
               (nx (swarm-pso-pos x nv)))
          (loop (+ i 1) (cons nx new-inds) (cons nv new-vels)))))))

(define (swarm-pso-vel v x pb gb)
  (let ((w *swarm-pso-w*)
        (c1 *swarm-pso-c1*)
        (c2 *swarm-pso-c2*))
    (let loop ((vs v) (xs x) (ps pb) (gs gb) (acc (list)))
      (if (null? vs) (reverse acc)
        (let* ((r1 (swarm-rand-float!))
               (r2 (swarm-rand-float!))
               (vi (car vs))
               (xi (car xs))
               (pi (if (null? ps) xi (car ps)))
               (gi (if (null? gs) xi (car gs)))
               (nvi (+ (* w vi)
                       (* c1 r1 (- pi xi))
                       (* c2 r2 (- gi xi)))))
          (loop (cdr vs)
                (cdr xs)
                (if (null? ps) (list) (cdr ps))
                (if (null? gs) (list) (cdr gs))
                (cons nvi acc)))))))

(define (swarm-pso-pos x v)
  (let loop ((d 0) (xs x) (vs v) (acc (list)))
    (if (null? xs) (reverse acc)
      (let* ((bh (swarm-bound-for d))
             (nx (swarm-clip (+ (car xs) (if (null? vs) 0.0 (car vs)))
                             (car bh) (car (cdr bh)))))
        (loop (+ d 1)
              (cdr xs)
              (if (null? vs) (list) (cdr vs))
              (cons nx acc))))))

; ── FSS (#2880): fish school search ────────────────────────────
; Individual swim (local), feeding (weight ↑ on improvement),
; collective drift to weighted barycenter, volitive expand/contract
; of step scale: stagnation → larger exploration; success → contract.

(define (swarm-fss-ones n)
  (let loop ((k 0) (acc (list)))
    (if (>= k n) (reverse acc) (loop (+ k 1) (cons 1.0 acc)))))

(define (swarm-fss-sum-fits fits)
  (let loop ((xs fits) (s 0.0))
    (if (null? xs) s (loop (cdr xs) (+ s (car xs))))))

(define (swarm-fss-sum-weights)
  (let loop ((xs *swarm-fss-weights*) (s 0.0))
    (if (null? xs) s (loop (cdr xs) (+ s (car xs))))))

; Mean span across dims for step scaling.
(define (swarm-fss-mean-span)
  (let loop ((d 0) (s 0.0) (c 0))
    (if (>= d *swarm-dim*) (if (= c 0) 1.0 (/ s c))
      (let* ((bh (swarm-bound-for d))
             (span (- (car (cdr bh)) (car bh))))
        (loop (+ d 1) (+ s (if (<= span 0.0) 1.0 span)) (+ c 1))))))

; Individual movement: random-direction swim scaled by step*volitive*span.
(define (swarm-fss-swim x)
  (let* ((scale (* *swarm-fss-step* *swarm-fss-volitive* (swarm-fss-mean-span))))
    (let loop ((d 0) (xs x) (acc (list)))
      (if (null? xs) (reverse acc)
        (let* ((bh (swarm-bound-for d))
               (lo (car bh))
               (hi (car (cdr bh)))
               (delta (swarm-rand-range! (- 0.0 scale) scale))
               (nx (swarm-clip (+ (car xs) delta) lo hi)))
          (loop (+ d 1) (cdr xs) (cons nx acc)))))))

; Weighted barycenter of school.
(define (swarm-fss-barycenter)
  (let ((wsum (swarm-fss-sum-weights))
        (n (swarm-length *swarm-inds*)))
    (if (or (= n 0) (<= wsum 0.0))
        (if (= n 0) (list) (swarm-list-ref *swarm-inds* 0))
      (let loop ((d 0) (acc (list)))
        (if (>= d *swarm-dim*) (reverse acc)
          (let ((coord
                  (let iloop ((i 0) (s 0.0))
                    (if (>= i n) (/ s wsum)
                      (let* ((xi (swarm-list-ref *swarm-inds* i))
                             (wi (swarm-list-ref *swarm-fss-weights* i))
                             (xd (swarm-list-ref xi d)))
                        (iloop (+ i 1) (+ s (* wi (if xd xd 0.0)))))))))
            (loop (+ d 1) (cons coord acc))))))))

; Drift all fish a fraction toward barycenter.
(define (swarm-fss-collective! frac)
  (let ((bary (swarm-fss-barycenter))
        (n (swarm-length *swarm-inds*)))
    (let loop ((i 0) (npos (list)))
      (if (>= i n)
          (set! *swarm-inds* (reverse npos))
        (let* ((xi (swarm-list-ref *swarm-inds* i))
               (pulled
                 (let dloop ((d 0) (xs xi) (bs bary) (acc (list)))
                   (if (null? xs) (reverse acc)
                     (let* ((bh (swarm-bound-for d))
                            (lo (car bh))
                            (hi (car (cdr bh)))
                            (bi (if (null? bs) (car xs) (car bs)))
                            (nx (swarm-clip
                                  (+ (car xs) (* frac (- bi (car xs))))
                                  lo hi)))
                       (dloop (+ d 1) (cdr xs)
                              (if (null? bs) (list) (cdr bs))
                              (cons nx acc)))))))
          (loop (+ i 1) (cons pulled npos)))))))

(define (swarm-step-fss! fitness-fn)
  (let ((n (swarm-length *swarm-inds*)))
    ; ensure weights
    (if (or (null? *swarm-fss-weights*)
            (not (= (swarm-length *swarm-fss-weights*) n)))
        (set! *swarm-fss-weights* (swarm-fss-ones n))
        #f)
    ; evaluate current if needed
    (if (or (null? *swarm-fits*) (not (= (swarm-length *swarm-fits*) n)))
        (set! *swarm-fits* (swarm-eval-pop fitness-fn *swarm-inds*))
        #f)
    ; 1) Individual movement + feeding
    (let loop ((i 0))
      (if (>= i n) #t
        (let* ((xi (swarm-list-ref *swarm-inds* i))
               (fi (swarm-list-ref *swarm-fits* i))
               (xn (swarm-fss-swim xi))
               (fn (swarm-eval-one fitness-fn xn))
               (wi (swarm-list-ref *swarm-fss-weights* i)))
          (if (> fn fi)
              (begin
                (set! *swarm-inds* (swarm-list-set *swarm-inds* i xn))
                (set! *swarm-fits* (swarm-list-set *swarm-fits* i fn))
                ; feeding: weight grows with improvement
                (set! *swarm-fss-weights*
                      (swarm-list-set *swarm-fss-weights* i
                                      (swarm-min 10.0 (+ wi (+ 0.1 (- fn fi)))))))
              ; mild weight decay when no improvement
              (set! *swarm-fss-weights*
                    (swarm-list-set *swarm-fss-weights* i
                                    (swarm-max 0.1 (* wi 0.98)))))
          (loop (+ i 1)))))
    ; 2) Collective movement toward weighted barycenter
    (swarm-fss-collective! 0.15)
    ; re-eval after collective (cheap re-eval of all)
    (set! *swarm-fits* (swarm-eval-pop fitness-fn *swarm-inds*))
    (swarm-note-best! *swarm-inds* *swarm-fits*)
    ; 3) Volitive: expand exploration on stagnation, contract on success
    (let ((sumf (swarm-fss-sum-fits *swarm-fits*)))
      (if (> sumf *swarm-fss-prev-sum*)
          (set! *swarm-fss-volitive*
                (swarm-max *swarm-fss-vol-min* (* *swarm-fss-volitive* 0.9)))
          (set! *swarm-fss-volitive*
                (swarm-min *swarm-fss-vol-max* (* *swarm-fss-volitive* 1.15))))
      (set! *swarm-fss-prev-sum* sumf))
    #t))

; ── Boids (#2879): wrap std/boids pure step + fitness ───────────
(define (swarm-step-boids! fitness-fn)
  (let* ((opts (hash "sep" *swarm-boids-sep*
                     "align" *swarm-boids-align*
                     "cohere" *swarm-boids-cohere*
                     "radius" *swarm-boids-radius*
                     "max-speed" *swarm-boids-max-speed*
                     "bounds" *swarm-bounds*))
         (res (boids:step *swarm-inds* *swarm-vels* opts))
         (npos (car res))
         (nvel (car (cdr res)))
         (fits (swarm-eval-pop fitness-fn npos)))
    (set! *swarm-inds* npos)
    (set! *swarm-vels* nvel)
    (set! *swarm-fits* fits)
    (swarm-note-best! npos fits)
    #t))

; ── ABC (#2878): employed / onlooker / scout ───────────────────
; Food source = continuous individual (list of numbers). Nectar = fitness
; (higher better). Neighbor: classic ABC one-dim phi mix, or gaussian.
; After `limit` failed improvements, scout replaces with random.

(define (swarm-abc-zeros n)
  (let loop ((k 0) (acc (list)))
    (if (>= k n) (reverse acc) (loop (+ k 1) (cons 0 acc)))))

(define (swarm-abc-min-fit fits)
  (if (null? fits) 0.0
    (let loop ((xs (cdr fits)) (m (car fits)))
      (if (null? xs) m
        (loop (cdr xs) (if (< (car xs) m) (car xs) m))))))

; Shift fitness to positive weights for roulette.
(define (swarm-abc-weights fits)
  (let ((mn (swarm-abc-min-fit fits)))
    (swarm-map (lambda (f) (+ (- f mn) 0.01)) fits)))

(define (swarm-abc-roulette weights)
  (let* ((sum (let loop ((xs weights) (s 0.0))
                (if (null? xs) s (loop (cdr xs) (+ s (car xs))))))
         (r (* (swarm-rand-float!) (if (<= sum 0.0) 1.0 sum))))
    (let loop ((xs weights) (i 0) (acc 0.0))
      (if (null? xs) 0
        (let ((acc2 (+ acc (car xs))))
          (if (>= acc2 r) i
            (loop (cdr xs) (+ i 1) acc2)))))))

; Classic ABC neighbor: random dim j, random other source k, phi in [-1,1]
(define (swarm-abc-neighbor-classic x sources i)
  (let* ((dim *swarm-dim*)
         (j (swarm-rand-int! (if (<= dim 1) 1 dim)))
         (n (swarm-length sources))
         (k (let loop ((t 0))
              (let ((kk (swarm-rand-int! (if (<= n 1) 1 n))))
                (if (or (not (= kk i)) (<= n 1) (>= t 8)) kk
                  (loop (+ t 1))))))
         (xk (swarm-list-ref sources k))
         (phi (- (* 2.0 (swarm-rand-float!)) 1.0)))
    (let loop ((d 0) (xs x) (ys (if (list? xk) xk x)) (acc (list)))
      (if (null? xs) (reverse acc)
        (let* ((xi (car xs))
               (yi (if (null? ys) xi (car ys)))
               (bh (swarm-bound-for d))
               (lo (car bh))
               (hi (car (cdr bh)))
               (nv (if (= d j)
                       (swarm-clip (+ xi (* phi (- xi yi))) lo hi)
                       xi)))
          (loop (+ d 1) (cdr xs)
                (if (null? ys) (list) (cdr ys))
                (cons nv acc)))))))

; Gaussian neighbor: all dims small noise
(define (swarm-abc-neighbor-gauss x)
  (let loop ((d 0) (xs x) (acc (list)))
    (if (null? xs) (reverse acc)
      (let* ((bh (swarm-bound-for d))
             (lo (car bh))
             (hi (car (cdr bh)))
             (span (- hi lo))
             (noise (swarm-rand-range! (- 0.0 (* 0.1 span)) (* 0.1 span)))
             (nv (swarm-clip (+ (car xs) noise) lo hi)))
        (loop (+ d 1) (cdr xs) (cons nv acc))))))

(define (swarm-abc-neighbor x sources i)
  (if (string=? *swarm-abc-neighbor* "classic")
      (swarm-abc-neighbor-classic x sources i)
      (swarm-abc-neighbor-gauss x)))

; One local search on source i: try neighbor; update if better.
(define (swarm-abc-try-improve! fitness-fn i)
  (let* ((x (swarm-list-ref *swarm-inds* i))
         (f0 (swarm-list-ref *swarm-fits* i))
         (xn (swarm-abc-neighbor x *swarm-inds* i))
         (fn (swarm-eval-one fitness-fn xn))
         (tr (swarm-list-ref *swarm-abc-trials* i)))
    (if (> fn f0)
        (begin
          (set! *swarm-inds* (swarm-list-set *swarm-inds* i xn))
          (set! *swarm-fits* (swarm-list-set *swarm-fits* i fn))
          (set! *swarm-abc-trials* (swarm-list-set *swarm-abc-trials* i 0))
          #t)
        (begin
          (set! *swarm-abc-trials*
                (swarm-list-set *swarm-abc-trials* i (+ tr 1)))
          #f))))

(define (swarm-step-abc! fitness-fn)
  (let ((n (swarm-length *swarm-inds*)))
    ; ensure fitnesses current
    (if (or (null? *swarm-fits*)
            (not (= (swarm-length *swarm-fits*) n)))
        (set! *swarm-fits* (swarm-eval-pop fitness-fn *swarm-inds*))
        #f)
    (swarm-note-best! *swarm-inds* *swarm-fits*)
    ; Employed bees: each source tries one neighbor
    (let loop ((i 0))
      (if (>= i n) #t
        (begin (swarm-abc-try-improve! fitness-fn i) (loop (+ i 1)))))
    ; Onlooker bees: pop roulette-selected local searches
    (let ((w (swarm-abc-weights *swarm-fits*)))
      (let loop ((k 0))
        (if (>= k n) #t
          (let ((i (swarm-abc-roulette w)))
            (swarm-abc-try-improve! fitness-fn i)
            (loop (+ k 1))))))
    ; Scout: abandon exhausted sources
    (let loop ((i 0))
      (if (>= i n) #t
        (let ((tr (swarm-list-ref *swarm-abc-trials* i)))
          (if (> tr *swarm-abc-limit*)
              (let ((xn (swarm-rand-ind)))
                (set! *swarm-inds* (swarm-list-set *swarm-inds* i xn))
                (set! *swarm-fits*
                      (swarm-list-set *swarm-fits* i
                                      (swarm-eval-one fitness-fn xn)))
                (set! *swarm-abc-trials*
                      (swarm-list-set *swarm-abc-trials* i 0)))
              #f)
          (loop (+ i 1)))))
    (swarm-note-best! *swarm-inds* *swarm-fits*)
    #t))

; ant (#2876): mutation-type ranking via std/ant pheromone table.
; Individuals are operator type *names* (strings). Population = ranked
; (or score-sampled) ops. Fitness feedback → pheromone:update; optional
; evaporate each step. Not classical graph ACO / continuous bins.

(define (swarm-ant-default-ops)
  (list "edsl-disp-ref" "full-hash-wrap" "full-disp-bool"
        "edsl-body-wrap" "full-disp-ref" "edsl-lit-tweak" "edsl-op-swap"))

; Build population: top-k by pheromone:rank, pad by cycling if pop > |ops|.
(define (swarm-ant-population-from-rank)
  (let* ((ranked (pheromone:rank *swarm-ant-ops*))
         (n (swarm-length ranked)))
    (if (= n 0) (list)
      (let loop ((k 0) (acc (list)))
        (if (>= k *swarm-pop*) (reverse acc)
          (loop (+ k 1)
                (cons (swarm-list-ref ranked (modulo k n)) acc)))))))

; Fitness → delta: reward above mean, mild penalty below (higher better).
(define (swarm-ant-delta fit mean)
  (let ((d (- fit mean)))
    (if (> d 0.0) d -0.05)))

(define (swarm-step-ant! fitness-fn)
  ; 1) optional global evaporation
  (if (and (number? *swarm-ant-evap*) (< *swarm-ant-evap* 1.0))
      (pheromone:evaporate! *swarm-ant-evap*)
      #f)
  ; 2) order candidates by trail strength
  (set! *swarm-inds* (swarm-ant-population-from-rank))
  ; 3) evaluate fitness on each operator type (string individual)
  (let* ((fits (swarm-eval-pop fitness-fn *swarm-inds*))
         (mean (let ((n (swarm-length fits)))
                 (if (= n 0) 0.0
                   (let loop ((xs fits) (s 0.0))
                     (if (null? xs) (/ s n)
                       (loop (cdr xs) (+ s (car xs)))))))))
    (set! *swarm-fits* fits)
    (swarm-note-best! *swarm-inds* fits)
    ; 4) deposit / penalize trails from fitness feedback
    (let loop ((ops *swarm-inds*) (fs fits))
      (if (or (null? ops) (null? fs)) #t
        (begin
          (pheromone:update (car ops) (swarm-ant-delta (car fs) mean))
          (loop (cdr ops) (cdr fs)))))
    #t))

; ── Public API ──────────────────────────────────────────────────
(define (swarm:kind) *swarm-kind*)
(define (swarm:gen) *swarm-gen*)

; hash-ref missing → () which is truthy; use null? for defaults.
(define (swarm-opt opts key default)
  (let ((v (hash-ref opts key)))
    (if (null? v) default v)))

(define (swarm:parallel! flag)
  (set! *swarm-parallel* (if flag #t #f))
  *swarm-parallel*)

(define (swarm:init opts)
  (let* ((kind (swarm-opt opts "kind" "grid"))
         (dim (swarm-opt opts "dim" 1))
         ; #2877: PSO default pop=16; other kinds default 8
         (pop-default (if (string=? kind "pso") 16 8))
         (pop (swarm-opt opts "pop" pop-default))
         (bounds (swarm-opt opts "bounds" (list (list -1.0 1.0))))
         (par (swarm-opt opts "parallel" #f))
         (seed (swarm-opt opts "seed" 424242))
         (bins (swarm-opt opts "bins" 8))
         (ops (swarm-opt opts "ops" (list)))
         (evap (swarm-opt opts "evaporate" 0.95))
         (w (swarm-opt opts "w" 0.7))
         (c1 (swarm-opt opts "c1" 1.4))
         (c2 (swarm-opt opts "c2" 1.4))
         (limit (swarm-opt opts "limit" 5))
         (neighbor (swarm-opt opts "neighbor" "gaussian"))
         (sep (swarm-opt opts "sep" 1.0))
         (align (swarm-opt opts "align" 0.5))
         (cohere (swarm-opt opts "cohere" 0.3))
         (radius (swarm-opt opts "radius" 0.5))
         (max-speed (swarm-opt opts "max-speed" 0.25))
         (step (swarm-opt opts "step" 0.1))
         ; #4740 multi-objective
         (objectives (swarm-opt opts "objectives" 0))
         (directions (swarm-opt opts "directions" (list)))
         (weights (swarm-opt opts "weights" (list)))
         (archive-max (swarm-opt opts "archive-max" 64))
         (hv-ref (swarm-opt opts "hv-ref" (list))))
    (set! *swarm-kind* kind)
    (set! *swarm-dim* dim)
    (set! *swarm-pop* pop)
    (set! *swarm-bounds* bounds)
    (set! *swarm-gen* 0)
    (set! *swarm-best-fit* -1000000000.0)
    (set! *swarm-best-ind* (list))
    (set! *swarm-seed* seed)
    (set! *swarm-bins* bins)
    (set! *swarm-parallel* (if par #t #f))
    ; #4741: a hash "parallel" option selects bounded/isolated waves.
    (set! *swarm-parallel-opts* (if (hash? par) par #f))
    (set! *swarm-last-errors* (list))
    ; #4740
    (set! *swarm-objectives* (if (and (number? objectives) (>= objectives 1)) objectives 0))
    (set! *swarm-directions* (if (list? directions) directions (list)))
    (set! *swarm-weights* (if (list? weights) weights (list)))
    (set! *swarm-archive-max* (if (and (number? archive-max) (>= archive-max 1)) archive-max 64))
    (set! *swarm-hv-ref* (if (list? hv-ref) hv-ref (list)))
    (set! *swarm-archive* (list))
    (set! *swarm-best-fit-raw* (list))
    (set! *swarm-ant-evap* (if (number? evap) evap 0.95))
    (set! *swarm-pso-w* (if (number? w) w 0.7))
    (set! *swarm-pso-c1* (if (number? c1) c1 1.4))
    (set! *swarm-pso-c2* (if (number? c2) c2 1.4))
    (set! *swarm-abc-limit* (if (number? limit) limit 5))
    (set! *swarm-abc-neighbor*
          (if (string? neighbor) neighbor "gaussian"))
    (set! *swarm-boids-sep* (if (number? sep) sep 1.0))
    (set! *swarm-boids-align* (if (number? align) align 0.5))
    (set! *swarm-boids-cohere* (if (number? cohere) cohere 0.3))
    (set! *swarm-boids-radius* (if (number? radius) radius 0.5))
    (set! *swarm-boids-max-speed*
          (if (number? max-speed) max-speed 0.25))
    (set! *swarm-fss-step* (if (number? step) step 0.1))
    (set! *swarm-fss-volitive* 1.0)
    (set! *swarm-fss-prev-sum* -1000000000.0)
    (cond
      ((string=? kind "pso")
       (set! *swarm-inds*
             (let loop ((k 0) (acc (list)))
               (if (>= k pop) (reverse acc)
                 (loop (+ k 1) (cons (swarm-rand-ind) acc)))))
       (set! *swarm-vels*
             (let loop ((k 0) (acc (list)))
               (if (>= k pop) (reverse acc)
                 (loop (+ k 1) (cons (swarm-rand-vel) acc)))))
       (set! *swarm-pbest* *swarm-inds*)
       (set! *swarm-pbest-fit*
             (let loop ((k 0) (acc (list)))
               (if (>= k pop) (reverse acc)
                 (loop (+ k 1) (cons -1000000000.0 acc))))))
      ((string=? kind "abc")
       ; #2878 artificial bee colony — continuous food sources
       (set! *swarm-inds*
             (let loop ((k 0) (acc (list)))
               (if (>= k pop) (reverse acc)
                 (loop (+ k 1) (cons (swarm-rand-ind) acc)))))
       (set! *swarm-abc-trials* (swarm-abc-zeros pop))
       (set! *swarm-fits* (list)))
      ((string=? kind "boids")
       ; #2879 flocking coordination on param vectors
       (set! *swarm-inds*
             (let loop ((k 0) (acc (list)))
               (if (>= k pop) (reverse acc)
                 (loop (+ k 1) (cons (swarm-rand-ind) acc)))))
       (set! *swarm-vels*
             (let loop ((k 0) (acc (list)))
               (if (>= k pop) (reverse acc)
                 (loop (+ k 1) (cons (swarm-rand-vel) acc)))))
       (set! *swarm-fits* (list)))
      ((string=? kind "fss")
       ; #2880 fish school search
       (set! *swarm-inds*
             (let loop ((k 0) (acc (list)))
               (if (>= k pop) (reverse acc)
                 (loop (+ k 1) (cons (swarm-rand-ind) acc)))))
       (set! *swarm-fss-weights* (swarm-fss-ones pop))
       (set! *swarm-fits* (list)))
      ((string=? kind "ant")
       ; mutation-type ranking (#2876) — ops list or default pheromone types
       (pheromone:init)
       (set! *swarm-ant-ops*
             (if (and (list? ops) (not (null? ops))) ops
               (swarm-ant-default-ops)))
       ; ensure each op has a trail entry
       (let loop ((xs *swarm-ant-ops*))
         (if (null? xs) #t
           (begin
             (pheromone:update (car xs) 0.0)
             (loop (cdr xs)))))
       (set! *swarm-inds* (swarm-ant-population-from-rank))
       ; dim unused for ant individuals (strings); keep for report schema
       (set! *swarm-dim* 0))
      (#t ; grid — discrete linspace product (#2875)
       (let* ((max-n (* pop 4)) ; keep full grid modestly larger than pop
              (full (swarm-build-grid-full bins max-n)))
         (set! *swarm-grid-full* full)
         (set! *swarm-grid-cursor* 0)
         (set! *swarm-inds*
               (swarm-grid-window 0 (if (< (swarm-length full) pop)
                                        (swarm-length full)
                                        pop))))))
    (set! *swarm-fits* (list))
    *swarm-kind*))

(define (swarm:step! fitness-fn)
  (cond
    ((string=? *swarm-kind* "pso") (swarm-step-pso! fitness-fn))
    ((string=? *swarm-kind* "abc") (swarm-step-abc! fitness-fn))
    ((string=? *swarm-kind* "boids") (swarm-step-boids! fitness-fn))
    ((string=? *swarm-kind* "fss") (swarm-step-fss! fitness-fn))
    ((string=? *swarm-kind* "ant") (swarm-step-ant! fitness-fn))
    (#t (swarm-step-grid! fitness-fn)))
  (set! *swarm-gen* (+ *swarm-gen* 1))
  *swarm-gen*)

(define (swarm:best) *swarm-best-ind*)

; Issue #2875: expose current population (list of individuals).
(define (swarm:population) *swarm-inds*)

; Rejected (#f) and non-numeric entries stay out of the mean (#4740/#4741).
(define (swarm-scored-fits)
  (let loop ((xs *swarm-fits*) (acc (list)))
    (if (null? xs) (reverse acc)
      (let ((v (car xs)))
        (if (or (number? v) (list? v))
            (loop (cdr xs) (cons (swarm-score v) acc))
          (loop (cdr xs) acc))))))

(define (swarm-mean-fit)
  (let* ((fs (swarm-scored-fits))
         (n (swarm-length fs)))
    (if (= n 0) 0.0
      (let loop ((xs fs) (s 0.0))
        (if (null? xs) (/ s n)
          (loop (cdr xs) (+ s (car xs))))))))

; Stable report schema (#2875): kind, gen, best-fit, mean-fit, pop, dim,
; diversity, parallel, best (individual).
(define (swarm:report)
  (hash "kind" *swarm-kind*
        "gen" *swarm-gen*
        "best-fit" *swarm-best-fit*
        "mean-fit" (swarm-mean-fit)
        "best" *swarm-best-ind*
        "pop" *swarm-pop*
        "dim" *swarm-dim*
        "diversity" (swarm-diversity)
        "parallel" *swarm-parallel*
        ; #2880 FSS exploratory scale (1.0 for other kinds)
        "volitive" (if (string=? *swarm-kind* "fss") *swarm-fss-volitive* 1.0)
        "step" (if (string=? *swarm-kind* "fss") *swarm-fss-step* 0.0)
        ; #4740 multi-objective surface
        "objectives" *swarm-objectives*
        "best-fitness" (if (> *swarm-objectives* 0) *swarm-best-fit-raw* *swarm-best-fit*)
        "front-size" (swarm-length *swarm-archive*)
        "hypervolume" (swarm-hypervolume)
        "archive-max" *swarm-archive-max*
        ; #4741 per-individual failure record (count of last generation)
        "errors" (swarm-length *swarm-last-errors*)
        "max-fibers" (let ((v (if *swarm-parallel-opts*
                                  (swarm-opt *swarm-parallel-opts* "max-fibers" 0)
                                  0)))
                       (if (number? v) v 0))
        "isolate" (if *swarm-parallel-opts*
                      (if (swarm-opt *swarm-parallel-opts* "isolate" #f) #t #f)
                      #f)))

(define (swarm:export)
  (let ((r (swarm:report)))
    (string-append
      "{\"kind\":\"" (swarm-opt r "kind" "?") "\""
      ",\"gen\":" (number->string (swarm-opt r "gen" 0))
      ",\"best-fit\":" (number->string (swarm-opt r "best-fit" 0))
      ",\"mean-fit\":" (number->string (swarm-opt r "mean-fit" 0))
      ",\"pop\":" (number->string (swarm-opt r "pop" 0))
      ",\"dim\":" (number->string (swarm-opt r "dim" 0))
      ",\"diversity\":" (number->string (swarm-opt r "diversity" 0))
      "}")))

(define (swarm:help)
  "std/swarm (#2874 #2875 #2876 #2877 #2878 #2879 #2880 #4740 #4741): (swarm:init h) (swarm:step! fit) (swarm:best) (swarm:population) (swarm:report) (swarm:export). kinds: grid|pso|ant|abc|boids|fss. fss opts: step (base swim). report volitive expands on stagnation. abc: limit,neighbor. pso: w,c1,c2. ant: ops,evaporate. boids: sep,align,cohere. Multi-objective (#4740): fit may be a list; init opts objectives/directions/archive-max/hv-ref; (swarm:front) Pareto archive; (swarm:scalarize fit [weights [directions]]); report front-size+hypervolume. Parallel (#4741): \"parallel\" (hash \"max-fibers\" 8 \"isolate\" #t \"on-error\" \"reject\"); (swarm:last-errors).")
