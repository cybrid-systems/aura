; Aura standard string library
; Import with: (import "std/string")
;
; Issue #2770: string-split (and length-walk siblings) were non-tail
; recursive over every character → recursion depth exceeded (>700) on
; ~400-char / multi-line mailbox inputs (Hermes Phase 5). All hot
; walks below use `while` + mutable accumulators so stack is O(1).

(export string-split string-split-words string-join string-trim
        string-upcase string-downcase
        string-contains? string-prefix? string-suffix? string-replace
        string-pad-left string-pad-right string-reverse string-repeat
        string->chars chars->string string-take string-drop)

; Note: string.aura intentionally avoids requiring std/list internally.
; Module evaluation runs in isolated env; internal imports would pollute top_.

; Split string by a separator — O(n) time, O(1) stack (#2770).
; sep can be: a string (uses first char), or a char code (integer).
; Uses substring ranges (no per-char reverse of character lists).
(define (string-split s sep)
  (define sep-code (if (string? sep) (string-ref sep 0) sep))
  (define n (string-length s))
  (let ((i 0)
        (start 0)
        (result (list)))
    (while (lambda () (< i n))
      (lambda ()
        (if (= (string-ref s i) sep-code)
          (begin
            (set! result (cons (substring s start i) result))
            (set! start (+ i 1))
            (set! i (+ i 1)))
          (set! i (+ i 1)))))
    (set! result (cons (substring s start n) result))
    (reverse result)))

; Split by any whitespace (space, tab, newline) — O(1) stack (#2770).
(define (string-split-words s)
  (define (word-char? c)
    (and (> c 32) (< c 127)))
  (define n (string-length s))
  (let ((i 0)
        (start 0)
        (in-word #f)
        (result (list)))
    (while (lambda () (< i n))
      (lambda ()
        (let ((c (string-ref s i)))
          (if (word-char? c)
            (begin
              (if (not in-word)
                (begin (set! start i) (set! in-word #t)))
              (set! i (+ i 1)))
            (begin
              (if in-word
                (begin
                  (set! result (cons (substring s start i) result))
                  (set! in-word #f)))
              (set! i (+ i 1)))))))
    (if in-word
      (set! result (cons (substring s start n) result)))
    (reverse result)))

; Join list of strings with separator — iterative (#2770 residual).
; Earlier B8a let-bound recursive form still used Θ(|strs|) stack.
(define (string-join strs sep)
  (if (null? strs) ""
    (if (null? (cdr strs)) (car strs)
      (let ((result (car strs))
            (rest (cdr strs)))
        (while (lambda () (pair? rest))
          (lambda ()
            (set! result (string-append result sep (car rest)))
            (set! rest (cdr rest))))
        result))))

; Trim whitespace from both ends (ASCII space 32). Index-based O(1) stack.
(define (string-trim s)
  (define n (string-length s))
  (let ((lo 0)
        (hi n))
    (while (lambda () (and (< lo hi) (= (string-ref s lo) 32)))
      (lambda () (set! lo (+ lo 1))))
    (while (lambda () (and (> hi lo) (= (string-ref s (- hi 1)) 32)))
      (lambda () (set! hi (- hi 1))))
    (substring s lo hi)))

; Convert to upper case (ASCII only)
(define (string-upcase s)
  (define (up c)
    (if (and (>= c 97) (<= c 122))
      (- c 32)
      c))
  (list->string (map up (string->list s))))

; Convert to lower case (ASCII only)
(define (string-downcase s)
  (define (down c)
    (if (and (>= c 65) (<= c 90))
      (+ c 32)
      c))
  (list->string (map down (string->list s))))

;; ── New v2 functions ───────────────────────────────────────

; Check if string contains a substring — iterative O(1) stack (#2770).
(define (string-contains? haystack needle)
  (define hlen (string-length haystack))
  (define nlen (string-length needle))
  (if (> nlen hlen) #f
    (let ((i 0)
          (found #f))
      (while (lambda () (and (not found) (<= i (- hlen nlen))))
        (lambda ()
          (if (equal? (substring haystack i (+ i nlen)) needle)
            (set! found #t)
            (set! i (+ i 1)))))
      found)))

; Check if string starts with prefix
(define (string-prefix? s prefix)
  (define plen (string-length prefix))
  (if (> plen (string-length s)) #f
    (equal? (substring s 0 plen) prefix)))

; Check if string ends with suffix
(define (string-suffix? s suffix)
  (define slen (string-length s))
  (define suflen (string-length suffix))
  (if (> suflen slen) #f
    (equal? (substring s (- slen suflen) slen) suffix)))

; Replace all occurrences of old with new in s — iterative (#2770).
(define (string-replace s old new)
  (define slen (string-length s))
  (define olen (string-length old))
  (if (or (= olen 0) (> olen slen)) s
    (let ((i 0)
          (result ""))
      (while (lambda () (< i slen))
        (lambda ()
          (if (and (<= (+ i olen) slen)
                   (equal? (substring s i (+ i olen)) old))
            (begin
              (set! result (string-append result new))
              (set! i (+ i olen)))
            (begin
              (set! result
                    (string-append result
                                   (list->string (list (string-ref s i)))))
              (set! i (+ i 1))))))
      result)))

; Pad string to width by adding spaces on the left
(define (string-pad-left s width)
  (let ((len (string-length s)))
    (if (>= len width) s
      (string-append (make-spaces (- width len)) s))))

; Pad string to width by adding spaces on the right
(define (string-pad-right s width)
  (let ((len (string-length s)))
    (if (>= len width) s
      (string-append s (make-spaces (- width len))))))

; Make a string of n spaces (helper) — iterative (#2770).
(define (make-spaces n)
  (if (<= n 0) ""
    (let ((result "")
          (i 0))
      (while (lambda () (< i n))
        (lambda ()
          (set! result (string-append result " "))
          (set! i (+ i 1))))
      result)))

; Reverse a string
(define (string-reverse s)
  (list->string (reverse (string->list s))))

; Repeat string n times — iterative O(1) stack (#2770).
; Needed so (string-split (string-repeat "a" 5000) …) does not blow
; the recursion cap while building the input.
(define (string-repeat s n)
  (if (<= n 0) ""
    (if (= n 1) s
      (let ((result "")
            (i 0))
        (while (lambda () (< i n))
          (lambda ()
            (set! result (string-append result s))
            (set! i (+ i 1))))
        result))))

; Convert string to list of char codes
(define (string->chars s)
  (string->list s))

; Convert list of char codes to string
(define (chars->string cs)
  (list->string cs))

; Take first n characters
(define (string-take s n)
  (substring s 0 (min n (string-length s))))

; Drop first n characters
(define (string-drop s n)
  (substring s (min n (string-length s)) (string-length s)))
