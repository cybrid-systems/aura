; lib/std/evo.aura — experience layer over the evo:record! worldline (#5004)
;
; The worldline is what evo:record! (#4910) records: target / decision /
; reason / evidence. Issue #5251 makes it in-process by default — the
; bounded ring is read by (query "qr:evo-trace") and AURA_EVO_LOG is only
; the optional JSONL spill. (evo:trace opts) is the one filtered entry; its
; "source" key also adapts the other audit surfaces (mutation-audit-log,
; security-audit-trail, or a caller-held meta:audit / prop:audit entry list)
; read-only into the same hash-record shape. This module turns those
; records into arm statistics + a strategy choice and never invents
; counters: with every source off a reader returns an empty worldline.
;
; Exports
;   trace      : evo:trace evo:records
;   worldline  : evo:worldline evo:parse-line evo:parse-log
;                evo:record-count evo:keep? evo:arm-of
;   statistics : evo:arm-stats evo:arms evo:best-arm evo:mean
;   selectors  : evo:choose evo:choose-fixed evo:choose-epsilon
;                evo:choose-ucb
;   policy     : evo:policy evo:policy-select evo:policy-report
;                evo:policy-arm evo:policy-selector
;   strategy   : strategy:new strategy:active strategy:set-strategy
;                strategy:report-success strategy:escalate strategy:arms
;                strategy:best
;
; State is a value everywhere: a policy or a strategy state is a hash the
; caller threads through. No module-level selection state.
;
; Import: (require "std/evo" all:)

(export evo:records evo:trace evo:worldline evo:parse-line evo:parse-log
        evo:record-count evo:keep? evo:arm-of
        evo:arm-stats evo:arms evo:best-arm evo:mean
        evo:choose evo:choose-fixed evo:choose-epsilon evo:choose-ucb
        evo:policy evo:policy-select evo:policy-report evo:policy-arm
        evo:policy-selector
        strategy:new strategy:active strategy:set-strategy
        strategy:report-success strategy:escalate strategy:arms
        strategy:best)

(require "std/string" all:)
(require "std/list" all:)

; ── worldline ──────────────────────────────────────────────────
; (evo:log-path) is the engine primitive (#4910); #f means the log is off.

(define (evo:parse-line line)
  (if (or (not (string? line)) (string=? (string-trim line) ""))
    #f
    (try
      (let ((v (json-parse line)))
        (if (hash? v) v #f))
      (catch (e) #f))))

(define (evo:parse-log text)
  (if (not (string? text))
    (quote ())
    (let loop ((lines (string-split text "\n")) (acc (quote ())))
      (if (null? lines)
        (reverse acc)
        (let ((rec (evo:parse-line (car lines))))
          (loop (cdr lines) (if rec (cons rec acc) acc)))))))

; Issue #5251: the trace is in process by default. (query "qr:evo-trace")
; reads the bounded ring (oldest first); the JSONL file stays an optional
; spill and is merged in by record id. One entry, (evo:trace
; opts), filters on target / decision / run / gate and returns hash records —
; never "key=val" strings.

(define (evo-trace-lines text)
  ; A blank rest line is not a record; evo:parse-line drops it below.
  (if (string? text) (string-split text "\n") (quote ())))

(define (evo-trace-ring-lines)
  (let ((v (try (query "qr:evo-trace") (catch (e) (quote ())))))
    (if (list? v) v (quote ()))))

(define (evo-trace-file-lines)
  (let ((path (try (evo:log-path) (catch (e) #f))))
    (if (string? path)
      (evo-trace-lines (try (read-file path) (catch (e) "")))
      (quote ()))))

(define (evo-record-id rec)
  (let ((id (if (hash? rec) (hash-ref rec "id" #f) #f)))
    (if (string? id) id "")))

; File first (it carries the earlier runs and the same current rows in
; append order), then ring-only rows (a spill that failed). A record that
; reached both is returned once, at its first position.
(define (evo-trace-all)
  (let loop ((lines (append (evo-trace-file-lines) (evo-trace-ring-lines)))
             (seen (quote ())) (acc (quote ())))
    (if (null? lines)
      (reverse acc)
      (let ((rec (evo:parse-line (car lines))))
        (if (not rec)
          (loop (cdr lines) seen acc)
          (let ((id (evo-record-id rec)))
            (if (and (not (string=? id "")) (member id seen))
              (loop (cdr lines) seen acc)
              (loop (cdr lines)
                    (if (string=? id "") seen (cons id seen))
                    (cons rec acc)))))))))

(define (evo-trace-field rec name)
  (let ((v (hash-ref rec name #f)))
    (cond ((string? v) v)
          ((number? v) (number->string v))
          (else ""))))

; want: #f (no filter), a string (exact), or a list of strings (any of).
(define (evo-trace-want? val want)
  (cond
    ((not want) #t)
    ((string? want) (string=? val want))
    ((list? want)
     (let loop ((ws want))
       (cond ((null? ws) #f)
             ((string=? val (car ws)) #t)
             (else (loop (cdr ws))))))
    (else #f)))

; decision is an upper-case verb in the record; compare case-insensitively.
(define (evo-trace-decision? val want)
  (cond
    ((not want) #t)
    ((string? want) (string=? (string-upcase val) (string-upcase want)))
    ((list? want)
     (evo-trace-want? (string-upcase val)
                      (map (lambda (w) (if (string? w) (string-upcase w) w)) want)))
    (else #f)))

; ── read-only aggregation of the other audit surfaces (#5251) ──
; Each source keeps its own storage; this only adapts its entries into the
; same hash-record shape, with "source" naming it and "raw" left intact.

(define (evo-audit-unquote s)
  (let ((n (string-length s)))
    (if (and (>= n 2)
             (string=? (substring s 0 1) "\"")
             (string=? (substring s (- n 1) n) "\""))
      (substring s 1 (- n 1))
      s)))

; "a=1 b=\"two words\"" -> (("a" . "1") ("b" . "two words"))
(define (evo-audit-kv line)
  (let loop ((toks (string-split (string-trim line) " ")) (acc (quote ())))
    (if (null? toks)
      (reverse acc)
      (let* ((tok (car toks))
             (parts (string-split tok "=")))
        (loop (cdr toks)
              (if (< (length parts) 2)
                acc
                (cons (cons (car parts) (evo-audit-unquote (string-join (cdr parts) "=")))
                      acc)))))))

(define (evo-audit-kv-hash kv)
  (let loop ((xs kv) (h (hash)))
    (if (null? xs)
      h
      (begin
        (hash-set! h (car (car xs)) (cdr (car xs)))
        (loop (cdr xs) h)))))

(define (evo-audit-kv-ref kv key default)
  (let loop ((xs kv))
    (cond ((null? xs) default)
          ((string=? (car (car xs)) key) (cdr (car xs)))
          (else (loop (cdr xs))))))

; One `key=val` audit line (mutation-audit-log / security-audit-trail).
(define (evo-audit-line line source)
  (let* ((kv (evo-audit-kv line))
         (op (evo-audit-kv-ref kv "op" ""))
         (kind (evo-audit-kv-ref kv "kind" op))
         (denied (evo-audit-kv-ref kv "denied" "0")))
    (hash "source" source
          "kind" kind
          "target" (evo-audit-kv-ref kv "target" "")
          "decision" (if (string=? denied "1") "ROLLBACK" "KEEP")
          "reason" (evo-audit-kv-ref kv "reason" "")
          "mutation" (evo-audit-kv-ref kv "mutation_id" "")
          "fields" (evo-audit-kv-hash kv)
          "raw" line)))

; A caller-held audit entry (meta:audit / prop:audit-entries / an evo-core
; handle rows). A hash passes its own fields through.
(define (evo-audit-entry e source)
  (if (hash? e)
    (hash "source" source
          "kind" (evo-trace-field e "kind")
          "target" (evo-trace-field e "target")
          "decision" (evo-trace-field e "decision")
          "reason" (evo-trace-field e "reason")
          "raw" e)
    (hash "source" source "kind" "" "target" "" "decision" "" "reason" ""
          "raw" e)))

(define (evo-audit-source-rows source o)
  (cond
    ((string=? source "mutation-audit")
     (let ((v (try (query "query:mutation-audit-log" 20) (catch (e) (quote ())))))
       (if (list? v) (map (lambda (line) (evo-audit-line line source)) v) (quote ()))))
    ((string=? source "security")
     (let ((v (try (query "query:security-audit-trail" 20) (catch (e) (quote ())))))
       (if (list? v) (map (lambda (line) (evo-audit-line line source)) v) (quote ()))))
    ((string=? source "entries")
     (let ((v (hash-ref o "entries" (quote ()))))
       (if (list? v) (map (lambda (e) (evo-audit-entry e source)) v) (quote ()))))
    (else (quote ()))))

(define (evo-trace-match? rec want-target want-decision want-run want-gate)
  (and (evo-trace-want? (evo-trace-field rec "target") want-target)
       (evo-trace-decision? (evo-trace-field rec "decision") want-decision)
       (evo-trace-want? (evo-trace-field rec "run") want-run)
       (evo-trace-want? (evo-trace-field rec "gate") want-gate)))

; (evo:trace opts) — the one entry.
;   opts: "source" ("trace" default | "mutation-audit" | "security" |
;         "entries" with "entries" = a caller-held audit list), plus the
;         target / decision / run / gate filters. Returns hash records.
(define (evo:trace opts)
  (let* ((o (if (hash? opts) opts (hash)))
         (source (let ((s (hash-ref o "source" "trace")))
                   (if (string? s) s "trace")))
         (want-target (hash-ref o "target" #f))
         (want-decision (hash-ref o "decision" #f))
         (want-run (hash-ref o "run" #f))
         (want-gate (hash-ref o "gate" #f))
         (rows (if (string=? source "trace")
                 (evo-trace-all)
                 (evo-audit-source-rows source o))))
    (if (and (not want-target) (not want-decision) (not want-run) (not want-gate))
      rows
      (filter
        (lambda (rec)
          (evo-trace-match? rec want-target want-decision want-run want-gate))
        rows))))

(define (evo:records)
  (evo:trace (hash)))

(define (evo:worldline)
  (evo:records))

(define (evo:record-count) (length (evo:records)))
(define (evo:record-count-of records) (length records))

(define (evo:keep? rec)
  (and (hash? rec) (equal? (hash-ref rec "decision" "") "KEEP")))

(define (evo:arm-of rec)
  (if (hash? rec)
    (let ((t (hash-ref rec "target" #f)))
      (if (string? t) t "unattributed"))
    "unattributed"))

; ── statistics ─────────────────────────────────────────────────
; (evo:mean n keeps) → keep rate; n = 0 → 0.0.

(define (evo:mean n keeps)
  (if (= n 0) 0.0 (/ (* 1.0 keeps) n)))

(define (evo-arm-row arm)
  (list (cons "arm" arm) (cons "n" 0) (cons "keeps" 0)))

(define (evo-alist-row row key default)
  (let loop ((xs row))
    (if (null? xs) default
      (if (equal? (car (car xs)) key)
        (cdr (car xs))
        (loop (cdr xs))))))

(define (evo-row-set row key val)
  (cond
    ((null? row) (list (cons key val)))
    ((equal? (car (car row)) key) (cons (cons key val) (cdr row)))
    (else (cons (car row) (evo-row-set (cdr row) key val)))))

(define (evo-row-find rows arm)
  (let loop ((xs rows))
    (if (null? xs) #f
      (if (equal? (evo-alist-row (car xs) "arm" "") arm) (car xs)
        (loop (cdr xs))))))

; (evo:arm-stats records) → list of alists
;   ((("arm" . name) ("n" . attempts) ("keeps" . keeps) ("mean" . rate)) ...)
(define (evo:rows-with-mean rows)
  (map (lambda (row)
         (evo-row-set row "mean"
                      (evo:mean (evo-alist-row row "n" 0)
                                (evo-alist-row row "keeps" 0))))
       rows))

(define (evo:arm-stats records)
  (let loop ((rs records) (rows (quote ())))
    (cond
      ((null? rs) (evo:rows-with-mean (reverse rows)))
      (else
       (let* ((rec (car rs))
              (arm (evo:arm-of rec))
              (row (evo-row-find rows arm))
              (n (+ 1 (if row (evo-alist-row row "n" 0) 0)))
              (k (+ (if (evo:keep? rec) 1 0)
                    (if row (evo-alist-row row "keeps" 0) 0)))
              (base (if row row (evo-arm-row arm)))
              (next (evo-row-set (evo-row-set base "n" n) "keeps" k)))
         (loop (cdr rs)
               (if row
                 (map (lambda (r) (if (eq? r row) next r)) rows)
                 (cons next rows))))))))

(define (evo:arms records) (evo:arm-stats records))

(define (evo-best-row rows)
  (let loop ((xs (cdr rows)) (best (car rows)))
    (cond
      ((null? xs) best)
      ((> (evo-alist-row (car xs) "mean" 0.0)
          (evo-alist-row best "mean" 0.0))
       (loop (cdr xs) (car xs)))
      (else (loop (cdr xs) best)))))

(define (evo:best-arm records)
  (let ((rows (evo:arm-stats records)))
    (if (null? rows) #f (evo-alist-row (evo-best-row rows) "arm" #f))))

; ── selectors ──────────────────────────────────────────────────
; Fixed: first arm (declaration order of the worldline).
(define (evo:choose-fixed arms)
  (if (null? arms) #f (evo-alist-row (car arms) "arm" #f)))

; ε-greedy: exploit the best empirical arm; with probability ε pull a
; uniformly random arm instead. Returns (arm next-seed).
(define (evo-next-seed seed)
  (modulo (+ (* seed 1103515245) 12345) 2147483647))

(define (evo:choose-epsilon arms epsilon seed)
  (if (null? arms) (list #f seed)
    (let* ((next (evo-next-seed seed))
           (coin (/ (modulo next 10000) 10000.0))
           (pick (modulo next (length arms)))
           (chosen (if (< coin epsilon)
                     (list-ref arms pick)
                     (evo-best-row arms))))
      (list (evo-alist-row chosen "arm" #f) next))))

; UCB1: mean + sqrt(2 ln N / n); unvisited arms are tried first.
(define (evo:choose-ucb arms)
  (if (null? arms) #f
    (let* ((total (foldl (lambda (acc row)
                           (+ acc (evo-alist-row row "n" 0)))
                         0 arms))
           (unvisited (find (lambda (row) (= 0 (evo-alist-row row "n" 0))) arms)))
      (if (pair? unvisited)
        (evo-alist-row unvisited "arm" #f)
        (let ((score (lambda (row)
                       (let ((n (evo-alist-row row "n" 1)))
                         (+ (evo-alist-row row "mean" 0.0)
                            (sqrt (/ (* 2.0 (log total)) n)))))))
          (evo-alist-row (evo-best-row (map (lambda (row)
                                              (evo-row-set row "mean" (score row)))
                                            arms))
                         "arm" #f))))))

; Generic dispatch: selector is "fixed" | "epsilon" | "ucb".
(define (evo:choose selector arms . args)
  (cond
    ((string=? selector "epsilon")
     (evo:choose-epsilon arms
       (if (pair? args) (car args) 0.1)
       (if (and (pair? args) (pair? (cdr args))) (cadr args) 424242)))
    ((string=? selector "ucb") (evo:choose-ucb arms))
    (else (evo:choose-fixed arms))))

; ── policy: a value, never a module variable ───────────────────
(define (evo:policy selector records)
  (hash "selector" (if (string? selector) selector "fixed")
        "arms" (evo:arm-stats (if (pair? records) records (quote ())))
        "seed" 424242
        "pulls" 0))

(define (evo:policy-selector p) (hash-ref p "selector" "fixed"))

(define (evo:policy-arm p)
  (evo:choose (evo:policy-selector p) (hash-ref p "arms" (quote ()))
              (hash-ref p "epsilon" 0.1) (hash-ref p "seed" 424242)))

; (evo:policy-select p) → (list arm next-policy)
(define (evo:policy-select p)
  (let* ((sel (evo:policy-selector p))
         (arms (hash-ref p "arms" (quote ())))
         (choice (evo:choose sel arms
                             (hash-ref p "epsilon" 0.1)
                             (hash-ref p "seed" 424242))))
    (if (list? choice)
      (list (car choice)
            (hash-set (hash-set p "seed" (car (cdr choice))) "pulls"
                      (+ 1 (hash-ref p "pulls" 0))))
      (list choice p))))

; (evo:policy-report p arm reward) → next policy with that arm updated
(define (evo:policy-report p arm reward)
  (let* ((arms (hash-ref p "arms" (quote ())))
         (row (evo-row-find arms arm))
         (base (if row row (evo-arm-row arm)))
         (n (+ 1 (evo-alist-row base "n" 0)))
         (k (+ (if reward 1 0) (evo-alist-row base "keeps" 0)))
         (next (evo-row-set (evo-row-set base "n" n) "keeps" k))
         (rows (if row
                 (map (lambda (r) (if (eq? r row) next r)) arms)
                 (cons next arms))))
    (hash-set p "arms" (evo:rows-with-mean rows))))

; ── strategy: the four names the old engine primitives held ────
; Value-based. (strategy:active) with no state returns void, matching the
; primitive's empty answer when nothing is active.

(define (strategy:new)
  (hash "active" #f "arms" (quote ()) "escalations" 0))

(define (strategy:active . args)
  (if (null? args) (void)
    (hash-ref (car args) "active" #f)))

; Issue #5169: strategy:best-arm is not defined. strategy:best (below)
; reads the same arms and returns the arm name, or #f when there are none.
(define (strategy:set-strategy st name)
  (hash-set st "active" (if (string? name) name (strategy:best st))))

(define (strategy:arms st) (hash-ref st "arms" (quote ())))

(define (strategy:best st)
  (let ((rows (hash-ref st "arms" (quote ()))))
    (if (null? rows) #f (evo-alist-row (evo-best-row rows) "arm" #f))))

(define (strategy:report-success st arm)
  (let* ((arms (hash-ref st "arms" (quote ())))
         (row (evo-row-find arms arm))
         (base (if row row (evo-arm-row arm)))
         (n (+ 1 (evo-alist-row base "n" 0)))
         (k (+ 1 (evo-alist-row base "keeps" 0)))
         (next (evo-row-set (evo-row-set base "n" n) "keeps" k)))
    (hash-set st "arms"
              (if row
                (map (lambda (r) (if (eq? r row) next r)) arms)
                (cons next arms)))))

(define (strategy:escalate st reason)
  (hash-set (hash-set st "escalations"
                      (+ 1 (hash-ref st "escalations" 0)))
            "escalation-reason" (if (string? reason) reason "unspecified")))
