; lib/std/query.aura — query: namespace high-level Agent API
;
; Import with: (import "std/query")
; Or:        (require "std/query" all:)
;
; Issue #562: Audit + demote query: namespace. The query:*
; primitives are large (66 as of #562 ship — see
; docs/design/query-namespace-decision.md). Most need
; internal workspace access (red-line #2 of the decision
; framework) so they stay in the engine, but the
; high-level composite patterns can move to stdlib.
;
; This module provides:
;   - High-level helpers that compose query:* primitives
;     in recommended ways
;   - Discovery helpers (query:list-categories, query:help)
;   - Soft-replacement markers for primitives that ARE
;     demoted (none yet — full audit + plan in the doc)
;
; Recommended Agent pattern:
;   1. (query :node-types)             ; discover primitive namespaces
;   2. (query:help "find")             ; read the help string
;   3. (query :find name)               ; find a node by name
;   4. (query :where '(<3) (filter-call)) ; filter nodes by predicate
;
; Where each step is one engine primitive call (no stdlib
; wrapper needed — the engine primitives ARE the right API
; surface).

(export query:list-categories query:help query:help-topics
        query:nodes-with-marker query:find-by-name query:subtree
        query:defines query:defines-by-marker
        query:calls-by-marker
        query:node-marker query:ref-counts
        query:ref-mutation-id query:ref-workspace-id
        query:define-records query:define-record query:semantic-view)

; Issue #4345: (query:ref-counts node-id) — the engine registers this
; behind the stats_impl face, which has no bare-name Soft binding; the
; only call surface is (engine:metrics "query:ref-counts" args...).
; Bind the bare Soft name the docs and Aura Pad expect by delegating
; to that face.
(define (query:ref-counts node-id)
  (engine:metrics "query:ref-counts" node-id))

; Issue #5144: the StableNodeRef unpack helpers. The engine primitives
; (qr:ref-mutation-id / qr:ref-workspace-id) are retired; a serialized
; StableNodeRef is the 4-tuple (id gen mutation_id workspace_id), so the
; 3rd / 4th fields are a plain list access with the same contract: any
; non-integer argument (or the wrong arity) yields #f instead of an int.
(define (query:ref-mutation-id id gen mutation-id workspace-id)
  (if (and (integer? id) (integer? gen)
           (integer? mutation-id) (integer? workspace-id))
      mutation-id
      #f))

(define (query:ref-workspace-id id gen mutation-id workspace-id)
  (if (and (integer? id) (integer? gen)
           (integer? mutation-id) (integer? workspace-id))
      workspace-id
      #f))

; ── (query:list-categories) — list the query: sub-namespaces
;     Used for discovery by AI Agents / docs.
(define (query:list-categories)
  (list "core"            ; node / parent / children / siblings
        "stable"          ; stable-ref / node-type / children-stable
        "def-use"         ; def-use / build-index / index-stats
        "pattern"         ; pattern / pattern-index-stats
        "filter"          ; filter / find / where / tag-arity-count
        "marker"          ; by-marker / marker-stats
        "schema"          ; schema / schema-of-marker / effects
        "module"          ; module-exports
        "stats"           ; all *-stats primitives
        "observability")) ; orchestration / primitive-error etc.

; ── Issue #5249: (query:help key) — one short entry per callable query name. ──
; The table below IS the coverage contract: every name the `(query :op)`
; dispatcher can reach (the q_impls core ops, the hidden query:* primitives,
; and the dispatcher-only reads) has an entry. query:help-topics returns the
; covered names, so a test can prove coverage without copying the table.
(define *query-help-table*
  (list
    (cons "node" "Node details for a node-id/stable-ref: (children value tag kind-name).")
    (cons "children" "Child node-ids of a node, in source order.")
    (cons "children-stable" "Child stable-refs as (id . gen) pairs; pass them back after a mutate.")
    (cons "parent" "Parent node-id of a node.")
    (cons "parent-stable" "Parent as a stable-ref (id . gen).")
    (cons "find" "Name locator: every node carrying the name, definitions first. Element 0 is the definition when one exists; trailing elements are reads. Use define-lookup for definition records.")
    (cons "def-use" "(def-use name) -> (defs uses) node-id lists for a name.")
    (cons "defines" "All define node ids: (defines) or (defines name). Add :records for the program view (name kind span name-span params callers callees def-use effects stable-ref), which exposes no internal keys.")
    (cons "defines-by-marker" "Define node ids whose SyntaxMarker matches (e.g. User).")
    (cons "calls" "All call node ids: (calls) or (calls callee-name).")
    (cons "calls-by-marker" "Call node ids whose SyntaxMarker matches.")
    (cons "by-marker" "Nodes filtered by SyntaxMarker.")
    (cons "node-marker" "SyntaxMarker of a node.")
    (cons "node-type" "NodeTag of a node as a name string.")
    (cons "node-types" "Census of node kinds as ((kind . count) ...).")
    (cons "module-exports" "Exported symbols of a module.")
    (cons "schema" "Schema descriptor of a node (when one is attached).")
    (cons "stable-ref" "StableNodeRef (id . gen) for a node-id; validates before export.")
    (cons "stable-ref-provenance" "Provenance fields of a held stable-ref.")
    (cons "reaches" "(reaches name) or (reaches node-id/stable-ref) -> (defs uses) reachable from a definition.")
    (cons "effects" "(effects name) -> (callers uses defs); callers first.")
    (cons "root" "Root node-id of the workspace AST.")
    (cons "code" "Authoritative workspace source text.")
    (cons "mutation-log" "Mutation log entries, newest last.")
    (cons "mutation-provenance" "Provenance record of a mutation id.")
    (cons "last-mutation-provenance" "Provenance of the most recent mutation.")
    (cons "node-provenance" "Provenance id stamped on a node.")
    (cons "provenance-of" "Narrowing provenance of a variable name (add * for all names).")
    (cons "provenance-of*" "Every variable name that has narrowing provenance.")
    (cons "ensure-ref" "Validate/refresh a stable-ref before reuse.")
    (cons "result-fresh?" "Is a held QueryResult still fresh?")
    (cons "result-matches" "Matches of a held QueryResult.")
    (cons "ref-valid?" "Validity of a packed stable-ref.")
    (cons "type-feedback" "Recorded type feedback for a node.")
    (cons "dirty-impact" "Dirty-propagation impact set of a node.")
    (cons "dirty-subtree" "Nodes in a dirty subtree.")
    (cons "mutations-since" "Mutations after a given mutation id.")
    (cons "mutation-impact" "Impact record of a mutation.")
    (cons "filter" "Filter node-ids by predicate primitive.")
    (cons "where" "Keyword predicate used by query:filter.")
    (cons "pattern" "Match nodes by the (tag, arity) index.")
    (cons "siblings" "Sibling node-ids of a node.")
    (cons "api-reference" "List the bound primitives on this engine.")
    (cons "arena-offset" "Arena offset of the workspace.")
    (cons "fiber-backend" "Spawn backend in use.")
    (cons "auto-rollback-on-panic" "Whether a panic auto-rolls back the workspace.")
        ))

(define (query:help key)
  (let ((hit (assoc key *query-help-table*)))
    (if hit
        (cdr hit)
        (string-append "no help available for: " key))))

; Issue #5249: the names query:help covers, in table order.
(define (query:help-topics)
  (map car *query-help-table*))

; ── (query:nodes-with-marker marker) — high-level wrapper
;     around (query :by-marker marker) with safe input check.
(define (query:nodes-with-marker marker)
  (if (string? marker)
    (query :by-marker marker)
    (list)))

; ── Issue #5249: the program semantic view ──────────────────────
; (query:define-records) returns one record per definition, in source
; order. A record is a hash with these PUBLIC keys only:
;
;   name       definition name (a string)
;   kind       "Define" | "MacroDef" | "DefineType"
;   span       (line col) of the form head (the define token)
;   name-span  (line col) of the definition-name token (goto-def / rename)
;   params     parameter names, in order
;   callers    one record per call site: (caller-name line col)
;   callees    callee names called from the body
;   def-use    hash {defs: ((line col) ...), uses: ((line col) ...)}
;   effects    hash {callers: N, reads: N, writes: N} — labelled groups
;   stable-ref (id . gen) handle to pass back through mutate:*
;
; Engine metadata (schema-*/issue-*/query-result-tag and the raw matches
; spine) is never part of a record: the view is program state, not the
; QueryResult wire. Spans come from the reader, so a (define ...) inside a
; comment or a string is not a definition and produces no record.
;
; (query:define-records)  all definitions
; (query:define-record n) the records for name n (empty list when absent)
(define (query:define-records)
  (query :defines :records))

(define (query:define-record name)
  (if (string? name)
      (query :defines :records name)
      (list)))

; Alias with a program-level name; same view.
(define (query:semantic-view)
  (query:define-records))

; ── (query:find-by-name name) — high-level wrapper around
;     (query :find name) (case-sensitive string match).
(define (query:find-by-name name)
  (if (string? name)
    (query :find name)
    -1))

; ── (query:subtree root-id) — return root-id + all descendants
;     via iterative children walk. Pure stdlib (no engine
;     helpers needed beyond query:children).
(define (query:subtree root-id)
  (let loop ((queue (list root-id)) (acc (list)))
    (cond
      ((null? queue) acc)
      (else
        (let* ((current (car queue))
               (rest (cdr queue))
               (children (query :children current))
               (new-acc (cons current acc)))
          (loop (append rest children) new-acc))))))
; ── Issue #278 — high-level "all defines / all calls" wrappers ──
;     The (query :defines / calls / defines-by-marker /
;     calls-by-marker) primitives are implemented as C++
;     engine primitives (see
;     src/compiler/evaluator_primitives_query_workspace.cpp).
;     They were originally planned as Aura stdlib wrappers
;     that compose (query :by-marker) + (query :defines /
;     calls), but (define (query:foo) ...) at top level
;     inside a (require ... all:) module hits a flat-
;     evaluator closure issue (colon-prefixed names produce
;     "invalid closure" when subsequently called). Moving
;     them to C++ is cleaner + faster (single-pass walk vs
;     2-pass set intersection).
;
; The Aura-level (define (query:foo) ...) form DOES work
; for top-level imports when the name is bound through
; the require mechanism's `all:` re-export — see
; query:list-categories / query:help above. The mechanism
; routes via the module's bindings table rather than the
; flat-evaluator's local env, so the colon-name issue
; doesn't trigger. We rely on this for the existing
; wrappers; the new defines-by-marker / calls-by-marker
; primitives are C++-engine-only for now.
;
; If you want to call them through stdlib, the C++
; primitives are reachable globally (no (require ...)
; needed for engine primitives — they're bound at the
; evaluator level). The export list below is updated to
; advertise them but they ARE available without require.
