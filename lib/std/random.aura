; random.aura — Simple pseudo-random number generator
; Import with: (require "std/random" all:)
;
; Linear Congruential Generator (LCG).
; Uses integer arithmetic only — no external deps.
; Default seed: 123456789

(export
  make-random random-next random-integer random-float
  random-range random-vector shuffle random-seed)

; (make-random) → generator (a pair (seed . state))
; (make-random seed) → generator with given seed
(define (make-random . rest)
  (cons (if (null? rest) 123456789 (car rest)) 0))

; (random-next gen) → (list next-val updated-gen)
(define (random-next gen)
  (define a 1103515245)
  (define c 12345)
  (define m 2147483648)    ; 2^31
  (define seed (car gen))
  (define next (modulo (+ (* a seed) c) m))
  (list next (cons next 0)))

; (random-integer gen) → (list 0..2^31-1 updated-gen)
; Issue #5194: the argument is a generator from (make-random), not a bound.
; Passing a number used to fail as "car: not a pair" from inside random-next.
(define (random-integer gen)
  (if (not (and (pair? gen) (integer? (car gen))))
      (error "random-integer: expected a generator, e.g. (random-integer (make-random))")
      (let ((result (random-next gen)))
        (list (car result) (cadr result)))))

; (random-float gen) → (list 0.0..1.0 updated-gen)
(define (random-float gen)
  (let ((result (random-next gen)))
    (list (/ (car result) 2147483648.0) (cadr result))))

; (random-range lo hi gen) → (list lo..hi-1 updated-gen)
(define (random-range lo hi gen)
  (let ((result (random-next gen)))
    (list (+ lo (modulo (car result) (- hi lo))) (cadr result))))

; (random-vector n gen) → (list (vector of n floats) updated-gen)
; Constant stack (the iter loop is tail-recursive). The vector is freshly
; built here, so its vector-set! writes do not need Mutate (#5195).
(define (random-vector n gen)
  (let ((v (make-vector n)))
    (let iter ((i 0) (g gen))
      (if (>= i n) (list v g)
        (let ((r (random-float g)))
          (vector-set! v i (car r))
          (iter (+ i 1) (cadr r)))))))

; (shuffle lst gen) → (list shuffled-list updated-gen)
; Issue #5194: the previous Fisher-Yates-via-recursion recursed once per
; element (stack overflow above ~512 elements) and located + rebuilt the list
; for every pick, so it was O(n^2). The list is copied into a fresh vector and
; shuffled in place (backward Fisher-Yates): constant stack, O(n) swaps.
; vector-set! on a vector this call just built is not a shared-state mutation,
; so the default (Restricted) preset admits it (#5195); a vector bound into a
; workspace would still need Mutate.
(define (shuffle lst gen)
  (let ((v (list->vector lst)))
    (let loop ((i (- (vector-length v) 1)) (g gen))
      (if (<= i 0)
          (list (vector->list v) g)
          (let* ((r (random-range 0 (+ i 1) g))
                 (j (car r))
                 (g2 (cadr r))
                 (tmp (vector-ref v i)))
            (vector-set! v i (vector-ref v j))
            (vector-set! v j tmp)
            (loop (- i 1) g2))))))

; (random-seed gen) → current seed of the generator (an integer)
; Issue #5194: the module header documents every export's shape now; this one
; takes exactly one argument (the generator) and returns its seed, it does not
; set a seed.
(define (random-seed gen)
  (car gen))
