; lib/std/bus_agent_cli.aura — the `aura agent` runner (#5400)
;
; The CLI (src/cli_agent_5400.inc) parses the options into AURA_AGENT_*
; environment variables and runs this file. The loop lives here so it
; uses the same std/bus and std/llm a user script would:
;
;   planner      claim nothing; post N tasks (optionally with a contract)
;   worker       claim -> model (or deterministic mock) -> heartbeat ->
;                contract evidence -> complete/fail; drain until no task
;   supervisor   ask the host for its real CPU/memory slack and print
;                the audited worker count (no fixed cap)
;
; The mock mode never touches the network and needs no key. A real run
; reads --prompt FILE; no prompt body is hardcoded here.

(require "std/bus" all:)
(require "std/llm" all:)
(require "std/fs" all:)

(define (agent-env name fallback)
  (let ((v (getenv name)))
    (if (string? v) v fallback)))

(define (agent-env-int name fallback)
  (let ((v (agent-env name "")))
    (if (string=? v "") fallback (string->number v))))

(define (agent-say label value)
  (display label) (display "=") (display value) (newline))

(define AGENT-ROLE (agent-env-int "AURA_AGENT_ROLE" 5))
(define AGENT-WS (agent-env-int "AURA_AGENT_WORKSPACE" 8900))
(define AGENT-PATH (agent-env "AURA_AGENT_BUS_PATH" ""))
(define AGENT-LEASE (agent-env-int "AURA_AGENT_LEASE_MS" 30000))
(define AGENT-TASKS (agent-env-int "AURA_AGENT_TASKS" 4))
(define AGENT-CONTRACT (string=? (agent-env "AURA_AGENT_CONTRACT" "0") "1"))
(define AGENT-MOCK (string=? (agent-env "AURA_AGENT_MOCK" "0") "1"))
(define AGENT-REQUIREMENT (agent-env "AURA_AGENT_REQUIREMENT" ""))
(define AGENT-PROMPT (agent-env "AURA_AGENT_PROMPT" ""))

(define (agent-prompt)
  (if (string=? AGENT-PROMPT "")
    ""
    (let ((text (read-file AGENT-PROMPT)))
      (if (string? text) text ""))))

(define (agent-mock-answer id)
  ; Deterministic: the same task id always yields the same bytes, so a
  ; seeded audit timeline has a stable shape.
  (string-append "mock:" (number->string id) ":" AGENT-REQUIREMENT))

; #5441: keep the LLM failure separate from its content. The old
; "llm-error:..." string was indistinguishable from a model answer, so
; the worker completed the task instead of failing it.
(define (agent-llm-result id)
  (if AGENT-MOCK
    (list "ok" (agent-mock-answer id))
    (let ((sys (agent-prompt))
          (usr (string-append AGENT-REQUIREMENT "\ntask " (number->string id))))
      (let ((r (llm:chat sys usr)))
        (if (and (hash? r) (hash-ref r "ok" #f))
          (list "ok" (hash-ref r "content" ""))
          (list "error" (if (hash? r) (hash-ref r "error" "unknown") "unknown")))))))

(define (agent-longest-word text)
  (let loop ((words (string-split text " ")) (best ""))
    (if (null? words)
      best
      (let ((word (string-trim (car words))))
        (loop (cdr words)
              (if (> (string-length word) (string-length best)) word best))))))

; #5441: the contract evidence must come from a check, not a constant.
; A real run requires the answer to cite the requirement's longest word
; (e.g. "port ZRANGEBYSCORE" -> ZRANGEBYSCORE). Mock mode is explicitly
; unverified: it says so on stdout and still supplies the test double's
; evidence so the contract flow can be exercised offline.
(define (agent-verify answer)
  (cond
    ((not (string? answer)) (list #f 0 "answer-not-string"))
    ((string=? answer "") (list #f 0 "empty-answer"))
    (AGENT-MOCK (list #t 100 "mock-unverified"))
    (else
      (let ((key (agent-longest-word AGENT-REQUIREMENT)))
        (if (or (string=? key "")
                (string-contains? (string-downcase answer) (string-downcase key)))
          (list #t 100 (string-append "answer-cites:" key))
          (list #f 0 (string-append "answer-misses:" key)))))))

(define (agent-heartbeat-interval)
  ; A fraction of the lease: long enough not to flood the host, short
  ; enough that a slow model call never lets the lease expire.
  (max 50 (min 5000 (quotient AGENT-LEASE 3))))

(define (agent-work-with-heartbeat id work)
  (define stop? #f)
  (define failed? #f)
  (define interval (agent-heartbeat-interval))
  (define fid
    (try (fiber:spawn
           (lambda ()
             (let loop ()
               (fiber:sleep interval)
               (if stop?
                 #t
                 (let ((hb (bus:heartbeat SID id AGENT-LEASE)))
                   (if (bus:error? hb)
                     (begin (set! failed? #t) (set! stop? #t))
                     (loop)))))))
         (catch (e) 0)))
  (define result (work))
  (set! stop? #t)
  (if (and (integer? fid) (> fid 0))
    (try (fiber:join fid) (catch (e) #f))
    #f)
  (list result failed?))

(define (agent-exit code)
  (display "agent-exit=") (display code) (newline)
  (exit code))

(define attached (bus:attach AGENT-PATH AGENT-WS AGENT-ROLE 255 255))
(if (bus:error? attached)
  (begin
    (display "attach-error=")
    (display (bus:message attached))
    (newline)
    (agent-exit 1)))

(define SID (car (cdr attached)))
(agent-say "role" AGENT-ROLE)
(agent-say "workspace" AGENT-WS)

; ── planner ───────────────────────────────────────────────────────
(define (planner-run)
  (let loop ((i 0) (posted 0))
    (if (>= i AGENT-TASKS)
      (begin
        (agent-say "posted" posted)
        (bus:detach SID)
        (agent-exit 0))
      (let ((p (bus:post-task SID 0 (+ 1000 i))))
        (if (bus:error? p)
          (begin
            (display "post-error=")
            (display (bus:message p))
            (newline)
            (bus:detach SID)
            (agent-exit 1))
          (let* ((id (car (cdr p)))
                 (c (if AGENT-CONTRACT (bus:contract SID id 42 100) #f)))
            (if (and AGENT-CONTRACT (bus:error? c))
              (begin
                (display "contract-error=")
                (display (bus:message c))
                (newline)
                (bus:detach SID)
                (agent-exit 1))
              (begin
                (agent-say "task" id)
                (loop (+ i 1) (+ posted 1))))))))))

; ── worker ────────────────────────────────────────────────────────
(define (agent-fail id reason)
  (display "failed-task=") (display id) (display " reason=") (display reason) (newline)
  (let ((f (bus:fail SID id 0)))
    (if (bus:error? f)
      (begin
        (display "fail-error=") (display (bus:message f)) (newline))
      (agent-say "task-failed" id)))
  (bus:detach SID)
  (agent-exit 1))

(define (worker-run)
  (let loop ((done 0))
    (let ((c (bus:claim SID AGENT-LEASE)))
      (if (bus:error? c)
        (let ((why (bus:message c)))
          ; #5439: only an empty board is idle. A board whose open tasks
          ; are all blocked (contract/gate/budget/permission/transport)
          ; must not look like a clean drain, or the supervisor sees a
          ; healthy zero-exit worker and the work never happens.
          (if (string=? why "task-none-open")
            (begin
              (agent-say "idle" why)
              (agent-say "completed" done)
              (bus:detach SID)
              (agent-exit 0))
            (begin
              (display "claim-error=") (display why) (newline)
              (bus:detach SID)
              (agent-exit 1))))
        (let* ((id (car (cdr c)))
               (hb0 (bus:heartbeat SID id AGENT-LEASE)))
          (if (bus:error? hb0)
            (agent-fail id (string-append "heartbeat:" (bus:message hb0)))
            (let* ((work (agent-work-with-heartbeat
                           id
                           (lambda () (agent-llm-result id))))
                   (result (car work))
                   (hb-failed (car (cdr work)))
                   (status (car result))
                   (payload (car (cdr result))))
              (if hb-failed
                (agent-fail id "heartbeat-lost")
                (if (string=? status "error")
                  (agent-fail id (string-append "llm-error:" payload))
                  (let ((hb1 (bus:heartbeat SID id AGENT-LEASE)))
                    (if (bus:error? hb1)
                      (agent-fail id (string-append "heartbeat:" (bus:message hb1)))
                      (let* ((v (agent-verify payload))
                             (verified (car v))
                             (metric (car (cdr v)))
                             (vwhy (car (cdr (cdr v)))))
                        (agent-say "verify" vwhy)
                        (if (not verified)
                          (agent-fail id (string-append "verify:" vwhy))
                          (let* ((ev (bus:contract-evidence SID id 1 metric))
                                 (done-rec (bus:complete SID id (+ 100 id))))
                            (if (bus:error? done-rec)
                              (agent-fail id
                                          (string-append "complete:" (bus:message done-rec)))
                              (begin
                                (agent-say "completed-task" id)
                                (agent-say "bytes" (string-length payload))
                                (loop (+ done 1))))))))))))))))))

; ── supervisor ────────────────────────────────────────────────────
(define (supervisor-run)
  (let ((plan (bus:supervise SID)))
    (if (bus:error? plan)
      (begin
        (display "supervise-error=")
        (display (bus:message plan))
        (newline)
        (bus:detach SID)
        (agent-exit 1))
      (begin
        (agent-say "scale" (list-ref plan 1))
        (agent-say "cpu-free-pct" (list-ref plan 2))
        (agent-say "mem-free-mb" (list-ref plan 3))
        (agent-say "reason" (list-ref plan 4))
        (agent-say "open-tasks" (list-ref plan 5))
        (bus:detach SID)
        (agent-exit 0)))))

(cond
  ((= AGENT-ROLE 4) (planner-run))
  ((= AGENT-ROLE 5) (worker-run))
  ((= AGENT-ROLE 6) (supervisor-run))
  (else
    (display "role-error=unknown role ")
    (display AGENT-ROLE)
    (newline)
    (bus:detach SID)
    (agent-exit 1)))
