; ── std/mutate.aura — mutation observability + safety bridge ──
;
; Issue #278: 高层 mutation 观察 / 诊断 helpers。
; Issue #1553: 桥接 engine MutationBoundaryGuard / safe-yield / quota
;   (#1547 try_acquire+quota, #1504 safe yield, #1546 arena quota)
;   到 stdlib Agent 面。
;
; API:
;   (mutate:summary)              → alist 摘要 (:total :committed :rolled-back ...)
;   (mutate:by-operator)          → hash (operator-name → count)
;   (mutate:last-info)            → alist 上一次 mutation 的 (:id :operator :target)
;   (mutate:operator-count name)  → 某 operator 的 mutation 次数
;   (mutate:rolled-back?)         → 是否存在已 rollback 的 mutation
;   (mutate:rollback-rate)        → ratio: rolled-back / total (返回 0..100 整数 pct)
;   (mutate:boundary-depth)       → Guard nesting depth (0 = yield/steal safe)
;   (mutate:boundary-safe?)       → #t when depth==0 and not held
;   (mutate:safe-yield)           → hash (ast:yield-at-boundary / #1504)
;   (mutate:quota-ok?)            → soft resource:quota-check (fibers/memory)
;   (mutate:safety-snapshot)      → alist of boundary/yield/fiber/quota signals
;   (mutate:atomic-batch-safe ops [summary] [keyword value]...)
;                                 → refuse if not boundary-safe; else yield + batch
;                                 → forwards :snapshot? :sync-query-index?
;                                   :allow-macro? :tenant-target (#4324)
;
; 观察 helper 失败时返回安全默认值（不抛错），适合 AI Agent 在
; 长 eval loop 里调用而不会因为无 workspace 而 crash。
; mutate:atomic-batch-safe 对未知关键字和 summary 后的非关键字报错，
; 不把它们吞成 #f（#4324）。

(export mutate:summary mutate:by-operator mutate:last-info
        mutate:operator-count mutate:rolled-back?
        mutate:rollback-rate
        mutate:boundary-depth mutate:boundary-safe?
        mutate:safe-yield mutate:quota-ok?
        mutate:safety-snapshot mutate:atomic-batch-safe
        mutate:catalog mutate:catalog-count mutate:catalog-names
        mutate:catalog-entry mutate:catalog-by-granularity
        mutate:catalog-granularities mutate:catalog-gates
        mutate:catalog-fields mutate:catalog-check)

; ── mutate:summary — 完整 mutation log 摘要 ──
;
; 返回 alist:
;   ((:total . n)
;    (:committed . n)
;    (:rolled-back . n)
;    (:by-operator . <hash>)
;    (:last-mutation-id . n)
;    (:last-operator . "...")
;    (:last-target-node . n))
;
; by-operator 保留为 hash (FlatHashTable) — 用户用 hash-ref 取值。
;
(define (mutate:summary)
  (try
    (let* ((h (query "qr:mutation-log-summary"))
           (total (hash-ref h "total"))
           (committed (hash-ref h "committed"))
           (rolled (hash-ref h "rolled-back"))
           (by-op (hash-ref h "by-operator"))
           (last-id (hash-ref h "last-mutation-id"))
           (last-op (hash-ref h "last-operator"))
           (last-tgt (hash-ref h "last-target-node")))
      (list (cons ":total" total)
            (cons ":committed" committed)
            (cons ":rolled-back" rolled)
            (cons ":by-operator" by-op)
            (cons ":last-mutation-id" last-id)
            (cons ":last-operator" last-op)
            (cons ":last-target-node" last-tgt)))
    (catch (e)
      ; 失败时返回空 list — AI Agent 可以 nil-check
      (list (cons ":total" 0)
            (cons ":committed" 0)
            (cons ":rolled-back" 0)
            (cons ":by-operator" (hash))
            (cons ":last-mutation-id" 0)
            (cons ":last-operator" "")
            (cons ":last-target-node" 0)))))

; ── mutate:by-operator — 按 operator 分组的 count hash ──
;
; 返回 hash (FlatHashTable): {operator-name → count}
; 用户用 (hash-ref <hash> "operator-name") 取值。
;
(define (mutate:by-operator)
  (try
    (let* ((h (query "qr:mutation-log-summary")))
      (hash-ref h "by-operator"))
    (catch (e) (hash))))

; ── mutate:last-info — 上一次 mutation 的信息 ──
;
; 返回 alist:
;   ((:id . n) (:operator . "...") (:target . n))
;
(define (mutate:last-info)
  (try
    (let* ((h (query "qr:mutation-log-summary"))
           (id (hash-ref h "last-mutation-id"))
           (op (hash-ref h "last-operator"))
           (tgt (hash-ref h "last-target-node")))
      (list (cons ":id" id)
            (cons ":operator" op)
            (cons ":target" tgt)))
    (catch (e)
      (list (cons ":id" 0)
            (cons ":operator" "")
            (cons ":target" 0)))))

; ── mutate:operator-count name — 某 operator 的 mutation 次数 ──
;
; 通过 (mutate:by-operator) hash-ref 查找。
; 找不到返回 0。
;
(define (mutate:operator-count name)
  (try
    (let ((op-hash (mutate:by-operator)))
      (let ((v (hash-ref op-hash name 0)))
        (if (null? v) 0 v)))
    (catch (e) 0)))

; ── mutate:rolled-back? — 是否存在已 rollback 的 mutation ──
;
; 返回 #t / #f。
;
(define (mutate:rolled-back?)
  (try
    (let* ((h (query "qr:mutation-log-summary"))
           (rolled (hash-ref h "rolled-back")))
      (> rolled 0))
    (catch (e) #f)))

; ── mutate:rollback-rate — rollback ratio (0..100 integer) ──
;
; 返回 rolled-back / total 的百分比（整数）。
; total == 0 时返回 0。
;
(define (mutate:rollback-rate)
  (try
    (let* ((h (query "qr:mutation-log-summary"))
           (rolled (hash-ref h "rolled-back"))
           (total (hash-ref h "total")))
      (if (= total 0) 0
        (let ((pct (* 100 (/ rolled total))))
          (if (< pct 0) 0
            (if (> pct 100) 100
              pct)))))
    (catch (e) 0)))

; ═══════════════════════════════════════════════════════════════
; #1553 — Boundary / safe-yield / quota bridge (engine P0 → stdlib)
; ═══════════════════════════════════════════════════════════════

(define (mutate-num v default)
  (if (number? v) v default))

; (mutate:boundary-depth) — current MutationBoundaryGuard nesting.
; 0 = steal-safe / yield-safe (#1504).
(define (mutate:boundary-depth)
  (try
    (mutate-num (stats:get "query:mutation-boundary-depth") 0)
    (catch (e) 0)))

; (mutate:boundary-safe?) — true when depth==0 and Guard not held.
(define (mutate:boundary-safe?)
  (try
    (let* ((d (mutate:boundary-depth))
           (sy (stats:get "query:mutation-boundary-safe-yield-stats"))
           (held (if (hash? sy) (mutate-num (hash-ref sy "held-now" 0) 0) 0)))
      (and (= d 0) (= held 0)))
    (catch (e) #t)))

; (mutate:safe-yield) — cooperative yield only at safe boundary.
; Wraps engine (ast:yield-at-boundary) / query:mutation-boundary-safe-yield
; via stats:get facade. Returns hash with yielded / skipped-held / depth
; (schema 1504), or empty hash on failure.
(define (mutate:safe-yield)
  (try
    (let ((h (stats:get "ast:yield-at-boundary")))
      (if (hash? h) h (hash)))
    (catch (e) (hash))))

; (mutate:quota-ok?) — soft quota probe for multi-agent loops.
; Uses resource:quota-check when available; unlimited (0 limit) → #t.
; Does not hard-fail mutations; agents use this for back-off decisions.
(define (mutate:quota-ok?)
  (try
    (let ((fib (try (resource:quota-check "fibers" 0) (catch (e) #t)))
          (mem (try (resource:quota-check "memory" 0) (catch (e) #t))))
      (and (not (eq? fib #f)) (not (eq? mem #f))))
    (catch (e) #t)))

; (mutate:safety-snapshot) — Agent-facing alist of live safety signals.
; Prefer over inventing new query:*-stats. Keys are strings for equal?.
(define (mutate:safety-snapshot)
  (try
    (let* ((depth (mutate:boundary-depth))
           (safe? (mutate:boundary-safe?))
           (sy (try (stats:get "query:mutation-boundary-safe-yield-stats")
                    (catch (e) (hash))))
           (hold (try (stats:get "query:mutation-boundary-hold-stats")
                      (catch (e) (hash))))
           (fiber (try (stats:get "query:fiber-boundary-violation-stats")
                       (catch (e) (hash))))
           (lr (try (stats:get "query:longrunning-infra-stats")
                    (catch (e) (hash))))
           (held (if (hash? sy) (mutate-num (hash-ref sy "held-now" 0) 0) 0))
           (sy-ok (if (hash? sy) (mutate-num (hash-ref sy "safe-yield-ok-total" 0) 0) 0))
           (sy-skip (if (hash? sy)
                      (mutate-num (hash-ref sy "safe-yield-skipped-held-total" 0) 0)
                      0))
           (long-hold (if (hash? hold)
                        (mutate-num (hash-ref hold "holds-over-1ms" 0) 0)
                        0))
           (rec-fail (if (hash? fiber)
                       (mutate-num (hash-ref fiber "recovery-failures" 0) 0)
                       0))
           (fiber-rb (if (hash? fiber)
                       (mutate-num (hash-ref fiber "rollbacks" 0) 0)
                       0))
           (quota-v (if (hash? lr)
                      (mutate-num (hash-ref lr "quota-violations" 0) 0)
                      0)))
      (list (cons ":boundary-depth" depth)
            (cons ":boundary-safe?" safe?)
            (cons ":held-now" held)
            (cons ":safe-yield-ok" sy-ok)
            (cons ":safe-yield-skipped-held" sy-skip)
            (cons ":long-hold-count" long-hold)
            (cons ":fiber-recovery-failures" rec-fail)
            (cons ":fiber-rollbacks" fiber-rb)
            (cons ":quota-violations" quota-v)
            (cons ":quota-ok?" (mutate:quota-ok?))))
    (catch (e)
      (list (cons ":boundary-depth" 0)
            (cons ":boundary-safe?" #t)
            (cons ":held-now" 0)
            (cons ":safe-yield-ok" 0)
            (cons ":safe-yield-skipped-held" 0)
            (cons ":long-hold-count" 0)
            (cons ":fiber-recovery-failures" 0)
            (cons ":fiber-rollbacks" 0)
            (cons ":quota-violations" 0)
            (cons ":quota-ok?" #t)))))

; Issue #4324: walk keyword/value pairs after the optional summary.
; Returns (snap sync allow have-tenant tenant). have-tenant is 0 or 1.
; Bool keywords match the engine: a following boolean or integer is the
; value; a bare keyword means #t. :tenant-target is forwarded only when
; the caller passed it (the engine's have_tenant_target flag changes the
; isolation check). Unknown keywords and a non-keyword after the summary
; are errors — callers see them, the batch try/catch does not.
(define (mutate:scan-batch-kws args snap sync allow have-tenant tenant)
  (if (null? args)
    (list snap sync allow have-tenant tenant)
    (let ((k (car args))
          (more (cdr args)))
      (if (not (keyword? k))
        (error "mutate:atomic-batch-safe: non-keyword after summary")
        (let ((name (keyword->string k)))
          (cond
            ((string=? name "tenant-target")
             (if (or (null? more) (not (integer? (car more))))
               (error "mutate:atomic-batch-safe: :tenant-target requires an integer tenant id")
               (mutate:scan-batch-kws (cdr more) snap sync allow 1 (car more))))
            ((or (string=? name "snapshot?")
                 (string=? name "sync-query-index?")
                 (string=? name "allow-macro?"))
             (if (or (null? more) (keyword? (car more)))
               (mutate:scan-batch-kws more
                 (if (string=? name "snapshot?") #t snap)
                 (if (string=? name "sync-query-index?") #t sync)
                 (if (string=? name "allow-macro?") #t allow)
                 have-tenant tenant)
               (if (or (boolean? (car more)) (integer? (car more)))
                 (let ((b (if (boolean? (car more))
                            (car more)
                            (not (= (car more) 0)))))
                   (mutate:scan-batch-kws (cdr more)
                     (if (string=? name "snapshot?") b snap)
                     (if (string=? name "sync-query-index?") b sync)
                     (if (string=? name "allow-macro?") b allow)
                     have-tenant tenant))
                 (error "mutate:atomic-batch-safe: boolean keyword requires a boolean"))))
            (else
              (error (string-append "unknown mutate:atomic-batch keyword: :" name)))))))))

; (mutate:atomic-batch-safe ops [summary] [keyword value]...)
; Guarded wrapper around engine (mutate :atomic-batch):
;   1) parse keywords; unknown keyword / stray non-keyword → error (#4324)
;   2) refuse when boundary not safe (depth>0 / held) → #f
;   3) soft yield at boundary before long batch (#1504)
;   4) forward :snapshot? :sync-query-index? :allow-macro?
;      and :tenant-target when the caller supplied it
;   5) run atomic-batch; return its result (#t / #f)
;
; Agents / orchestrator SHOULD prefer this over raw atomic-batch
; for multi-fiber closed loops.
(define (mutate:atomic-batch-safe ops . rest)
  (let* ((summary (if (or (null? rest) (keyword? (car rest)))
                    "atomic-batch-safe"
                    (car rest)))
         (kws (if (or (null? rest) (keyword? (car rest)))
                rest
                (cdr rest)))
         (parsed (mutate:scan-batch-kws kws #f #t #f 0 0)))
    (if (error? parsed)
      parsed
      (let* ((snap (car parsed))
             (r1 (cdr parsed))
             (sync (car r1))
             (r2 (cdr r1))
             (allow (car r2))
             (r3 (cdr r2))
             (have-tenant (car r3))
             (tenant (car (cdr r3))))
        (if (not (mutate:boundary-safe?))
          #f
          (begin
            ; Cooperative yield so concurrent fibers can steal / make progress
            ; before we enter MutationBoundaryGuard for the batch.
            (mutate:safe-yield)
            (try
              (if (null? ops)
                #f
                (if (= have-tenant 1)
                  (mutate :atomic-batch ops summary
                    :snapshot? snap
                    :sync-query-index? sync
                    :allow-macro? allow
                    :tenant-target tenant)
                  (mutate :atomic-batch ops summary
                    :snapshot? snap
                    :sync-query-index? sync
                    :allow-macro? allow)))
              (catch (e) #f))))))))
+
; ═══════════════════════════════════════════════════════════════
; #5252 wave 2 — the mutate:* operator catalog (data only)
; ═══════════════════════════════════════════════════════════════
;
; The engine registers 30 callable mutate:* small steps as HIDDEN
; primitives (#5141 / #5144): they resolve at call position, they are not
; first-class values, and primitives:list does not show them. An Agent
; cannot enumerate them from the runtime — this catalog is that enumerable
; face. It is pure data: no new primitive slot, no new effect, no change to
; the hidden design.
;
; Source of truth: kMutateHygieneInventory in
;   src/compiler/evaluator_primitives_mutate.cpp
; is the registration point's review table (#4665): a mutate:* registration
; with no row is refused there, fail-closed. tests/suite/mutate_catalog.aura
; parses that table and fails when this list and the registry drift apart, so
; the names are checked against the engine, never maintained in parallel.
;
; Row fields:
;   "name"        string  the call name ("mutate:...")
;   "granularity" string  binding | function | subtree | literal | query |
;                         batch | metadata | policy
;   "params"      string  argument shape, from the registration's usage text
;   "rollback?"   bool    #t when a snapshot / the mutation log restores it
;   "gate"        string  acceptance (#5255 verdict, via a std wrapper) |
;                         mutation-boundary (engine guard only) | none
;   "protected?"  bool    #t when a define name is an argument, so the #5253
;                         protected set can constrain the operator
;   "hygiene"     string  required | exempt — the #4665 registration policy,
;                         checked against the registry by the suite
;   "hidden"      bool    #t — registered add_hidden, not a first-class value
;   "wrappers"    list    std wrappers whose result the #5255 gate decides

(define (mutate-catalog-row name gran params rollback gate prot hyg wrappers)
  (hash "name" name
        "granularity" gran
        "params" params
        "rollback?" rollback
        "gate" gate
        "protected?" prot
        "hygiene" hyg
        "hidden" #t
        "wrappers" wrappers))

(define *mutate-catalog-rows*
  (list
    (mutate-catalog-row "mutate:replace-type" "subtree"
      "(node-id|stable-ref new-type:string [summary:string])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:replace-value" "literal"
      "(node-id|stable-ref value [summary:string])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:record-patch" "literal"
      "(node-id|stable-ref key:string value:string)" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:query-and-replace" "query"
      "(predicates... template:string [summary:string])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:query-and-replace-batch" "query"
      "(predicates... template:string ...)" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:rebind" "binding"
      "(name:string define-source:string [summary:string] [validate: type-name])" #t "acceptance" #t "required"
      (list "safe-refactor:replace-fn"))
    (mutate-catalog-row "mutate:set-body" "function"
      "(name:string body-source:string [:allow-macro? bool] [summary:string])" #t "mutation-boundary" #t "required" (quote ()))
    (mutate-catalog-row "mutate:remove-node" "subtree"
      "(node-id [:allow-macro? bool])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:insert-child" "subtree"
      "(parent-id position:int code:string [:allow-macro? bool])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:tweak-literal" "literal"
      "(node-id|stable-ref delta|factor:number [summary:string])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:replace-pattern" "subtree"
      "(pattern replacement [summary:string])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:replace-subtree" "subtree"
      "(node-id new-code:string [summary:string] [:allow-macro? bool])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:atomic-batch" "batch"
      "(ops:list [summary:string] [keyword value]...)" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:splice" "subtree"
      "(parent-id position:int code-strings... [:allow-macro? bool] [summary:string])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:wrap" "subtree"
      "(node-id wrapper-template:string [:allow-macro? bool] [summary:string])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:refactor/extract" "function"
      "(node-id new-name:string [summary:string])" #t "mutation-boundary" #t "required" (quote ()))
    (mutate-catalog-row "mutate:rename-symbol" "binding"
      "(old-name:string new-name:string [summary:string])" #t "acceptance" #t "required"
      (list "refactor:rename-var"))
    (mutate-catalog-row "mutate:move-node" "subtree"
      "(node parent pos [:allow-macro? bool])" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:extract-function" "function"
      "(node-id new-name:string [:allow-macro? bool])" #t "acceptance" #t "required"
      (list "refactor:extract-function"))
    (mutate-catalog-row "mutate:inline-call" "function"
      "(call-node-id [:allow-macro? bool])" #t "acceptance" #f "required"
      (list "refactor:inline-function"))
    (mutate-catalog-row "mutate:from-verification-feedback" "subtree"
      "(strategy:string node payload:string)" #t "mutation-boundary" #f "required" (quote ()))
    (mutate-catalog-row "mutate:check-stable-ref" "metadata"
      "(stable-ref (id . gen))" #f "none" #f "exempt" (quote ()))
    (mutate-catalog-row "mutate:check" "metadata"
      "(name:string define-source:string)" #f "none" #f "exempt" (quote ()))
    (mutate-catalog-row "mutate:set-stale-ref-policy" "policy"
      "(policy:string \"warn\"|\"strict\"|\"disabled\")" #f "none" #f "exempt" (quote ()))
    (mutate-catalog-row "mutate:rollback-macro-introduced" "subtree"
      "(root-id [:keep-provenance? bool])" #f "mutation-boundary" #f "exempt" (quote ()))
    (mutate-catalog-row "mutate:set-pattern-index-policy" "policy"
      "(policy:string \"lazy\"|\"eager-after-mutate\"|\"eager-after-cow\")" #f "none" #f "exempt" (quote ()))
    (mutate-catalog-row "mutate:request-gc-safepoint" "metadata"
      "([timeout-ms:int])" #f "none" #f "exempt" (quote ()))
    (mutate-catalog-row "mutate:save-hygiene-checkpoint" "metadata"
      "() -> handle:int" #f "none" #f "exempt" (quote ()))
    (mutate-catalog-row "mutate:restore-hygiene-checkpoint" "metadata"
      "(handle:int)" #f "mutation-boundary" #f "exempt" (quote ()))
    (mutate-catalog-row "mutate:set-agent-fingerprint" "metadata"
      "(fingerprint:int)" #f "none" #f "exempt" (quote ()))))

(define (mutate-catalog-member? x xs)
  (cond ((null? xs) #f)
        ((equal? x (car xs)) #t)
        (else (mutate-catalog-member? x (cdr xs)))))

; (mutate:catalog) — the rows, in registration order.
(define (mutate:catalog) *mutate-catalog-rows*)

(define (mutate:catalog-count) (length *mutate-catalog-rows*))

; (mutate:catalog-names) — the 30 call names as strings.
(define (mutate:catalog-names)
  (let loop ((rs *mutate-catalog-rows*) (acc (quote ())))
    (if (null? rs)
        (reverse acc)
        (loop (cdr rs) (cons (hash-ref (car rs) "name" "") acc)))))

; (mutate:catalog-entry name) — one row, or #f when the name is not an
; operator. A string in, data out: no primitive is probed or called.
(define (mutate:catalog-entry name)
  (let loop ((rs *mutate-catalog-rows*))
    (cond ((null? rs) #f)
          ((equal? (hash-ref (car rs) "name" #f) name) (car rs))
          (else (loop (cdr rs))))))

; (mutate:catalog-by-granularity g) — rows whose unit of edit is g.
(define (mutate:catalog-by-granularity g)
  (let loop ((rs *mutate-catalog-rows*) (acc (quote ())))
    (cond ((null? rs) (reverse acc))
          ((equal? (hash-ref (car rs) "granularity" #f) g)
           (loop (cdr rs) (cons (car rs) acc)))
          (else (loop (cdr rs) acc)))))

(define (mutate:catalog-granularities)
  (list "binding" "function" "subtree" "literal" "query" "batch" "metadata" "policy"))

(define (mutate:catalog-gates)
  (list "acceptance" "mutation-boundary" "none"))

(define (mutate:catalog-fields)
  (list "name" "granularity" "params" "rollback?" "gate" "protected?" "hygiene" "hidden" "wrappers"))

; (mutate:catalog-check) — the catalog's own invariants as a list of problem
; strings (empty = clean): required fields, allowed vocabulary, unique names,
; a protected row names a define, and "acceptance" rows name their wrapper.
; It does not read the C++ registry — the suite cross-checks that half.
(define (mutate:catalog-check)
  (let ((grans (mutate:catalog-granularities))
        (gates (mutate:catalog-gates))
        (hygs (list "required" "exempt"))
        (bad (quote ())))
    (let loop ((rs *mutate-catalog-rows*) (seen (quote ())))
      (cond
        ((null? rs) (reverse bad))
        (else
         (let* ((r (car rs))
                (n (if (hash? r) (hash-ref r "name" #f) #f))
                (tag (if (string? n) n "?"))
                (par (if (hash? r) (hash-ref r "params" #f) #f))
                (gate (if (hash? r) (hash-ref r "gate" #f) #f))
                (prot (if (hash? r) (hash-ref r "protected?" #f) #f))
                (wrap (if (hash? r) (hash-ref r "wrappers" (quote ())) (quote ()))))
           (if (not (and (string? n) (string-prefix? n "mutate:")))
               (set! bad (cons (string-append tag ":name") bad)))
           (if (and (string? n) (mutate-catalog-member? n seen))
               (set! bad (cons (string-append tag ":duplicate") bad)))
           (if (not (mutate-catalog-member? (if (hash? r) (hash-ref r "granularity" #f) #f) grans))
               (set! bad (cons (string-append tag ":granularity") bad)))
           (if (not (mutate-catalog-member? gate gates))
               (set! bad (cons (string-append tag ":gate") bad)))
           (if (not (mutate-catalog-member? (if (hash? r) (hash-ref r "hygiene" #f) #f) hygs))
               (set! bad (cons (string-append tag ":hygiene") bad)))
           (if (not (string? par))
               (set! bad (cons (string-append tag ":params") bad)))
           (if (not (boolean? (if (hash? r) (hash-ref r "rollback?" #f) #f)))
               (set! bad (cons (string-append tag ":rollback?") bad)))
           (if (not (boolean? prot))
               (set! bad (cons (string-append tag ":protected?") bad)))
           (if (not (equal? #t (if (hash? r) (hash-ref r "hidden" #f) #f)))
               (set! bad (cons (string-append tag ":hidden") bad)))
           (if (not (list? wrap))
               (set! bad (cons (string-append tag ":wrappers") bad)))
           (if (and (equal? prot #t) (not (and (string? par) (string-contains? par "name:string"))))
               (set! bad (cons (string-append tag ":protected-without-name") bad)))
           (if (not (equal? (equal? gate "acceptance") (not (null? wrap))))
               (set! bad (cons (string-append tag ":gate/wrappers") bad)))
           (loop (cdr rs) (if (string? n) (cons n seen) seen))))))))

