; lib/std/regex.aura — Regular expression utilities
;
; (require "std/regex" all:)
;

(export re-match? re-find re-replace re-split re-quote)

(define (re-match? pattern str)
  (not (= (regex-match? pattern str) 0)))

(define (re-find pattern str)
  (let ((r (regex-find pattern str))) (if (string? r) r "")))

(define (re-replace pattern str replacement)
  (let ((r (regex-replace pattern str replacement))) (if (string? r) r str)))

;; string-index is the core primitive (2 or 3 arguments); Issue #5238.

;; Split string by regex matches.
;; #5325: the native regex-split IS this operation. The old loop re-found the
;; first match text (one timed regex call per segment) and recursed on the
;; remainder without tail position, so ~510 segments blew the depth cap. The
;; boundary contract is unchanged: an empty string yields (), a miss yields
;; (list str), and a trailing empty segment is dropped (regex-split drops it,
;; and the old recursion dropped it too).
(define (re-split pattern str)
  (if (string=? str "") () (regex-split pattern str)))

;; Escape special regex chars.
;; #5325: one regex-replace with $& instead of an O(n^2) string-append per
;; character (and one list->string mint per character).
(define (re-quote str)
  (re-replace "[.^$*+?()\\[\\]{}|\\\\]" str "\\$&"))
