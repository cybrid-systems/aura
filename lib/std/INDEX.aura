; lib/std/INDEX.aura — Stdlib discoverability index (Issue #565)
;
; Import with: (import "std/INDEX")
; Or:        (require "std/INDEX" all:)
;
; The PRIMARY discovery surface for AI Agents. Lists every
; stdlib module with a one-line description + an example call.
; The full doc catalog is at docs/generated/stdlib-index.md
; (auto-generated by build.py docs), but the agent-facing
; surface is this INDEX.
;
; ── Form-order authoring note (#2766 / #2769) ──────────────────
; Prefer (export …) before (require …) when a module defines cells
; or private helpers free-ref'd by exports. Host binder tolerates
; either order since #2766 (prologue Phase 0 + dual-path pool),
; but export-first is the stdlib canonical form (orchestrator #2768,
; audit #2769). Do not reintroduce require-before-export without
; updating scripts/coverage/checks/check_stdlib_require_export_audit_2769.py
; (use --fix to reorder).

(export stdlib:list stdlib:help stdlib:examples
        stdlib:by-prefix stdlib:by-tag)

; The master registry of stdlib modules. Each entry is
; (name . (description . example-call)). Order = discoverable
; order (high-level Agent helpers first, low-level primitives
; last). This list is the canonical source of truth for the
; stdlib catalog; build.py docs reads it for the generated
; stdlib-index.md.
(define stdlib-registry
  (list
    ; ── High-level Agent modules (Issue #559-#564 demotions) ──
    (list "stats"
      (list "Query + observability stats unified layer (56 *-stats primitives)"
            "(stats:get \"query:envframe-dualpath-stats\")"))
    (list "synthesize"
      (list "Synthesize namespace stdlib wrappers (LLM template registration)"
            "(synthesize:list-templates)"))
    (list "query"
      (list "High-level query: namespace Agent API"
            "(query:list-categories)"))
    (list "ast"
      (list "AST helpers: formatted summary, validate, version"
            "(ast:summary-formatted)"))
    (list "workspace"
      (list "Workspace helpers: snapshot, rollback, memory"
            "(ws:snapshot-current)"))
    ; Issue #5003: core:any/all/zip-with duplicated std/list any/all/zip
    ; and core:group-by duplicated std/iter group-by. std/core stays as a
    ; deprecated facade only; it is no longer a recommended entry point.
    ; (list "core" ...) removed from the recommended list.
    ; ── Adaptive + agent helpers ──
    (list "adaptive"
      (list "Adaptive API discovery + diagnostics"
            "(get-api-ref stdlib-list)"))
    ; Issue #4939: the shared base for the v0.2 evolution algorithms
    (list "evo-core"
      (list "Candidates/lineage values, ask/tell search handles, worldline-isolated trials, deterministic RNG, evo log v=2"
            "(require \"std/evo-core\" all:)(evo:ask (evo:search (hash \"algo\" \"mock\" \"seed\" 42 \"budget\" 8)) 2)"))
    ; Issue #4940: the multi-objective layer of the v0.2 search stack
    (list "pareto"
      (list "Pareto archive/commit gate, non-dominated sort, crowding, exact 2/3-objective HV, IGD, NSGA-II"
            "(require \"std/pareto\" all:)(pareto:nd-sort (list (list 1 2) (list 2 1)) (hash \"dirs\" (list \"min\" \"min\")))"))
    (list "moead"
      (list "MOEA/D decomposition search (Tchebycheff/PBI/weighted sum), Das-Dennis weights, MOEA/DD archive"
            "(require \"std/moead\" all:)(moead:ask (moead:make (hash \"n-obj\" 2 \"H\" 12)) 4)"))
    ; ── Aura layer (#5004): agent / orch / evo are written in Aura over the
    ;    primitives; the Scheme layer below is engine + host prims. ──
    (list "agent"
      (list "Aura layer: one closed loop — observe/propose/check/apply/verify/record + hot-replace step (#5004)"
            "(agent:closed-loop-once :source \"(define (f x) (+ x 1))\" :rebind \"f\" \"(lambda (x) (* x 2))\")"))
    (list "orch"
      (list "Aura layer: multi-agent over spawn/send/recv/join/cancel — spawn, ask, pipeline, parallel, supervise (#5004)"
            "(require \"std/orch\" all:)(orch:spawn \"worker\" (lambda (x) (* x 2)))(orch:ask \"worker\" 21)"))
    (list "evo"
      (list "Aura layer: experience from the evo:record! worldline — fixed / epsilon-greedy / UCB selectors (#5004)"
            "(require \"std/evo\" all:)(evo:choose-ucb (evo:arms (evo:records)))"))
    (list "search"
      (list "Aura layer: one search protocol — init/step/best/export; kinds grid/pso/abc/fss/ant/es/anneal/bandit/beam (#5007)"
            "(require \"std/search\" all:)(search:run (search:init \"es\" (hash \"dim\" 2 \"pop\" 8)) fitness 10)"))
    ; ── Legacy swarm surfaces (#5007): importable, NOT recommended. ──
    ; Use std/search for the same algorithms through search:step. pso/abc/
    ; fss/ant keep their module names for one release; boids is coupling
    ; between agents, so the orchestration example lives in std/orch.
    (list "swarm"
      (list "Legacy (use std/search): process-state swarm family grid/pso/ant/abc/boids/fss"
            "(require \"std/search\" all:)(search:init \"pso\" (hash \"dim\" 2 \"pop\" 12))"))
    (list "pso"
      (list "Legacy (use std/search kind pso): particle swarm surface"
            "(require \"std/search\" all:)(search:init \"pso\" (hash \"dim\" 2 \"pop\" 12))"))
    (list "abc"
      (list "Legacy (use std/search kind abc): artificial bee colony surface"
            "(require \"std/search\" all:)(search:init \"abc\" (hash \"dim\" 2 \"pop\" 12))"))
    (list "boids"
      (list "Coordination example for std/orch, not a search kind: separation/alignment/cohesion"
            "(require \"std/boids\" all:)(boids:step positions velocities (hash \"sep\" 1.0))"))
    (list "fss"
      (list "Legacy (use std/search kind fss): fish school search surface"
            "(require \"std/search\" all:)(search:init \"fss\" (hash \"dim\" 2 \"pop\" 16))"))
    ; Issue #5003: SRFI-132 sorting is std/sort; algorithmic helpers stay here.
    (list "algorithm"
      (list "Algorithm utilities (group, partition, min/max-by, binary-search); sorting moved to std/sort"
            "(partition (lambda (x) (> x 0)) (list -1 2 -3))"))
    (list "capability"
      (list "Capability discovery"
            "(capability? \"Mutate\")"))
    (list "combinators"
      (list "Higher-order combinators"
            "(combinator:compose f g)"))
    (list "data"
      (list "Structured data utilities"
            "(data:make-hash)"))
    (list "rule"
      (list "Rule engine helpers"
            "(rule:define)"))
    ; Issue #5003: there is no std/edsl module. Macros are language
    ; forms, not a stdlib entry; see std/struct and std/record for
    ; macro-generating libraries. (list "edsl" ...) removed.
    ; ── Pipeline + agent ──
    (list "pipeline"
      (list "Synthesize pipeline names (v2 implementation detail of std/synthesize; not a parallel surface)"
            "(require \"std/synthesize\" all:)(synthesize:run-tests code tests)"))
    (list "orchestrator"
      (list "One-release forwarder to std/orch (#5004); import std/orch in new code"
            "(require \"std/orch\" all:)(orch:pipeline steps input)"))
    ; ── Collection + data ──
    (list "list"
      (list "SRFI-1 list utilities (foldl/foldr, any/every, cons*, append-map, filter-map) [perf-tier:hot #923/#928]"
            "(append-map (lambda (x) (list x x)) (list 1 2))"))
    (list "vector"
      (list "SRFI-133 vector library (vector-append, vector-map, vector-fold, vector-count, vector-copy!)"
            "(vector-append (vector 1) (vector 2 3))"))
    (list "sort"
      (list "SRFI-132 sorting (list-sort, vector-sort, vector-sort!, sort!)"
            "(list-sort < (list 3 1 2))"))
    (list "bitwise"
      (list "SRFI-151 bitwise ops (bitwise-and/ior/xor/not, arithmetic-shift, bit-count)"
            "(bitwise-and 12 10)"))
    (list "record"
      (list "SRFI-9 define-record-type records (tagged vector, accessors + mutators)"
            "(define-record-type <p> (make-p x) p? (x px set-px!))"))
    (list "char"
      (list "R7RS (scheme char): comparisons, ASCII case/fold, digit-value"
            "(char-ci=? (char-upcase 97) 65)"))
    (list "exception"
      (list "R7RS exceptions: with-exception-handler, raise-continuable, guard, error-object?"
            "(guard (e ((string? e) e)) (error \"x\"))"))
    (list "parameter"
      (list "R7RS parameters: make-parameter / parameterize (dynamic extent)"
            "(parameterize ((p 1)) (p))"))
    (list "lazy"
      (list "R7RS lazy: delay / force / promise? (memoising promises)"
            "(force (delay (+ 1 2)))"))
    (list "case-lambda"
      (list "R7RS case-lambda: arity-dispatched procedures"
            "((case-lambda (() 0) ((a) a)) 7)"))
    (list "bytevector"
      (list "R7RS bytevectors + UTF-8 (tagged vector; bytevector? discriminates)"
            "(utf8->string (string->utf8 \"héllo\"))"))
    (list "r7rs"
      (list "R7RS-small coverage table (every export: kernel / std / this-version / no)"
            "(r7rs:status \"eq?\")"))
    (list "hash"
      (list "SRFI-125 hash tables + SRFI-128 minimal comparator; hash-set/remove are COPY-ON-WRITE"
            "(hash-table-ref (alist->hash-table (list (list 'k 1))) 'k)"))
    (list "json"
      (list "JSON utilities"
            "(json:stringify (cons 'a 1))"))
    (list "string"
      (list "String utilities"
            "(string:length \"hello\")"))
    ; ── TUI (Issues #1334–#1358) ──
    ; ── Atomic resource swap (Issue #1380) ──
    (list "atomic-swap"
      (list "Bind resource→artifact; queue swap, drain at sync boundary"
            "(require \"std/atomic-swap\" all:)"))
    ; ── Workspace persistence (Issue #1381) ──
    (list "persist"
      (list "Save/load workspace + AOT meta + mutation log (AURASOUL binary)"
            "(require \"std/persist\" all:)"))
    ; ── Hot strategy / hot-update ──
    ; Issue #2582: pure-Aura strategy rebind (denseness) vs AOT .so reload.
    (list "hot-strategy"
      (list "Pure-Aura hot strategy swap + snapshot heal (mutate:rebind; not AOT)"
            "(require \"std/hot-strategy\" all:)(hot-strategy:swap! \"strat\" \"(lambda (x) x)\" \"v2\")"))
    ; ── AOT hot-update (Issue #1370): replacement steps behind std/agent ──
    ; #5004: these four are no longer separate public surfaces. The agent
    ; replacement step composes them: (agent:hot-replace path agent-id polls).
    (list "hot-update"
      (list "Replacement step of std/agent: AOT .so reload (agent:hot-replace composes region+reload+monitor)"
            "(require \"std/agent\" all:)(agent:hot-replace \"/path/module.so\" 0 1)"))
    (list "hot-update-reload"
      (list "Replacement step of std/agent: AOT reload strategies (manual, threshold, composite)"
            "(require \"std/hot-update-reload\" all:)"))
    (list "hot-update-region"
      (list "Replacement step of std/agent: region isolation used by agent:hot-replace"
            "(require \"std/hot-update-region\" all:)"))
    (list "hot-update-monitor"
      (list "Replacement step of std/agent: health polling used by agent:hot-replace"
            "(require \"std/hot-update-monitor\" all:)"))
    ; ── IO / system ──
    (list "io"
      (list "The one home of the file verbs (file-read/write/exists?/size/copy/delete) plus R7RS ports (string, file, stdin/stdout/stderr). std/fs re-exports these; it no longer defines a second set (#5005)"
            "(open-input-string \"ab\")"))
    (list "net"
      (list "HTTP client host prims — sandbox requires network effect (#3174)"
            "(require \"std/net\" all:)"))
    (list "socket"
      (list "TCP client+server host prims — sandbox requires network effect (#3174)"
            "(require \"std/socket\" all:)"))
    (list "git"
      (list "Git host prims — sandbox requires exec+write (#3174)"
            "(require \"std/git\" all:)"))
    (list "process"
      (list "shell/command/sys-* host prims — sandbox requires exec (#3174)"
            "(require \"std/process\" all:)"))
    (list "ffi"
      (list "C FFI host prims (c-load/c-func/c-alloc/opaque/struct) — sandbox requires effect:ffi (#3176)"
            "(require \"std/ffi\" all:)"))
    (list "fs"
      (list "Path + directory helpers (path-join/dirname/basename/extname, dir-list/files/dirs) and re-exported file verbs from std/io"
            "(path-join \"a\" \"b\")"))
    ; Issue #5003: no std/path module — path helpers live in std/fs.
    ; Issue #5005: std/time supplies current-second/current-jiffy.
    (list "time"
      (list "R7RS time: current-second, current-jiffy, jiffies-per-second (wall + monotonic)"
            "(current-jiffy)"))
    ; ── Engine primitives discoverability (#1552) ──
    (list "primitives"
      (list "Engine PrimRegistrar registry (fiber/mutate/query hot paths) + Agent discovery (#1552)"
            "(require \"std/primitives\" all:)(primitives:help)"))
    ; ── Helpers ──
    ; Issue #981: removed duplicate "hash" entry (first entry under
    ; Collection + data is canonical: "(hash:set 'k 'v)").
    (list "INDEX"
      (list "This discoverability index"
            "(stdlib:list)"))))
; ── (stdlib:list) — returns list of all module names
(define (stdlib:list)
  (map car stdlib-registry))

; ── (stdlib:help name) — returns the help alist for a module
;     Returns '("not-found" name) if name is unknown.
(define (stdlib:help name)
  (let loop ((rest stdlib-registry))
    (cond
      ((null? rest) (list "not-found" name))
      ((string=? name (car (car rest)))
       (car (cdr (car rest))))
      (else (loop (cdr rest))))))

; ── (stdlib:examples) — returns list of (name . example-call) pairs
(define (stdlib:examples)
  (let helper ((rest stdlib-registry) (acc (list)))
    (cond
      ((null? rest) (reverse acc))
      (else
        (let* ((entry (car rest))
               (name (car entry))
               (data (car (cdr entry)))
               (example (car (cdr (cdr data)))))
          (helper (cdr rest) (cons (list name example) acc)))))))

; ── (stdlib:by-prefix prefix) — returns modules whose name starts with prefix
(define (stdlib:by-prefix prefix)
  (let helper ((rest stdlib-registry) (acc (list)))
    (cond
      ((null? rest) (reverse acc))
      ((string=? "" prefix)
       (helper (cdr rest) (cons (car (car rest)) acc)))
      (else
        (let* ((name (car (car rest)))
               (match? (if (>= (string-length name) (string-length prefix))
                       (string=? (substring name 0 (string-length prefix)) prefix)
                       #f)))
          (helper (cdr rest)
                  (if match? (cons name acc) acc)))))))

; ── (stdlib:by-tag tag) — returns modules whose help text contains tag
(define (stdlib:by-tag tag)
  (let helper ((rest stdlib-registry) (acc (list)))
    (cond
      ((null? rest) (reverse acc))
      (else
        (let* ((entry (car rest))
               (name (car entry))
               (help (car (car (cdr entry)))))
          (helper (cdr rest)
                  (if (string-contains? (string?-> help) tag)
                    (cons name acc)
                    acc)))))))

; Helper: string-contains? for the stdlib layer (used by by-tag).
(define (string-contains? str sub)
  (cond
    ((= (string-length sub) 0) #t)
    ((> (string-length sub) (string-length str)) #f)
    (else
      (let loop ((i 0))
        (cond
          ((> (+ i (string-length sub)) (string-length str)) #f)
          ((string=? (substring str i (+ i (string-length sub))) sub) #t)
          (else (loop (+ i 1))))))))

; Helper: convert any to string (used by by-tag for help text).
(define (string?-> v)
  (cond
    ((string? v) v)
    ((number? v) (number->string v))
    ((symbol? v) (symbol->string v))
    ((boolean? v) (if v "true" "false"))
    (else "...")))