; std/bus — local tool bus surface (v0.3.0, Issue #5127)
;
; Kernel keeps only what Aura cannot do: create/map the shared image,
; attach across processes, capability checks and the atomic publish
; generation. One primitive (bus-call) carries those verbs; this module
; is the stable public surface and the place for status/record helpers.
;
; Failures are records, not #f: (list "error" CODE MESSAGE).

(export bus:attach bus:detach bus:subscribe bus:publish bus:query
        bus:host bus:unhost bus:host?
        bus:publish-cct bus:publish-patch bus:publish-worldline bus:project-nodes
        bus:project-cct bus:project-patches bus:project-worldlines
        bus:hotspots bus:diff-worldlines
        bus:constraints
        bus:install-constraint bus:rollback-constraints
        bus:audit-filter
        bus:trial bus:keep bus:rollback bus:grant bus:revoke bus:audit
        bus:publish-source bus:bind-evidence bus:evidence bus:canary-confirm
        bus:candidate-digest bus:source-field bus:grant-activate
        bus:bind-gate bus:gate-evidence
        bus:audit-replay bus:audit-evo bus:defines bus:repro bus:source-read
        bus:round-open bus:round-state bus:round-budget
        bus:degradation-state bus:degrade-install bus:degrade-rollback
        bus:slo bus:capacity-plan
        bus:post-task bus:claim bus:heartbeat bus:complete bus:fail
        bus:task-status
        bus:status bus:code bus:message bus:ok? bus:help
        bus:attach? bus:error? bus:record?)

; (bus:attach path workspace role caps channels)
; path may be "" to use $XDG_RUNTIME_DIR/aura/bus/<workspace>.sock.
(define (bus:attach path workspace role caps channels)
  (bus-call "attach" path workspace role caps channels))

; Issue #5128: the workspace owner hosts the bus (#5121's process model:
; the coordinator is the Aura process that owns the live workspace, not
; a separate daemon). Roles: 1 perf, 2 harness, 3 maintainer, 0 generic.
; (bus:host workspace [image-bytes] [path]) -> (ok path workspace);
; idempotent per workspace. Peers are served concurrently (#5377); a
; disconnect ends only that session, never the host. The sandbox preset
; comes from AURA_SANDBOX (ci drops constraint-write, prod also grant).
(define (bus:host workspace . rest)
  (let ((bytes (if (pair? rest) (car rest) 0))
        (path (if (and (pair? rest) (pair? (cdr rest))) (car (cdr rest)) "")))
    (bus-call "host" workspace bytes path)))

(define (bus:unhost workspace)
  (bus-call "unhost" workspace))

(define (bus:host? workspace)
  (bus-call "host?" workspace))

(define (bus:detach session)
  (bus-call "detach" session))

; (bus:subscribe session channel) -> (ok generation count offset length snapshot)
(define (bus:subscribe session channel)
  (bus-call "subscribe" session channel))

; (bus:query session channel since-generation since-count)
; -> (ok generation count snapshot rows). count is the channel's TOTAL
; record count (the next cursor); rows holds only the records after the
; cursor. snapshot=1 (full rows) when the cursor generation or count is
; ahead of the channel; (0,0) reads everything.
(define (bus:query session channel since-generation since-count)
  (bus-call "query" session channel since-generation since-count))

; (bus:publish session key value) -> (ok generation count)
(define (bus:publish session key value)
  (bus-call "publish-metric" session key value))

; Record projections for the other channels.
; Project the live workspace FlatAST nodes into the Nodes channel.
(define (bus:project-nodes session)
  (bus-call "project-nodes" session))

; Live producers: project the running workspace into a channel instead
; of handing it pre-built records.
; (bus:project-cct session) -> (ok generation count)
; (bus:project-patches session) -> (ok generation total next-mutation skipped)
; (bus:project-worldlines session) -> (ok generation total next-mutation)
(define (bus:project-cct session)
  (bus-call "project-cct" session))

(define (bus:project-patches session)
  (bus-call "project-patches" session))

(define (bus:project-worldlines session)
  (bus-call "project-worldlines" session))

; Agent query face: aggregate the CCT by mid and diff two worldlines.
; (bus:hotspots session top) -> (ok count rows); rows = (mid samples self-ns node)
; (bus:diff-worldlines session id-a id-b) -> (ok state-a state-b rows);
; rows = (node in-a in-b field-a field-b value-a value-b)
(define (bus:hotspots session top)
  (bus-call "hotspots" session top))

(define (bus:diff-worldlines session id-a id-b)
  (bus-call "worldline-diff" session id-a id-b))

; (bus:constraints session) -> (ok version count rows); rows = (name source)
; Reads the coordinator's current set from the image constraints section.
(define (bus:constraints session)
  (bus-call "constraints" session))

; (bus:install-constraint session name source) -> (ok version); needs constraint-write.
; The coordinator binds name -> compiled predicate; unknown names are rejected.
(define (bus:install-constraint session name source)
  (bus-call "install-constraint" session name source))

; (bus:rollback-constraints session) -> (ok); needs constraint-write.
(define (bus:rollback-constraints session)
  (bus-call "rollback-constraints" session))

(define (bus:publish-cct session parent mid node samples self-ns)
  (bus-call "publish-cct" session parent mid node samples self-ns))

(define (bus:publish-patch session node field value worldline generation)
  (bus-call "publish-patch" session node field value worldline generation))

(define (bus:publish-worldline session id parent state constraint patch-off patch-len)
  (bus-call "publish-worldline" session id parent state constraint patch-off patch-len))

; (bus:trial session channel [task-id]) -> (ok worldline)
; A task-scoped capability must pass the task id (default 0).
(define (bus:trial session channel . task-id)
  (bus-call "trial" session channel (if (pair? task-id) (car task-id) 0)))

; (bus:keep session worldline node value) runs the current constraints.
(define (bus:keep session worldline node value)
  (bus-call "keep" session worldline node value))

(define (bus:rollback session worldline)
  (bus-call "rollback" session worldline))

; ── v0.3.1 closed loop (#5378/#5379/#5381) ─────────────────────
; The source-carrier patch field marker: a patch with this field_offset
; carries new_value = a string-table index holding the candidate define
; source, not an immediate field value.
(define bus:source-field 4294967280)

; (bus:publish-source session source-text) -> (ok index generation)
; Appends the candidate define source to the image string table. The
; proposer then publishes a patch (bus:publish-patch session node
; bus:source-field index worldline generation) naming the target define.
(define (bus:publish-source session source-text)
  (bus-call "publish-source" session source-text))

; (bus:bind-evidence session worldline baseline candidate workload seed verifier)
; -> (ok worldline). Binds the five-tuple evidence to a pending trial;
; KEEP re-checks baseline/candidate against the live workspace and the
; committed patch bytes. All of workload/seed/verifier must be nonzero.
(define (bus:bind-evidence session worldline baseline candidate workload seed verifier)
  (bus-call "bind-evidence" session worldline baseline candidate workload seed verifier))

; (bus:evidence session worldline) -> (ok baseline candidate workload seed verifier)
; Reads the committed evidence tail of a worldline record.
(define (bus:evidence session worldline)
  (bus-call "evidence" session worldline))

; (bus:canary-confirm session worldline) -> (ok worldline)
; Seals the active canary observation early (judge confirmation). The
; window also seals automatically when it expires with metrics at/above
; the floor; a floor breach reverts automatically.
(define (bus:canary-confirm session worldline)
  (bus-call "canary-confirm" session worldline))

; (bus:candidate-digest session worldline) -> (ok digest)
; The coordinator's FNV-1a digest of the trial's committed patch bytes;
; bind it as candidate_hash in bus:bind-evidence.
(define (bus:candidate-digest session worldline)
  (bus-call "candidate-digest" session worldline))

; (bus:grant-activate session token) -> (ok bits worldline)
; Present a granted token to narrow this session's capability to the
; token's effective (scoped) caps. The judge activates the host's
; delegated keep+rollback on a single worldline before bus:keep.
(define (bus:grant-activate session token)
  (bus-call "grant-activate" session token))

; ── v0.3.2 statistical admission (#5391) ──────────────────────
; (bus:bind-gate session worldline round workload seed verifier folds
;                 threshold control verdict windows) -> (ok worldline)
; Bind the held-out evidence of a candidate to its trial. `windows` is
; the list of per-fold out-of-sample metric deltas in parts per
; million (signed); `round` groups the candidates of one admission
; round — the family the multiple-comparison correction applies to.
; `control` marks the round's negative control: a known-harmful
; candidate the statistics must reject. The coordinator recomputes the
; verdict from the windows; the judge's `verdict` is audited, not
; believed.
(define (bus:bind-gate session worldline round workload seed verifier folds threshold control
               verdict windows)
  (bus-call "bind-gate" session worldline round workload seed verifier folds threshold control
             verdict windows))

; (bus:gate-evidence session worldline) -> (ok verdict family adjusted threshold fingerprint)
; Read the coordinator's own admission verdict for a worldline:
; verdict 1 = keep, 2 = reject; adjusted is the deflated mean in
; parts per million.
(define (bus:gate-evidence session worldline)
  (bus-call "gate-evidence" session worldline))

; ── v0.3.2 audit replay (#5392) ───────────────────────────────
; (bus:audit-replay session) -> (ok events worldlines keeps findings
;                                 first-seq first-kind first-reason nodes)
; Replay the audit log: reconstruct the worldline lineage, check its
; integrity (no orphan event, no broken parent, monotonic sequence,
; every KEEP with its constraint and admission evidence) and
; reproduce the admission verdicts. findings = 0 means the lineage is
; sound; first-kind names the first defect (1 orphan, 2 broken
; parent, 3 sequence regression, 4 audit mismatch, 5 keep without
; constraint, 6 keep without verdict, 7 verdict mismatch, 8 evidence
; mismatch). Each node is
; (worldline parent state trial-seq keep-seq verdict-seq constraint
;  reproduced fingerprint timestamp-ms baseline candidate workload
;  seed verifier gate-verdict gate-family adjusted reason).
(define (bus:audit-replay session)
  (bus-call "audit-replay" session))

; (bus:audit-evo session) -> (ok text)
; The same lineage as evo schema v2 JSONL (docs/evo.md): one JSON
; object per line, so `aura evo log` reads the bus lineage directly.
(define (bus:audit-evo session)
  (bus-call "audit-evo" session))

; (bus:defines session) -> (ok count truncated rows)
; The host's live define names and their node ids. The node ids belong
; to the host's own workspace AST, so a peer that wants to rewrite a
; named function (choose-fn + admit-fn + ttl-fn) asks the host instead
; of guessing an id. Each row is (name node).
(define (bus:defines session)
  (bus-call "defines" session))

; (bus:source-read session index) -> (ok source-text)
; The committed source of a candidate define. The judge measures the
; candidate body on held-out data, so it must see the text the proposer
; committed; the source table is committed evidence, not a private
; channel.
(define (bus:source-read session index)
  (bus-call "source-read" session index))

; (bus:repro session worldline) -> (ok five-tuple windows policy verdict)
; The reproduction package of one worldline: the evidence five-tuple,
; the held-out windows, the policy snapshot and the coordinator's own
; verdict. Everything the admission decision was made from, so the
; decision can be re-run offline and must land on the same verdict.
(define (bus:repro session worldline)
  (bus-call "repro" session worldline))

; ── v0.3.2 轮次编排(#5393) ───────────────────────────────────
; (bus:round-open session) -> (ok round-id phase)
; Ask the coordinator to open an admission round. The host decides:
; one round at a time, no round on top of an unsealed observation,
; outside the cooldown and under the round cap. A refusal names the
; reason (round-active / canary-active / round-cooldown /
; round-budget-exhausted).
(define (bus:round-open session)
  (bus-call "round-open" session))

; (bus:round-state session) -> (ok phase round-id worldline opened sealed reason)
; The round state machine: phase 0 idle, 1 signal, 2 trial, 3 judge,
; 4 canary, 5 sealed.
(define (bus:round-state session)
  (bus-call "round-state" session))

; (bus:round-budget session) -> (ok wall-ms cooldown-ms max-rounds version)
; The host's round budget: the wall clock a round may take, the gap
; between two rounds, the round cap.
(define (bus:round-budget session)
  (bus-call "round-budget" session))

; ── v0.3.2 退化检测(#5394) ────────────────────────────────────
; (bus:degradation-state session) -> (ok version samples alerts last-change
;                                    min-samples drift limit calm keys)
; The host's degradation detector: its version, how many samples it
; saw, how many times it fired, the sample index of the last change
; point and the configuration in force. Each key row is
; (key higher-is-worse samples alerts ewma cusum-ppm).
(define (bus:degradation-state session)
  (bus-call "degradation-state" session))

; (bus:degrade-install session min-samples alpha drift limit calm
;                      down-keys up-keys) -> (ok version)
; Install a new detector configuration (a new version). `down-keys`
; are the metrics whose fall is a degradation, `up-keys` the ones
; whose rise is. Needs constraint-write.
(define (bus:degrade-install session min-samples alpha drift limit calm down-keys up-keys)
  (bus-call "degrade-install" session min-samples alpha drift limit calm down-keys up-keys))

; (bus:degrade-rollback session) -> (ok version)
; Restore the previous detector configuration. Needs constraint-write.
(define (bus:degrade-rollback session)
  (bus-call "degrade-rollback" session))

; ── v0.3.3 任务看板(#5399) ───────────────────────────────────
; (bus:post-task session parent ref) -> (ok id state owner epoch deadline parent ref)
; Publish a task. parent/ref are opaque (a parent task id, a contract
; fingerprint or a worldline).
(define (bus:post-task session parent ref)
  (bus-call "post-task" session parent ref))

; (bus:claim session lease-ms [task-id]) -> (ok id state owner epoch deadline parent ref)
; Atomically claim a specific task, or the oldest open one when task-id
; is omitted/0. A second claim while the lease is live is refused
; (task-claimed); after the deadline another worker can claim it.
(define (bus:claim session lease-ms . task-id)
  (bus-call "claim" session lease-ms (if (pair? task-id) (car task-id) 0)))

; (bus:heartbeat session task-id lease-ms) -> (ok ...)
; Renew the holder's lease. A non-holder or an expired lease is refused.
(define (bus:heartbeat session task-id lease-ms)
  (bus-call "heartbeat" session task-id lease-ms))

; (bus:complete session task-id ref) / (bus:fail session task-id ref)
; Finish the task. Only the current holder can finish it.
(define (bus:complete session task-id ref)
  (bus-call "complete" session task-id ref))

(define (bus:fail session task-id ref)
  (bus-call "fail" session task-id ref))

; (bus:task-status session task-id) -> (ok id state owner epoch deadline parent ref open-count)
; state: 0 open, 1 claimed, 2 done, 3 failed.
(define (bus:task-status session task-id)
  (bus-call "task-status" session task-id))

; ── v0.3.2 性能与容量(#5395) ─────────────────────────────────
; (bus:slo session) -> (ok frames frame-cpu-ns p99-cpu-ns publishes
;                       publish-cpu-ns attaches attach-cpu-ns catchups
;                       catchup-max)
; The bus's own overhead, in CPU time (never the wall clock: a shared
; runner measures the scheduler, not the work). The p99 is the 99th
; percentile of the per-frame CPU cost.
(define (bus:slo session)
  (bus-call "slo" session))

; (bus:capacity-plan session) -> (ok rounds low remaining-metrics
;                                 remaining-cc remaining-patches
;                                 remaining-worldlines remaining-nodes
;                                 committed-bytes image-bytes)
; The room left in the image and the rounds it still supports. The
; channel capacities are a function of the delivered image (#5387), so
; the plan follows the image.
(define (bus:capacity-plan session)
  (bus-call "capacity-plan" session))

; (bus:grant session bits channels loans expires worldline [task-id]) -> (ok token)
; A task-scoped grant carries the task id; the worker may only open,
; keep and roll back that task's trial (#5401).
(define (bus:grant session bits channels loans expires worldline . task-id)
  (bus-call "grant" session bits channels loans expires worldline
            (if (pair? task-id) (car task-id) 0)))

(define (bus:revoke session token)
  (bus-call "revoke" session token))

; (bus:audit session worldline) -> (ok count truncated events)
(define (bus:audit session worldline)
  (bus-call "audit" session worldline))

; (bus:audit-filter session worldline actor since-seq) filters the same log;
; 0 means "all" for worldline/actor, 1 starts at the first event.
(define (bus:audit-filter session worldline actor since-seq)
  (bus-call "audit" session worldline actor since-seq))

; Agent-facing help: verbs, capabilities and failure codes.
(define (bus:help)
  (string-append
    "std/bus (v0.3.3) — local tool bus\n"
    "host: (bus:host workspace [image-bytes] [path]) -> (ok path workspace); the workspace owner hosts; roles 1 perf / 2 harness / 3 maintainer\n"
    "unhost: (bus:unhost workspace); host?: (bus:host? workspace) -> (ok 0|1)\n"
    "attach: (bus:attach path workspace role caps channels) -> (ok session size caps)\n"
    "detach: (bus:detach session)\n"
    "subscribe: (bus:subscribe session channel) -> (ok generation count offset length snapshot)\n"
    "publish: (bus:publish session key value) -> (ok generation count); needs publish\n"
    "project: (bus:project-nodes session) / (bus:project-cct session) / (bus:project-patches session) / (bus:project-worldlines session) project live workspace state; needs publish\n"
    "query: (bus:hotspots session top) -> (ok count rows); (bus:diff-worldlines session id-a id-b) -> (ok state-a state-b rows); needs read\n"
    "constraints: (bus:constraints session) -> (ok version count rows); rows = (name source); needs read\n"
    "query: (bus:query session channel since-generation since-count) -> (ok generation count snapshot rows)\n"
    "trial: (bus:trial session channel [task-id]) -> (ok worldline); needs trial; a task-scoped grant must pass its task id\n"
    "keep/rollback: (bus:keep session worldline node value) / (bus:rollback session worldline); needs keep/rollback and the current constraints pass\n"
    "grant/revoke: (bus:grant session bits channels loans expires worldline [task-id]) -> (ok token); (bus:revoke session token); needs grant; a task id scopes the grant to that task's trial (#5401)\n"
    "audit: (bus:audit session worldline) -> (ok count truncated events); needs read\n"
    "gate: (bus:bind-gate session worldline round workload seed verifier folds threshold control verdict windows) -> (ok worldline); (bus:gate-evidence session worldline) -> (ok verdict family adjusted threshold fingerprint); the coordinator recomputes the admission verdict from the held-out windows\n"
    "replay: (bus:audit-replay session) -> (ok events worldlines keeps findings first-seq first-kind first-reason nodes); (bus:audit-evo session) -> (ok text); the lineage, its integrity findings and the reproduced verdicts\n"
    "source: (bus:publish-source session source-text) -> (ok index generation); (bus:source-read session index) -> (ok source-text); (bus:source-field) is the patch field marker; the committed source of a candidate define, so the judge can measure it\n"
    "evidence: (bus:bind-evidence session worldline baseline candidate workload seed verifier) -> (ok worldline); (bus:evidence session worldline) -> (ok five-tuple); (bus:candidate-digest session worldline) -> (ok digest); (bus:canary-confirm session worldline) seals an observation\n"
    "grant: (bus:grant-activate session token) narrows this session to a granted token's capability\n"
    "defines: (bus:defines session) -> (ok count rows); rows = (name node-id); the host's live define names, so a peer can address a function by name\n"
    "round: (bus:round-open session) -> (ok round-id phase); (bus:round-state session) -> (ok phase round-id worldline opened sealed reason); (bus:round-budget session) -> (ok wall-ms cooldown-ms max-rounds version); the admission round state machine\n"
    "degrade: (bus:degradation-state session) -> (ok version samples alerts last-change min-samples drift limit calm keys); (bus:degrade-install session min-samples alpha drift limit calm down-keys up-keys) / (bus:degrade-rollback session) -> (ok version); the host's degradation detector\n"
    "slo: (bus:slo session) -> (ok frames frame-cpu-ns p99-cpu-ns publishes publish-cpu-ns attaches attach-cpu-ns catchups catchup-max); (bus:capacity-plan session) -> (ok rounds low remaining-metrics remaining-cc remaining-patches remaining-worldlines remaining-nodes committed-bytes image-bytes); the bus's own overhead and the room left\n"
    "tasks: (bus:post-task session parent ref) -> (ok id state owner epoch deadline parent ref); (bus:claim session lease-ms [task-id]) claims the oldest open task (or the named one) atomically; (bus:heartbeat session task-id lease-ms) renews; (bus:complete session task-id ref) / (bus:fail session task-id ref) finish; (bus:task-status session task-id) reads state (0 open, 1 claimed, 2 done, 3 failed) and open-count; channel 6 carries the task events\n"
    "failures: (error code message); codes: schema-mismatch, seals-missing, loan-exhausted, image-full, validation-failed, permission, unregistered-id, transport-failed\n"))

(define (bus:status record) (car record))
(define (bus:ok? record) (string=? (car record) "ok"))
(define (bus:error? record) (string=? (car record) "error"))
(define (bus:attach? record) (bus:ok? record))
(define (bus:record? value) (pair? value))
(define (bus:code record)
  (if (and (pair? record) (pair? (cdr record))) (car (cdr record)) #f))
(define (bus:message record)
  (if (and (pair? record) (pair? (cdr record)) (pair? (cddr record)))
      (car (cddr record))
      #f))
